{
  "name": "lenso-ui-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "actions:check": "node tooling/check-action-pins.mjs",
    "build": "pnpm generate && turbo run build",
    "build:packages": "pnpm generate && turbo run build --filter='!@lenso/ui-docs'",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm lint && pnpm actions:check && pnpm release-status:check && pnpm test:tooling && pnpm generate && pnpm --filter @lenso/token-generator check-generated && turbo run typecheck test build && pnpm design-lint",
    "design-lint": "pnpm --filter @lenso/token-generator check-generated && pnpm --filter @lenso/design-lint build && node packages/design-lint/dist/cli.mjs --config design-lint.config.json",
    "dev": "turbo run dev --parallel",
    "format": "oxfmt --ignore-path .oxfmtignore . && pnpm format:mdx",
    "format:check": "oxfmt --ignore-path .oxfmtignore --check . && pnpm format:mdx:check",
    "format:mdx": "node tooling/format-mdx.mjs --write",
    "format:mdx:check": "node tooling/format-mdx.mjs --check",
    "generate": "pnpm --filter @lenso/token-generator generate && pnpm --filter @lenso/registry-builder generate",
    "lint": "oxlint --deny-warnings --react-plugin --jsx-a11y-plugin .",
    "release-status:check": "node tooling/release-status.mjs --check",
    "release-status:write": "node tooling/release-status.mjs --write",
    "test": "turbo run test",
    "test:tooling": "node --test tooling/*.test.mjs",
    "typecheck": "turbo run typecheck",
    "version": "changeset version && pnpm release-status:write && pnpm generate && pnpm --filter @lenso/registry-builder snapshot"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@stylexjs/stylex": "catalog:",
    "@stylexjs/unplugin": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "^24.18.0"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}
