---
import pages from '../../.cache/pages.json';
export function getStaticPaths() {
  return pages.map(page=>({params:{slug:page.path==='/'?undefined:page.path.slice(1)},props:{page}}));
}
const {page}=Astro.props;
---
<html lang="en">
  <head><meta charset="utf-8"/><title>{page.title}</title></head>
  <body>
    <header>Documentation benchmark</header>
    <nav aria-label="Documentation">{pages.map(item=><a href={item.path}>{item.title}</a>)}</nav>
    <section aria-label="Search documentation">
      <input aria-label="Search documentation" type="search"/>
      <div id="results"></div>
    </section>
    <main><Fragment set:html={page.html}/></main>
    <script>
      const input=document.querySelector('input')!;
      const results=document.querySelector('#results')!;
      let revision=0;
      input.addEventListener('input',async()=>{
        const version=++revision,query=input.value.trim().toLowerCase();
        if(!query){results.replaceChildren();return;}
        const {index}=await import('../search-data');
        if(version!==revision)return;
        const links=index.filter(item=>item.text.includes(query)).map(item=>{
          const link=document.createElement('a');link.href=item.href;link.textContent=item.title;return link;
        });
        results.replaceChildren(...links);
      });
    </script>
    <style is:global>
      body { margin: 0; font: 16px system-ui, sans-serif; }
      h1,h2,p,pre { margin: 0; }
      h1 { font-size: 27px; } h2 { font-size: 21px; }
      pre,code { font: inherit; white-space: pre-wrap; }
      nav a,#results a { display: block; }
    </style>
  </body>
</html>
