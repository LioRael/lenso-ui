---
import { ClientRouter } from 'astro:transitions';
import pages from '../../.cache/pages.json';
export function getStaticPaths() {
  return pages.map(page=>({params:{slug:page.path==='/'?undefined:page.path.slice(1)},props:{page}}));
}
const {page}=Astro.props;
const clientRouter=process.env.COMPARE_CLIENT_ROUTER==='1';
const markdown=JSON.stringify(page.markdown).replaceAll('<','\\u003c');
---
<html lang={page.locale} transition:animate="none">
  <head>
    <meta charset="utf-8"/><title>{page.title} | Documentation comparison</title>
    <meta name="description" content={page.description}/>
    <link rel="canonical" href={'https://docs.example.test'+page.path}/>
    {clientRouter && <ClientRouter fallback="swap"/>}
  </head>
  <body data-benchmark-scope={page.scope}>
    <div transition:persist="comparison-counter">
      <button data-testid="comparison-counter">Count: 0</button>
    </div>
    <a href={page.path+'#docs-content'} data-astro-prefetch="false">Skip to content</a>
    <header>Documentation comparison</header>
    <nav aria-label="Language">{page.locales.map(item=><a href={item.href} aria-current={item.current?'true':'false'} data-astro-prefetch="false">{item.label}</a>)}</nav>
    <nav aria-label="Version">{page.versions.map(item=><a href={item.href} aria-current={item.current?'true':'false'} data-astro-prefetch="false">{item.label}</a>)}</nav>
    {page.version==='v1' && <div role="status">You are reading an archived version.</div>}
    <nav aria-label="Documentation">{page.groups.map(group=><section aria-label={group.title}><h2>{group.title}</h2>{group.items.map(item=><a href={item.href} aria-current={item.href===page.path?'page':'false'} data-astro-prefetch="false">{item.title}</a>)}</section>)}</nav>
    <section aria-label="Search documentation" data-docs-part="search">
      <input aria-label="Search documentation" type="search"/>
      <div data-search-feedback role="status"></div><div data-search-results></div>
    </section>
    <main id="docs-content" tabindex="-1">
      <p>{page.description}</p>
      <section aria-label="Page actions"><button data-copy>Copy Markdown</button><a href={page.markdownUrl} target="_blank" data-astro-prefetch="false">Open Markdown</a></section>
      <article><Fragment set:html={page.html}/></article>
      <nav aria-label="Adjacent pages">{page.previous&&<a href={page.previous.href} data-astro-prefetch="false">Previous: {page.previous.title}</a>}{page.next&&<a href={page.next.href} data-astro-prefetch="false">Next: {page.next.title}</a>}</nav>
    </main>
    <nav aria-label="On this page">{page.toc.map(item=><a href={page.path+'#'+item.id} data-astro-prefetch="false">{item.title}</a>)}</nav>
    <script type="application/json" id="comparison-markdown" set:html={markdown}/>
    <script>import '../client';</script>
    <style is:global>
      body { margin: 0; font: 16px system-ui, sans-serif; }
      h1,h2,p,pre { margin: 0; }
      h1 { font-size: 27px; } h2 { font-size: 21px; }
      pre,code { font: inherit; white-space: pre-wrap; }
      nav a,[data-search-results] a { display: block; }
    </style>
  </body>
</html>
