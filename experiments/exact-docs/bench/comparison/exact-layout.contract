use DocsLayout, DocsLink, DocsHeading from "@lenso/exact-docs/contract"
component ComparisonLayout
  props
    siteName: string
    pageTitle: string
    currentPath: string
    navigation: DocsLink[]
    toc: DocsHeading[]
    query: string
    search: action
    results: DocsLink[]
  inject
    comparisonCount: number
    comparisonIncrement: action
  slot
  view
    view
      button press=comparisonIncrement testId="comparison-counter"
        text `Count: ${comparisonCount}`
      DocsLayout(siteName=siteName, pageTitle=pageTitle, currentPath=currentPath, navigation=navigation, toc=toc, query=query, search=search, results=results)
        children
