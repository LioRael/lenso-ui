use Theme, Button, SearchFieldState, SearchFieldRoot, SearchFieldGroup, SearchFieldInput, SearchFieldSearchIcon, ModalState, Modal, ModalBackdrop, ModalViewport, ModalPopup, ModalHeader, ModalTitle, ModalBody, ModalTrigger, ModalCloseIcon from "@lenso/ui-exact"
use Link as PrimitiveLink from "@lenso/primitives-exact/button"
use DocsLink, DocsHeading, DocsGroup, DocsChoice, DocsLabels from "@lenso/exact-docs/contract"

component LensoDocsLayout
  props
    siteName: string
    pageTitle: string
    currentPath: string
    navigation: DocsLink[]
    toc: DocsHeading[]
    query: string
    search: action
    results: DocsLink[]
    appearance: string
    toggleAppearance: action
    copyMarkdown: action
  inject
    docsGroups: DocsGroup[]
    docsPrevious: option<DocsLink>
    docsNext: option<DocsLink>
    docsDescription: string
    docsContentPending: bool
    docsContentFailed: bool
    docsMarkdown: string
    docsMarkdownUrl: string
    docsLocales: DocsChoice[]
    docsVersions: DocsChoice[]
    docsLabels: DocsLabels
    docsVersionStatus: string
    docsSearchPending: bool
    docsSearchFailed: bool
    docsLocale: string
  slot
  derive field = SearchFieldState(id="docs-search", name="query", label=docsLabels.search, labelledBy="", describedBy="", value=query, placeholder=docsLabels.search, autocomplete="off", variant="secondary", fullWidth=true, disabled=false, readOnly=false, required=false, invalid=false)
  derive drawer = ModalState(id="docs-mobile-navigation", label=docsLabels.navigation, labelledBy="docs-menu-title", describedBy="", dismiss="any", size="sm", placement="top", scroll="inside", backdrop="dimmed")
  derive home = match first(navigation) { case some(item) => item.href, case none => "/" }
  view
    Theme(appearance=appearance)
      view data-docs-part="root" data-docs-theme-part="root"
        link href=`${currentPath}#docs-content` data-docs-theme-part="skip"
          text docsLabels.skipContent
        header data-docs-part="header" data-docs-theme-part="header"
          view data-docs-theme-part="header-backdrop" aria-hidden=true
          view data-docs-theme-part="header-row"
            view data-docs-theme-part="mobile-trigger"
              ModalTrigger(id="docs-menu-open", label=docsLabels.navigation, target=drawer.id, disabled=false, size="sm", variant="borderless")
                svg width=18 height=18 viewBox="0 0 20 20" fill="none" aria-hidden=true
                  path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width=1.5 stroke-linecap="round"
            link href=home data-docs-theme-part="brand"
              text siteName
            section aria-label=docsLabels.search data-docs-part="search" data-docs-theme-part="search"
              SearchFieldRoot(state=field)
                SearchFieldGroup(state=field)
                  SearchFieldSearchIcon()
                  SearchFieldInput(state=field, input=search, change=search, submit=search(query))
              if query != ""
                view data-docs-theme-part="results" aria-live="polite"
                  if docsSearchPending
                    text docsLabels.searchLoading role="status"
                  else if docsSearchFailed
                    text docsLabels.searchError role="alert"
                  else
                    if results.length == 0
                      text docsLabels.noResults role="status"
                    for item in results key=item.href
                      link href=item.href
                        text item.title
            Button(label=(appearance == "light" ? (docsLocale == "zh-CN" ? "深色" : "Dark") : (docsLocale == "zh-CN" ? "浅色" : "Light")), press=toggleAppearance, disabled=false, size="sm", variant="borderless", testId="docs-appearance")
        view data-docs-theme-part="columns"
          aside data-docs-theme-part="sidebar"
            link href=home data-docs-theme-part="sidebar-brand"
              text siteName
            LensoDocsNavigation(currentPath=currentPath)
          main id="docs-content" data-docs-part="content" data-docs-theme-part="article" tabindex=-1 aria-busy=docsContentPending
            if docsVersionStatus == "archived" or docsVersionStatus == "deprecated"
              text (docsVersionStatus == "archived" ? docsLabels.archivedVersion : docsLabels.deprecatedVersion) role="status" data-docs-part="version-notice" data-docs-theme-part="notice"
            if docsMarkdownUrl != "" or docsMarkdown != ""
              section aria-label=docsLabels.pageActions data-docs-part="page-actions" data-docs-theme-part="page-actions"
                Button(label=docsLabels.copyMarkdown, press=copyMarkdown(docsMarkdown), disabled=(docsContentPending or docsContentFailed), size="sm", variant="borderless", testId="copy-markdown")
                if docsMarkdownUrl != ""
                  PrimitiveLink(id="docs-open-markdown", label=docsLabels.openMarkdown, href=docsMarkdownUrl)
                    svg width=14 height=14 viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width=1.5 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
                      path d="M6 3H3v10h10v-3M9 3h4v4M13 3 7 9"
            children
            nav aria-label=docsLabels.pagination data-docs-part="pagination" data-docs-theme-part="pagination"
              match docsPrevious
                case some(item)
                  link href=item.href
                    text docsLabels.previous data-docs-theme-part="eyebrow"
                    text item.title
                case none
                  view
              match docsNext
                case some(item)
                  link href=item.href
                    text docsLabels.next data-docs-theme-part="eyebrow"
                    text item.title
                case none
                  view
          aside data-docs-theme-part="toc"
            if toc.length > 0
              text docsLabels.toc data-docs-theme-part="toc-heading"
              nav aria-label=docsLabels.toc data-docs-part="toc"
                for item in toc key=item.id
                  if item.level > 1
                    link href=`${currentPath}#${item.id}`
                      text item.title
        Modal(state=drawer)
          ModalBackdrop(state=drawer)
          ModalViewport()
            ModalPopup(state=drawer)
              ModalHeader()
                ModalTitle(id="docs-menu-title", level=2)
                  text docsLabels.navigation
                ModalCloseIcon(id="docs-menu-close", label=docsLabels.back, target=drawer.id, disabled=false)
              ModalBody(state=drawer)
                LensoDocsNavigation(currentPath=currentPath)

component LensoDocsNavigation
  props
    currentPath: string
  inject
    docsGroups: DocsGroup[]
    docsLocales: DocsChoice[]
    docsVersions: DocsChoice[]
    docsLabels: DocsLabels
  view
    column data-docs-theme-part="navigation-body"
      nav aria-label=docsLabels.navigation data-docs-part="navigation"
        for group in docsGroups key=group.id
          section data-docs-part="navigation-group"
            if group.title != ""
              h2
                text group.title
            for item in group.items key=item.href
              link href=item.href aria-current=(item.href == currentPath ? "page" : "false")
                text item.title
      view data-docs-theme-part="scope"
        if docsLocales.length > 1
          nav aria-label=docsLabels.language data-docs-part="locales"
            for item in docsLocales key=item.id
              if item.href != ""
                link href=item.href aria-current=(item.current ? "true" : "false")
                  text item.label
              else
                text item.label aria-disabled=true
        if docsVersions.length > 1
          nav aria-label=docsLabels.version data-docs-part="versions"
            for item in docsVersions key=item.id
              if item.href != ""
                link href=item.href aria-current=(item.current ? "true" : "false")
                  text item.label
              else
                text item.label aria-disabled=true

component LensoDocsNotFound
  props
    siteName: string
    home: string
    visitKey: string
  slot
  view
    view navigationKey=visitKey
      Theme(appearance="light")
        view data-docs-theme-part="root"
          header data-docs-theme-part="header"
            view data-docs-theme-part="header-backdrop" aria-hidden=true
            view data-docs-theme-part="header-row"
              link href=home data-docs-theme-part="not-found-brand"
                text siteName
          view data-docs-theme-part="columns"
            main data-docs-part="content" data-docs-theme-part="article" tabindex=-1
              children
