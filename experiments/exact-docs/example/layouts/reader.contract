use DocsLink, DocsHeading, DocsGroup, DocsChoice, DocsLabels from "@lenso/exact-docs/contract"

component ReaderLayout
  props
    siteName: string
    pageTitle: string
    currentPath: string
    navigation: DocsLink[]
    toc: DocsHeading[]
    query: string
    search: action
    results: DocsLink[]
  inject
    docsGroups: DocsGroup[]
    docsPrevious: option<DocsLink>
    docsNext: option<DocsLink>
    docsDescription: string
    docsContentPending: bool
    docsContentFailed: bool
    docsMarkdown: string
    docsMarkdownUrl: string
    docsLocales: DocsChoice[]
    docsVersions: DocsChoice[]
    docsLabels: DocsLabels
    docsVersionStatus: string
    docsSearchPending: bool
    docsSearchFailed: bool
  slot
  action copyMarkdown
    copyText(docsMarkdown)
  view
    view data-docs-part="reader-layout" testId="reader-layout"
      link href=`${currentPath}#docs-content`
        text docsLabels.skipContent
      header data-docs-part="header"
        text siteName
        text pageTitle testId="reader-title"
      if docsLocales.length > 1
        nav aria-label=docsLabels.language data-docs-part="locales"
          for item in docsLocales key=item.id
            if item.href != ""
              link href=item.href aria-current=(item.current ? "true" : "false")
                text item.label
            else
              text `${item.label} (${docsLabels.unavailable})`
      if docsVersions.length > 1
        nav aria-label=docsLabels.version data-docs-part="versions"
          for item in docsVersions key=item.id
            if item.href != ""
              link href=item.href aria-current=(item.current ? "true" : "false")
                text item.label
            else
              text `${item.label} (${docsLabels.unavailable})`
      if docsVersionStatus == "archived" or docsVersionStatus == "deprecated"
        text (docsVersionStatus == "archived" ? docsLabels.archivedVersion : docsLabels.deprecatedVersion) role="status" data-docs-part="version-notice"
      nav aria-label=docsLabels.navigation data-docs-part="navigation"
        for group in docsGroups key=group.id
          section data-docs-part="navigation-group" aria-label=group.title
            if group.title != ""
              h2
                text group.title
            for item in group.items key=item.href
              link href=item.href aria-current=(item.href == currentPath ? "page" : "false")
                text item.title
      section aria-label=docsLabels.search data-docs-part="search"
        input type="search" aria-label=docsLabels.search value=query input=search
        if query != ""
          if docsSearchPending
            text docsLabels.searchLoading role="status"
          else if docsSearchFailed
            text docsLabels.searchError role="alert"
          else
            if results.length == 0
              text docsLabels.noResults role="status"
            for item in results key=item.href
              link href=item.href
                text item.title
      nav aria-label=docsLabels.toc data-docs-part="toc"
        for item in toc key=item.id
          link href=`${currentPath}#${item.id}`
            text item.title
      main id="docs-content" data-docs-part="content" tabindex=-1 aria-busy=docsContentPending
        if docsDescription != ""
          text docsDescription data-docs-part="description"
        if docsMarkdownUrl != ""
          section aria-label=docsLabels.pageActions data-docs-part="page-actions"
            button press=copyMarkdown disabled=(docsContentPending or docsContentFailed) testId="copy-markdown"
              text docsLabels.copyMarkdown
            link href=docsMarkdownUrl target="_blank"
              text docsLabels.openMarkdown
        children
        nav aria-label=docsLabels.pagination data-docs-part="pagination"
          match docsPrevious
            case some(item)
              link href=item.href aria-label=`${docsLabels.previous}: ${item.title}`
                text `${docsLabels.previous}: ${item.title}`
            case none
              view
          match docsNext
            case some(item)
              link href=item.href aria-label=`${docsLabels.next}: ${item.title}`
                text `${docsLabels.next}: ${item.title}`
            case none
              view
