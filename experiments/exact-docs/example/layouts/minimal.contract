use DocsLink, DocsHeading from "@lenso/exact-docs/contract"

// Set docs.json layout to {"source":"layouts/minimal.contract","component":"MinimalLayout"}.
component MinimalLayout
  props
    siteName: string
    pageTitle: string
    currentPath: string
    navigation: DocsLink[]
    toc: DocsHeading[]
    query: string
    search: action
    results: DocsLink[]
  slot
  view
    view data-docs-part="custom-layout" testId="custom-layout"
      header
        text siteName
      nav aria-label="Documentation"
        for item in navigation key=item.href
          link href=item.href aria-current=(item.href == currentPath ? "page" : "false")
            text item.title
      input type="search" aria-label="Search documentation" value=query input=search
      if query != ""
        for item in results key=item.href
          link href=item.href
            text item.title
      main
        children
