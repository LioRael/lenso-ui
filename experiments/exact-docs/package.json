{
  "name": "@lenso/exact-docs",
  "version": "0.0.1",
  "private": true,
  "bin": {
    "exact-docs": "./src/cli.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./contract/index.contract",
    "./content": "./src/content.ts",
    "./markdown": "./src/markdown.ts",
    "./renderers/exact": "./src/renderers/exact.ts",
    "./renderers/html": "./src/renderers/html.ts"
  },
  "scripts": {
    "test": "bun test test/*.test.ts",
    "typecheck": "bun check --no-script -p tsconfig.json",
    "dev": "bun src/cli.ts dev example",
    "build": "bun src/cli.ts build example",
    "validate": "bun src/cli.ts validate example",
    "test:browser": "bun test/browser.mjs",
    "test:performance": "bun bench/performance.mjs",
    "test:compare": "bun bench/compare.mjs",
    "test:production": "bun test/production.mjs",
    "test:scale": "bun bench/scale.mjs",
    "test:acceptance": "bun test/acceptance.mjs",
    "test:content-loading": "bun test/content-loading.mjs"
  },
  "dependencies": {
    "shiki": "4.6.0"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
