{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun", "node", "react", "@webgpu/types"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": [
    "glass-route-lab/*.ts",
    "glass-shared-gpu/*.ts",
    "glass-shared-core/*.ts",
    "glass-driver-comparison/*.ts"
  ]
}
