{
  "version": 1,
  "name": "Compare physical iOS hard scroll edges",
  "description": "Open the local hard-edge probe at Pattern / Y 128 and cycle Native, MyGo and current Lenso Trial in light then dark appearance, verifying each settled offset receipt. Navigation smoke check only: record or capture the individual states separately for optical measurements. Requires the hard probe build, not the earlier soft probe. Leaves Trial / Dark on screen.",
  "app": "local.lenso.ScrollEdgeProbe",
  "risk": "navigation",
  "category": "testing",
  "locale": "en-US",
  "tags": ["lenso", "hard-scroll-edge", "physical-ios"],
  "verified_on": [
    {
      "device": "iPhone 15 Pro Max",
      "ios": "27.2",
      "date": "2026-11-08"
    }
  ],
  "steps": [
    {
      "kind": "launch_app",
      "bundle": "local.lenso.ScrollEdgeProbe"
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "label": "Trial"
          }
        ]
      },
      "timeout_ms": 6000,
      "poll_ms": 250
    },
    {
      "kind": "tap_label",
      "label": "Pattern"
    },
    {
      "kind": "tap_label",
      "label": "Light"
    },
    {
      "kind": "tap_label",
      "label": "Y 128"
    },
    {
      "kind": "tap_label",
      "label": "Native"
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "label": "Native · y=128 · native hard · edge=96"
          }
        ]
      },
      "timeout_ms": 6000,
      "poll_ms": 250
    },
    {
      "kind": "pause",
      "ms": 1000
    },
    {
      "kind": "tap_label",
      "label": "MyGo"
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "label": "MyGo · {\"y\":128,\"width\":430,\"dpr\":3}"
          }
        ]
      },
      "timeout_ms": 6000,
      "poll_ms": 250
    },
    {
      "kind": "pause",
      "ms": 1000
    },
    {
      "kind": "tap_label",
      "label": "Trial"
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "label": "Trial · {\"y\":128,\"width\":430,\"dpr\":3}"
          }
        ]
      },
      "timeout_ms": 6000,
      "poll_ms": 250
    },
    {
      "kind": "pause",
      "ms": 1000
    },
    {
      "kind": "tap_label",
      "label": "Dark"
    },
    {
      "kind": "tap_label",
      "label": "Native"
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "label": "Native · y=128 · native hard · edge=96"
          }
        ]
      },
      "timeout_ms": 6000,
      "poll_ms": 250
    },
    {
      "kind": "pause",
      "ms": 1000
    },
    {
      "kind": "tap_label",
      "label": "MyGo"
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "label": "MyGo · {\"y\":128,\"width\":430,\"dpr\":3}"
          }
        ]
      },
      "timeout_ms": 6000,
      "poll_ms": 250
    },
    {
      "kind": "pause",
      "ms": 1000
    },
    {
      "kind": "tap_label",
      "label": "Trial"
    },
    {
      "kind": "wait_for",
      "expect": {
        "present": [
          {
            "label": "Trial · {\"y\":128,\"width\":430,\"dpr\":3}"
          }
        ]
      },
      "timeout_ms": 6000,
      "poll_ms": 250
    },
    {
      "kind": "pause",
      "ms": 1000
    }
  ]
}
