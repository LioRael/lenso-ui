#!/bin/sh
set -eu
[ "$#" -eq 0 ] || { echo "This script takes no arguments" >&2; exit 64; }
. .agents/env
command -v bun >/dev/null 2>&1 || { echo "Required tool: Bun 1.4.4; Linux: .agents/setup" >&2; exit 78; }
[ "$(bun --version)" = 1.4.4 ] || { echo "Required Bun 1.4.4" >&2; exit 78; }
# Documentation hosts, preserved primitives and publishing use the pinned Node version.
command -v node >/dev/null 2>&1 || { echo "Required tool: Node 26.10.0" >&2; exit 78; }
[ "$(node --version)" = v26.10.0 ] || { echo "Required Node 26.10.0" >&2; exit 78; }
bun install --frozen-lockfile
