#!/bin/sh
set -eu
[ "$#" -eq 0 ] || { echo "This script takes no arguments" >&2; exit 64; }
. .agents/env
command -v node >/dev/null 2>&1 || { echo "Required tool: node; Linux: .agents/setup; macOS: supply the documented tool locally" >&2; exit 78; }
[ "$(node --version)" = v26.10.0 ] || { echo "Required Node 26.10.0" >&2; exit 78; }
command -v pnpm >/dev/null 2>&1 || { echo "Required tool: pnpm; Linux: .agents/setup; macOS: supply the documented tool locally" >&2; exit 78; }
[ "$(pnpm --version)" = 12.9.1 ] || { echo "Required pnpm 12.9.1" >&2; exit 78; }

pnpm install --frozen-lockfile
