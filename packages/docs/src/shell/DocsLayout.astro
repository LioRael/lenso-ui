---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";

import type { DocsConfig } from "../config";
import { docsHref, routeSlug } from "../config";
import type { DocsNavTab } from "../navigation";
import "@lenso/tokens/styles.css";
import "./docs.css";

interface Props {
  config: DocsConfig;
  entry: CollectionEntry<"docs">;
  headings: MarkdownHeading[];
  navigation: DocsNavTab[];
}

const { config, entry, headings, navigation } = Astro.props;
const currentHref = docsHref(config, entry.id);
const slug = routeSlug(entry.id);
const activeTab = navigation.find((tab) => slug === tab.path || slug.startsWith(`${tab.path}/`));
const searchHref = `${config.basePath ?? ""}/search.json`.replace(/\/+/g, "/");
const pageTitle = `${entry.data.title} · ${config.title}`;
const canonical = config.site || Astro.site ? new URL(currentHref, config.site ?? Astro.site).href : undefined;
const visibleHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:," />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    {entry.data.description && <meta name="description" content={entry.data.description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <script is:inline>
      try {
        document.documentElement.dataset.theme = localStorage.getItem("lenso-docs-theme")
          || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      } catch {}
    </script>
  </head>
  <body>
    <div class="docs-shell" data-search-href={searchHref}>
      <header class="docs-header">
        <div class="docs-header-leading">
          <button class="docs-icon-button docs-mobile-nav-trigger" type="button" aria-label="Open navigation" data-open-nav>
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
          </button>
          <a class="docs-brand" href={navigation[0]?.href ?? "/"}>{config.title}</a>
          <span class="docs-brand-divider" aria-hidden="true"></span>
          <nav class="docs-tabs" aria-label="Documentation sections">
            {navigation.map((tab) => (
              <a class:list={["docs-tab", { "is-active": tab.path === activeTab?.path }]} href={tab.href} aria-current={tab.path === activeTab?.path ? "page" : undefined}>
                {tab.label}
              </a>
            ))}
          </nav>
        </div>
        <button class="docs-search-trigger" type="button" data-open-search aria-label="Search documentation">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="8.8" cy="8.8" r="5.4" stroke="currentColor" stroke-width="1.4" /><path d="m13 13 4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
          <span class="docs-search-label">Search documentation</span>
          <span class="docs-search-shortcut" data-search-shortcut>⌘ K</span>
        </button>
        <button class="docs-icon-button docs-theme-trigger" type="button" aria-label="Change color theme" data-toggle-theme>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M16.6 12.2A7 7 0 0 1 7.8 3.4 7 7 0 1 0 16.6 12.2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
        </button>
      </header>

      <aside class="docs-sidebar" aria-label="Section navigation">
        <div class="docs-sidebar-inner">
          <p class="docs-sidebar-heading">{activeTab?.label ?? "Documentation"}</p>
          <nav aria-label={activeTab?.label ?? "Documentation"}>
            {activeTab?.groups.map((group) => (
              <div class="docs-sidebar-group">
                {group.title && <p class="docs-sidebar-group-heading">{group.title}</p>}
                {group.pages.map((page) => (
                  <a class:list={["docs-sidebar-item", { "is-active": page.href === currentHref }]} href={page.href} aria-current={page.href === currentHref ? "page" : undefined}>
                    {page.title}
                  </a>
                ))}
              </div>
            ))}
          </nav>
        </div>
      </aside>

      <main class="docs-main" id="main-content">
        <div class="docs-content-layout">
          <article class="docs-article">
            <div class="docs-article-heading">
              <p class="docs-article-eyebrow">{activeTab?.label}</p>
              <h1>{entry.data.title}</h1>
              {entry.data.description && <p class="docs-article-description">{entry.data.description}</p>}
            </div>
            <div class="docs-prose"><slot /></div>
          </article>
          {visibleHeadings.length > 0 && (
            <aside class="docs-toc" aria-label="On this page">
              <p>On this page</p>
              <nav>
                {visibleHeadings.map((heading) => (
                  <a class:list={["docs-toc-link", { "is-nested": heading.depth === 3 }]} href={`#${heading.slug}`}>{heading.text}</a>
                ))}
              </nav>
            </aside>
          )}
        </div>
      </main>
    </div>

    <dialog class="docs-mobile-nav" data-nav-dialog aria-label="Navigation">
      <div class="docs-dialog-topline"><span>{config.title}</span><button class="docs-icon-button" type="button" aria-label="Close navigation" data-close-nav>×</button></div>
      <nav aria-label="Documentation sections">
        {navigation.map((tab) => <a class:list={["docs-tab", { "is-active": tab.path === activeTab?.path }]} href={tab.href}>{tab.label}</a>)}
      </nav>
      <div class="docs-mobile-nav-pages">
        {activeTab?.groups.map((group) => (
          <div class="docs-sidebar-group">
            {group.title && <p class="docs-sidebar-group-heading">{group.title}</p>}
            {group.pages.map((page) => <a class:list={["docs-sidebar-item", { "is-active": page.href === currentHref }]} href={page.href}>{page.title}</a>)}
          </div>
        ))}
      </div>
    </dialog>

    <dialog class="docs-search-dialog" data-search-dialog aria-label="Search documentation">
      <div class="docs-search-input-wrap">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="8.8" cy="8.8" r="5.4" stroke="currentColor" stroke-width="1.4" /><path d="m13 13 4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
        <input type="search" aria-label="Search documentation" placeholder="Search documentation…" data-search-input autocomplete="off" />
        <button type="button" data-close-search aria-label="Close search">Esc</button>
      </div>
      <div class="docs-search-results" data-search-results role="status" aria-live="polite">Type to search the documentation.</div>
    </dialog>

    <script>
      const root = document.querySelector<HTMLElement>(".docs-shell");
      const navDialog = document.querySelector<HTMLDialogElement>("[data-nav-dialog]");
      const searchDialog = document.querySelector<HTMLDialogElement>("[data-search-dialog]");
      const searchInput = document.querySelector<HTMLInputElement>("[data-search-input]");
      const results = document.querySelector<HTMLElement>("[data-search-results]");
      type SearchDocument = { href: string; title: string; description: string; text: string };
      let documents: SearchDocument[] | undefined;

      document.querySelector("[data-open-nav]")?.addEventListener("click", () => navDialog?.showModal());
      document.querySelector("[data-close-nav]")?.addEventListener("click", () => navDialog?.close());
      navDialog?.addEventListener("click", (event) => { if (event.target === navDialog) navDialog.close(); });

      async function openSearch() {
        searchDialog?.showModal();
        searchInput?.focus();
        if (documents || !root?.dataset.searchHref) return;
        if (results) results.textContent = "Loading pages…";
        try {
          const response = await fetch(root.dataset.searchHref);
          if (!response.ok) throw new Error(String(response.status));
          documents = await response.json() as SearchDocument[];
          updateResults();
        } catch {
          if (results) results.textContent = "Search is unavailable. Try again later.";
        }
      }

      function updateResults() {
        if (!results || !searchInput || !documents) return;
        const query = searchInput.value.trim().toLocaleLowerCase();
        results.replaceChildren();
        if (!query) { results.textContent = "Type to search the documentation."; return; }
        const terms = query.split(/\s+/);
        const matches = documents
          .map((doc) => {
            const title = doc.title.toLocaleLowerCase();
            const description = doc.description.toLocaleLowerCase();
            const body = doc.text.toLocaleLowerCase();
            const score = terms.every((term) => title.includes(term) || description.includes(term) || body.includes(term))
              ? terms.reduce((sum, term) => sum + (title.includes(term) ? 6 : 0) + (description.includes(term) ? 3 : 0) + (body.includes(term) ? 1 : 0), 0)
              : 0;
            return { doc, score };
          })
          .filter(({ score }) => score > 0)
          .sort((a, b) => b.score - a.score)
          .slice(0, 12);
        if (!matches.length) { results.textContent = "No pages match your search."; return; }
        for (const { doc } of matches) {
          const link = document.createElement("a");
          link.href = doc.href;
          const title = document.createElement("strong");
          title.textContent = doc.title;
          const description = document.createElement("span");
          description.textContent = doc.description;
          link.append(title, description);
          results.append(link);
        }
      }

      document.querySelectorAll("[data-open-search]").forEach((button) => button.addEventListener("click", openSearch));
      document.querySelector("[data-close-search]")?.addEventListener("click", () => searchDialog?.close());
      searchDialog?.addEventListener("click", (event) => { if (event.target === searchDialog) searchDialog.close(); });
      searchInput?.addEventListener("input", updateResults);
      searchInput?.addEventListener("keydown", (event) => {
        const first = results?.querySelector<HTMLAnchorElement>("a");
        if ((event.key === "ArrowDown" || event.key === "Enter") && first) {
          event.preventDefault();
          if (event.key === "Enter") first.click(); else first.focus();
        }
      });
      results?.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
        const links = [...results.querySelectorAll<HTMLAnchorElement>("a")];
        const current = links.indexOf(document.activeElement as HTMLAnchorElement);
        if (current < 0) return;
        event.preventDefault();
        const next = event.key === "ArrowDown" ? links[current + 1] : links[current - 1];
        if (next) next.focus(); else if (event.key === "ArrowUp") searchInput?.focus();
      });
      if (!/Mac|iPhone|iPad/.test(navigator.platform)) {
        const shortcut = document.querySelector<HTMLElement>("[data-search-shortcut]");
        if (shortcut) shortcut.textContent = "Ctrl K";
      }
      document.addEventListener("keydown", (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
          event.preventDefault();
          if (searchDialog?.open) searchDialog.close(); else void openSearch();
        }
      });

      const themeTrigger = document.querySelector<HTMLButtonElement>("[data-toggle-theme]");
      function updateThemeLabel() {
        themeTrigger?.setAttribute("aria-label", document.documentElement.dataset.theme === "dark" ? "Switch to light theme" : "Switch to dark theme");
      }
      updateThemeLabel();
      themeTrigger?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        updateThemeLabel();
        try { localStorage.setItem("lenso-docs-theme", next); } catch {}
      });
    </script>
  </body>
</html>
