---
import { codeToHtml } from "shiki";

interface Props {
  code: string;
  description?: string;
  language?: string;
  title?: string;
}

const {
  code,
  description,
  language = "tsx",
  title = "Implementation",
} = Astro.props;

const lines = code.replace(/\r\n?/g, "\n").split("\n");
while (lines[0]?.trim() === "") lines.shift();
while (lines.at(-1)?.trim() === "") lines.pop();
const filled = lines.filter((line) => line.trim());
const indent = filled.length
  ? Math.min(...filled.map((line) => line.match(/^[ \t]*/)?.[0].length ?? 0))
  : 0;
const source = lines.map((line) => (line.trim() ? line.slice(indent) : "")).join("\n");
const highlighted = await codeToHtml(source, {
  lang: language,
  themes: { light: "github-light", dark: "github-dark" },
});
const headingId = title.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, "-").replace(/^-|-$/g, "");
---

<section class="docs-code-example">
  <h2 id={headingId}>{title}</h2>
  {description && <p>{description}</p>}
  <div class="docs-code-example-source" set:html={highlighted} />
</section>
