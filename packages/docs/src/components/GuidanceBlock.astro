---
interface Props { title: string }
const { title } = Astro.props;
const headingId = title.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, "-").replace(/^-|-$/g, "");
---

<section class="docs-guidance-block">
  <h2 id={headingId}>{title}</h2>
  <div class="docs-guidance-content"><slot /></div>
</section>
