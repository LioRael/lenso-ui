---
import { getCollection } from "astro:content";
import config from "virtual:lenso-docs-config";
import metadata from "virtual:lenso-docs-meta";

import { createDocsNavigation } from "../navigation";

const navigation = createDocsNavigation(config, await getCollection("docs"), metadata);
const target = navigation[0]?.href ?? "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{config.title}</title>
    <link rel="canonical" href={new URL(target, config.site ?? Astro.site ?? Astro.url).href} />
  </head>
  <body>
    <p><a href={target}>Open {config.title}</a></p>
  </body>
</html>
