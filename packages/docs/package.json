{
  "name": "@lenso/docs",
  "version": "0.1.0",
  "description": "Content-first static documentation with MDX and the Lenso documentation shell.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LioRael/lenso-ui.git",
    "directory": "packages/docs"
  },
  "bin": {
    "lenso-docs": "./src/cli.ts"
  },
  "files": [
    "src",
    "dist",
    "LICENSE",
    "LICENSE.FUMADOCS",
    "NOTICE.md",
    "ARCHITECTURE.md",
    "VISUAL.md",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/config.ts",
      "import": "./src/config.ts"
    },
    "./react": {
      "types": "./dist/framework/react.d.ts",
      "import": "./dist/framework/react.js"
    },
    "./client": {
      "types": "./dist/framework/client.d.ts",
      "import": "./dist/framework/client.js"
    },
    "./server": {
      "types": "./dist/framework/compile-document.d.ts",
      "import": "./dist/framework/compile-document.js"
    },
    "./source": {
      "types": "./dist/source/source.d.ts",
      "import": "./dist/source/source.js"
    },
    "./presentation": {
      "types": "./dist/presentation/index.d.ts",
      "import": "./dist/presentation/index.js"
    },
    "./tabs": {
      "types": "./dist/presentation/tabs.d.ts",
      "import": "./dist/presentation/tabs.js"
    },
    "./toc": {
      "types": "./dist/presentation/toc.d.ts",
      "import": "./dist/presentation/toc.js"
    },
    "./highlight": {
      "types": "./dist/presentation/highlight.d.ts",
      "import": "./dist/presentation/highlight.js"
    },
    "./font.css": "./src/font.css",
    "./fonts/*": "./dist/fonts/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ./node_modules/tsdown/dist/run.mjs --config tsdown.config.ts --concurrency 1 && bun ./node_modules/typescript/bin/tsc -p tsconfig.presentation.json && bun scripts/copy-assets.ts && bun ./node_modules/typescript/bin/tsc -p tsconfig.framework.json && bun build src/source.ts --target=bun --outfile dist/source/source.js && bun ./node_modules/typescript/bin/tsc -p tsconfig.source.json && bun build src/runtime.ts --target=bun --external '*' --outfile /dev/null",
    "build:dev": "bun ./node_modules/tsdown/dist/run.mjs --config tsdown.config.ts --concurrency 1 && bun scripts/copy-assets.ts --development && bun build src/source.ts --target=bun --outfile dist/source/source.js && bun ./node_modules/typescript/bin/tsc -p tsconfig.source.json && bun build src/runtime.ts --target=bun --external '*' --outfile /dev/null",
    "test": "bun test --preload ../../tests/setup/stylex.ts --timeout 30000 test/*.test.ts",
    "typecheck": "bun check --no-script --noEmit && bun check --no-script -p tsconfig.test.json --noEmit",
    "lint": "bun --bun oxlint --deny-warnings src test",
    "dev": "bun ./node_modules/tsdown/dist/run.mjs --config tsdown.config.ts --watch --no-clean --concurrency 1"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@base-ui/react": "catalog:",
    "@fuma-translate/react": "1.0.2",
    "@gravity-ui/icons": "2.23.1",
    "@lenso/glass": "workspace:*",
    "@lenso/tokens": "workspace:*",
    "@lenso/ui": "workspace:*",
    "@mdx-js/mdx": "3.1.1",
    "@pierre/highlights": "0.5.0",
    "@stylexjs/babel-plugin": "0.19.1",
    "@stylexjs/postcss-plugin": "0.19.1",
    "@stylexjs/stylex": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "fumadocs-core": "16.18.4",
    "fumadocs-ui": "16.18.4",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "next": "catalog:",
    "next-mdx-remote": "6.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remark-gfm": "4.0.1",
    "shiki": "4.6.0",
    "typescript": "catalog:",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "tsdown": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=20.9.0"
  }
}
