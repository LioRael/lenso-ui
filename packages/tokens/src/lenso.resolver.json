{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "name": "Lenso UI themes",
  "version": "2025.10",
  "sets": {
    "foundation": { "sources": [{ "$ref": "foundation.json" }] }
  },
  "modifiers": {
    "theme": {
      "default": "light",
      "contexts": {
        "light": [{ "$ref": "semantic.json" }, { "$ref": "themes/light.json" }],
        "dark": [{ "$ref": "semantic.json" }, { "$ref": "themes/dark.json" }]
      }
    }
  },
  "resolutionOrder": [{ "$ref": "#/sets/foundation" }, { "$ref": "#/modifiers/theme" }]
}
