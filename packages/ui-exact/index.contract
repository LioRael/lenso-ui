use DisclosureState, AccordionState, AccordionItemState, Disclosure, DisclosureHeading, DisclosureTrigger, DisclosureIndicator, DisclosureContent, DisclosureBody, Accordion, AccordionItem, AccordionHeading, AccordionTrigger, AccordionIndicator, AccordionPanel, AccordionBody from "./components/disclosure.contract"
use Input, TextArea, TextField, InputGroup, InputGroupPrefix, InputGroupSuffix, Label, Description, FieldError, Fieldset, Checkbox, CheckboxGroup, Radio, RadioGroup from "./components/forms.contract"
use Surface from "./components/surface.contract"

component Theme
  props
    appearance: string
  slot
  view
    column data-theme=appearance
      children

component Backdrop
  slot
  view
    column data-lenso-backdrop=""
      children

component Button
  props
    label: string
    press: action
    disabled: bool
    size: string
    variant: string
    testId: string
  view
    button appearance="none" press=press disabled=disabled testId=testId hatch="lenso-ui"
      data-lenso-kind="button" data-lenso-size=size data-lenso-variant=variant
      text label

component Glass
  props
    testId: string
  slot
  view
    column testId=testId hatch="lenso-ui" data-lenso-kind="glass" padding=16 border-radius=24
      children

component GlassButton
  props
    label: string
    press: action
    disabled: bool
    size: string
    variant: string
    testId: string
  view
    button appearance="none" press=press disabled=disabled testId=testId hatch="lenso-ui"
      data-lenso-kind="glass-button" data-lenso-size=size data-lenso-variant=variant
      data-lenso-disabled=disabled
      text label
