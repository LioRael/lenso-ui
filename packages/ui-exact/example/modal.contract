use ModalState, Modal, ModalBackdrop, ModalViewport, ModalPopup, ModalHeader, ModalTitle, ModalDescription, ModalBody, ModalIcon, ModalFooter, ModalTrigger, ModalClose, ModalAction, ModalCloseIcon, Button, Input, Label from "@lenso/ui-exact"

component ModalExample
  state draft = "Lenso"
  state saved = ""
  state error = ""
  state disabled = false
  state mounted = true
  state tall = false
  state scroll = "inside"
  state placement = "auto"
  state size = "md"
  state backdrop = "opaque"
  state dismiss = "closerequest"
  derive settings = ModalState(id="settings-modal", label="Profile settings", labelledBy="settings-modal-title", describedBy="settings-modal-description", dismiss=dismiss, size=size, placement=placement, scroll=scroll, backdrop=backdrop)
  derive nested = ModalState(id="nested-modal", label="Nested confirmation", labelledBy="nested-modal-title", describedBy="", dismiss="closerequest", size="xs", placement="center", scroll="inside", backdrop="opaque")
  action edit(value: string)
    draft = value
    error = ""
  action commit(value: string)
    draft = value
  action save
    if draft.trim().length < 2
      error = "Enter at least two characters."
    else
      saved = draft
      close("settings-modal")
  action toggleDisabled
    disabled = not disabled
  action toggleMounted
    mounted = not mounted
  action toggleTall
    tall = not tall
  action toggleScroll
    scroll = scroll == "inside" ? "outside" : "inside"
  action togglePlacement
    placement = placement == "auto" ? "top" : (placement == "top" ? "center" : (placement == "center" ? "bottom" : "auto"))
  action toggleSize
    size = size == "md" ? "lg" : (size == "lg" ? "xs" : (size == "xs" ? "sm" : (size == "sm" ? "cover" : (size == "cover" ? "full" : "md"))))
  action toggleBackdrop
    backdrop = backdrop == "opaque" ? "blur" : (backdrop == "blur" ? "transparent" : "opaque")
  action toggleDismiss
    dismiss = dismiss == "closerequest" ? "any" : (dismiss == "any" ? "none" : "closerequest")
  action openProgrammatically
    showModal("settings-modal")
  view
    column id="modal-examples" gap=16
      text "Modal" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        ModalTrigger(id="modal-trigger", label="Edit profile", target="settings-modal", disabled=disabled, size="md", variant="prominent")
          text "Edit profile"
        Button(label="Open with action", press=openProgrammatically, disabled=disabled, size="sm", variant="bordered", testId="modal-open-action")
        Button(label="Disable trigger", press=toggleDisabled, disabled=false, size="sm", variant="bordered", testId="modal-disable")
        Button(label="Mount modal", press=toggleMounted, disabled=false, size="sm", variant="bordered", testId="modal-mount")
        Button(label="Modal size", press=toggleSize, disabled=false, size="sm", variant="bordered", testId="modal-size")
        Button(label="Modal placement", press=togglePlacement, disabled=false, size="sm", variant="bordered", testId="modal-placement")
        Button(label="Modal backdrop", press=toggleBackdrop, disabled=false, size="sm", variant="bordered", testId="modal-backdrop")
        Button(label="Modal dismissal", press=toggleDismiss, disabled=false, size="sm", variant="bordered", testId="modal-dismiss")
      text saved testId="modal-saved"
      if mounted
        Modal(state=settings)
          ModalBackdrop(state=settings)
          ModalViewport()
            ModalPopup(state=settings)
              ModalHeader()
                ModalTitle(id="settings-modal-title", level=2)
                  text "Profile settings"
                ModalDescription(id="settings-modal-description")
                  text "Changes are saved only when you confirm."
              ModalBody(state=settings)
                Label(id="modal-name-label", controlId="modal-name", label="Display name", required=true)
                Input(id="modal-name", name="display-name", label="", labelledBy="modal-name-label", describedBy="modal-error", value=draft, input=edit, change=commit, submit=save, placeholder="Name", type="text", autocomplete="name", disabled=false, readOnly=false, required=true, invalid=(error != ""), variant="primary")
                text error id="modal-error" testId="modal-error" role="status"
                row gap=8 flex-wrap="wrap"
                  Button(label="Long content", press=toggleTall, disabled=false, size="sm", variant="bordered", testId="modal-tall")
                  Button(label="Scroll mode", press=toggleScroll, disabled=false, size="sm", variant="bordered", testId="modal-scroll")
                  Button(label="Remove while open", press=toggleMounted, disabled=false, size="sm", variant="borderless", testId="modal-remove")
                  ModalTrigger(id="modal-nested-trigger", label="Open nested confirmation", target="nested-modal", disabled=false, size="sm", variant="bordered")
                    text "Nested confirmation"
                if tall
                  column height=1000 flex-shrink=0 justify-content="space-between"
                    text "Start of scrollable content"
                    text "End of scrollable content" testId="modal-scroll-end"
              ModalFooter()
                ModalClose(id="modal-cancel", label="Cancel", target="settings-modal", disabled=false, size="md", variant="bordered")
                  text "Cancel"
                ModalAction(id="modal-save", label="Save profile", press=save, disabled=false, size="md", variant="prominent")
                  text "Save"
              ModalCloseIcon(id="modal-close-icon", label="Close profile settings", target="settings-modal", disabled=false)
          Modal(state=nested)
            ModalBackdrop(state=nested)
            ModalViewport()
              ModalPopup(state=nested)
                ModalIcon()
                  text "!"
                ModalHeader()
                  ModalTitle(id="nested-modal-title", level=2)
                    text "Nested confirmation"
                ModalFooter()
                  ModalClose(id="nested-close", label="Return to settings", target="nested-modal", disabled=false, size="md", variant="prominent")
                    text "Return"
