use DisclosureState, AccordionState, AccordionItemState, Disclosure, DisclosureHeading, DisclosureTrigger, DisclosureIndicator, DisclosureContent, DisclosureBody, Accordion, AccordionItem, AccordionHeading, AccordionTrigger, AccordionIndicator, AccordionPanel, AccordionBody, Button, Input from "@lenso/ui-exact"

component DisclosureExample
  state expanded = false
  state disabled = false
  state mounted = true
  state tall = false
  state draft = "Keep this draft"
  state submitted = ""
  state selected = ["account"]
  state nested = ["one"]
  state multiple = false
  state orientation = "vertical"
  state variant = "surface"
  state loopFocus = true
  state hideSeparator = false
  derive details = DisclosureState(id="details", open=expanded, disabled=disabled)
  derive settings = AccordionState(id="settings", value=selected, multiple=multiple, disabled=disabled, orientation=orientation, loopFocus=loopFocus, variant=variant, hideSeparator=hideSeparator)
  derive innerSettings = AccordionState(id="nested-settings", value=nested, multiple=false, disabled=false, orientation="vertical", loopFocus=true, variant="default", hideSeparator=false)
  derive account = AccordionItemState(id="account-section", value="account", disabled=false)
  derive locked = AccordionItemState(id="locked-section", value="locked", disabled=true)
  derive privacy = AccordionItemState(id="privacy-section", value="privacy", disabled=false)
  derive innerOne = AccordionItemState(id="nested-one", value="one", disabled=false)
  derive innerTwo = AccordionItemState(id="nested-two", value="two", disabled=false)
  action expand(value: bool)
    expanded = value
  action collapse
    expanded = false
  action toggleDisabled
    disabled = not disabled
  action toggleMounted
    mounted = not mounted
  action toggleTall
    tall = not tall
  action edit(value: string)
    draft = value
  action submit
    submitted = draft
  action select(value: string[])
    selected = value
  action selectNested(value: string[])
    nested = value
  action toggleMultiple
    if multiple
      selected = selected.slice(0, 1)
    multiple = not multiple
  action toggleOrientation
    orientation = orientation == "vertical" ? "horizontal" : "vertical"
  action toggleVariant
    variant = variant == "surface" ? "default" : "surface"
  action toggleLoop
    loopFocus = not loopFocus
  action toggleSeparators
    hideSeparator = not hideSeparator
  view
    column id="disclosure-examples" gap=12 padding-top=24
      text "Expandable content" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        Button(label="Disable expanders", press=toggleDisabled, disabled=false, size="md", variant="bordered", testId="expanders-disabled")
        Button(label="Toggle expanders", press=toggleMounted, disabled=false, size="md", variant="bordered", testId="expanders-mounted")
        Button(label="More content", press=toggleTall, disabled=false, size="md", variant="bordered", testId="expanders-tall")
        Button(label="Collapse details", press=collapse, disabled=false, size="md", variant="borderless", testId="expanders-collapse")
        Button(label="Multiple panels", press=toggleMultiple, disabled=false, size="md", variant="bordered", testId="accordion-multiple")
        Button(label="Orientation", press=toggleOrientation, disabled=false, size="md", variant="bordered", testId="accordion-orientation")
        Button(label="Presentation", press=toggleVariant, disabled=false, size="md", variant="bordered", testId="accordion-variant")
        Button(label="Loop focus", press=toggleLoop, disabled=false, size="md", variant="bordered", testId="accordion-loop")
        Button(label="Separators", press=toggleSeparators, disabled=false, size="md", variant="bordered", testId="accordion-separators")
      if mounted
        Disclosure(state=details)
          DisclosureHeading(level=3)
            DisclosureTrigger(state=details, change=expand)
              row gap=8 align-items="center"
                text "Details"
                DisclosureIndicator()
          DisclosureContent(state=details)
            DisclosureBody()
              text "Expanding this section preserves the editor and its draft."
              Input(id="details-draft", name="details", label="Details draft", labelledBy="", describedBy="", value=draft, input=edit, change=edit, submit=submit, placeholder="Draft", type="text", autocomplete="off", disabled=false, readOnly=false, required=false, invalid=false, variant="primary")
              if tall
                text "Additional content stays inside the measured region when its height changes."
                text "The parent adapts without scaling or replacing the editor."
        Accordion(state=settings)
          AccordionItem(state=settings, item=account)
            AccordionHeading(level=3)
              AccordionTrigger(state=settings, item=account, change=select)
                text "Account"
                AccordionIndicator()
            AccordionPanel(state=settings, item=account)
              AccordionBody()
                text "Manage account settings."
                Accordion(state=innerSettings)
                  AccordionItem(state=innerSettings, item=innerOne)
                    AccordionHeading(level=4)
                      AccordionTrigger(state=innerSettings, item=innerOne, change=selectNested)
                        text "Nested first"
                        AccordionIndicator()
                    AccordionPanel(state=innerSettings, item=innerOne)
                      AccordionBody()
                        text "Nested panels keep their own selection."
                  AccordionItem(state=innerSettings, item=innerTwo)
                    AccordionHeading(level=4)
                      AccordionTrigger(state=innerSettings, item=innerTwo, change=selectNested)
                        text "Nested second"
                        AccordionIndicator()
                    AccordionPanel(state=innerSettings, item=innerTwo)
                      AccordionBody()
                        text "Arrow navigation stays inside the nested accordion."
          AccordionItem(state=settings, item=locked)
            AccordionHeading(level=3)
              AccordionTrigger(state=settings, item=locked, change=select)
                text "Unavailable"
                AccordionIndicator()
            AccordionPanel(state=settings, item=locked)
              AccordionBody()
                text "This panel cannot be opened."
          AccordionItem(state=settings, item=privacy)
            AccordionHeading(level=3)
              AccordionTrigger(state=settings, item=privacy, change=select)
                text "Privacy"
                AccordionIndicator()
            AccordionPanel(state=settings, item=privacy)
              AccordionBody()
                text "Choose your privacy preferences."
      text (expanded ? "Details open" : "Details closed") testId="details-state"
      text `Selected: ${selected.join(", ")}` testId="accordion-state"
      text `Nested: ${nested.join(", ")}` testId="nested-state"
      text `Submitted: ${submitted}` testId="details-submitted"
