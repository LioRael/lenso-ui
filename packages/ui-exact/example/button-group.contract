use ButtonGroupState, ButtonGroup, ButtonGroupItem, ButtonGroupIcon, ButtonGroupSeparator, Button from "@lenso/ui-exact"

component ButtonGroupExample
  state glass = false
  state detached = false
  state vertical = false
  state full = false
  state disabled = false
  state middleDisabled = false
  state loading = false
  state destructive = false
  state tinted = false
  state large = false
  state small = false
  state prominent = false
  state borderless = false
  state rtl = false
  state visible = true
  state first = true
  state count = 0
  derive group = ButtonGroupState(id="actions-group", label="Document actions", direction=(rtl ? "rtl" : "ltr"), orientation=(vertical ? "vertical" : "horizontal"), size=(small ? "sm" : (large ? "lg" : "md")), variant=(prominent ? "prominent" : (borderless ? "borderless" : "bordered")), glass=glass, detached=detached, fullWidth=full, disabled=disabled, destructive=destructive, tint=(tinted ? "rgb(45 132 56)" : ""))
  action increment
    count = count + 1
  action toggleGlass
    glass = not glass
  action toggleDetached
    detached = not detached
  action toggleVertical
    vertical = not vertical
  action toggleFull
    full = not full
  action toggleDisabled
    disabled = not disabled
  action toggleMiddle
    middleDisabled = not middleDisabled
  action toggleLoading
    loading = not loading
  action toggleDestructive
    destructive = not destructive
  action toggleTint
    tinted = not tinted
  action toggleSize
    large = not large
  action toggleSmall
    small = not small
  action toggleProminent
    prominent = not prominent
  action toggleBorderless
    borderless = not borderless
  action toggleRtl
    rtl = not rtl
  action toggleVisible
    visible = not visible
  action toggleFirst
    first = not first
  view
    column id="button-group-examples" gap=16
      text "Grouped actions" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        Button(label="Actions glass", press=toggleGlass, disabled=false, size="sm", variant="bordered", testId="actions-glass")
        Button(label="Actions detached", press=toggleDetached, disabled=false, size="sm", variant="bordered", testId="actions-detached")
        Button(label="Actions vertical", press=toggleVertical, disabled=false, size="sm", variant="bordered", testId="actions-vertical")
        Button(label="Actions full width", press=toggleFull, disabled=false, size="sm", variant="bordered", testId="actions-full")
        Button(label="Actions disabled", press=toggleDisabled, disabled=false, size="sm", variant="bordered", testId="actions-disabled")
        Button(label="Actions middle disabled", press=toggleMiddle, disabled=false, size="sm", variant="bordered", testId="actions-middle")
        Button(label="Actions loading", press=toggleLoading, disabled=false, size="sm", variant="bordered", testId="actions-loading")
        Button(label="Actions destructive", press=toggleDestructive, disabled=false, size="sm", variant="bordered", testId="actions-destructive")
        Button(label="Actions tint", press=toggleTint, disabled=false, size="sm", variant="bordered", testId="actions-tint")
        Button(label="Actions large", press=toggleSize, disabled=false, size="sm", variant="bordered", testId="actions-size")
        Button(label="Actions small", press=toggleSmall, disabled=false, size="sm", variant="bordered", testId="actions-small")
        Button(label="Actions prominent", press=toggleProminent, disabled=false, size="sm", variant="bordered", testId="actions-prominent")
        Button(label="Actions borderless", press=toggleBorderless, disabled=false, size="sm", variant="bordered", testId="actions-borderless")
        Button(label="Actions direction", press=toggleRtl, disabled=false, size="sm", variant="bordered", testId="actions-rtl")
        Button(label="Actions first", press=toggleFirst, disabled=false, size="sm", variant="bordered", testId="actions-first")
        Button(label="Actions visible", press=toggleVisible, disabled=false, size="sm", variant="bordered", testId="actions-visible")
      text `Actions: ${count}` testId="actions-count"
      if visible
        ButtonGroup(state=group)
          if first
            ButtonGroupItem(state=group, id="actions-save", label="Save", disabled=false, loading=false, iconOnly=false, elastic=true, type="button", press=increment)
              text "Save"
          ButtonGroupSeparator(state=group)
          ButtonGroupItem(state=group, id="actions-duplicate", label="Duplicate", disabled=middleDisabled, loading=loading, iconOnly=false, elastic=true, type="button", press=increment)
            text "Duplicate"
          ButtonGroupItem(state=group, id="actions-more", label="More actions", disabled=false, loading=false, iconOnly=true, elastic=true, type="button", press=increment)
            ButtonGroupIcon(glass=glass)
              text "⋯"
