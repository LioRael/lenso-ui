use Radio, RadioGroup from "@lenso/ui-exact"

component ChoiceCompatibilityExample
  state selected = -1
  action choose(value: string)
    selected = value == "" ? 0 : 1
  view
    column id="choice-compatibility" gap=8
      RadioGroup(label="Choice compatibility", describedBy="", orientation="vertical")
        Radio(id="choice-empty", name="choice-edge", label="Empty value", describedBy="", value="", checked=(selected == 0), change=choose, disabled=false, required=false, invalid=false)
        Radio(id="choice-space", name="choice-edge", label="Space value", describedBy="", value=" ", checked=(selected == 1), change=choose, disabled=false, required=false, invalid=false)
      text (selected == 0 ? "empty" : (selected == 1 ? "space" : "none")) testId="choice-edge-value"
