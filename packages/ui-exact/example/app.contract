use ButtonGroupExample from "./button-group.contract"
use SegmentedControlExample from "./segmented-control.contract"
use TabsExample from "./tabs.contract"
use SliderExample from "./slider.contract"
use SwitchExample from "./switch.contract"
use AvatarExample from "./avatar.contract"
use Theme, Button, Backdrop, Glass, GlassButton, Surface from "@lenso/ui-exact"
use FormExample from "./forms.contract"
use DisclosureExample from "./disclosure.contract"

use NavigationExample from "./navigation.contract"

use FeedbackExample from "./feedback.contract"

use ToggleExample from "./toggle.contract"

use ModalExample from "./modal.contract"

use AlertDialogExample from "./alert-dialog.contract"

use ContentExample from "./content.contract"

use LayoutExample from "./layout.contract"

component App
  state count = 0
  state disabled = false
  state visible = true
  state appearance = "light"
  state size = "md"
  state refreshStatus = "idle"
  state refreshGeneration = 0
  state refreshCount = 0
  state refreshDue = -1
  state refreshDisabled = false
  state refreshVisible = true
  state refreshManual = false
  state refreshFailure = false
  state refreshRejected = false
  state refreshOutcome = false
  state refreshInstant = false
  derive refreshModel = RefreshControlState(id="refresh-sample", label="Recent entries", status=refreshStatus, generation=refreshGeneration, disabled=refreshDisabled, threshold=72, height="20rem", refreshLabel="Refresh entries", pullLabel="Pull to refresh", releaseLabel="Release to refresh", refreshingLabel="Refreshing entries", completeLabel="Entries updated", errorLabel="Could not refresh. Try again.")
  task refreshDeadline when refreshDue >= 0
    every(16, refreshTick)
  action refreshTick
    if refreshDue >= 0 and performanceNow() >= refreshDue
      refreshDue = -1
      refreshStatus = refreshOutcome ? "error" : "complete"
  action requestRefresh
    if not refreshDisabled and not refreshRejected and refreshStatus != "refreshing"
      refreshCount = refreshCount + 1
      refreshGeneration = refreshGeneration + 1
      refreshStatus = refreshInstant ? (refreshFailure ? "error" : "complete") : "refreshing"
      refreshOutcome = refreshFailure
      refreshDue = (refreshManual or refreshInstant) ? -1 : performanceNow() + 600
  action finishRefresh
    if refreshStatus == "refreshing"
      refreshDue = -1
      refreshStatus = "complete"
  action failRefresh
    if refreshStatus == "refreshing"
      refreshDue = -1
      refreshStatus = "error"
  action toggleRefreshDisabled
    refreshDisabled = not refreshDisabled
    if refreshStatus != "refreshing"
      refreshStatus = "idle"
  action toggleRefreshVisible
    refreshVisible = not refreshVisible
    refreshDue = -1
    refreshStatus = "idle"
    refreshGeneration = refreshGeneration + 1
  action toggleRefreshInstant
    refreshInstant = not refreshInstant
  action toggleRefreshManual
    refreshManual = not refreshManual
  action toggleRefreshFailure
    refreshFailure = not refreshFailure
  action toggleRefreshRejected
    refreshRejected = not refreshRejected
  action increment
    count = count + 1
  action toggleDisabled
    disabled = not disabled
  action toggleVisible
    visible = not visible
  action toggleTheme
    appearance = appearance == "light" ? "dark" : "light"
  action toggleSize
    size = size == "md" ? "lg" : "md"
  view
    Theme(appearance=appearance)
      Surface(id="example-page", variant="secondary")
        column padding=24 gap=20 width="100%" max-width="42.5rem" margin="0 auto" box-sizing="border-box"
          text "Lenso for Exact" role="heading" aria-level=1
          text "Shared Lenso materials, Exact state and native button semantics."
          text `Count: ${count}` testId="count"
          row gap=8 flex-wrap="wrap"
            Button(label="Count", press=increment, disabled=false, size="md", variant="prominent", testId="action")
            Button(label="Disable glass", press=toggleDisabled, disabled=false, size="md", variant="bordered", testId="disable")
            Button(label="Toggle surfaces", press=toggleVisible, disabled=false, size="md", variant="bordered", testId="visibility")
            Button(label="Toggle size", press=toggleSize, disabled=false, size="md", variant="borderless", testId="size")
            Button(label="Toggle theme", press=toggleTheme, disabled=false, size="md", variant="borderless", testId="theme")
          column position="relative" height=320
            Backdrop()
              box height=110 background-color="-exact-system-blue"
              box height=110 background-color="-exact-system-green"
              box height=100 background-color="-exact-system-orange"
            if visible
              column position="absolute" left=16 right=16 top=24
                Glass(testId="glass-panel")
                  text "A floating material surface"
                  text "The content stays owned by its caller."
              column position="absolute" left=24 top=200
                GlassButton(label=`Add ${count}`, press=increment, disabled=disabled, size=size, variant="default", testId="glass-action")
          FormExample()
          DisclosureExample()
          NavigationExample()
          FeedbackExample()
          ToggleExample()
          ModalExample()
          AlertDialogExample()
          ContentExample()
          LayoutExample()
          AvatarExample()
          SwitchExample()
          SliderExample()
          TabsExample()
          SegmentedControlExample()
          ButtonGroupExample()
          PageControlExample()
          ScrollShadowExample()
          SearchFieldExample()
          PaginationExample()
          ToolbarExample()
          GlassContainerExample()
          ToolbarFusionExample()
          PopoverExample()
          PopoverHoverExample()
          TooltipExample()
          MenuExample()
          MenuSubmenuExample()
          ModalMenuExample()
          MenuBarExample()
          NumberFieldExample()
          SelectExample()
          ListExample()
          ColorExample()
          ColorFieldExample()
          ColorSliderExample()
          ColorAreaExample()
          ColorPickerExample()
          ListBoxExample()
          TagExample()
          ComboBoxExample()
          AutocompleteExample()
          InputOTPExample()
          PopupButtonExample()
          SectionIndexExample()
          ContextMenuExample()
          ContextMenuBarExample()
          ContextMenuPreviewExample()
          GlassToggleExample()
          NavigationBarExample()
          WheelPickerExample()
          GlassMagnifierExample()
          DateFieldExample()
          TimeFieldExample()
          CalendarExample()
          CalendarYearPickerExample()
          TabBarExample()
          RefreshControlExample(model=refreshModel, count=refreshCount, visible=refreshVisible, instant=refreshInstant, manual=refreshManual, failure=refreshFailure, rejected=refreshRejected, refresh=requestRefresh, finish=finishRefresh, fail=failRefresh, toggleDisabled=toggleRefreshDisabled, toggleVisible=toggleRefreshVisible, toggleInstant=toggleRefreshInstant, toggleManual=toggleRefreshManual, toggleFailure=toggleRefreshFailure, toggleRejected=toggleRefreshRejected)
          SwipeExample()
          ChoiceCompatibilityExample()
          InputCompatibilityExample()
