use AlertState, Alert, AlertTitle, AlertIndicator, AlertContent, AlertDescription, AlertDefaultIcon, BadgeState, Badge, BadgeAnchor, BadgeLabel, Chip, ChipLabel, CloseButtonRoot, CloseButton, Button from "@lenso/ui-exact"

component ContentExample
  state color = "default"
  state size = "md"
  state variant = "secondary"
  state placement = "top-right"
  state count = 3
  state visible = true
  state loading = false
  state disabled = false
  state destructive = false
  state long = false
  derive message = AlertState(id="content-alert", status=color, role="status", label="", labelledBy="content-alert-title", describedBy="content-alert-description")
  derive badge = BadgeState(id="content-badge", label=`${count} unread messages`, size=size, color=color, variant=(variant == "tertiary" ? "secondary" : variant), placement=placement)
  action changeColor
    color = color == "default" ? "accent" : (color == "accent" ? "success" : (color == "success" ? "warning" : (color == "warning" ? "danger" : "default")))
  action changeSize
    size = size == "md" ? "lg" : (size == "lg" ? "sm" : "md")
  action changeVariant
    variant = variant == "secondary" ? "soft" : (variant == "soft" ? "primary" : (variant == "primary" ? "tertiary" : "secondary"))
  action changePlacement
    placement = placement == "top-right" ? "bottom-right" : (placement == "bottom-right" ? "bottom-left" : (placement == "bottom-left" ? "top-left" : "top-right"))
  action increment
    count = count + 1
  action toggleLoading
    loading = not loading
  action toggleDisabled
    disabled = not disabled
  action toggleDestructive
    destructive = not destructive
  action toggleVisible
    visible = not visible
  action toggleLong
    long = not long
  action dismiss
    visible = false
  view
    column id="content-examples" gap=16
      text "Messages and labels" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        Button(label="Content color", press=changeColor, disabled=false, size="sm", variant="bordered", testId="content-color")
        Button(label="Content size", press=changeSize, disabled=false, size="sm", variant="bordered", testId="content-size")
        Button(label="Content variant", press=changeVariant, disabled=false, size="sm", variant="bordered", testId="content-variant")
        Button(label="Badge placement", press=changePlacement, disabled=false, size="sm", variant="bordered", testId="content-placement")
        Button(label="Increment count", press=increment, disabled=false, size="sm", variant="bordered", testId="content-increment")
        Button(label="Loading close", press=toggleLoading, disabled=false, size="sm", variant="bordered", testId="content-loading")
        Button(label="Disable close", press=toggleDisabled, disabled=false, size="sm", variant="bordered", testId="content-disabled")
        Button(label="Destructive close", press=toggleDestructive, disabled=false, size="sm", variant="bordered", testId="content-destructive")
        Button(label="Mount content", press=toggleVisible, disabled=false, size="sm", variant="bordered", testId="content-visible")
        Button(label="Long message", press=toggleLong, disabled=false, size="sm", variant="bordered", testId="content-long")
      row gap=16 align-items="center" flex-wrap="wrap"
        CloseButton(id="content-close", label="Increment close counter", press=increment, disabled=disabled, loading=loading, destructive=destructive)
        CloseButtonRoot(id="content-custom-close", label="Custom close counter", press=increment, disabled=disabled, loading=loading, destructive=destructive)
          text "×" aria-hidden=true
        text `${count}` testId="content-count"
        Chip(id="content-chip", size=size, color=color, variant=variant)
          ChipLabel()
            text "Design"
          CloseButton(id="content-chip-close", label="Remove design label", press=increment, disabled=disabled, loading=loading, destructive=false)
      if visible
        Alert(state=message)
          AlertIndicator(state=message)
            AlertDefaultIcon(status=color)
          AlertContent()
            AlertTitle(state=message, id="content-alert-title")
              text "Your settings are saved"
            AlertDescription(id="content-alert-description")
              text (long ? "ThisIsAnUnbrokenMessageThatMustWrapInsideTheAlertWithoutPushingItsDismissControlOutsideTheViewportAndMustRemainReadableOnSmallScreens" : "You can continue editing at any time.")
          CloseButton(id="content-alert-close", label="Dismiss saved settings message", press=dismiss, disabled=disabled, loading=loading, destructive=false)
        row padding=12
          BadgeAnchor(id="content-badge-anchor")
            box width=72 height=56 background-color="-exact-system-blue" border-radius=16
            Badge(state=badge)
              BadgeLabel()
                text `${count}`
