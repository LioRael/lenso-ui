use AlertDialogState, AlertDialog, AlertDialogBackdrop, AlertDialogViewport, AlertDialogPopup, AlertDialogHeader, AlertDialogTitle, AlertDialogDescription, AlertDialogBody, AlertDialogFields, AlertDialogFooter, AlertDialogIcon, AlertDialogTrigger, AlertDialogClose, AlertDialogAction, AlertDialogCloseIcon, AlertDialogDefaultIcon, Button, Input from "@lenso/ui-exact"

component AlertDialogExample
  state value = ""
  state error = ""
  state removed = false
  state mounted = true
  state disabled = false
  state size = "md"
  state placement = "center"
  state backdrop = "opaque"
  state layout = "auto"
  state tone = "danger"
  state third = false
  derive prompt = AlertDialogState(id="delete-alert", label="Delete workspace?", labelledBy="delete-title", describedBy="delete-description", size=size, placement=placement, backdrop=backdrop)
  action edit(next: string)
    value = next
    error = ""
  action change(next: string)
    value = next
  action remove
    if value != "DELETE"
      error = "Type DELETE to confirm."
    else
      removed = true
      close("delete-alert")
  action open
    showModal("delete-alert")
  action toggleMounted
    mounted = not mounted
  action toggleDisabled
    disabled = not disabled
  action toggleSize
    size = size == "md" ? "lg" : (size == "lg" ? "xs" : (size == "xs" ? "sm" : (size == "sm" ? "cover" : "md")))
  action togglePlacement
    placement = placement == "center" ? "top" : (placement == "top" ? "bottom" : (placement == "bottom" ? "auto" : "center"))
  action toggleBackdrop
    backdrop = backdrop == "opaque" ? "blur" : (backdrop == "blur" ? "transparent" : "opaque")
  action toggleLayout
    layout = layout == "auto" ? "stacked" : (layout == "stacked" ? "side-by-side" : "auto")
  action toggleTone
    tone = tone == "danger" ? "success" : (tone == "success" ? "warning" : (tone == "warning" ? "accent" : (tone == "accent" ? "default" : "danger")))
  action toggleThird
    third = not third
  view
    column id="alert-dialog-examples" gap=16
      text "Alert dialog" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        AlertDialogTrigger(id="alert-trigger", label="Delete workspace", target="delete-alert", disabled=disabled, size="md", variant="bordered")
          text "Delete workspace"
        Button(label="Open with action", press=open, disabled=disabled, size="sm", variant="bordered", testId="alert-open")
        Button(label="Disable trigger", press=toggleDisabled, disabled=false, size="sm", variant="bordered", testId="alert-disable")
        Button(label="Mount alert", press=toggleMounted, disabled=false, size="sm", variant="bordered", testId="alert-mount")
        Button(label="Alert size", press=toggleSize, disabled=false, size="sm", variant="bordered", testId="alert-size")
        Button(label="Alert placement", press=togglePlacement, disabled=false, size="sm", variant="bordered", testId="alert-placement")
        Button(label="Alert backdrop", press=toggleBackdrop, disabled=false, size="sm", variant="bordered", testId="alert-backdrop")
        Button(label="Alert footer", press=toggleLayout, disabled=false, size="sm", variant="bordered", testId="alert-layout")
        Button(label="Alert icon", press=toggleTone, disabled=false, size="sm", variant="bordered", testId="alert-tone")
        Button(label="Third action", press=toggleThird, disabled=false, size="sm", variant="bordered", testId="alert-third")
      text (removed ? "Workspace deleted" : "Workspace retained") testId="alert-result"
      if mounted
        AlertDialog(state=prompt)
          AlertDialogBackdrop(state=prompt)
          AlertDialogViewport()
            AlertDialogPopup(state=prompt)
              AlertDialogHeader()
                AlertDialogIcon(variant=tone)
                  AlertDialogDefaultIcon(variant=tone)
                AlertDialogTitle(id="delete-title", level=2)
                  text "Delete workspace?"
                AlertDialogDescription(id="delete-description")
                  text "This removes the workspace. Type DELETE to confirm."
              AlertDialogBody()
                AlertDialogFields()
                  Input(id="alert-confirmation", name="confirmation", label="Type DELETE", labelledBy="", describedBy="alert-error", value=value, input=edit, change=change, submit=remove, placeholder="DELETE", type="text", autocomplete="off", disabled=false, readOnly=false, required=true, invalid=(error != ""), variant="primary")
                  text error id="alert-error" testId="alert-error" role="status"
              AlertDialogFooter(layout=layout)
                AlertDialogClose(id="alert-cancel", label="Keep workspace", target="delete-alert", disabled=false, initialFocus=true)
                  text "Keep"
                AlertDialogAction(id="alert-delete", label="Delete workspace permanently", press=remove, disabled=disabled, variant="destructive")
                  text "Delete"
                if third
                  AlertDialogAction(id="alert-third-action", label="Remove dialog", press=toggleMounted, disabled=false, variant="default")
                    text "Remove dialog"
              AlertDialogCloseIcon(id="alert-close-icon", label="Close confirmation", target="delete-alert", disabled=false)
