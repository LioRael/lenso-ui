use Button, Link, LinkIcon, LinkArrow, BreadcrumbsState, Breadcrumbs, BreadcrumbsItem, BreadcrumbsLink, BreadcrumbsSeparator, BreadcrumbsChevron, Separator from "@lenso/ui-exact"

component NavigationExample
  state disabled = false
  state rtl = false
  state visible = true
  state tertiary = false
  state currentHome = false
  derive trail = BreadcrumbsState(id="trail", label="Location", disabled=disabled, direction=(rtl ? "rtl" : "ltr"))
  action toggleDisabled
    disabled = not disabled
  action toggleDirection
    rtl = not rtl
  action toggleVisible
    visible = not visible
  action toggleCurrent
    currentHome = not currentHome
  action toggleVariant
    tertiary = not tertiary
  view
    column id="navigation-examples" gap=16 direction=(rtl ? "rtl" : "ltr")
      text "Navigation" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        Button(label="Disable links", press=toggleDisabled, disabled=false, size="sm", variant="bordered", testId="navigation-disabled")
        Button(label="Reverse direction", press=toggleDirection, disabled=false, size="sm", variant="bordered", testId="navigation-direction")
        Button(label="Toggle navigation", press=toggleVisible, disabled=false, size="sm", variant="bordered", testId="navigation-visible")
        Button(label="Separator variant", press=toggleVariant, disabled=false, size="sm", variant="bordered", testId="navigation-variant")
        Button(label="Change current page", press=toggleCurrent, disabled=false, size="sm", variant="bordered", testId="navigation-current")
      if visible
        column gap=16
          Breadcrumbs(state=trail)
            BreadcrumbsItem()
              BreadcrumbsLink(state=trail, id="trail-home", href="#navigation-target", target="_self", label="Home", current=currentHome, disabled=false)
                text "Home"
              BreadcrumbsChevron()
            BreadcrumbsItem()
              BreadcrumbsLink(state=trail, id="trail-library", href="#navigation-target", target="_self", label="Library", current=false, disabled=true)
                text "Library"
              BreadcrumbsSeparator()
                text "/"
            BreadcrumbsItem()
              BreadcrumbsLink(state=trail, id="trail-current", href="#navigation-target", target="_self", label="Components", current=(not currentHome), disabled=false)
                text "Components"
          Separator(id="navigation-horizontal", orientation="horizontal", variant=(tertiary ? "tertiary" : "default"), decorative=false)
          row gap=12 align-items="center" flex-wrap="wrap"
            Link(id="navigation-local", href="#navigation-target", target="_self", label="Jump to navigation target", disabled=disabled)
              text "Jump to target"
              LinkArrow()
            Separator(id="navigation-vertical", orientation="vertical", variant="secondary", decorative=true)
            Link(id="navigation-external", href="https://github.com/expo/exact", target="_blank", label="Exact source", disabled=disabled)
              LinkIcon()
                text "↗"
              text "Exact source"
          text "Navigation target" id="navigation-target" testId="navigation-target"
