use PaginationState, Pagination, PaginationSummary, PaginationContent, PaginationItem, PaginationLink, PaginationPrevious, PaginationNext, PaginationPreviousIcon, PaginationNextIcon, PaginationEllipsis, Button from "@lenso/ui-exact"

component PaginationExample
  state size = "md"
  state direction = "ltr"
  state disabled = false
  state visible = true
  state current = 2
  derive pages = PaginationState(id="pagination-demo", label="Document pages", size=size, direction=direction, disabled=disabled)
  action cycleSize
    size = size == "md" ? "lg" : (size == "lg" ? "sm" : "md")
  action toggleDirection
    direction = direction == "ltr" ? "rtl" : "ltr"
  action toggleDisabled
    disabled = not disabled
  action toggleVisible
    visible = not visible
  action toggleCurrent
    current = current == 2 ? 1 : 2
  view
    column gap=12
      text "Pagination" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        Button(label="Pagination size", press=cycleSize, disabled=false, size="sm", variant="bordered", testId="pagination-size")
        Button(label="Pagination direction", press=toggleDirection, disabled=false, size="sm", variant="bordered", testId="pagination-direction")
        Button(label="Disable pagination", press=toggleDisabled, disabled=false, size="sm", variant="bordered", testId="pagination-disable")
        Button(label="Current page", press=toggleCurrent, disabled=false, size="sm", variant="bordered", testId="pagination-current")
        Button(label="Toggle pagination", press=toggleVisible, disabled=false, size="sm", variant="bordered", testId="pagination-visible")
      if visible
        Pagination(state=pages)
          PaginationSummary(state=pages)
            text `Page ${current} of 8`
          PaginationContent()
            PaginationItem()
              PaginationPrevious(state=pages, id="pagination-prev", href="#pagination-page-1", target="_self", label="Previous page", disabled=(current == 1))
                PaginationPreviousIcon()
            PaginationItem()
              PaginationLink(state=pages, id="pagination-one", href="#pagination-page-1", target="_self", label="Page 1", current=(current == 1), disabled=false)
                text "1"
            PaginationItem()
              PaginationLink(state=pages, id="pagination-two", href="#pagination-page-2", target="_self", label="Page 2", current=(current == 2), disabled=false)
                text "2"
            PaginationItem()
              PaginationEllipsis(state=pages)
                text "…"
            PaginationItem()
              PaginationLink(state=pages, id="pagination-eight", href="#pagination-page-8", target="_self", label="Page 8", current=false, disabled=true)
                text "8"
            PaginationItem()
              PaginationNext(state=pages, id="pagination-next", href="#pagination-page-3", target="_blank", label="Next page in new tab", disabled=false)
                text "Next"
                PaginationNextIcon()
      text "Page 1 destination" id="pagination-page-1" testId="pagination-page-1"
      text "Page 2 destination" id="pagination-page-2" testId="pagination-page-2"
