use SwipeActionsState, SwipeActions, SwipeActionsContent, SwipeActionsBody, SwipeActionsTrigger, SwipeActionsActions, SwipeActionsAction, Button from "@lenso/ui-exact"

component SwipeExample
  state side = ""
  state count = 0
  state deleted = 0
  state disabled = false
  state editing = false
  state direction = "ltr"
  state full = false
  state mounted = true
  derive swipe = SwipeActionsState(id="message-swipe", direction=direction, disabled=(disabled or editing), openSide=side)
  action change(value: string)
    side = value
  action read
    count = count + 1
  action remove
    deleted = deleted + 1
  action toggleDisabled
    disabled = not disabled
  action toggleEditing
    editing = not editing
  action toggleDirection
    direction = direction == "ltr" ? "rtl" : "ltr"
  action toggleFull
    full = not full
  action toggleMounted
    mounted = not mounted
  view
    column gap=12
      text "Swipe actions" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        Button(label="Disable swipe", press=toggleDisabled, disabled=false, size="sm", variant="bordered", testId="swipe-disabled")
        Button(label="Editing", press=toggleEditing, disabled=false, size="sm", variant="bordered", testId="swipe-editing")
        Button(label="Direction", press=toggleDirection, disabled=false, size="sm", variant="bordered", testId="swipe-direction")
        Button(label="Full swipe", press=toggleFull, disabled=false, size="sm", variant="bordered", testId="swipe-full")
        Button(label="Mount swipe", press=toggleMounted, disabled=false, size="sm", variant="bordered", testId="swipe-mounted")
      if mounted
        SwipeActions(state=swipe, change=change)
          SwipeActionsContent()
            SwipeActionsTrigger(state=swipe, side="start", label="Show leading actions", change=change)
            SwipeActionsBody()
              text "Project update"
              text "Swipe to reveal message actions."
            SwipeActionsTrigger(state=swipe, side="end", label="Show trailing actions", change=change)
          SwipeActionsActions(state=swipe, side="start")
            SwipeActionsAction(state=swipe, id="swipe-read", disabled=false, fullSwipe=false, variant="tint", change=change, press=read)
              text "Read"
          SwipeActionsActions(state=swipe, side="end")
            SwipeActionsAction(state=swipe, id="swipe-archive", disabled=true, fullSwipe=false, variant="default", change=change, press=read)
              text "Archive"
            SwipeActionsAction(state=swipe, id="swipe-delete", disabled=false, fullSwipe=full, variant="danger", change=change, press=remove)
              text "Delete"
      text `Read: ${count}` testId="swipe-read-count"
      text `Deleted: ${deleted}` testId="swipe-delete-count"
      text `Side: ${side}` testId="swipe-side"
