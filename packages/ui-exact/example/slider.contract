use SliderState, Slider, SliderLabel, SliderOutput, SliderControl, SliderTrack, SliderFill, SliderThumb, SliderMarks, Button from "@lenso/ui-exact"

fn sliderValueText(values: number[], index: number): string = match values.at(index) { case some(value) => `${value} USD`, case none => "" }

component SliderExample
  state values = [20, 60]
  state disabled = false
  state readOnly = false
  state vertical = false
  state rtl = false
  state edge = true
  state push = true
  state visible = true
  state accept = true
  state changes = 0
  state commits = 0
  state committedValues = ""
  derive range = SliderState(id="slider-range", label="", labelledBy="slider-label", describedBy="slider-help", values=values, min=0, max=100, step=5, largeStep=20, minStepsBetweenValues=1, collision=(push ? "push" : "none"), orientation=(vertical ? "vertical" : "horizontal"), direction=(rtl ? "rtl" : "ltr"), alignment=(edge ? "edge" : "center"), disabled=disabled, readOnly=readOnly, name="range")
  action change(next: number[])
    if accept
      changes = changes + 1
      values = next
  action commit(next: number[])
    commits = commits + 1
    committedValues = next.map(value => `${value}`).join(",")
  action toggleDisabled
    disabled = not disabled
  action toggleReadOnly
    readOnly = not readOnly
  action toggleVertical
    vertical = not vertical
  action toggleRtl
    rtl = not rtl
  action toggleAlignment
    edge = not edge
  action toggleCollision
    push = not push
  action toggleVisible
    visible = not visible
  action toggleAccept
    accept = not accept
  action reset
    values = [20, 60]
  action single
    values = values.length == 1 ? [20, 60] : [40]
  view
    column id="slider-examples" gap=16
      text "Sliders" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        Button(label="Slider disabled", press=toggleDisabled, disabled=false, size="sm", variant="bordered", testId="slider-disabled")
        Button(label="Slider read only", press=toggleReadOnly, disabled=false, size="sm", variant="bordered", testId="slider-readonly")
        Button(label="Slider vertical", press=toggleVertical, disabled=false, size="sm", variant="bordered", testId="slider-vertical")
        Button(label="Slider direction", press=toggleRtl, disabled=false, size="sm", variant="bordered", testId="slider-rtl")
        Button(label="Slider alignment", press=toggleAlignment, disabled=false, size="sm", variant="bordered", testId="slider-alignment")
        Button(label="Slider collision", press=toggleCollision, disabled=false, size="sm", variant="bordered", testId="slider-collision")
        Button(label="Slider visibility", press=toggleVisible, disabled=false, size="sm", variant="bordered", testId="slider-visible")
        Button(label="Slider accept changes", press=toggleAccept, disabled=false, size="sm", variant="bordered", testId="slider-accept")
        Button(label="Reset slider", press=reset, disabled=false, size="sm", variant="bordered", testId="slider-reset")
        Button(label="Slider single value", press=single, disabled=false, size="sm", variant="bordered", testId="slider-single")
      text `Changes: ${changes}` testId="slider-changes"
      text `Commits: ${commits} (${committedValues})` testId="slider-commits"
      if visible
        box height=(vertical ? "260px" : "auto")
          Slider(state=range)
            SliderLabel(state=range, label="Price range")
            SliderOutput(id="slider-value")
              text values.map(value => `${value}`).join(" – ")
            SliderControl(state=range)
              SliderTrack(state=range)
                SliderFill(state=range)
              SliderThumb(state=range, index=0, label=(values.length == 1 ? "Price" : "Minimum price"), valueText=sliderValueText(values, 0), change=change, commit=commit)
              if values.length > 1
                SliderThumb(state=range, index=1, label="Maximum price", valueText=sliderValueText(values, 1), change=change, commit=commit)
      text "Choose your price range." id="slider-help"
      SliderMarks()
        text "0"
        text "100"
