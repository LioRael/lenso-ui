use CalendarState, CalendarRoot, CalendarHeader, CalendarGrid, CalendarNavButton, CalendarYearPickerState, CalendarYearPickerTrigger, CalendarYearPickerGrid, Button from "@lenso/ui-exact"

component CalendarYearPickerExample
  state value = ["2024-02-29"]
  state focused = "2024-02-29"
  state locale = "en-US"
  state open = false
  state rejected = false
  state mounted = true
  state disabled = false
  state bounded = false
  state allYears = false
  derive calendar = CalendarState(id="year-calendar", label="Departure year calendar", value=value, focused=focused, placeholder="2024-02-29", today="2024-02-15", locale=locale, calendar="", firstDay="", weekdayStyle=(locale == "fa-IR" ? "narrow" : "short"), selectionMode="single", min=(bounded ? "2023-03-01" : ""), max=(bounded ? "2025-05-31" : ""), unavailable=[], disabled=disabled, readOnly=false, invalid=false, direction=(locale == "fa-IR" ? "rtl" : "ltr"))
  derive picker = CalendarYearPickerState(id="year-picker", open=open, visibleYears=(allYears ? 0 : 20))
  action change(next: string[])
    value = next
  action changeOpen(next: bool)
    if not rejected
      open = next
  action cycleLocale
    locale = (locale == "en-US" ? "fa-IR" : "en-US")
  action toggleRejected
    rejected = not rejected
  action toggleMounted
    mounted = not mounted
  action toggleDisabled
    disabled = not disabled
  action toggleBounds
    bounded = not bounded
  action toggleAll
    allYears = not allYears
  action replace
    focused = (focused == "2024-02-29" ? "2026-11-12" : "2024-02-29")
  action externalOpen
    open = not open
  view
    column id="calendar-year-picker-examples" gap=12
      text "Calendar years" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        Button(label="Year locale", press=cycleLocale, disabled=false, size="sm", variant="bordered", testId="year-locale")
        Button(label="Reject year visibility", press=toggleRejected, disabled=false, size="sm", variant="bordered", testId="year-rejected")
        Button(label="Year availability", press=toggleDisabled, disabled=false, size="sm", variant="bordered", testId="year-disabled")
        Button(label="Mount year calendar", press=toggleMounted, disabled=false, size="sm", variant="bordered", testId="year-mounted")
        Button(label="Year bounds", press=toggleBounds, disabled=false, size="sm", variant="bordered", testId="year-bounds")
        Button(label="All bounded years", press=toggleAll, disabled=false, size="sm", variant="bordered", testId="year-all")
        Button(label="Replace year focus", press=replace, disabled=false, size="sm", variant="bordered", testId="year-replace")
        Button(label="Year visibility", press=externalOpen, disabled=false, size="sm", variant="bordered", testId="year-open")
      text value.join("|") testId="year-value"
      if mounted
        CalendarRoot(state=calendar)
          CalendarHeader()
            CalendarYearPickerTrigger(calendar=calendar, state=picker, change=changeOpen)
            CalendarNavButton(state=calendar, next=false, label="Previous month")
            CalendarNavButton(state=calendar, next=true, label="Next month")
          CalendarGrid(state=calendar, change=change)
          CalendarYearPickerGrid(state=picker, change=changeOpen)
