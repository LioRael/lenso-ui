use GlassMagnifier, Button, Surface from "@lenso/ui-exact"

component GlassMagnifierExample
  state draggable = true
  state animated = true
  state elastic = false
  state mounted = true
  state count = 0
  action toggleDraggable
    draggable = not draggable
  action toggleAnimated
    animated = not animated
  action toggleElastic
    elastic = not elastic
  action toggleMounted
    mounted = not mounted
  action act
    count = count + 1
  view
    column id="magnifier-examples" gap=12
      text "A closer look" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        Button(label="Drag lens", press=toggleDraggable, disabled=false, size="sm", variant="bordered", testId="magnifier-draggable")
        Button(label="Animate lens", press=toggleAnimated, disabled=false, size="sm", variant="bordered", testId="magnifier-animated")
        Button(label="Elastic lens", press=toggleElastic, disabled=false, size="sm", variant="bordered", testId="magnifier-elastic")
        Button(label="Mount lens", press=toggleMounted, disabled=false, size="sm", variant="bordered", testId="magnifier-mounted")
      text `${count}` testId="magnifier-count"
      Surface(id="magnifier-stage", variant="secondary")
        column gap=16 padding=24
          text "Coastal field notes" role="heading" aria-level=3
          text "Follow the shoreline past the old harbour and the lighthouse."
          text "North 36°  West 122°"
          text "Waves, weather and places to return to."
        if mounted
          GlassMagnifier(id="magnifier-lens", draggable=draggable, animated=animated, elastic=elastic)
            Button(label="Details", press=act, disabled=false, size="sm", variant="borderless", testId="magnifier-details")
