use WheelPickerState, WheelPickerOption, WheelPicker, Button from "@lenso/ui-exact"

component WheelPickerExample
  state value = "thursday"
  state disabled = false
  state rejected = false
  state mounted = true
  state empty = false
  state rtl = false
  state removed = false
  state count = 0
  derive options = (empty ? [] : [WheelPickerOption(value="monday", label="Monday", disabled=false), WheelPickerOption(value="tuesday", label="Tuesday", disabled=false), WheelPickerOption(value="wednesday", label="Wednesday", disabled=true), WheelPickerOption(value="thursday", label="Thursday", disabled=false), WheelPickerOption(value="friday", label="Friday", disabled=false), WheelPickerOption(value="saturday", label="Saturday", disabled=false), WheelPickerOption(value="sunday", label="Sunday", disabled=false)]).filter(option => not removed or option.value != "thursday")
  derive wheel = WheelPickerState(id="wheel-demo", label="Day of the week", labelledBy="", options=options, value=value, disabled=disabled, direction=(rtl ? "rtl" : "ltr"), name="weekday", form="", emptyLabel="No days available")
  action change(next: string)
    count = count + 1
    if not rejected
      value = next
  action toggleDisabled
    disabled = not disabled
  action toggleRejected
    rejected = not rejected
  action toggleMounted
    mounted = not mounted
  action toggleEmpty
    empty = not empty
  action toggleDirection
    rtl = not rtl
  action toggleRemoved
    removed = not removed
  action replace
    value = (value == "sunday" ? "tuesday" : "sunday")
  view
    column id="wheel-picker-examples" gap=12
      text "Choose a day" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        Button(label="Wheel availability", press=toggleDisabled, disabled=false, size="sm", variant="bordered", testId="wheel-disabled")
        Button(label="Reject wheel choice", press=toggleRejected, disabled=false, size="sm", variant="bordered", testId="wheel-rejected")
        Button(label="Mount wheel", press=toggleMounted, disabled=false, size="sm", variant="bordered", testId="wheel-mounted")
        Button(label="Empty wheel", press=toggleEmpty, disabled=false, size="sm", variant="bordered", testId="wheel-empty")
        Button(label="Wheel direction", press=toggleDirection, disabled=false, size="sm", variant="bordered", testId="wheel-direction")
        Button(label="Remove Thursday", press=toggleRemoved, disabled=false, size="sm", variant="bordered", testId="wheel-removed")
        Button(label="Replace wheel value", press=replace, disabled=false, size="sm", variant="bordered", testId="wheel-replace")
      text value testId="wheel-value"
      text `${count}` testId="wheel-count"
      if mounted
        WheelPicker(state=wheel, change=change)
