use ColorSwatchPickerState, ColorSwatch, ColorSwatchPicker, ColorSwatchPickerItem, Button from "@lenso/ui-exact"

component ColorExample
  state value = "#FF0000FF"
  state disabled = false
  state mounted = true
  state size = "md"
  state shape = "circle"
  state layout = "grid"
  state direction = "ltr"
  derive picker = ColorSwatchPickerState(id="accent-colors", label="Accent color", value=value, name="accent", disabled=disabled, required=true, size=size, shape=shape, layout=layout, direction=direction)
  action change(next: string)
    value = next
  action disable
    disabled = not disabled
  action remount
    mounted = not mounted
  action resize
    size = size == "xs" ? "sm" : size == "sm" ? "md" : size == "md" ? "lg" : size == "lg" ? "xl" : "xs"
  action reshape
    shape = shape == "circle" ? "square" : "circle"
  action relayout
    layout = layout == "grid" ? "stack" : layout == "stack" ? "palette" : "grid"
  action redirect
    direction = direction == "ltr" ? "rtl" : "ltr"
  action equivalent
    value = "rgb(0, 128, 255)"
  view
    column gap=12
      text "Colors" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        Button(label="Disable colors", press=disable, disabled=false, size="sm", variant="bordered", testId="color-disabled")
        Button(label="Mount colors", press=remount, disabled=false, size="sm", variant="bordered", testId="color-mounted")
        Button(label="Color size", press=resize, disabled=false, size="sm", variant="bordered", testId="color-size")
        Button(label="Color shape", press=reshape, disabled=false, size="sm", variant="bordered", testId="color-shape")
        Button(label="Color layout", press=relayout, disabled=false, size="sm", variant="bordered", testId="color-layout")
        Button(label="Color direction", press=redirect, disabled=false, size="sm", variant="bordered", testId="color-direction")
        Button(label="Equivalent RGB", press=equivalent, disabled=false, size="sm", variant="bordered", testId="color-equivalent")
      if mounted
        ColorSwatch(id="accent-preview", color=value, label="Current accent", size=size, shape=shape)
        ColorSwatch(id="alpha-preview", color="#FF000080", label="Half-transparent red", size=size, shape=shape)
        ColorSwatchPicker(state=picker)
          ColorSwatchPickerItem(state=picker, id="accent-red", color="#FF0000FF", label="Red", disabled=false, change=change)
          ColorSwatchPickerItem(state=picker, id="accent-blue", color="#0080FFFF", label="Blue", disabled=false, change=change)
          ColorSwatchPickerItem(state=picker, id="accent-green", color="#00FF00FF", label="Green unavailable", disabled=true, change=change)
          ColorSwatchPickerItem(state=picker, id="accent-alpha", color="#FF000080", label="Half-transparent red", disabled=false, change=change)
      text value testId="color-value"
