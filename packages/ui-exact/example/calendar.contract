use CalendarState, Calendar, Button from "@lenso/ui-exact"

component CalendarExample
  state value = ["2024-02-29"]
  state focused = "2024-02-29"
  state locale = "en-US"
  state mode = "single"
  state disabled = false
  state readOnly = false
  state rejected = false
  state mounted = true
  state bounded = false
  state count = 0
  derive calendar = CalendarState(id="calendar-demo", label="Departure date", value=value, focused=focused, placeholder="2024-02-29", today="2024-02-15", locale=locale, calendar="", firstDay="", weekdayStyle=(locale == "fa-IR" ? "narrow" : "short"), selectionMode=mode, min=(bounded ? "2024-02-10" : ""), max=(bounded ? "2024-03-15" : ""), unavailable=["2024-02-20"], disabled=disabled, readOnly=readOnly, invalid=false, direction=(locale == "fa-IR" ? "rtl" : "ltr"))
  action change(next: string[])
    count = count + 1
    if not rejected
      value = next
  action cycleLocale
    locale = (locale == "en-US" ? "en-GB" : locale == "en-GB" ? "fa-IR" : "en-US")
  action cycleMode
    mode = (mode == "single" ? "multiple" : mode == "multiple" ? "none" : "single")
  action toggleDisabled
    disabled = not disabled
  action toggleReadOnly
    readOnly = not readOnly
  action toggleRejected
    rejected = not rejected
  action toggleMounted
    mounted = not mounted
  action toggleBounds
    bounded = not bounded
  action replace
    value = ["2025-01-15"]
    focused = "2025-01-15"
  view
    column id="calendar-examples" gap=12
      text "Calendar" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        Button(label="Calendar locale", press=cycleLocale, disabled=false, size="sm", variant="bordered", testId="calendar-locale")
        Button(label="Calendar selection", press=cycleMode, disabled=false, size="sm", variant="bordered", testId="calendar-mode")
        Button(label="Calendar availability", press=toggleDisabled, disabled=false, size="sm", variant="bordered", testId="calendar-disabled")
        Button(label="Calendar read only", press=toggleReadOnly, disabled=false, size="sm", variant="bordered", testId="calendar-readonly")
        Button(label="Reject calendar", press=toggleRejected, disabled=false, size="sm", variant="bordered", testId="calendar-rejected")
        Button(label="Mount calendar", press=toggleMounted, disabled=false, size="sm", variant="bordered", testId="calendar-mounted")
        Button(label="Calendar bounds", press=toggleBounds, disabled=false, size="sm", variant="bordered", testId="calendar-bounds")
        Button(label="Replace calendar", press=replace, disabled=false, size="sm", variant="bordered", testId="calendar-replace")
      text value.join("|") testId="calendar-value"
      text `${count}` testId="calendar-count"
      if mounted
        Calendar(state=calendar, change=change)
