use TooltipState, TooltipProvider, Tooltip, TooltipTrigger, TooltipPortal, TooltipPositioner, TooltipPopup, TooltipArrow, TooltipViewport, Button from "@lenso/ui-exact"

component TooltipExample
  state count = 0
  state disabled = false
  state mounted = true
  state showTrigger = true
  state showArrow = true
  state rtl = false
  state side = "top"
  state align = "center"
  state openDelay = -1
  state closeDelay = -1
  state hoverable = true
  state closeOnClick = true
  derive settings = TooltipState(id="tooltip-save", side=side, align=align, direction=(rtl ? "rtl" : "ltr"), sideOffset=-1, alignOffset=0, collisionPadding=8, collisionAvoidance=true, disableAnchorTracking=false, disableHoverablePopup=(not hoverable))
  derive second = TooltipState(id="tooltip-share", side="top", align="center", direction="ltr", sideOffset=-1, alignOffset=0, collisionPadding=8, collisionAvoidance=true, disableAnchorTracking=false, disableHoverablePopup=false)
  action save
    count = count + 1
  action toggleDisabled
    disabled = not disabled
  action toggleMounted
    mounted = not mounted
  action toggleTrigger
    showTrigger = not showTrigger
  action toggleArrow
    showArrow = not showArrow
  action toggleDirection
    rtl = not rtl
  action cycleSide
    side = side == "top" ? "bottom" : (side == "bottom" ? "left" : (side == "left" ? "right" : (side == "right" ? "inline-start" : (side == "inline-start" ? "inline-end" : "top"))))
  action cycleAlign
    align = align == "center" ? "start" : (align == "start" ? "end" : "center")
  action toggleDelay
    openDelay = openDelay == -1 ? 80 : -1
    closeDelay = closeDelay == -1 ? 0 : -1
  action toggleHoverable
    hoverable = not hoverable
  action toggleClick
    closeOnClick = not closeOnClick
  view
    column id="tooltip-examples" gap=12
      text "Tooltip" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        Button(label="Placement", press=cycleSide, disabled=false, size="sm", variant="bordered", testId="tooltip-side")
        Button(label="Alignment", press=cycleAlign, disabled=false, size="sm", variant="bordered", testId="tooltip-align")
        Button(label="Direction", press=toggleDirection, disabled=false, size="sm", variant="bordered", testId="tooltip-direction")
        Button(label="Disable tooltip", press=toggleDisabled, disabled=false, size="sm", variant="bordered", testId="tooltip-disabled")
        Button(label="Mount popup", press=toggleMounted, disabled=false, size="sm", variant="bordered", testId="tooltip-mounted")
        Button(label="Mount trigger", press=toggleTrigger, disabled=false, size="sm", variant="bordered", testId="tooltip-trigger-mounted")
        Button(label="Arrow", press=toggleArrow, disabled=false, size="sm", variant="bordered", testId="tooltip-arrow")
        Button(label="Delay", press=toggleDelay, disabled=false, size="sm", variant="bordered", testId="tooltip-delay")
        Button(label="Hoverable", press=toggleHoverable, disabled=false, size="sm", variant="bordered", testId="tooltip-hoverable")
        Button(label="Close on click", press=toggleClick, disabled=false, size="sm", variant="bordered", testId="tooltip-click")
      TooltipProvider(delay=-1, closeDelay=-1, timeout=400)
        Tooltip()
          row gap=24
            if showTrigger
              TooltipTrigger(id="tooltip-save-trigger", target="tooltip-save", label="Save document", press=save, disabled=disabled, delay=openDelay, closeDelay=closeDelay, closeOnClick=closeOnClick)
                text "Save document"
            TooltipTrigger(id="tooltip-other-trigger", target="tooltip-save", label="Save a copy", press=save, disabled=false, delay=openDelay, closeDelay=closeDelay, closeOnClick=true)
              text "Save a copy"
            TooltipTrigger(id="tooltip-share-trigger", target="tooltip-share", label="Share document", press=save, disabled=false, delay=-1, closeDelay=-1, closeOnClick=true)
              text "Share document"
          if mounted
            TooltipPortal()
              TooltipPositioner(state=settings)
                TooltipPopup(state=settings)
                  if showArrow
                    TooltipArrow(state=settings)
                  TooltipViewport()
                    text "Save changes to this document."
          TooltipPortal()
            TooltipPositioner(state=second)
              TooltipPopup(state=second)
                TooltipArrow(state=second)
                text "Invite people to review this document."
      text `Saves: ${count}` testId="tooltip-count"
      Button(label="Next action", press=save, disabled=false, size="sm", variant="bordered", testId="tooltip-next")
