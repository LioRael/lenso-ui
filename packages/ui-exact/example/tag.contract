use TagGroupState, TagGroup, TagGroupList, Tag, Button from "@lenso/ui-exact"

component TagExample
  state keys = ["", "a,b", "雪", "locked"]
  state selected: string[] = []
  state mode = "multiple"
  state size = "md"
  state variant = "default"
  state disabled = false
  state readOnly = false
  state removable = true
  state mounted = true
  state rtl = false
  state reject = false
  state rejectSelection = false
  state defer = false
  state pending = ""
  state hasPending = false
  state lastRemoval = ""
  state requests = 0
  derive group = TagGroupState(id="project-tags", label="Project tags", keys=keys, value=selected, mode=mode, disabled=disabled, readOnly=readOnly, direction=(rtl ? "rtl" : "ltr"), size=size, variant=variant, removable=removable)
  action change(value: string[])
    if not rejectSelection
      selected = value
  action remove(key: string)
    requests = requests + 1
    lastRemoval = `Remove: ${key}`
    if not reject
      if defer
        pending = key
        hasPending = true
      else
        keys = keys.filter(value => value != key)
  action confirm
    if hasPending
      keys = keys.filter(value => value != pending)
      hasPending = false
  action reset
    keys = ["", "a,b", "雪", "locked"]
    selected = []
    hasPending = false
  action empty
    keys = []
    selected = []
  action veto
    reject = not reject
  action vetoSelection
    rejectSelection = not rejectSelection
  action delay
    defer = not defer
  action disable
    disabled = not disabled
  action lock
    readOnly = not readOnly
  action removability
    removable = not removable
  action remount
    mounted = not mounted
  action redirect
    rtl = not rtl
  action cycleSize
    size = size == "sm" ? "md" : size == "md" ? "lg" : "sm"
  action surface
    variant = variant == "default" ? "surface" : "default"
  action selection
    mode = mode == "multiple" ? "single" : mode == "single" ? "none" : "multiple"
    selected = []
  view
    column id="tag-examples" testId="tag-examples" gap=12
      text "Tags" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        Button(label="Reset tags", press=reset, disabled=false, size="sm", variant="bordered", testId="tags-reset")
        Button(label="Empty tags", press=empty, disabled=false, size="sm", variant="bordered", testId="tags-empty")
        Button(label="Reject removal", press=veto, disabled=false, size="sm", variant="bordered", testId="tags-reject")
        Button(label="Reject selection", press=vetoSelection, disabled=false, size="sm", variant="bordered", testId="tags-reject-selection")
        Button(label="Defer removal", press=delay, disabled=false, size="sm", variant="bordered", testId="tags-defer")
        Button(label="Confirm removal", press=confirm, disabled=false, size="sm", variant="bordered", testId="tags-confirm")
        Button(label="Disable tags", press=disable, disabled=false, size="sm", variant="bordered", testId="tags-disabled")
        Button(label="Read only tags", press=lock, disabled=false, size="sm", variant="bordered", testId="tags-readonly")
        Button(label="Allow removal", press=removability, disabled=false, size="sm", variant="bordered", testId="tags-removable")
        Button(label="Mount tags", press=remount, disabled=false, size="sm", variant="bordered", testId="tags-mounted")
        Button(label="Tags direction", press=redirect, disabled=false, size="sm", variant="bordered", testId="tags-direction")
        Button(label="Tag size", press=cycleSize, disabled=false, size="sm", variant="bordered", testId="tags-size")
        Button(label="Tag surface", press=surface, disabled=false, size="sm", variant="bordered", testId="tags-variant")
        Button(label="Tag selection", press=selection, disabled=false, size="sm", variant="bordered", testId="tags-mode")
      if mounted
        TagGroup(state=group, change=change, remove=remove)
          TagGroupList()
            for key in keys key=key
              Tag(state=group, id=(key == "" ? "tag-empty" : key == "a,b" ? "tag-comma" : key == "雪" ? "tag-unicode" : "tag-locked"), itemKey=key, textValue=(key == "" ? "Design" : key == "a,b" ? "Development" : key == "雪" ? "Research" : "Locked"), disabled=(key == "locked"), remove=remove)
                text (key == "" ? "Design" : key == "a,b" ? "Development" : key == "雪" ? "Research" : "Locked")
      text `Selection: ${selected.join("|")}` testId="tags-value"
      text lastRemoval testId="tags-last-removal"
      text `Requests: ${requests}` testId="tags-requests"
      text (hasPending ? "Pending" : "No pending removal") testId="tags-pending"
