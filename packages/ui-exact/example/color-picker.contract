use ColorPickerState, ColorPicker, ColorPickerTrigger, ColorPickerPopover, ColorPickerDialog, PopoverState, PopoverClose, ColorAreaState, ColorArea, ColorAreaThumb, ColorSliderState, ColorSlider, ColorSliderLabel, ColorSliderOutput, ColorSliderTrack, ColorSliderThumb, ColorFieldState, ColorField, ColorFieldLabel, ColorInputGroup, ColorInputGroupInput, ColorSwatchPickerState, ColorSwatchPicker, ColorSwatchPickerItem, ColorSwatch, Button from "@lenso/ui-exact"

component ColorPickerExample
  state value = "hsba(210, 50%, 50%, 0.5)"
  state commits = 0
  state disabled = false
  state readOnly = false
  state reject = false
  state mounted = true
  state rtl = false
  derive picker = ColorPickerState(id="combined-picker", label="Choose color", value=value, disabled=disabled, readOnly=readOnly, direction=(rtl ? "rtl" : "ltr"))
  derive popup = PopoverState(id="combined-picker", label="Color picker", labelledBy="combined-picker-title", describedBy="", side="bottom", align="start", direction=picker.direction, sideOffset=8, alignOffset=0, collisionPadding=12, collisionAvoidance=true, disableAnchorTracking=false)
  derive area = ColorAreaState(id="picker-plane", label="Saturation and brightness", value=value, colorSpace="hsb", xChannel="saturation", yChannel="brightness", locale="en-US", direction=picker.direction, xName="", yName="", disabled=disabled, readOnly=readOnly, showDots=false)
  derive hue = ColorSliderState(id="picker-hue", label="Hue", value=value, channel="hue", colorSpace="hsb", locale="en-US", name="", orientation="horizontal", direction=picker.direction, disabled=disabled, readOnly=readOnly)
  derive alpha = ColorSliderState(id="picker-alpha", label="Opacity", value=value, channel="alpha", colorSpace="hsb", locale="en-US", name="", orientation="horizontal", direction=picker.direction, disabled=disabled, readOnly=readOnly)
  derive field = ColorFieldState(id="picker-hex", label="Hex color", labelledBy="picker-hex-label", describedBy="", value=value, channel="hexa", colorSpace="rgb", locale="en-US", name="color", disabled=disabled, readOnly=readOnly, required=true, invalid=false, variant="secondary", fullWidth=true)
  derive palette = ColorSwatchPickerState(id="picker-palette", label="Preset colors", value=value, name="", disabled=(disabled or readOnly), required=false, size="sm", shape="circle", layout="grid", direction=picker.direction)
  action change(next: string)
    if not reject and not disabled and not readOnly
      value = next
  action commit(next: string)
    commits = commits + 1
  action disable
    disabled = not disabled
  action lock
    readOnly = not readOnly
  action veto
    reject = not reject
  action remount
    mounted = not mounted
  action redirect
    rtl = not rtl
  action external
    value = "hsba(30, 75%, 80%, 0.75)"
  view
    column id="color-picker-examples" testId="color-picker-examples" gap=12
      text "Color picker" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        Button(label="Disable picker", press=disable, disabled=false, size="sm", variant="bordered", testId="picker-disabled")
        Button(label="Read only picker", press=lock, disabled=false, size="sm", variant="bordered", testId="picker-readonly")
        Button(label="Reject picker changes", press=veto, disabled=false, size="sm", variant="bordered", testId="picker-reject")
        Button(label="Mount picker", press=remount, disabled=false, size="sm", variant="bordered", testId="picker-mounted")
        Button(label="Picker direction", press=redirect, disabled=false, size="sm", variant="bordered", testId="picker-direction")
        Button(label="External color", press=external, disabled=false, size="sm", variant="bordered", testId="picker-external")
      if mounted
        ColorPicker(state=picker)
          ColorPickerTrigger(state=picker)
            ColorSwatch(id="picker-trigger-swatch", color=value, label="Selected color", size="sm", shape="square")
            text "Choose color"
          ColorPickerPopover(state=popup)
            ColorPickerDialog(id="combined-picker-title", level=3)
              text "Color picker"
            box padding=20
              ColorArea(state=area, change=change, commit=commit)
                ColorAreaThumb(state=area, change=change, commit=commit)
            ColorSlider(state=hue, change=change, commit=commit)
              ColorSliderLabel(state=hue)
              ColorSliderOutput(state=hue)
              ColorSliderTrack(state=hue)
                ColorSliderThumb(state=hue, change=change, commit=commit)
            ColorSlider(state=alpha, change=change, commit=commit)
              ColorSliderLabel(state=alpha)
              ColorSliderOutput(state=alpha)
              ColorSliderTrack(state=alpha)
                ColorSliderThumb(state=alpha, change=change, commit=commit)
            ColorField(state=field, change=change, commit=commit)
              ColorFieldLabel(state=field)
              ColorInputGroup(state=field)
                ColorInputGroupInput(state=field, change=change, commit=commit)
            ColorSwatchPicker(state=palette)
              ColorSwatchPickerItem(state=palette, id="picker-red", color="#FF0000", label="Red", disabled=false, change=change)
              ColorSwatchPickerItem(state=palette, id="picker-blue", color="#0080FF", label="Blue", disabled=false, change=change)
            PopoverClose(id="picker-done", label="Done", target=picker.id, disabled=false, size="md", variant="bordered")
              text "Done"
      text value testId="picker-value"
      text `Commits: ${commits}` testId="picker-commits"
