use PopoverState, Popover, PopoverPortal, PopoverTrigger, PopoverPositioner, PopoverPopup, PopoverArrow, PopoverTitle, PopoverDescription, PopoverViewport, PopoverClose, Button, Input, Label from "@lenso/ui-exact"

component PopoverExample
  state side = "bottom"
  state align = "center"
  state rtl = false
  state offset = 16
  state collision = true
  state tracking = true
  state disabled = false
  state mounted = true
  state showArrow = true
  state draft = "Weekly report"
  state saved = ""
  derive settings = PopoverState(id="export-popover", label="Export options", labelledBy="export-popover-title", describedBy="export-popover-description", side=side, align=align, direction=(rtl ? "rtl" : "ltr"), sideOffset=offset, alignOffset=0, collisionPadding=8, collisionAvoidance=collision, disableAnchorTracking=(not tracking))
  derive nested = PopoverState(id="format-popover", label="Document format", labelledBy="format-popover-title", describedBy="", side="inline-end", align="start", direction=(rtl ? "rtl" : "ltr"), sideOffset=16, alignOffset=0, collisionPadding=8, collisionAvoidance=true, disableAnchorTracking=false)
  action edit(value: string)
    draft = value
  action commit(value: string)
    draft = value
  action save
    saved = draft
    hidePopover("export-popover")
  action cycleSide
    side = side == "bottom" ? "top" : (side == "top" ? "left" : (side == "left" ? "right" : (side == "right" ? "inline-start" : (side == "inline-start" ? "inline-end" : "bottom"))))
  action cycleAlign
    align = align == "center" ? "start" : (align == "start" ? "end" : "center")
  action toggleDirection
    rtl = not rtl
  action cycleOffset
    offset = offset == 16 ? 28 : (offset == 28 ? 4 : 16)
  action toggleCollision
    collision = not collision
  action toggleTracking
    tracking = not tracking
  action toggleDisabled
    disabled = not disabled
  action toggleMounted
    mounted = not mounted
  action toggleArrow
    showArrow = not showArrow
  action openElsewhere
    showPopover("export-popover", source="popover-secondary")
  view
    column id="popover-examples" gap=12
      text "Popover" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        Button(label="Placement", press=cycleSide, disabled=false, size="sm", variant="bordered", testId="popover-side")
        Button(label="Alignment", press=cycleAlign, disabled=false, size="sm", variant="bordered", testId="popover-align")
        Button(label="Direction", press=toggleDirection, disabled=false, size="sm", variant="bordered", testId="popover-direction")
        Button(label="Offset", press=cycleOffset, disabled=false, size="sm", variant="bordered", testId="popover-offset")
        Button(label="Collisions", press=toggleCollision, disabled=false, size="sm", variant="bordered", testId="popover-collision")
        Button(label="Tracking", press=toggleTracking, disabled=false, size="sm", variant="bordered", testId="popover-tracking")
        Button(label="Disable trigger", press=toggleDisabled, disabled=false, size="sm", variant="bordered", testId="popover-disabled")
        Button(label="Mount popup", press=toggleMounted, disabled=false, size="sm", variant="bordered", testId="popover-mounted")
        Button(label="Arrow", press=toggleArrow, disabled=false, size="sm", variant="bordered", testId="popover-arrow")
      Popover()
        row gap=24
          PopoverTrigger(id="popover-open", label="Export options", target="export-popover", disabled=disabled, size="md", variant="bordered", openOnHover=false, delay=300, closeDelay=0)
            text "Export options"
          PopoverTrigger(id="popover-secondary", label="Export elsewhere", target="export-popover", disabled=false, size="md", variant="bordered", openOnHover=false, delay=300, closeDelay=0)
            text "Export elsewhere"
        if mounted
          PopoverPortal()
            PopoverPositioner(state=settings)
              PopoverPopup(state=settings)
                if showArrow
                  PopoverArrow(state=settings)
                PopoverViewport()
                  column gap=16
                    PopoverTitle(id="export-popover-title", level=3)
                      text "Export options"
                    PopoverDescription(id="export-popover-description")
                      text "Choose a name for your document."
                    column gap=8
                      Label(id="export-name-label", controlId="export-name", label="Document name", required=false)
                      Input(id="export-name", name="exportName", label="Document name", labelledBy="export-name-label", describedBy="", value=draft, input=edit, change=commit, submit=save, placeholder="Document name", type="text", autocomplete="off", disabled=false, readOnly=false, required=false, invalid=false, variant="primary")
                    row gap=8 flex-wrap="wrap"
                      PopoverClose(id="popover-cancel", label="Cancel export", target="export-popover", disabled=false, size="sm", variant="bordered")
                        text "Cancel"
                      Button(label="Export", press=save, disabled=false, size="sm", variant="prominent", testId="popover-save")
                      PopoverTrigger(id="popover-format", label="Document format", target="format-popover", disabled=false, size="sm", variant="borderless", openOnHover=false, delay=300, closeDelay=0)
                        text "Format"
                    PopoverPositioner(state=nested)
                      PopoverPopup(state=nested)
                        PopoverArrow(state=nested)
                        PopoverTitle(id="format-popover-title", level=4)
                          text "Document format"
                        PopoverDescription(id="format-popover-description")
                          text "Export as a PDF with selectable text."
                        PopoverClose(id="format-close", label="Close format details", target="format-popover", disabled=false, size="sm", variant="bordered")
                          text "Done"
      text saved testId="popover-saved"
      Button(label="Open at second trigger", press=openElsewhere, disabled=false, size="sm", variant="bordered", testId="popover-open-action")
      Button(label="Next action", press=save, disabled=false, size="sm", variant="bordered", testId="popover-next")
