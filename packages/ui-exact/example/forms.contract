use Input, TextArea, TextField, InputGroup, InputGroupPrefix, Label, Description, FieldError, Fieldset, Checkbox, CheckboxGroup, Radio, RadioGroup, Button from "@lenso/ui-exact"

component FormExample
  state name = ""
  state notes = ""
  state submitted = ""
  state subscribed = false
  state mixed = true
  state account = "personal"
  state visible = true
  state disabled = false
  state readOnly = false
  derive invalid = name.length > 0 and name.trim().length < 2
  action editName(value: string)
    name = value
  action commitName(value: string)
    name = value.trim()
  action submitName
    if name.trim().length >= 2
      submitted = name.trim()
  action editNotes(value: string)
    notes = value
  action subscribe(value: bool)
    subscribed = value
    mixed = false
  action pickAccount(value: string)
    account = value
  action toggleVisible
    visible = not visible
  action toggleDisabled
    disabled = not disabled
  action toggleReadOnly
    readOnly = not readOnly
  view
    column gap=16 padding-top=24
      text "Form controls" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        Button(label="Toggle disabled", press=toggleDisabled, disabled=false, size="md", variant="bordered", testId="form-disabled")
        Button(label="Toggle read-only", press=toggleReadOnly, disabled=false, size="md", variant="bordered", testId="form-readonly")
        Button(label="Toggle fields", press=toggleVisible, disabled=false, size="md", variant="bordered", testId="form-visible")
      if visible
        Fieldset(id="profile", label="Profile")
          TextField(id="name-field", invalid=invalid, disabled=disabled)
            Label(id="name-label", controlId="name", label="Name", required=true)
            Input(id="name", name="name", label="Name", labelledBy="name-label", describedBy=(invalid ? "name-error" : "name-hint"), value=name, input=editName, change=commitName, submit=submitName, placeholder="Your name", type="text", autocomplete="name", disabled=disabled, readOnly=readOnly, required=true, invalid=invalid, variant="primary")
            Description(id="name-hint", label="Use at least two characters.")
            FieldError(id="name-error", message=(invalid ? "Enter at least two characters." : ""))
          TextField(id="notes-field", invalid=false, disabled=disabled)
            Label(id="notes-label", controlId="notes", label="Notes", required=false)
            InputGroup(id="notes-group", variant="secondary")
              InputGroupPrefix()
                text "Note" testId="notes-prefix"
              TextArea(id="notes", name="notes", label="Notes", labelledBy="notes-label", describedBy="notes-hint", value=notes, input=editNotes, change=editNotes, placeholder="Optional notes", rows=3, disabled=disabled, readOnly=readOnly, required=false, invalid=false, variant="secondary")
            Description(id="notes-hint", label="Line breaks and selection stay native.")
          CheckboxGroup(label="Updates", describedBy="updates-hint")
            Description(id="updates-hint", label="Choose whether to receive product updates.")
            Checkbox(id="subscribe", name="subscribe", label="Product updates", describedBy="updates-hint", checked=subscribed, indeterminate=mixed, change=subscribe, disabled=disabled, required=false, invalid=false)
          RadioGroup(label="Account type", describedBy="account-hint", orientation="vertical")
            Description(id="account-hint", label="Choose one account type.")
            Radio(id="personal", name="account", label="Personal", describedBy="account-hint", value="personal", checked=(account == "personal"), change=pickAccount, disabled=disabled, required=true, invalid=false)
            Radio(id="business", name="account", label="Business", describedBy="account-hint", value="business", checked=(account == "business"), change=pickAccount, disabled=disabled, required=true, invalid=false)
      text `Draft: ${name}` testId="name-state"
      text `Notes: ${notes}` testId="notes-state"
      text `Submitted: ${submitted}` testId="submitted-state"
      text (subscribed ? "Subscribed" : "Not subscribed") testId="subscribe-state"
      text `Account: ${account}` testId="account-state"
