use RangeState, ProgressState, ProgressBar, ProgressBarLabel, ProgressBarOutput, ProgressBarTrack, ProgressBarFill, Meter, MeterLabel, MeterOutput, MeterTrack, MeterFill, ProgressCircle, ProgressCircleLabel, ProgressCircleTrack, ProgressCircleTrackCircle, ProgressCircleFillCircle, Spinner, Skeleton, Button from "@lenso/ui-exact"

component FeedbackExample
  state value = 35
  state indeterminate = false
  state disabled = false
  state visible = true
  state size = "md"
  state spinnerSize = "md"
  state color = "accent"
  state animation = "shimmer"
  state customText = false
  state reversed = false
  state rtl = false
  derive lower = reversed ? 110 : 10
  derive upper = reversed ? 10 : 110
  derive summary = indeterminate ? "Processing" : (customText ? "35 of 110 files" : "")
  derive barRange = RangeState(id="upload", label="Upload", value=value, min=lower, max=upper, valueText=summary, size=size, color=color, disabled=disabled)
  derive bar = ProgressState(range=barRange, indeterminate=indeterminate)
  derive circleRange = RangeState(id="sync", label="Sync", value=value, min=lower, max=upper, valueText=summary, size=size, color=color, disabled=disabled)
  derive circle = ProgressState(range=circleRange, indeterminate=indeterminate)
  derive storage = RangeState(id="storage", label="Storage", value=value, min=lower, max=upper, valueText=(customText ? "35 of 110 files" : ""), size=size, color=color, disabled=disabled)
  action advance
    value = value == 35 ? 200 : (value == 200 ? -50 : 35)
  action toggleIndeterminate
    indeterminate = not indeterminate
  action toggleDisabled
    disabled = not disabled
  action toggleVisible
    visible = not visible
  action toggleSize
    size = size == "md" ? "lg" : (size == "lg" ? "sm" : "md")
  action toggleSpinnerSize
    spinnerSize = spinnerSize == "md" ? "lg" : (spinnerSize == "lg" ? "xl" : (spinnerSize == "xl" ? "sm" : "md"))
  action toggleColor
    color = color == "accent" ? "success" : (color == "success" ? "warning" : (color == "warning" ? "danger" : (color == "danger" ? "default" : "accent")))
  action toggleAnimation
    animation = animation == "shimmer" ? "pulse" : (animation == "pulse" ? "none" : "shimmer")
  action toggleText
    customText = not customText
  action toggleDirection
    rtl = not rtl
  action toggleRange
    reversed = not reversed
  view
    column id="feedback-examples" gap=16 direction=(rtl ? "rtl" : "ltr")
      text "Progress and loading" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        Button(label="Change value", press=advance, disabled=false, size="sm", variant="bordered", testId="feedback-value")
        Button(label="Indeterminate", press=toggleIndeterminate, disabled=false, size="sm", variant="bordered", testId="feedback-indeterminate")
        Button(label="Disabled", press=toggleDisabled, disabled=false, size="sm", variant="bordered", testId="feedback-disabled")
        Button(label="Toggle feedback", press=toggleVisible, disabled=false, size="sm", variant="bordered", testId="feedback-visible")
        Button(label="Change size", press=toggleSize, disabled=false, size="sm", variant="bordered", testId="feedback-size")
        Button(label="Spinner size", press=toggleSpinnerSize, disabled=false, size="sm", variant="bordered", testId="feedback-spinner-size")
        Button(label="Change color", press=toggleColor, disabled=false, size="sm", variant="bordered", testId="feedback-color")
        Button(label="Skeleton animation", press=toggleAnimation, disabled=false, size="sm", variant="bordered", testId="feedback-animation")
        Button(label="Custom value text", press=toggleText, disabled=false, size="sm", variant="bordered", testId="feedback-text")
        Button(label="Reverse range", press=toggleRange, disabled=false, size="sm", variant="bordered", testId="feedback-range")
        Button(label="Reverse feedback direction", press=toggleDirection, disabled=false, size="sm", variant="bordered", testId="feedback-direction")
      if visible
        column gap=16
          ProgressBar(state=bar)
            ProgressBarLabel()
              text "Upload"
            ProgressBarOutput(state=bar)
            ProgressBarTrack(state=bar)
              ProgressBarFill(state=bar)
          Meter(state=storage)
            MeterLabel()
              text "Storage"
            MeterOutput(state=storage)
            MeterTrack(state=storage)
              MeterFill(state=storage)
          row gap=16 align-items="center"
            ProgressCircle(state=circle)
              ProgressCircleTrack(state=circle)
                ProgressCircleTrackCircle(state=circle, cx=18, cy=18, radius=16, thickness=4)
                ProgressCircleFillCircle(state=circle, cx=18, cy=18, radius=16, thickness=4)
            ProgressCircleLabel()
              text "Sync"
            Spinner(id="feedback-spinner", label="Loading files", size=spinnerSize, color="secondary")
            Spinner(id="feedback-spinner-current", label="Loading preview", size="sm", color="current")
          Skeleton(id="feedback-skeleton", width="100%", height="64px", animation=animation)
            column padding=12 gap=8
              Skeleton(id="feedback-skeleton-line", width="60%", height="12px", animation=animation)
              Skeleton(id="feedback-skeleton-line-two", width="40%", height="12px", animation="none")
