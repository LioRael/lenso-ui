use AutocompleteState, AutocompleteOption, AutocompleteRoot, AutocompleteLabel, AutocompleteInputGroup, AutocompleteInput, AutocompleteTrigger, AutocompleteIndicator, AutocompleteClearButton, AutocompletePortal, AutocompletePositioner, AutocompletePopover, AutocompleteList, AutocompleteItem, AutocompleteItemText, AutocompleteItemIndicator, AutocompleteGroup, AutocompleteGroupLabel, AutocompleteSeparator, AutocompleteEmpty, AutocompleteStatus, AutocompleteChips, AutocompleteChip, AutocompleteChipRemove, AutocompleteValue, AutocompleteSearchClear, Autocomplete, Button from "@lenso/ui-exact"

component AutocompleteExample
  state value = ["react"]
  state query = ""
  state values: string[] = []
  state search = ""
  state disabled = false
  state readOnly = false
  state reject = false
  state rejectQuery = false
  state mounted = true
  state rtl = false
  state variant = "primary"
  state filter = "contains"
  state externalForm = false
  state removeReact = false
  state queries = 0
  derive options = [AutocompleteOption(value="react", label="React", disabled=false), AutocompleteOption(value="disabled", label="Reason (unavailable)", disabled=true), AutocompleteOption(value="", label="Résumé", disabled=false), AutocompleteOption(value="a,b", label="Solid", disabled=false), AutocompleteOption(value="雪", label="Svelte", disabled=false)]
  derive available = options.filter(item => not removeReact or item.value != "react")
  derive single = AutocompleteState(id="framework-auto", label="Framework selection", labelledBy="framework-auto-label", describedBy="auto-hint", value=value, inputValue=query, defaultValue=["react"], defaultInputValue="", multiple=false, disabled=disabled, readOnly=readOnly, required=true, invalid=false, name="framework", form=(externalForm ? "auto-external-form-fixture" : ""), placeholder="Choose a framework", searchLabel="Search frameworks", searchPlaceholder="Search options", variant=variant, fullWidth=true, direction=(rtl ? "rtl" : "ltr"), filter=filter, locale="en-US", autoHighlight=true, loop=true, side="bottom", align="start", sideOffset=4, collisionPadding=8)
  derive many = AutocompleteState(id="frameworks-auto", label="Framework selections", labelledBy="frameworks-auto-label", describedBy="", value=values, inputValue=search, defaultValue=[], defaultInputValue="", multiple=true, disabled=disabled, readOnly=readOnly, required=false, invalid=false, name="frameworks", form=(externalForm ? "auto-external-form-fixture" : ""), placeholder="Choose frameworks", searchLabel="Search multiple frameworks", searchPlaceholder="Search options", variant=variant, fullWidth=true, direction=(rtl ? "rtl" : "ltr"), filter=filter, locale="en-US", autoHighlight=true, loop=true, side="bottom", align="start", sideOffset=4, collisionPadding=8)
  action choose(next: string[], text: string)
    if not reject
      value = next
      query = text
  action edit(text: string)
    queries = queries + 1
    if not rejectQuery
      query = text
  action chooseMany(next: string[], text: string)
    if not reject
      values = next
      search = text
  action editMany(text: string)
    if not rejectQuery
      search = text
  action disable
    disabled = not disabled
  action lock
    readOnly = not readOnly
  action veto
    reject = not reject
  action vetoQuery
    rejectQuery = not rejectQuery
  action remount
    mounted = not mounted
  action redirect
    rtl = not rtl
  action surface
    variant = variant == "primary" ? "secondary" : "primary"
  action filtering
    filter = filter == "contains" ? "startsWith" : filter == "startsWith" ? "none" : "contains"
  action associate
    externalForm = not externalForm
  action external
    value = ["雪"]
    query = ""
  action remove
    removeReact = not removeReact
  view
    column id="autocomplete-examples" gap=16 width="100%"
      text "Autocomplete" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        Button(label="Disable autocomplete", press=disable, disabled=false, size="sm", variant="bordered", testId="auto-disabled")
        Button(label="Read only autocomplete", press=lock, disabled=false, size="sm", variant="bordered", testId="auto-readonly")
        Button(label="Reject choices", press=veto, disabled=false, size="sm", variant="bordered", testId="auto-reject")
        Button(label="Reject search", press=vetoQuery, disabled=false, size="sm", variant="bordered", testId="auto-reject-query")
        Button(label="Mount autocomplete", press=remount, disabled=false, size="sm", variant="bordered", testId="auto-mounted")
        Button(label="Reverse autocomplete", press=redirect, disabled=false, size="sm", variant="bordered", testId="auto-direction")
        Button(label="Autocomplete surface", press=surface, disabled=false, size="sm", variant="bordered", testId="auto-variant")
        Button(label="Autocomplete filter", press=filtering, disabled=false, size="sm", variant="bordered", testId="auto-filter")
        Button(label="External selection", press=external, disabled=false, size="sm", variant="bordered", testId="auto-external")
        Button(label="External form", press=associate, disabled=false, size="sm", variant="bordered", testId="auto-form")
        Button(label="Remove React", press=remove, disabled=false, size="sm", variant="bordered", testId="auto-remove-react")
      text "Choose a value, then search inside the popup." id="auto-hint"
      if mounted
        AutocompleteRoot(state=single, options=available, change=choose)
          AutocompleteLabel(state=single)
          AutocompleteInputGroup(state=single)
            AutocompleteTrigger(state=single, label="Choose framework")
              AutocompleteValue(state=single, options=available)
              AutocompleteIndicator()
            AutocompleteClearButton(state=single, label="Clear framework", change=choose)
          AutocompletePortal()
            AutocompletePositioner(state=single)
              AutocompletePopover()
                box hatch="lenso-ui" data-lenso-kind="autocomplete-search" data-slot="autocomplete-search"
                  AutocompleteInput(state=single, input=edit)
                  AutocompleteSearchClear(state=single, label="Clear framework search", input=edit)
                AutocompleteList(state=single)
                  AutocompleteGroup(id="auto-popular", labelledBy="auto-popular-label")
                    AutocompleteGroupLabel(id="auto-popular-label")
                      text "Popular"
                    for item, index in available key=item.value
                      if index < 3
                        AutocompleteItem(state=single, item=item, index=index, change=choose)
                          AutocompleteItemText()
                            text item.label
                          AutocompleteItemIndicator(selected=value.includes(item.value))
                  AutocompleteSeparator()
                  AutocompleteGroup(id="auto-more", labelledBy="auto-more-label")
                    AutocompleteGroupLabel(id="auto-more-label")
                      text "More frameworks"
                    for item, index in available key=item.value
                      if index >= 3
                        AutocompleteItem(state=single, item=item, index=index, change=choose)
                          AutocompleteItemText()
                            text item.label
                          AutocompleteItemIndicator(selected=value.includes(item.value))
                AutocompleteEmpty(id="framework-auto-empty", label="No frameworks found")
          AutocompleteStatus(id="framework-auto-status", label="{count} frameworks available")
        Autocomplete(state=many, options=available, input=editMany, change=chooseMany, triggerLabel="Choose frameworks", clearLabel="Clear frameworks", searchClearLabel="Clear frameworks search", emptyLabel="No frameworks found", statusLabel="{count} frameworks available")
      text value.join("|") id="auto-selected" testId="auto-selected"
      text `${queries}` id="auto-query-count" testId="auto-query-count"
      text "After autocomplete" id="auto-after" testId="auto-after" tabindex=0
