use SegmentedControlOption, SegmentedControlState, SegmentedControl, SegmentedControlRoot, SegmentedControlItem, SegmentedControlIndicator, Button from "@lenso/ui-exact"

component SegmentedControlExample
  state value = "day"
  state hasValue = true
  state disabled = false
  state readOnly = false
  state required = false
  state middleDisabled = true
  state glass = false
  state elastic = true
  state large = false
  state rtl = false
  state empty = false
  state visible = true
  state accept = true
  state long = false
  state changes = 0
  state richValue = ""
  state richHasValue = false
  state richChanges = 0
  derive rich = SegmentedControlState(id="segments-rich", label="Display mode", value=richValue, hasValue=richHasValue, direction="ltr", size="sm", lift=20, elastic=true, glass=false, disabled=false, readOnly=false, required=false, name="display-mode", form="segments-native-form")
  derive choices = empty ? [] : [SegmentedControlOption(value="day", label="Day", disabled=false), SegmentedControlOption(value="week", label="Week", disabled=middleDisabled), SegmentedControlOption(value="month", label=(long ? "Month with a deliberately long billing period label" : "Month"), disabled=false)]
  derive state = SegmentedControlState(id="segments", label="Billing period", value=value, hasValue=hasValue, direction=(rtl ? "rtl" : "ltr"), size=(large ? "lg" : "sm"), lift=20, elastic=elastic, glass=glass, disabled=disabled, readOnly=readOnly, required=required, name="billing-period", form="segments-native-form")
  action chooseRich(next: string)
    richValue = next
    richHasValue = true
    richChanges = richChanges + 1
  action clearRich
    richHasValue = false
  action toggleLong
    long = not long
  action change(next: string)
    if accept
      value = next
      hasValue = true
      changes = changes + 1
  action toggleDisabled
    disabled = not disabled
  action toggleReadonly
    readOnly = not readOnly
  action toggleRequired
    required = not required
  action toggleMiddle
    middleDisabled = not middleDisabled
  action toggleGlass
    glass = not glass
  action toggleElastic
    elastic = not elastic
  action toggleSize
    large = not large
  action toggleRtl
    rtl = not rtl
  action toggleEmpty
    empty = not empty
  action toggleVisible
    visible = not visible
  action toggleAccept
    accept = not accept
  action clear
    hasValue = false
  action selectDay
    value = "day"
    hasValue = true
  view
    column id="segmented-examples" gap=16
      text "Segmented controls" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        Button(label="Segments long label", press=toggleLong, disabled=false, size="sm", variant="bordered", testId="segments-long")
        Button(label="Segments disabled", press=toggleDisabled, disabled=false, size="sm", variant="bordered", testId="segments-disabled")
        Button(label="Segments read only", press=toggleReadonly, disabled=false, size="sm", variant="bordered", testId="segments-readonly")
        Button(label="Segments required", press=toggleRequired, disabled=false, size="sm", variant="bordered", testId="segments-required")
        Button(label="Segments middle", press=toggleMiddle, disabled=false, size="sm", variant="bordered", testId="segments-middle")
        Button(label="Segments glass", press=toggleGlass, disabled=false, size="sm", variant="bordered", testId="segments-glass")
        Button(label="Segments elastic", press=toggleElastic, disabled=false, size="sm", variant="bordered", testId="segments-elastic")
        Button(label="Segments size", press=toggleSize, disabled=false, size="sm", variant="bordered", testId="segments-size")
        Button(label="Segments direction", press=toggleRtl, disabled=false, size="sm", variant="bordered", testId="segments-rtl")
        Button(label="Segments empty", press=toggleEmpty, disabled=false, size="sm", variant="bordered", testId="segments-empty")
        Button(label="Segments visible", press=toggleVisible, disabled=false, size="sm", variant="bordered", testId="segments-visible")
        Button(label="Segments accept", press=toggleAccept, disabled=false, size="sm", variant="bordered", testId="segments-accept")
        Button(label="Clear segments", press=clear, disabled=false, size="sm", variant="bordered", testId="segments-clear")
        Button(label="Select day", press=selectDay, disabled=false, size="sm", variant="bordered", testId="segments-day")
      text `Choice: ${hasValue ? value : "none"}` testId="segments-value"
      text `Choice changes: ${changes}` testId="segments-changes"
      if visible
        SegmentedControl(state=state, items=choices, emptyLabel="No billing periods", change=change)
      text `Display mode changes: ${richChanges}` testId="segments-rich-changes"
      Button(label="Clear display mode", press=clearRich, disabled=false, size="sm", variant="bordered", testId="segments-rich-clear")
      SegmentedControlRoot(state=rich)
        SegmentedControlItem(state=rich, id="segments-rich-auto", value="", label="Automatic", disabled=false, change=chooseRich)
          text "Automatic"
        SegmentedControlItem(state=rich, id="segments-rich-custom", value="custom profile", label="Custom", disabled=false, change=chooseRich)
          text "Custom" font-weight=600
        SegmentedControlIndicator()
