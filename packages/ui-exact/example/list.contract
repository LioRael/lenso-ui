use ListState, ListReorderHandle, ListEditItem, List, ListItem, ListAction, ListSection, ListSeparator, ListContent, ListTitle, ListDescription, ListLeading, ListTrailing, Button from "@lenso/ui-exact"

component ListExample
  state count = 0
  state move = ""
  state order = ["recent", "archive"]
  state editing = false
  state selected = []
  state variant = "grouped"
  state disabled = false
  state direction = "ltr"
  derive list = ListState(id="library-list", label="Library", variant=variant, direction=direction, disabled=disabled, editing=editing, selectedKeys=selected)
  action reorder(key: string, target: string, position: string)
    move = `${key}:${position}:${target}`
    order = position == "before" ? [key, target] : [target, key]
  action toggleEditing
    editing = not editing
  action selection(keys: string[])
    selected = keys
  action selectAll
    selected = selected.includes("team") ? ["recent", "archive", "team"] : ["recent", "archive"]
  action externalSelection
    selected = ["archive"]
  action activate
    count = count + 1
  action toggleVariant
    variant = variant == "grouped" ? "plain" : "grouped"
  action toggleDisabled
    disabled = not disabled
  action toggleDirection
    direction = direction == "ltr" ? "rtl" : "ltr"
  view
    column gap=12
      text "List" role="heading" aria-level=2
      row gap=8
        Button(label="List surface", press=toggleVariant, disabled=false, size="sm", variant="bordered", testId="list-variant")
        Button(label="List disabled", press=toggleDisabled, disabled=false, size="sm", variant="bordered", testId="list-disabled")
        Button(label="List direction", press=toggleDirection, disabled=false, size="sm", variant="bordered", testId="list-direction")
      Button(label="Edit list", press=toggleEditing, disabled=false, size="sm", variant="bordered", testId="list-edit")
      Button(label="Set selection", press=externalSelection, disabled=false, size="sm", variant="bordered", testId="list-external")
      List(state=list, selectAll=selectAll)
        for entry in order key=entry
          if entry == "recent"
            ListEditItem(state=list, id="library-recent", itemKey="recent", label="Select recent", disabled=false, height="regular", change=selection)
              ListAction(state=list, id="library-open", disabled=false, press=activate)
                ListLeading()
                  text "↗" aria-hidden=true
                ListContent()
                  ListTitle()
                    text "Recent documents"
                  ListDescription()
                    text "Open the documents you edited recently."
                ListTrailing()
                  text "12"
              ListReorderHandle(state=list, id="recent-move", itemKey="recent", label="Move recent", disabled=false, reorder=reorder)
          else
            ListEditItem(state=list, id="library-archive", itemKey="archive", label="Select archive", disabled=false, height="tall", change=selection)
              ListContent()
                ListTitle()
                  text "Archive"
                ListDescription()
                  text "Documents stay available for later reading and can wrap across multiple lines."
              ListReorderHandle(state=list, id="archive-move", itemKey="archive", label="Move archive", disabled=false, reorder=reorder)
        ListSection(id="library-shared", title="Shared")
          ListEditItem(state=list, id="library-team", itemKey="team", label="Select team", disabled=true, height="regular", change=selection)
            ListAction(state=list, id="library-team-open", disabled=true, press=activate)
              ListContent()
                ListTitle()
                  text "Team library"
      text `Opened: ${count}` testId="list-count"
      text `Selection: ${selected.join(",")}` testId="list-selection-value"
      text move testId="list-move-request"
