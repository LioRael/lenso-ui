use ToolbarState, Toolbar, ToolbarGroup, ToolbarButton, ToolbarLink, ToolbarSeparator, ToolbarButtonIcon, Button from "@lenso/ui-exact"

component ToolbarExample
  state vertical = false
  state rtl = false
  state attached = false
  state glass = true
  state elastic = true
  state disabled = false
  state groupDisabled = false
  state focusable = false
  state loading = false
  state loop = true
  state size = "md"
  state variant = "auto"
  state visible = true
  state showCopy = true
  state clicks = 0
  derive bar = ToolbarState(id="toolbar-demo", label="Document editing", orientation=(vertical ? "vertical" : "horizontal"), direction=(rtl ? "rtl" : "ltr"), disabled=disabled, loopFocus=loop, attached=attached, elastic=elastic)
  action activate
    clicks = clicks + 1
  action orientation
    vertical = not vertical
  action direction
    rtl = not rtl
  action toggleAttached
    attached = not attached
  action toggleGlass
    glass = not glass
  action toggleElastic
    elastic = not elastic
  action toggleDisabled
    disabled = not disabled
  action toggleGroup
    groupDisabled = not groupDisabled
  action toggleFocusable
    focusable = not focusable
  action toggleLoading
    loading = not loading
  action toggleLoop
    loop = not loop
  action cycleSize
    size = size == "md" ? "lg" : (size == "lg" ? "sm" : "md")
  action cycleVariant
    variant = variant == "auto" ? "filled" : (variant == "filled" ? "glass" : (variant == "glass" ? "plain" : "auto"))
  action toggleVisible
    visible = not visible
  action toggleCopy
    showCopy = not showCopy
  view
    column gap=12
      text "Toolbar" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        Button(label="Toolbar axis", press=orientation, disabled=false, size="sm", variant="bordered", testId="toolbar-axis")
        Button(label="Toolbar direction", press=direction, disabled=false, size="sm", variant="bordered", testId="toolbar-direction")
        Button(label="Attach toolbar", press=toggleAttached, disabled=false, size="sm", variant="bordered", testId="toolbar-attached")
        Button(label="Toolbar glass", press=toggleGlass, disabled=false, size="sm", variant="bordered", testId="toolbar-glass")
        Button(label="Toolbar elastic", press=toggleElastic, disabled=false, size="sm", variant="bordered", testId="toolbar-elastic")
        Button(label="Toolbar disabled", press=toggleDisabled, disabled=false, size="sm", variant="bordered", testId="toolbar-disabled")
        Button(label="Clipboard disabled", press=toggleGroup, disabled=false, size="sm", variant="bordered", testId="toolbar-group-disabled")
        Button(label="Focusable disabled", press=toggleFocusable, disabled=false, size="sm", variant="bordered", testId="toolbar-focusable")
        Button(label="Toolbar loading", press=toggleLoading, disabled=false, size="sm", variant="bordered", testId="toolbar-loading")
        Button(label="Toolbar loop", press=toggleLoop, disabled=false, size="sm", variant="bordered", testId="toolbar-loop")
        Button(label="Toolbar size", press=cycleSize, disabled=false, size="sm", variant="bordered", testId="toolbar-size")
        Button(label="Toolbar variant", press=cycleVariant, disabled=false, size="sm", variant="bordered", testId="toolbar-variant")
        Button(label="Toggle toolbar", press=toggleVisible, disabled=false, size="sm", variant="bordered", testId="toolbar-visible")
        Button(label="Toggle Copy", press=toggleCopy, disabled=false, size="sm", variant="bordered", testId="toolbar-copy-visible")
      text `Actions: ${clicks}` testId="toolbar-count"
      if visible
        Toolbar(state=bar)
          ToolbarGroup(state=bar, id="toolbar-clipboard", label="Clipboard", glass=glass, disabled=groupDisabled)
            if showCopy
              ToolbarButton(state=bar, id="toolbar-copy", label="Copy", size=size, variant=variant, groupDisabled=groupDisabled, grouped=true, surface=true, glass=glass, iconOnly=false, elastic=elastic, destructive=false, tint="", disabled=false, focusableWhenDisabled=false, loading=false, press=activate)
                text "Copy"
            ToolbarButton(state=bar, id="toolbar-paste", label="Paste", size=size, variant=variant, groupDisabled=groupDisabled, grouped=true, surface=true, glass=glass, iconOnly=false, elastic=elastic, destructive=false, tint="", disabled=true, focusableWhenDisabled=focusable, loading=false, press=activate)
              text "Paste"
          ToolbarSeparator(orientation=(vertical ? "horizontal" : "vertical"))
          ToolbarButton(state=bar, id="toolbar-save", label="Save", size=size, variant=variant, groupDisabled=false, grouped=false, surface=false, glass=glass, iconOnly=true, elastic=elastic, destructive=false, tint="", disabled=false, focusableWhenDisabled=false, loading=loading, press=activate)
            ToolbarButtonIcon()
              svg width=18 height=18 viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width=1.5
                path d="M3 2h8l2 2v10H3zM5 2v4h5V2M5 14V9h6v5"
          ToolbarLink(id="toolbar-help", label="Editing help", href="#toolbar-help-target", target="_self", disabled=false)
            text "Help"
      text "Editing help destination" id="toolbar-help-target"
