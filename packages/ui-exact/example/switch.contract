use SwitchState, Switch, SwitchContent, SwitchControl, SwitchThumb, SwitchIcon, Button, Description from "@lenso/ui-exact"

component SwitchExample
  state checked = false
  state disabled = false
  state readOnly = false
  state required = false
  state visible = true
  state size = "md"
  state changes = 0
  derive control = SwitchState(id="switch-notifications", label="Notifications", describedBy="switch-description", checked=checked, disabled=disabled, readOnly=readOnly, required=required, invalid=false, size=size, name="notifications", value="enabled")
  action change(next: bool)
    checked = next
    changes = changes + 1
  action toggleDisabled
    disabled = not disabled
  action toggleReadOnly
    readOnly = not readOnly
  action toggleRequired
    required = not required
  action toggleVisible
    visible = not visible
  action cycleSize
    size = size == "md" ? "lg" : (size == "lg" ? "sm" : "md")
  action reset
    checked = false
  view
    column id="switch-examples" gap=16
      text "Switches" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        Button(label="Switch disabled", press=toggleDisabled, disabled=false, size="sm", variant="bordered", testId="switch-disabled")
        Button(label="Switch read only", press=toggleReadOnly, disabled=false, size="sm", variant="bordered", testId="switch-readonly")
        Button(label="Switch required", press=toggleRequired, disabled=false, size="sm", variant="bordered", testId="switch-required")
        Button(label="Switch size", press=cycleSize, disabled=false, size="sm", variant="bordered", testId="switch-size")
        Button(label="Switch visibility", press=toggleVisible, disabled=false, size="sm", variant="bordered", testId="switch-visible")
        Button(label="Reset switch", press=reset, disabled=false, size="sm", variant="bordered", testId="switch-reset")
      text `Switch changes: ${changes}` testId="switch-changes"
      if visible
        Switch(state=control, change=change)
          SwitchContent()
            SwitchControl(size=size)
              SwitchThumb(size=size, checked=checked)
                SwitchIcon()
                  text (checked ? "✓" : "")
            text "Notifications"
        Description(id="switch-description", label="Receive updates about shared documents.")
