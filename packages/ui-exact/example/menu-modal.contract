use MenuState, Menu, MenuTrigger, MenuPortal, MenuPositioner, MenuPopup, MenuItem, MenuItemLabel, MenuSubmenuRoot, MenuSubmenuPositioner, MenuSubmenuTrigger, MenuSubmenuHeading, MenuSubmenuBody, Button from "@lenso/ui-exact"

component ModalMenuExample
  state modal = true
  state mounted = true
  state selected = 0
  state background = 0
  derive settings = MenuState(id="modal-actions", label="Document options", labelledBy="", side="bottom", align="end", direction="ltr", sideOffset=8, alignOffset=0, collisionPadding=8, collisionAvoidance=true, disableAnchorTracking=false)
  derive nested = MenuState(id="modal-actions-child", label="Export", labelledBy="", side="inline-end", align="start", direction="ltr", sideOffset=8, alignOffset=-10, collisionPadding=8, collisionAvoidance=true, disableAnchorTracking=false)
  action choose
    selected = selected + 1
  action outside
    background = background + 1
  action toggleModal
    modal = not modal
  action toggleMounted
    mounted = not mounted
  view
    column id="modal-menu-examples" gap=12
      text "Modal menu" role="heading" aria-level=2
      row gap=8
        Button(label="Modal", press=toggleModal, disabled=false, size="sm", variant="bordered", testId="menu-modal-mode")
        Button(label="Mount menu", press=toggleMounted, disabled=false, size="sm", variant="bordered", testId="menu-modal-mounted")
      Menu()
        MenuTrigger(id="menu-modal-open", label="Document options", target="modal-actions", disabled=false, iconOnly=false)
          text "Document options"
        if mounted
          MenuPortal()
            MenuPositioner(state=settings, modal=modal)
              MenuPopup(state=settings)
                MenuItem(id="menu-modal-save", target="modal-actions", label="Save", press=choose, disabled=false, variant="default", closeOnClick=true)
                  MenuItemLabel()
                    text "Save"
                MenuSubmenuTrigger(id="menu-modal-export", target="modal-actions-child", label="Export", disabled=false, openOnHover="auto", delay=100, closeDelay=0)
                  MenuItemLabel()
                    text "Export"
              MenuSubmenuRoot()
                MenuSubmenuPositioner(state=nested, presentation="auto")
                  MenuPopup(state=nested)
                    MenuSubmenuHeading(id="menu-modal-back", target="modal-actions-child", label="Back to Document options")
                      text "Export"
                    MenuSubmenuBody()
                      MenuItem(id="menu-modal-pdf", target="modal-actions-child", label="PDF", press=choose, disabled=false, variant="default", closeOnClick=true)
                        MenuItemLabel()
                          text "PDF"
      Button(label="Background action", press=outside, disabled=false, size="sm", variant="bordered", testId="menu-modal-background")
      text `Background actions: ${background}` testId="menu-modal-background-count"
      text `Selected actions: ${selected}` testId="menu-modal-selected-count"
      Button(label="Next action", press=outside, disabled=false, size="sm", variant="bordered", testId="menu-modal-next")
