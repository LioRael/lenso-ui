use ContextMenuState, ContextMenu, ContextMenuTrigger, ContextMenuPositioner, ContextMenuLayout, ContextMenuPreview, ContextMenuBarPopup, ContextMenuBar, ContextMenuBarItem, ContextMenuExpand, MenuState, MenuItem, MenuItemLabel, Button from "@lenso/ui-exact"

component ContextMenuPreviewExample
  state compact = true
  state horizontal = false
  state trailing = false
  state mounted = true
  state preview = true
  state count = 0
  derive menu = MenuState(id="context-preview", label="Draft preview actions", labelledBy="", side="bottom", align="start", direction="ltr", sideOffset=2, alignOffset=0, collisionPadding=8, collisionAvoidance=true, disableAnchorTracking=false)
  derive state = ContextMenuState(menu=menu, disabled=false)
  action reset
    compact = true
  action expand
    compact = false
  action act
    count = count + 1
  action toggleLayout
    horizontal = not horizontal
  action toggleAlignment
    trailing = not trailing
  action toggleMounted
    mounted = not mounted
  action togglePreview
    preview = not preview
  view
    column id="context-menu-preview-examples" gap=12
      text "Draft preview" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        Button(label="Change preview layout", press=toggleLayout, disabled=false, size="sm", variant="bordered", testId="context-preview-layout")
        Button(label="Change preview alignment", press=toggleAlignment, disabled=false, size="sm", variant="bordered", testId="context-preview-alignment")
        Button(label="Toggle preview content", press=togglePreview, disabled=false, size="sm", variant="bordered", testId="context-preview-enabled")
        Button(label="Toggle preview menu", press=toggleMounted, disabled=false, size="sm", variant="bordered", testId="context-preview-mounted")
      text `${count}` testId="context-preview-count"
      if mounted
        ContextMenu(state=state)
          ContextMenuTrigger(state=state, id="context-preview-target", label="Preview draft")
            column gap=8
              text "Weekend plans" role="heading" aria-level=3
              text "Right-click or hold to preview this draft."
          ContextMenuPositioner(state=state, modal=false)
            ContextMenuLayout(layout=(horizontal ? "horizontal" : "vertical"), previewAlign=(trailing ? "trailing" : "leading"))
              if preview
                ContextMenuPreview(id="context-preview-card")
                  column gap=8
                    text "Weekend plans" role="heading" aria-level=3
                    text "Visit the coast and stop for coffee on the way."
                    Button(label="Preview content action", press=act, disabled=false, size="sm", variant="borderless", testId="context-preview-inert")
              ContextMenuBarPopup(state=state, compact=compact, reset=reset)
                if compact
                  ContextMenuBar()
                    ContextMenuBarItem(id="context-preview-copy", target="context-preview", label="Copy", press=act, disabled=false, variant="default", closeOnClick=true)
                      text "Copy"
                    ContextMenuExpand(state=state, label="More actions", expand=expand)
                else
                  MenuItem(id="context-preview-full-copy", target="context-preview", label="Copy draft", press=act, disabled=false, variant="default", closeOnClick=true)
                    MenuItemLabel()
                      text "Copy draft"
                  MenuItem(id="context-preview-delete", target="context-preview", label="Delete draft", press=act, disabled=false, variant="danger", closeOnClick=true)
                    MenuItemLabel()
                      text "Delete draft"
