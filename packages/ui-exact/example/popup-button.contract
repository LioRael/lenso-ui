use PopupButton, PopupButtonMenuTrigger, PopupButtonSelectTrigger, MenuState, Menu, MenuPortal, MenuPositioner, MenuPopup, MenuItemRadio, MenuItemIndicator, MenuItemLabel, MenuRadioGroup, SelectState, SelectOption, SelectRoot, SelectValue, SelectPortal, SelectPositioner, SelectPopover, SelectList, SelectItem, SelectItemText, SelectItemIndicator, Button from "@lenso/ui-exact"

component PopupButtonExample
  state ascending = true
  state count = 0
  state selected = "date"
  state appearance = ["auto"]
  state disabled = false
  state readOnly = false
  state mounted = true
  state rtl = false
  state reject = false
  derive menu = MenuState(id="popup-sort-menu", label="Sort by", labelledBy="", side="bottom", align="start", direction=(rtl ? "rtl" : "ltr"), sideOffset=4, alignOffset=0, collisionPadding=8, collisionAvoidance=true, disableAnchorTracking=false)
  derive field = SelectState(id="popup-appearance", label="Appearance", labelledBy="", describedBy="popup-hint", value=appearance, defaultValue=["auto"], multiple=false, disabled=disabled, readOnly=readOnly, required=false, invalid=false, name="appearance", form="", variant="primary", fullWidth=false, direction=(rtl ? "rtl" : "ltr"), side="bottom", align="start", sideOffset=4, collisionPadding=8)
  derive options = [SelectOption(value="auto", label="Automatic", disabled=false), SelectOption(value="locked", label="Unavailable", disabled=true), SelectOption(value="light", label="Light", disabled=false), SelectOption(value="dark", label="Dark", disabled=false)]
  derive summary = options.filter(item => appearance.includes(item.value)).map(item => item.label).join(", ")
  action order
    ascending = not ascending
    count = count + 1
  action byDate
    if not reject
      selected = "date"
  action byName
    if not reject
      selected = "name"
  action choose(next: string[])
    if not reject
      appearance = next
  action disable
    disabled = not disabled
  action lock
    readOnly = not readOnly
  action remount
    mounted = not mounted
  action redirect
    rtl = not rtl
  action veto
    reject = not reject
  view
    column id="popup-button-examples" testId="popup-button-examples" gap=16 width="100%" direction=(rtl ? "rtl" : "ltr")
      text "Popup choices" role="heading" aria-level=2
      row gap=8 flex-wrap="wrap"
        Button(label="Disable choices", press=disable, disabled=false, size="sm", variant="bordered", testId="popup-disabled")
        Button(label="Read only selection", press=lock, disabled=false, size="sm", variant="bordered", testId="popup-readonly")
        Button(label="Mount choices", press=remount, disabled=false, size="sm", variant="bordered", testId="popup-mounted")
        Button(label="Reverse choices", press=redirect, disabled=false, size="sm", variant="bordered", testId="popup-direction")
        Button(label="Reject choices", press=veto, disabled=false, size="sm", variant="bordered", testId="popup-reject")
      text "Choose sorting and appearance." id="popup-hint"
      if mounted
        PopupButton(id="popup-order", label="Sort direction", disabled=disabled, type="button", press=order)
          text (ascending ? "Ascending" : "Descending")
        Menu()
          PopupButtonMenuTrigger(id="popup-menu-open", label="Sort by", target="popup-sort-menu", disabled=disabled)
            text (selected == "date" ? "Date" : "Name")
          MenuPortal()
            MenuPositioner(state=menu, modal=false)
              MenuPopup(state=menu)
                MenuRadioGroup(label="Sort by")
                  MenuItemRadio(id="popup-sort-date", target=menu.id, label="Date", press=byDate, disabled=false, variant="default", closeOnClick=true, checked=(selected == "date"))
                    MenuItemIndicator(checked=(selected == "date"))
                      text "✓"
                    MenuItemLabel()
                      text "Date"
                  MenuItemRadio(id="popup-sort-name", target=menu.id, label="Name", press=byName, disabled=false, variant="default", closeOnClick=true, checked=(selected == "name"))
                    MenuItemIndicator(checked=(selected == "name"))
                      text "✓"
                    MenuItemLabel()
                      text "Name"
        SelectRoot(state=field, change=choose)
          PopupButtonSelectTrigger(state=field)
            SelectValue(text=summary, empty=(appearance.length == 0), placeholder="Choose appearance")
          SelectPortal()
            SelectPositioner(state=field)
              SelectPopover()
                SelectList(state=field)
                  for item, index in options key=item.value
                    SelectItem(state=field, item=item, index=index, change=choose)
                      SelectItemIndicator(selected=appearance.includes(item.value))
                      SelectItemText()
                        text item.label
      text `${count}` id="popup-order-count" testId="popup-order-count"
      text selected id="popup-sort-value" testId="popup-sort-value"
      text appearance.join("|") id="popup-appearance-value" testId="popup-appearance-value"
      text "After choices" testId="popup-after" tabindex=0
