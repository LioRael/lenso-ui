use StyledRadio from "./generated/radio.contract"

shape ColorSwatchPickerState
  id: string
  label: string
  value: string
  name: string
  disabled: bool
  required: bool
  size: string
  shape: string
  layout: string
  direction: string

component ColorSwatch
  props
    id: string
    color: string
    label: string
    size: string
    shape: string
  view
    box id=id testId=id role="img" aria-label=label hatch="lenso-ui" data-lenso-kind="color-swatch" data-slot="color-swatch" data-lenso-value=color data-lenso-size=size data-lenso-variant=shape
      box background-color=color aria-hidden=true hatch="lenso-ui" data-lenso-kind="color-swatch-fill" data-slot="color-swatch-fill"

component ColorSwatchPicker
  props
    state: ColorSwatchPickerState
  slot
  view
    box id=state.id testId=state.id role="radiogroup" aria-label=state.label aria-disabled=state.disabled aria-required=state.required direction=state.direction hatch="lenso-ui" data-lenso-kind="color-swatch-picker" data-slot="color-swatch-picker" data-lenso-value=state.value data-lenso-layout=state.layout
      children

component ColorSwatchPickerItem
  props
    state: ColorSwatchPickerState
    id: string
    color: string
    label: string
    disabled: bool
    change: action
  action select(value: string)
    if not state.disabled and not disabled
      change(value)
  view
    box testId=`${id}-item` hatch="lenso-ui" data-lenso-kind="color-swatch-picker-item" data-slot="color-swatch-picker-item" data-lenso-value=color data-lenso-size=state.size data-lenso-variant=state.shape data-lenso-layout=state.layout data-lenso-disabled=(state.disabled or disabled) data-lenso-active=(state.value == color)
      StyledRadio(id=id, name=state.name, label=label, value=color, selected=state.value, disabled=(state.disabled or disabled), change=select, description="", required=state.required, invalid=false)
      box aria-hidden=true hatch="lenso-ui" data-lenso-kind="color-swatch-picker-swatch" data-slot="color-swatch-picker-swatch" data-lenso-value=color data-lenso-layout=state.layout
        box background-color=color hatch="lenso-ui" data-lenso-kind="color-swatch-fill" data-slot="color-swatch-fill"
