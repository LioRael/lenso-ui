use DisclosureState, AccordionState, AccordionItemState, StyledDisclosure, StyledDisclosureTrigger, StyledAccordion, StyledAccordionItem, StyledAccordionTrigger from "./generated/disclosure.contract"

component Disclosure
  props
    state: DisclosureState
  slot
  view
    StyledDisclosure(state=state)
      children

component DisclosureHeading
  props
    level: number
  slot
  view
    box role="heading" aria-level=level hatch="lenso-ui" data-lenso-kind="disclosure-heading"
      children

component DisclosureTrigger
  props
    state: DisclosureState
    change: action
  slot
  view
    StyledDisclosureTrigger(state=state, change=change)
      children

component DisclosureIndicator
  view
    svg viewBox="0 0 16 16" fill="none" aria-hidden=true
      hatch="lenso-ui" data-lenso-kind="disclosure-indicator"
      path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width=1.5 stroke-linecap="round" stroke-linejoin="round"

component DisclosureContent
  props
    state: DisclosureState
  slot
  view
    column id=`${state.id}-content` testId=`${state.id}-content` role="region"
      aria-labelledby=`${state.id}-trigger` aria-hidden=(not state.open) inert=(not state.open)
      height=(state.open ? "auto" : "0px") overflow="clip"
      hatch="lenso-ui" data-lenso-kind="disclosure-content" data-lenso-open=state.open
      data-lenso-trigger=`${state.id}-trigger`
      column flex-shrink=0 box-sizing="border-box" data-lenso-panel-measure=""
        children

component DisclosureBody
  slot
  view
    column hatch="lenso-ui" data-lenso-kind="disclosure-body"
      children

component Accordion
  props
    state: AccordionState
  slot
  view
    StyledAccordion(state=state)
      children

component AccordionItem
  props
    state: AccordionState
    item: AccordionItemState
  slot
  view
    StyledAccordionItem(state=state, item=item)
      children

component AccordionHeading
  props
    level: number
  slot
  view
    box role="heading" aria-level=level hatch="lenso-ui" data-lenso-kind="accordion-heading"
      children

component AccordionTrigger
  props
    state: AccordionState
    item: AccordionItemState
    change: action
  slot
  view
    StyledAccordionTrigger(state=state, item=item, change=change)
      children

component AccordionIndicator
  view
    svg viewBox="0 0 16 16" fill="none" aria-hidden=true
      hatch="lenso-ui" data-lenso-kind="accordion-indicator"
      path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width=1.5 stroke-linecap="round" stroke-linejoin="round"

component AccordionPanel
  props
    state: AccordionState
    item: AccordionItemState
  derive expanded = state.value.includes(item.value)
  slot
  view
    column id=`${item.id}-content` testId=`${item.id}-content` role="region"
      aria-labelledby=`${item.id}-trigger` aria-hidden=(not expanded) inert=(not expanded)
      height=(expanded ? "auto" : "0px") overflow="clip"
      hatch="lenso-ui" data-lenso-kind="accordion-panel" data-lenso-open=expanded
      data-lenso-trigger=`${item.id}-trigger`
      column flex-shrink=0 box-sizing="border-box" data-lenso-panel-measure=""
        children

component AccordionBody
  slot
  view
    column hatch="lenso-ui" data-lenso-kind="accordion-body"
      children
