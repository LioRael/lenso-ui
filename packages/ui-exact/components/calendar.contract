use StyledCalendarDay from "./generated/calendar-day.contract"

shape CalendarState
  id: string
  label: string
  value: string[]
  focused: string
  placeholder: string
  today: string
  locale: string
  calendar: string
  firstDay: string
  weekdayStyle: string
  selectionMode: string
  min: string
  max: string
  unavailable: string[]
  disabled: bool
  readOnly: bool
  invalid: bool
  direction: string

component Calendar
  props
    state: CalendarState
    change: action
  view
    CalendarRoot(state=state)
      CalendarHeader()
        CalendarHeading(state=state)
        CalendarNavButton(state=state, next=false, label="Previous month")
        CalendarNavButton(state=state, next=true, label="Next month")
      CalendarGrid(state=state, change=change)

component CalendarRoot
  props
    state: CalendarState
  slot
  view
    box id=state.id testId=state.id role="group" aria-label=state.label aria-disabled=state.disabled aria-invalid=state.invalid direction=state.direction
      hatch="lenso-ui" data-lenso-kind="calendar" data-slot="calendar" data-lenso-value=state.value.join("|") data-lenso-focused=state.focused data-lenso-placeholder=state.placeholder data-lenso-today=state.today data-lenso-locale=state.locale data-lenso-calendar=state.calendar data-lenso-first-day=state.firstDay data-lenso-weekday-style=state.weekdayStyle data-lenso-selection-mode=state.selectionMode data-lenso-min=state.min data-lenso-max=state.max data-lenso-unavailable=state.unavailable.join("|") data-lenso-disabled=state.disabled data-lenso-readonly=state.readOnly
      children

component CalendarHeader
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="calendar-header" data-slot="calendar-header"
      children

component CalendarHeading
  props
    state: CalendarState
  view
    box id=`${state.id}-heading` role="heading" aria-level=2 aria-live="polite" aria-atomic=true hatch="lenso-ui" data-lenso-kind="calendar-heading" data-slot="calendar-heading"

component CalendarNavButton
  props
    state: CalendarState
    next: bool
    label: string
  view
    button id=`${state.id}-${next ? "next" : "previous"}` testId=`${state.id}-${next ? "next" : "previous"}` type="button" appearance="none" disabled=true aria-label=label
      hatch="lenso-ui" data-lenso-kind="calendar-nav-button" data-slot="calendar-nav-button" data-lenso-next=next
      svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=1.5 aria-hidden=true hatch="lenso-ui" data-lenso-kind="calendar-nav-icon" data-lenso-direction=state.direction data-lenso-next=next
        path d=(next ? "m9 6 6 6-6 6" : "m15 6-6 6 6 6")

component CalendarGrid
  props
    state: CalendarState
    change: action
  state layout = ""
  action configure(next: string)
    layout = next
  view
    box role="grid" aria-labelledby=`${state.id}-heading` hatch="lenso-ui" data-lenso-kind="calendar-grid" data-slot="calendar-grid"
      box role="row" hatch="lenso-ui" data-lenso-kind="calendar-week" data-slot="calendar-week"
        for index in [0,1,2,3,4,5,6] key=index
          CalendarHeaderCell(index=index)
      if layout.length > 0
        for week in layout.split("~") key=week
          box role="row" hatch="lenso-ui" data-lenso-kind="calendar-week" data-slot="calendar-week"
            for date in week.split("|") key=date
              CalendarCell(state=state, date=date, change=change)
    input type="hidden" value="" input=configure hatch="lenso-ui" data-lenso-kind="calendar-request" data-slot="calendar-layout"

component CalendarHeaderCell
  props
    index: number
  view
    box role="columnheader" hatch="lenso-ui" data-lenso-kind="calendar-header-cell" data-slot="calendar-header-cell" data-lenso-index=index

component CalendarCell
  props
    state: CalendarState
    date: string
    change: action
  action select(pressed: bool)
    if not state.disabled and not state.readOnly and state.selectionMode != "none"
      if state.selectionMode == "multiple"
        change(state.value.includes(date) ? state.value.filter(value => value != date) : state.value.concat([date]))
      else
        change([date])
  view
    box role="gridcell" aria-selected=state.value.includes(date) hatch="lenso-ui" data-lenso-kind="calendar-cell-container" data-slot="calendar-cell-container"
      StyledCalendarDay(id=`${state.id}-day-${date}`, date=date, label=date, pressed=state.value.includes(date), disabled=true, change=select)
        box aria-hidden=true hatch="lenso-ui" data-lenso-kind="calendar-day-label" data-slot="calendar-day-label"
