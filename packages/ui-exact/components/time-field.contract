use DateFieldState, DateFieldLabel, DateFieldDescription, DateFieldError, DateInputGroupInput, DateInputGroupRootModel from "./date-field.contract"

shape TimeFieldState
  id: string
  label: string
  description: string
  error: string
  value: string
  placeholder: string
  locale: string
  hourCycle: string
  granularity: string
  min: string
  max: string
  disabled: bool
  readOnly: bool
  required: bool
  invalid: bool
  direction: string
  variant: string
  fullWidth: bool
  name: string
  form: string

fn timeDateState(state: TimeFieldState): DateFieldState = DateFieldState(id=state.id, label=state.label, description=state.description, error=state.error, value=state.value, placeholder=state.placeholder, locale=state.locale, min=state.min, max=state.max, disabled=state.disabled, readOnly=state.readOnly, required=state.required, invalid=state.invalid, direction=state.direction, variant=state.variant, fullWidth=state.fullWidth, name=state.name, form=state.form, calendar="")

component TimeField
  props
    state: TimeFieldState
    change: action
  view
    TimeFieldRoot(state=state)
      TimeFieldLabel(state=state)
      TimeFieldInput(state=state, change=change)
      TimeFieldDescription(state=state)
      TimeFieldError(state=state)

component TimeFieldRoot
  props
    state: TimeFieldState
  slot
  view
    box id=state.id testId=state.id hatch="lenso-ui" data-lenso-kind="time-field" data-slot="time-field" data-lenso-full-width=state.fullWidth data-lenso-disabled=state.disabled data-lenso-invalid=state.invalid
      children

component TimeFieldInput
  props
    state: TimeFieldState
    change: action
  derive field = timeDateState(state)
  view
    DateInputGroupRootModel(state=field, time=true, hourCycle=state.hourCycle, granularity=state.granularity)
      DateInputGroupInput(state=field, change=change)

component TimeFieldLabel
  props
    state: TimeFieldState
  view
    DateFieldLabel(state=timeDateState(state))

component TimeFieldDescription
  props
    state: TimeFieldState
  view
    DateFieldDescription(state=timeDateState(state))

component TimeFieldError
  props
    state: TimeFieldState
  view
    DateFieldError(state=timeDateState(state))

