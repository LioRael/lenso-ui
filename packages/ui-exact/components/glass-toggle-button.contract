use StyledGlassToggleButton from "./generated/glass-toggle-button.contract"
use StyledGlassToggleButtonGroupItem from "./generated/glass-toggle-group-item.contract"
use ToggleButtonGroupState from "./toggle.contract"

component GlassToggleButton
  props
    id: string
    label: string
    pressed: bool
    change: action
    disabled: bool
    size: string
    variant: string
    iconOnly: bool
    fullWidth: bool
    tint: string
    elastic: bool
  slot
  view
    StyledGlassToggleButton(id=id, label=label, pressed=pressed, change=change, disabled=disabled, size=size, variant=variant, iconOnly=iconOnly, fullWidth=fullWidth, tint=tint, elastic=elastic)
      children

component GlassToggleButtonIcon
  slot
  view
    box aria-hidden=true hatch="lenso-ui" data-lenso-kind="glass-toggle-button-icon" data-slot="glass-button-icon"
      children

component GlassToggleButtonGroupItem
  props
    state: ToggleButtonGroupState
    id: string
    value: string
    label: string
    disabled: bool
    iconOnly: bool
    tint: string
    elastic: bool
    change: action
  derive pressed = state.value.includes(value)
  action toggle(next: bool)
    if not disabled and not state.disabled
      if not next
        change(state.value.filter(entry => entry != value))
      else
        change(state.multiple ? state.value.concat([value]) : [value])
  slot
  view
    StyledGlassToggleButtonGroupItem(id=id, label=label, pressed=pressed, change=toggle, disabled=(state.disabled or disabled), size=state.size, variant=(state.variant == "prominent" ? "prominent" : "default"), fullWidth=state.fullWidth, iconOnly=iconOnly, orientation=state.orientation, detached=state.detached, tint=tint, elastic=elastic)
      children
