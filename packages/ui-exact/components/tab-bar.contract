use StyledTabBarLink from "./generated/tab-bar-link.contract"

shape TabBarState
  id: string
  label: string
  layout: string
  direction: string
  elastic: bool
  lift: number
  minimized: bool
  autoMinimize: string
  scrollTarget: string
  expandLabel: string

component TabBarRoot
  props
    state: TabBarState
    minimize: action
    activate: action
  action requestMinimize(value: string)
    minimize(value == "true")
  action requestActivate(value: string)
    activate(value)
  slot
  view
    box id=state.id testId=state.id role="navigation" aria-label=state.label direction=state.direction
      hatch="lenso-ui" data-lenso-kind="tab-bar" data-slot="tab-bar" data-layout=state.layout data-lenso-direction=state.direction data-lenso-elastic=state.elastic data-lenso-lift=state.lift data-lenso-minimized=state.minimized data-lenso-auto-minimize=state.autoMinimize data-lenso-scrollport=state.scrollTarget
      children
      input type="hidden" value="" input=requestMinimize hatch="lenso-ui" data-lenso-kind="select-reset" data-slot="tab-bar-minimize-request"
      input type="hidden" value="" input=requestActivate hatch="lenso-ui" data-lenso-kind="select-reset" data-slot="tab-bar-activate-request"

component TabBarGroup
  props
    state: TabBarState
    id: string
    separate: bool
    minimize: action
  action expand
    minimize(false)
  slot
  view
    box id=id testId=id hatch="lenso-ui" data-lenso-kind="tab-bar-group" data-slot="tab-bar-group" data-tab-bar-group="" data-layout=state.layout data-lenso-separate=separate data-lenso-elastic=state.elastic data-lenso-minimized=state.minimized
      box aria-hidden=true hatch="lenso-ui" data-lenso-kind="tab-bar-material" data-slot="tab-bar-material" data-material="glass-small" data-material-resting="" data-layout=state.layout
        box hatch="lenso-ui" data-lenso-kind="tab-bar-lens" data-material-lens=""
      if not separate
        box aria-hidden=true inert=true hatch="lenso-ui" data-lenso-kind="tab-bar-indicator" data-slot="tab-bar-indicator"
          box hatch="lenso-ui" data-lenso-kind="tab-bar-refraction" data-slot="tab-bar-refraction"
            box hatch="lenso-ui" data-lenso-kind="tabs-knob-lens" data-knob-material="toggle"
            box hatch="lenso-ui" data-lenso-kind="tabs-knob-face"
        box aria-hidden=true inert=true hatch="lenso-ui" data-lenso-kind="tab-bar-highlight" data-slot="tab-bar-highlight"
          box hatch="lenso-ui" data-lenso-kind="tab-bar-highlight-clip" data-slot="tab-bar-highlight-ring"
            box hatch="lenso-ui" data-lenso-kind="tab-bar-highlight-optics" data-slot="tab-bar-highlight-optics"
              box hatch="lenso-ui" data-lenso-kind="tab-bar-highlight-row" data-slot="tab-bar-highlight-row"
          box hatch="lenso-ui" data-lenso-kind="tab-bar-highlight-clip" data-slot="tab-bar-highlight-centre"
            box hatch="lenso-ui" data-lenso-kind="tab-bar-highlight-row" data-slot="tab-bar-highlight-centre-row"
      box id=`${id}-list` testId=`${id}-list` role="list" aria-hidden=(state.minimized and not separate) inert=(state.minimized and not separate) hatch="lenso-ui" data-lenso-kind="tab-bar-list" data-slot="tab-bar-list" data-tab-bar-list="" data-layout=state.layout data-lenso-separate=separate
        children
      if not separate and state.minimized
        button id=`${id}-expand` testId=`${id}-expand` type="button" appearance="none" aria-label=state.expandLabel aria-expanded=false aria-controls=`${id}-list` press=expand
          hatch="lenso-ui" data-lenso-kind="tab-bar-expand" data-slot="tab-bar-expand" data-tab-bar-expand=""
          text "⋯" aria-hidden=true hatch="lenso-ui" data-lenso-kind="tab-bar-expand-fallback"

component TabBarLink
  props
    state: TabBarState
    id: string
    value: string
    label: string
    href: string
    current: bool
    disabled: bool
    separate: bool
    iconOnly: bool
    hasIcon: bool
  slot
  view
    box role="listitem" hatch="lenso-ui" data-lenso-kind="tab-bar-item-container" data-layout=state.layout data-lenso-separate=separate
      StyledTabBarLink(id=id, label=label, href=href, value=value, disabled=disabled, current=current, hasIcon=hasIcon, iconOnly=iconOnly, layout=state.layout)
        if current
          box aria-hidden=true hatch="lenso-ui" data-lenso-kind="tab-bar-fallback" data-tab-bar-fallback="" data-layout=state.layout
        children

component TabBarButton
  props
    state: TabBarState
    id: string
    label: string
    disabled: bool
    separate: bool
    iconOnly: bool
    hasIcon: bool
    press: action
  slot
  view
    box role="listitem" hatch="lenso-ui" data-lenso-kind="tab-bar-item-container" data-layout=state.layout data-lenso-separate=separate
      button id=id testId=id type="button" appearance="none" aria-label=label disabled=disabled press=press
        hatch="lenso-ui" data-lenso-kind="tab-bar-button" data-slot="tab-bar-button" data-tab-bar-item="" data-layout=state.layout data-lenso-icon-only=iconOnly data-lenso-has-icon=hasIcon data-lenso-disabled=disabled
        children

component TabBarIcon
  props
    state: TabBarState
    iconOnly: bool
  slot
  view
    box aria-hidden=true hatch="lenso-ui" data-lenso-kind="tab-bar-icon" data-slot="tab-bar-icon" data-tab-bar-content="" data-layout=state.layout data-lenso-icon-only=iconOnly
      children

component TabBarLabel
  props
    iconOnly: bool
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="tab-bar-label" data-slot="tab-bar-label" data-tab-bar-content="" data-lenso-icon-only=iconOnly
      children

component TabBar
  props
    state: TabBarState
    minimize: action
    activate: action
  slot
  view
    TabBarRoot(state=state, minimize=minimize, activate=activate)
      children
