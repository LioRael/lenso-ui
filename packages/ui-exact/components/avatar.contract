shape AvatarState
  id: string
  label: string
  size: string
  color: string
  variant: string

component Avatar
  props
    state: AvatarState
  slot
  view
    box id=state.id testId=state.id role="img" aria-label=state.label hatch="lenso-ui" data-lenso-kind="avatar" data-slot="avatar" data-lenso-size=state.size data-lenso-color=state.color data-lenso-variant=state.variant
      children

component AvatarImage
  props
    src: string
  view
    image src alt="" aria-hidden=true hatch="lenso-ui" data-lenso-kind="avatar-image" data-slot="avatar-image"

component AvatarFallback
  props
    state: AvatarState
    clipped: bool
  slot
  view
    box aria-hidden=true hatch="lenso-ui" data-lenso-kind="avatar-fallback" data-slot="avatar-fallback" data-lenso-size=state.size data-lenso-color=state.color data-lenso-variant=state.variant data-lenso-clipped=clipped
      children

component AvatarGroup
  props
    id: string
    label: string
    grid: bool
  slot
  view
    row id=id testId=id role="group" aria-label=label hatch="lenso-ui" data-lenso-kind="avatar-group" data-slot="avatar-group" data-lenso-grid=grid
      children

component AvatarGroupItem
  props
    size: string
    overlap: bool
    ring: bool
    clipped: bool
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="avatar-group-item" data-lenso-size=size data-lenso-overlap=overlap data-lenso-ring=ring data-lenso-clipped=clipped
      children
