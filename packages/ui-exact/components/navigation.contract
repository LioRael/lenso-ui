use StyledLink from "./generated/link.contract"

component Link
  props
    id: string
    href: string
    target: string
    label: string
    disabled: bool
  slot
  view
    StyledLink(id=id, label=label, href=href, target=target, disabled=disabled)
      children

component LinkIcon
  slot
  view
    box aria-hidden=true hatch="lenso-ui" data-lenso-kind="link-icon" data-slot="link-icon"
      children

component LinkArrow
  view
    box aria-hidden=true hatch="lenso-ui" data-lenso-kind="link-arrow" data-slot="link-icon"
      svg width="100%" height="100%" viewBox="0 0 16 16" fill="none"
        path d="M5 3h8v8M13 3 3 13" stroke="currentColor" stroke-width=1.5 stroke-linecap="round" stroke-linejoin="round"

shape BreadcrumbsState
  id: string
  label: string
  disabled: bool
  direction: string

component Breadcrumbs
  props
    state: BreadcrumbsState
  slot
  view
    box id=state.id testId=state.id role="navigation" aria-label=state.label direction=state.direction
      data-slot="breadcrumbs-nav" data-lenso-direction=state.direction
      row role="list" hatch="lenso-ui" data-lenso-kind="breadcrumbs" data-slot="breadcrumbs"
        children

component BreadcrumbsItem
  slot
  view
    row role="listitem" hatch="lenso-ui" data-lenso-kind="breadcrumbs-item" data-slot="breadcrumbs-item"
      children

component BreadcrumbsLink
  props
    state: BreadcrumbsState
    id: string
    href: string
    target: string
    label: string
    current: bool
    disabled: bool
  slot
  view
    link id=id testId=id href=((state.disabled or disabled) ? "" : href) target=target role="link"
      aria-label=label aria-current=(current ? "page" : "false")
      aria-disabled=(state.disabled or disabled) tabindex=((state.disabled or disabled) ? -1 : 0)
      hatch="lenso-ui" data-lenso-kind="breadcrumbs-link" data-slot="link" data-lenso-current=current
      children

component BreadcrumbsSeparator
  slot
  view
    box aria-hidden=true hatch="lenso-ui" data-lenso-kind="breadcrumbs-separator" data-slot="breadcrumbs-separator"
      children

component BreadcrumbsChevron
  view
    svg aria-hidden=true hatch="lenso-ui" data-lenso-kind="breadcrumbs-chevron" data-slot="breadcrumbs-separator"
      viewBox="0 0 12 12" fill="none"
      path d="m4.5 3 3 3-3 3" stroke="currentColor" stroke-width=1.5 stroke-linecap="round" stroke-linejoin="round"

component Separator
  props
    id: string
    orientation: string
    variant: string
    decorative: bool
  view
    box id=id testId=id role=(decorative ? "presentation" : "separator")
      aria-orientation=orientation aria-hidden=decorative
      hatch="lenso-ui" data-lenso-kind="separator" data-slot="separator"
      data-orientation=orientation data-lenso-variant=variant
