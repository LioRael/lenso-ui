component StyledAccordionTrigger
  props
    state: AccordionState
    item: AccordionItemState
    change: action
  derive expanded = state.value.includes(item.value)
  action toggle
    if not state.disabled and not item.disabled
      if expanded
        change(state.value.filter(value => value != item.value))
      else
        change(state.multiple ? state.value.concat([item.value]) : [item.value])
  slot
  view
    button id=`${item.id}-trigger` testId=`${item.id}-trigger`
      aria-expanded=expanded aria-controls=`${item.id}-content` disabled=(state.disabled or item.disabled) press=toggle appearance="none" tabindex=0 hatch="lenso-ui" data-lenso-kind="accordion-trigger" data-slot="accordion-trigger" data-lenso-panel-open=expanded data-lenso-variant=state.variant
      children
