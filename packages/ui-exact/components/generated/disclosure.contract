component StyledDisclosureTrigger
  props
    state: DisclosureState
    change: action
  slot
  view
    button id=`${state.id}-trigger` testId=`${state.id}-trigger`
      aria-expanded=state.open aria-controls=`${state.id}-content` disabled=state.disabled
      press=change(not state.open) appearance="none" tabindex=0 hatch="lenso-ui" data-lenso-kind="disclosure-trigger" data-slot="disclosure-trigger" data-lenso-panel-open=state.open
      children

