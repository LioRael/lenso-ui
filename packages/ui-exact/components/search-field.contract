shape SearchFieldState
  id: string
  name: string
  label: string
  labelledBy: string
  describedBy: string
  value: string
  placeholder: string
  autocomplete: string
  variant: string
  fullWidth: bool
  disabled: bool
  readOnly: bool
  required: bool
  invalid: bool

component SearchFieldRoot
  props
    state: SearchFieldState
  slot
  view
    column id=state.id testId=state.id hatch="lenso-ui" data-lenso-kind="search-field" data-slot="search-field"
      data-lenso-full-width=state.fullWidth data-lenso-invalid=state.invalid data-lenso-disabled=state.disabled
      children

component SearchFieldGroup
  props
    state: SearchFieldState
  slot
  view
    row id=`${state.id}-group` testId=`${state.id}-group` hatch="lenso-ui" data-lenso-kind="search-field-group" data-slot="search-field-group"
      data-material="glass-small" data-lenso-variant=state.variant data-lenso-full-width=state.fullWidth data-lenso-disabled=state.disabled
      children

component SearchFieldInput
  props
    state: SearchFieldState
    input: action
    change: action
    submit: action
  view
    input type="search" id=`${state.id}-input` testId=`${state.id}-input` data-lenso-name=state.name value=state.value
      input=input change=change submit=submit placeholder=state.placeholder autocomplete=state.autocomplete
      aria-label=state.label aria-labelledby=state.labelledBy aria-describedby=state.describedBy
      disabled=state.disabled readonly=state.readOnly data-lenso-required=state.required aria-required=state.required aria-invalid=state.invalid
      hatch="lenso-ui" data-lenso-kind="search-field-input" data-slot="search-field-input" data-lenso-invalid=state.invalid

component SearchFieldSearchIcon
  view
    svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width=1.5 stroke-linecap="round" aria-hidden=true
      hatch="lenso-ui" data-lenso-kind="search-field-icon" data-slot="search-field-search-icon"
      circle cx=7 cy=7 r=4.75
      path d="m10.5 10.5 3.25 3.25"

component SearchFieldClearIcon
  view
    svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width=1.5 stroke-linecap="round" aria-hidden=true
      hatch="lenso-ui" data-lenso-kind="search-field-clear-icon"
      path d="m4.5 4.5 7 7m0-7-7 7"

component SearchFieldClearButton
  props
    state: SearchFieldState
    label: string
  slot
  view
    button appearance="none" type="button" id=`${state.id}-clear` testId=`${state.id}-clear` aria-label=label tabindex=0
      disabled=(state.disabled or state.value == "") hatch="lenso-ui" data-lenso-kind="search-field-clear" data-slot="search-field-clear-button"
      children

component SearchField
  props
    state: SearchFieldState
    input: action
    change: action
    submit: action
    clearLabel: string
  view
    SearchFieldRoot(state=state)
      SearchFieldGroup(state=state)
        SearchFieldSearchIcon()
        SearchFieldInput(state=state, input=input, change=change, submit=submit)
        SearchFieldClearButton(state=state, label=clearLabel)
          SearchFieldClearIcon()
