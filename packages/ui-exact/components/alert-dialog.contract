use StyledAlertRoot, StyledAlertTrigger, StyledAlertClose, StyledAlertCloseIcon from "./generated/dialog-parts.contract"

shape AlertDialogState
  id: string
  label: string
  labelledBy: string
  describedBy: string
  size: string
  placement: string
  backdrop: string

component AlertDialog
  props
    state: AlertDialogState
  slot
  view
    StyledAlertRoot(id=state.id, label=state.label, description=state.describedBy, labelledBy=state.labelledBy)
      children

component AlertDialogBackdrop
  props
    state: AlertDialogState
  view
    box aria-hidden=true hatch="lenso-ui" data-lenso-kind="alert-dialog-backdrop" data-slot="alert-dialog-backdrop" data-lenso-variant=state.backdrop

component AlertDialogViewport
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="alert-dialog-viewport" data-slot="alert-dialog-viewport"
      children

component AlertDialogPopup
  props
    state: AlertDialogState
  slot
  view
    column id=`${state.id}-popup` testId=`${state.id}-popup` hatch="lenso-ui" data-lenso-kind="alert-dialog-popup"
      data-slot="alert-dialog-popup" data-material="glass-medium" data-size=state.size data-placement=state.placement
      box aria-hidden=true hatch="lenso-ui" data-lenso-kind="alert-dialog-lens" data-material-lens=""
      children

component AlertDialogHeader
  slot
  view
    column hatch="lenso-ui" data-lenso-kind="alert-dialog-header" data-slot="alert-dialog-header"
      children

component AlertDialogTitle
  props
    id: string
    level: number
  slot
  view
    box id=id role="heading" aria-level=level hatch="lenso-ui" data-lenso-kind="alert-dialog-title" data-slot="alert-dialog-title"
      children

component AlertDialogDescription
  props
    id: string
  slot
  view
    box id=id hatch="lenso-ui" data-lenso-kind="alert-dialog-description" data-slot="alert-dialog-description"
      children

component AlertDialogBody
  slot
  view
    column hatch="lenso-ui" data-lenso-kind="alert-dialog-body" data-slot="alert-dialog-body"
      children

component AlertDialogFields
  slot
  view
    column hatch="lenso-ui" data-lenso-kind="alert-dialog-fields" data-slot="alert-dialog-fields"
      children

component AlertDialogFooter
  props
    layout: string
  slot
  view
    row hatch="lenso-ui" data-lenso-kind="alert-dialog-footer" data-slot="alert-dialog-footer" data-layout=layout
      children

component AlertDialogIcon
  props
    variant: string
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="alert-dialog-icon" data-slot="alert-dialog-icon" data-lenso-variant=variant
      children

component AlertDialogTrigger
  props
    id: string
    label: string
    target: string
    disabled: bool
    size: string
    variant: string
  slot
  view
    StyledAlertTrigger(id=id, label=label, target=target, disabled=disabled, size=size, variant=variant)
      children

component AlertDialogClose
  props
    id: string
    label: string
    target: string
    disabled: bool
    initialFocus: bool
  slot
  view
    StyledAlertClose(id=id, label=label, target=target, disabled=disabled, initialFocus=initialFocus)
      children

component AlertDialogAction
  props
    id: string
    label: string
    press: action
    disabled: bool
    variant: string
  slot
  view
    button id=id testId=id appearance="none" tabindex=0 aria-label=label disabled=disabled press=press
      hatch="lenso-ui" data-lenso-kind="alert-dialog-action" data-slot="alert-dialog-action" data-variant=variant
      children

component AlertDialogCloseIcon
  props
    id: string
    label: string
    target: string
    disabled: bool
  view
    StyledAlertCloseIcon(id=id, label=label, target=target, disabled=disabled)
      svg viewBox="0 0 16 16" fill="none" aria-hidden=true hatch="lenso-ui" data-lenso-kind="modal-close-glyph"
        path d="m4 4 8 8M12 4l-8 8" stroke="currentColor" stroke-width=1.5 stroke-linecap="round"

component AlertDialogDefaultIcon
  props
    variant: string
  view
    svg viewBox="0 0 16 16" width=20 height=20 fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" aria-hidden=true data-slot="alert-dialog-default-icon"
      if variant == "success"
        path d="M13.5 8a5.5 5.5 0 1 1-11 0a5.5 5.5 0 0 1 11 0M15 8A7 7 0 1 1 1 8a7 7 0 0 1 14 0m-3.9-1.55a.75.75 0 1 0-1.2-.9L7.419 8.858L6.03 7.47a.75.75 0 0 0-1.06 1.06l2 2a.75.75 0 0 0 1.13-.08z"
      else if variant == "warning"
        path d="M7.134 2.994L2.217 11.5a1 1 0 0 0 .866 1.5h9.834a1 1 0 0 0 .866-1.5L8.866 2.993a1 1 0 0 0-1.732 0m3.03-.75c-.962-1.665-3.366-1.665-4.329 0L.918 10.749c-.963 1.666.24 3.751 2.165 3.751h9.834c1.925 0 3.128-2.085 2.164-3.751zM8 5a.75.75 0 0 1 .75.75v2a.75.75 0 0 1-1.5 0v-2A.75.75 0 0 1 8 5m1 5.75a1 1 0 1 1-2 0a1 1 0 0 1 2 0"
      else if variant == "danger"
        path d="M8 13.5a5.5 5.5 0 1 0 0-11a5.5 5.5 0 0 0 0 11M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14m1-4.5a1 1 0 1 1-2 0a1 1 0 0 1 2 0M8.75 5a.75.75 0 0 0-1.5 0v2.5a.75.75 0 0 0 1.5 0z"
      else
        path d="M8 13.5a5.5 5.5 0 1 0 0-11a5.5 5.5 0 0 0 0 11M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14m1-9.5a1 1 0 1 1-2 0a1 1 0 0 1 2 0m-.25 3a.75.75 0 0 0-1.5 0V11a.75.75 0 0 0 1.5 0z"
