shape TooltipState
  id: string
  side: string
  align: string
  direction: string
  sideOffset: number
  alignOffset: number
  collisionPadding: number
  collisionAvoidance: bool
  disableAnchorTracking: bool
  disableHoverablePopup: bool

component TooltipProvider
  props
    delay: number
    closeDelay: number
    timeout: number
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="tooltip-provider" data-slot="tooltip-provider"
      data-lenso-hover-delay=delay data-lenso-close-delay=closeDelay data-lenso-timeout=timeout
      children

component Tooltip
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="tooltip-root" data-slot="tooltip-root"
      children

component TooltipTrigger
  props
    id: string
    target: string
    label: string
    press: action
    disabled: bool
    delay: number
    closeDelay: number
    closeOnClick: bool
  slot
  view
    button id=id testId=id appearance="none" tabindex=0 aria-label=label press=press
      hatch="lenso-ui" data-lenso-kind="tooltip-trigger" data-slot="tooltip-trigger"
      data-lenso-for=target data-lenso-disabled=disabled data-lenso-hover-delay=delay
      data-lenso-close-delay=closeDelay data-lenso-close-on-click=closeOnClick
      children

component TooltipPortal
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="tooltip-portal" data-slot="tooltip-portal"
      children

component TooltipPositioner
  props
    state: TooltipState
  slot
  view
    box id=state.id testId=state.id popover="manual" role="presentation"
      hatch="lenso-ui" data-lenso-kind="tooltip-positioner" data-slot="tooltip-positioner"
      data-lenso-side=state.side data-lenso-align=state.align data-lenso-direction=state.direction
      data-lenso-side-offset=state.sideOffset data-lenso-align-offset=state.alignOffset
      data-lenso-collision-padding=state.collisionPadding data-lenso-collision-avoidance=state.collisionAvoidance
      data-lenso-disable-anchor-tracking=state.disableAnchorTracking data-lenso-disable-hoverable-popup=state.disableHoverablePopup
      children

component TooltipPopup
  props
    state: TooltipState
  slot
  view
    box id=`${state.id}-popup` testId=`${state.id}-popup` role="tooltip"
      hatch="lenso-ui" data-lenso-kind="tooltip-popup" data-slot="tooltip-popup"
      data-direction=state.direction data-material="thick"
      box aria-hidden=true hatch="lenso-ui" data-lenso-kind="tooltip-material" data-slot="tooltip-material"
        box aria-hidden=true hatch="lenso-ui" data-lenso-kind="tooltip-paint-blur"
        box aria-hidden=true hatch="lenso-ui" data-lenso-kind="tooltip-paint-upper"
        box aria-hidden=true hatch="lenso-ui" data-lenso-kind="tooltip-paint-lower"
      children

component TooltipArrow
  props
    state: TooltipState
  view
    box aria-hidden=true hatch="lenso-ui" data-lenso-kind="tooltip-arrow" data-slot="tooltip-arrow"
      data-side=state.side data-direction=state.direction
      box aria-hidden=true hatch="lenso-ui" data-lenso-kind="tooltip-arrow-material" data-slot="tooltip-arrow-material"

component TooltipViewport
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="tooltip-viewport" data-slot="tooltip-viewport"
      children
