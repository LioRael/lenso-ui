use StyledCalendarYearPickerTrigger from "./generated/calendar-year-trigger.contract"
use StyledCalendarYearPickerCell from "./generated/calendar-year-cell.contract"
use CalendarState from "./calendar.contract"

shape CalendarYearPickerState
  id: string
  open: bool
  visibleYears: number

component CalendarYearPickerTrigger
  props
    calendar: CalendarState
    state: CalendarYearPickerState
    change: action
  view
    StyledCalendarYearPickerTrigger(id=`${state.id}-trigger`, label="Choose year", pressed=state.open, disabled=calendar.disabled, target=`${state.id}-grid`, change=change)
      CalendarYearPickerTriggerHeading(calendar=calendar)
      CalendarYearPickerTriggerIndicator(open=state.open)

component CalendarYearPickerTriggerHeading
  props
    calendar: CalendarState
  view
    box id=`${calendar.id}-heading` hatch="lenso-ui" data-lenso-kind="calendar-year-picker-heading" data-slot="calendar-heading"

component CalendarYearPickerTriggerIndicator
  props
    open: bool
  view
    box aria-hidden=true hatch="lenso-ui" data-lenso-kind="calendar-year-picker-indicator" data-slot="calendar-year-picker-trigger-indicator" data-lenso-open=open
      svg viewBox="0 0 24 24" width=13 height=13 fill="none" stroke="currentColor" stroke-width=1.5
        path d="m9 6 6 6-6 6"

component CalendarYearPickerGrid
  props
    state: CalendarYearPickerState
    change: action
  state layout = ""
  action configure(next: string)
    layout = next
  action request(value: string)
    change(value == "true")
  view
    box id=`${state.id}-grid` testId=`${state.id}-grid` role="group" aria-label="Year" aria-hidden=(not state.open) inert=(not state.open)
      hatch="lenso-ui" data-lenso-kind="calendar-year-picker-grid" data-slot="calendar-year-picker-grid" data-lenso-open=state.open data-lenso-visible-years=state.visibleYears
      if layout.length > 0
        for date in layout.split("|") key=date
          CalendarYearPickerCell(id=state.id, date=date, change=change)
    input type="hidden" value="" input=configure hatch="lenso-ui" data-lenso-kind="calendar-request" data-slot="calendar-year-layout"
    input type="hidden" value="" input=request hatch="lenso-ui" data-lenso-kind="calendar-request" data-slot="calendar-year-open-request"

component CalendarYearPickerCell
  props
    id: string
    date: string
    change: action
  action noChange(value: bool)
    if false
      change(value)
  view
    StyledCalendarYearPickerCell(id=`${id}-year-${date}`, date=date, label=date, pressed=false, disabled=true, change=noChange)
      box aria-hidden=true hatch="lenso-ui" data-lenso-kind="calendar-day-label" data-slot="calendar-year-label"
