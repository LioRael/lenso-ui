use StyledComboBoxInput from "./generated/combo-box-input.contract"
use StyledComboBoxPositioner, StyledComboBoxTrigger, StyledComboBoxItem from "./generated/combo-box-parts.contract"
use Label from "./forms.contract"

shape ComboBoxState
  id: string
  label: string
  labelledBy: string
  describedBy: string
  value: string[]
  inputValue: string
  defaultValue: string[]
  defaultInputValue: string
  multiple: bool
  disabled: bool
  readOnly: bool
  required: bool
  invalid: bool
  name: string
  form: string
  placeholder: string
  variant: string
  fullWidth: bool
  direction: string
  filter: string
  locale: string
  autoHighlight: bool
  loop: bool
  side: string
  align: string
  sideOffset: number
  collisionPadding: number

shape ComboBoxOption
  value: string
  label: string
  disabled: bool

fn comboBoxLabel(options: ComboBoxOption[], value: string): string = match first(options.filter(item => item.value == value)) { case some(item) => item.label, case none => value }

component ComboBoxRoot
  props
    state: ComboBoxState
    options: ComboBoxOption[]
    change: action
  derive closedText = state.multiple ? "" : (match first(state.value) { case some(value) => comboBoxLabel(options, value), case none => "" })
  action restore(text: string)
    if not state.disabled and not state.readOnly and state.inputValue != closedText
      change(state.value, closedText)
  action inputCleared(text: string)
    if not state.disabled and not state.readOnly and state.value.length > 0
      change([], "")
  action reset(text: string)
    change(state.defaultValue, state.defaultInputValue)
  slot
  view
    box id=state.id testId=state.id direction=state.direction hatch="lenso-ui" data-lenso-kind="combo-box-root" data-slot="combo-box-root"
      data-lenso-value=state.inputValue data-lenso-multiple=state.multiple data-lenso-disabled=state.disabled data-lenso-readonly=state.readOnly data-lenso-full-width=state.fullWidth data-lenso-variant=state.variant data-lenso-direction=state.direction data-lenso-filter=state.filter data-lenso-locale=state.locale data-lenso-activate-on-focus=state.autoHighlight data-lenso-loop=state.loop
      children
      input type="hidden" value="" input=restore hatch="lenso-ui" data-lenso-kind="select-reset" data-slot="combo-box-restore"
      input type="hidden" value="" input=inputCleared hatch="lenso-ui" data-lenso-kind="select-reset" data-slot="combo-box-input-clear"
      input type="hidden" value="" input=reset hatch="lenso-ui" data-lenso-kind="select-reset" data-slot="combo-box-reset"
      input type="text" value=(state.value.length > 0 ? "1" : "") disabled=state.disabled tabindex=-1 aria-hidden=true
        hatch="lenso-ui" data-lenso-kind="select-validity" data-slot="combo-box-validity" data-lenso-required=state.required data-lenso-form=state.form
      for value in state.value key=value
        input type="hidden" value=value disabled=state.disabled hatch="lenso-ui" data-lenso-kind="select-form" data-slot="combo-box-form" data-lenso-name=state.name data-lenso-form=state.form

component ComboBoxLabel
  props
    state: ComboBoxState
  view
    Label(id=`${state.id}-label`, controlId=`${state.id}-input`, label=state.label, required=state.required)

component ComboBoxInputGroup
  props
    state: ComboBoxState
  slot
  view
    box id=`${state.id}-field` testId=`${state.id}-field` hatch="lenso-ui" data-lenso-kind="combo-box-input-group" data-slot="combo-box-input-group" data-lenso-variant=state.variant data-lenso-full-width=state.fullWidth
      children

component ComboBoxInput
  props
    state: ComboBoxState
    input: action
  action edited(value: string)
    if not state.disabled and not state.readOnly
      input(value)
  action noChange(value: string)
    if false
      input(value)
  view
    StyledComboBoxInput(id=`${state.id}-input`, label=state.label, description=state.describedBy, value=state.inputValue, type="text", placeholder=state.placeholder, disabled=state.disabled, readOnly=state.readOnly, invalid=state.invalid, input=edited, change=noChange, listId=`${state.id}-list`, name="", labelledBy=state.labelledBy, autocomplete="off", required=state.required, variant=state.variant)

component ComboBoxTrigger
  props
    state: ComboBoxState
    label: string
  slot
  view
    StyledComboBoxTrigger(id=`${state.id}-trigger`, label=label, target=`${state.id}-popup`, disabled=(state.disabled or state.readOnly))
      children

component ComboBoxIndicator
  view
    svg width=16 height=16 viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width=1.5 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true hatch="lenso-ui" data-lenso-kind="combo-box-indicator" data-slot="combo-box-indicator"
      path d="m4 6 4 4 4-4"

component ComboBoxClearButton
  props
    state: ComboBoxState
    label: string
    change: action
  action clear
    if not state.disabled and not state.readOnly and (state.value.length > 0 or state.inputValue != "")
      change([], "")
  view
    button id=`${state.id}-clear` testId=`${state.id}-clear` appearance="none" type="button" tabindex=-1 aria-label=label disabled=(state.disabled or state.readOnly or (state.value.length == 0 and state.inputValue == "")) press=clear
      hatch="lenso-ui" data-lenso-kind="combo-box-clear" data-slot="combo-box-clear"
      svg width=12 height=12 viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width=1.5 stroke-linecap="round" aria-hidden=true
        path d="m3 3 6 6m0-6-6 6"

component ComboBoxPortal
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="combo-box-portal" data-slot="combo-box-portal"
      children

component ComboBoxPositioner
  props
    state: ComboBoxState
  slot
  view
    StyledComboBoxPositioner(id=`${state.id}-popup`, direction=state.direction, side=state.side, align=state.align, sideOffset=state.sideOffset, collisionPadding=state.collisionPadding)
      children

component ComboBoxPopover
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="combo-box-popover" data-slot="combo-box-popover"
      children

component ComboBoxList
  props
    state: ComboBoxState
  slot
  view
    box id=`${state.id}-list` testId=`${state.id}-list` role="listbox" aria-label=state.label aria-labelledby=state.labelledBy hatch="lenso-ui" data-lenso-kind="combo-box-list" data-slot="combo-box-list"
      children

component ComboBoxItem
  props
    state: ComboBoxState
    item: ComboBoxOption
    index: number
    change: action
  derive selected = state.value.includes(item.value)
  action choose
    if not state.disabled and not state.readOnly and not item.disabled
      if state.multiple
        change(selected ? state.value.filter(value => value != item.value) : state.value.concat([item.value]), "")
      else
        change([item.value], item.label)
  slot
  view
    StyledComboBoxItem(id=`${state.id}-option-${index}`, label=item.label, disabled=(state.disabled or item.disabled), press=choose, value=item.value, selected=selected)
      children

component ComboBoxItemText
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="combo-box-item-text" data-slot="combo-box-item-text"
      children

component ComboBoxItemIndicator
  props
    selected: bool
  view
    box aria-hidden=true hatch="lenso-ui" data-lenso-kind="combo-box-item-indicator" data-slot="combo-box-item-indicator" data-lenso-checked=selected
      svg width=12 height=12 viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
        path d="m2 6 2.5 2.5L10 3"

component ComboBoxGroup
  props
    id: string
    labelledBy: string
  slot
  view
    box id=id role="group" aria-labelledby=labelledBy hatch="lenso-ui" data-lenso-kind="combo-box-group" data-slot="combo-box-group"
      children

component ComboBoxGroupLabel
  props
    id: string
  slot
  view
    box id=id hatch="lenso-ui" data-lenso-kind="combo-box-group-label" data-slot="combo-box-group-label"
      children

component ComboBoxSeparator
  view
    box role="separator" hatch="lenso-ui" data-lenso-kind="combo-box-separator" data-slot="combo-box-separator"

component ComboBoxEmpty
  props
    id: string
    label: string
  view
    text label id=id testId=id hatch="lenso-ui" data-lenso-kind="combo-box-empty" data-slot="combo-box-empty"

component ComboBoxStatus
  props
    id: string
    label: string
  view
    text "" id=id testId=id role="status" aria-live="polite" aria-atomic=true hatch="lenso-ui" data-lenso-kind="combo-box-status" data-slot="combo-box-status" data-lenso-label=label

component ComboBoxChips
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="combo-box-chips" data-slot="combo-box-chips"
      children

component ComboBoxChip
  props
    id: string
    value: string
    label: string
  slot
  view
    box id=id testId=id tabindex=-1 aria-label=label hatch="lenso-ui" data-lenso-kind="combo-box-chip" data-slot="combo-box-chip" data-lenso-value=value
      children

component ComboBoxChipRemove
  props
    state: ComboBoxState
    id: string
    value: string
    label: string
    change: action
  action remove
    if not state.disabled and not state.readOnly
      change(state.value.filter(key => key != value), state.inputValue)
  view
    button id=id testId=id appearance="none" type="button" tabindex=-1 aria-label=label disabled=(state.disabled or state.readOnly) press=remove hatch="lenso-ui" data-lenso-kind="combo-box-chip-remove" data-slot="combo-box-chip-remove"
      svg width=10 height=10 viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width=1.5 stroke-linecap="round" aria-hidden=true
        path d="m3 3 6 6m0-6-6 6"

component ComboBox
  props
    state: ComboBoxState
    options: ComboBoxOption[]
    input: action
    change: action
    triggerLabel: string
    clearLabel: string
    emptyLabel: string
    statusLabel: string
  view
    ComboBoxRoot(state=state, options=options, change=change)
      ComboBoxLabel(state=state)
      ComboBoxInputGroup(state=state)
        ComboBoxInput(state=state, input=input)
        ComboBoxClearButton(state=state, label=clearLabel, change=change)
        ComboBoxTrigger(state=state, label=triggerLabel)
          ComboBoxIndicator()
      if state.multiple
        ComboBoxChips()
          for value, index in state.value key=value
            ComboBoxChip(id=`${state.id}-chip-${index}`, value=value, label=comboBoxLabel(options, value))
              text comboBoxLabel(options, value)
              ComboBoxChipRemove(state=state, id=`${state.id}-chip-remove-${index}`, value=value, label=`${clearLabel} ${comboBoxLabel(options, value)}`, change=change)
      ComboBoxPortal()
        ComboBoxPositioner(state=state)
          ComboBoxPopover()
            ComboBoxList(state=state)
              for item, index in options key=item.value
                ComboBoxItem(state=state, item=item, index=index, change=change)
                  ComboBoxItemText()
                    text item.label
                  ComboBoxItemIndicator(selected=state.value.includes(item.value))
            ComboBoxEmpty(id=`${state.id}-empty`, label=emptyLabel)
      ComboBoxStatus(id=`${state.id}-status`, label=statusLabel)
