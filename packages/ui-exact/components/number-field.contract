    NumericRoot(state=state, kind="stepper", change=change, commit=commit)
      children

component StepperGroup
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="stepper-group" data-slot="stepper-group"
      children
      box aria-hidden=true hatch="lenso-ui" data-lenso-kind="stepper-separator"

component StepperInput
  props
    state: NumberFieldState
    change: action
    commit: action
  view
    NumericInput(state=state, kind="stepper-input", change=change, commit=commit)

component StepperIncrementButton
  props
    state: NumberFieldState
    label: string
    disabled: bool
    change: action
    commit: action
  slot
  view
    NumericButton(state=state, kind="stepper-increment", direction=1, label=label, disabled=disabled, change=change, commit=commit)
      children

component StepperDecrementButton
  props
    state: NumberFieldState
    label: string
    disabled: bool
    change: action
    commit: action
  slot
  view
    NumericButton(state=state, kind="stepper-decrement", direction=-1, label=label, disabled=disabled, change=change, commit=commit)
      children

component NumberFieldScrubArea
  props
    state: NumberFieldState
    id: string
    direction: string
    pixelSensitivity: number
    teleportDistance: option<number>
  slot
  view
    box id=id testId=id role="presentation" hatch="lenso-ui" data-lenso-kind="number-scrub-area" data-slot="number-scrub-area"
      data-lenso-direction=direction data-lenso-pixel-sensitivity=pixelSensitivity data-lenso-teleport=numberFieldText(teleportDistance)
      children

component NumberFieldScrubAreaCursor
  props
    id: string
  slot
  view
    box id=id testId=id role="presentation" aria-hidden=true inert=true popover="manual" tabindex=-1
      hatch="lenso-ui" data-lenso-kind="number-scrub-cursor" data-slot="number-scrub-cursor"
      children
