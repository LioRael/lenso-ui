shape NumberFieldState
  id: string
  label: string
  labelledBy: string
  describedBy: string
  value: option<number>
  min: option<number>
  max: option<number>
  step: number
  largeStep: number
  smallStep: number
  snapOnStep: bool
  allowOutOfRange: bool
  allowWheelScrub: bool
  disabled: bool
  readOnly: bool
  required: bool
  invalid: bool
  name: string
  locale: string
  format: string
  variant: string
  fullWidth: bool
  direction: string

fn numberFieldText(value: option<number>): string = match value { case some(n) => `${n}`, case none => "" }
fn numberFieldAt(value: option<number>, fallback: number): number = match value { case some(n) => n, case none => fallback }
fn numberFieldMin(state: NumberFieldState): number = numberFieldAt(state.min, -9007199254740991)
fn numberFieldMax(state: NumberFieldState): number = numberFieldAt(state.max, 9007199254740991)
fn numberFieldNext(state: NumberFieldState, direction: number): number = min(numberFieldMax(state), max(numberFieldMin(state), match state.value { case some(n) => n + direction * state.step, case none => 0 }))
fn numberFieldBlocked(state: NumberFieldState, direction: number): bool = state.disabled or state.readOnly or (direction > 0 ? numberFieldAt(state.value, numberFieldMin(state) - 1) >= numberFieldMax(state) : numberFieldAt(state.value, numberFieldMax(state) + 1) <= numberFieldMin(state))

component NumericRoot
  props
    state: NumberFieldState
    kind: string
    change: action
    commit: action
  action propose(text: string)
    if not state.disabled and not state.readOnly
      change(parseNumber(text))
  action committed(text: string)
    if not state.disabled and not state.readOnly
      commit(parseNumber(text))
  slot
  view
    box id=state.id testId=state.id role="group" aria-label=state.label direction=state.direction
      hatch="lenso-ui" data-lenso-kind=kind data-slot=kind
      data-lenso-value=numberFieldText(state.value) data-lenso-min=numberFieldText(state.min) data-lenso-max=numberFieldText(state.max) data-lenso-step=state.step
      data-lenso-large-step=state.largeStep data-lenso-small-step=state.smallStep data-lenso-snap=state.snapOnStep
      data-lenso-out-of-range=state.allowOutOfRange data-lenso-wheel=state.allowWheelScrub
      data-lenso-disabled=state.disabled data-lenso-readonly=state.readOnly data-lenso-required=state.required data-lenso-invalid=state.invalid
      data-lenso-locale=state.locale data-lenso-format=state.format data-lenso-variant=state.variant data-lenso-full-width=state.fullWidth
      children
      input type="hidden" tabindex=-1 aria-hidden=true value=numberFieldText(state.value) input=propose disabled=state.disabled
        hatch="lenso-ui" data-lenso-kind="number-request" data-slot="number-change"
      input type="hidden" tabindex=-1 aria-hidden=true value=numberFieldText(state.value) input=committed disabled=state.disabled
        hatch="lenso-ui" data-lenso-kind="number-request" data-slot="number-commit"
      input type="hidden" tabindex=-1 aria-hidden=true value=numberFieldText(state.value) disabled=state.disabled data-lenso-name=state.name
        hatch="lenso-ui" data-lenso-kind="number-form" data-slot="number-form"

component NumberField
  props
    state: NumberFieldState
    change: action
    commit: action
  slot
  view
    NumericRoot(state=state, kind="number-field", change=change, commit=commit)
      children

component NumberFieldGroup
  props
    state: NumberFieldState
  slot
  view
    box id=`${state.id}-group` testId=`${state.id}-group` hatch="lenso-ui" data-lenso-kind="number-field-group" data-slot="number-field-group"
      data-lenso-variant=state.variant data-lenso-full-width=state.fullWidth data-lenso-disabled=state.disabled data-lenso-invalid=state.invalid
      children

component NumericInput
  props
    state: NumberFieldState
    kind: string
    change: action
    commit: action
  action edited(text: string)
    if not state.disabled and not state.readOnly
      change(parseNumber(text))
  action committed(text: string)
    if not state.disabled and not state.readOnly
      commit(parseNumber(text))
  view
    input id=`${state.id}-input` testId=`${state.id}-input` type="number" inputmode="decimal" value=numberFieldText(state.value) input=edited change=committed
      min=numberFieldMin(state) max=numberFieldMax(state) step=state.step disabled=state.disabled readonly=state.readOnly
      aria-label=state.label aria-labelledby=state.labelledBy aria-describedby=state.describedBy aria-invalid=state.invalid
      aria-required=state.required data-lenso-required=state.required
      hatch="lenso-ui" data-lenso-kind=kind data-slot="number-input" data-lenso-value=numberFieldText(state.value)

component NumberFieldInput
  props
    state: NumberFieldState
    change: action
    commit: action
  view
    NumericInput(state=state, kind="number-field-input", change=change, commit=commit)

component NumericButton
  props
    state: NumberFieldState
    kind: string
    direction: number
    label: string
    disabled: bool
    change: action
    commit: action
  action activate
    if not disabled and not numberFieldBlocked(state, direction)
      let next = numberFieldNext(state, direction)
      change(some(next))
      commit(some(next))
  slot
  view
    button id=`${state.id}-${direction > 0 ? "increment" : "decrement"}` testId=`${state.id}-${direction > 0 ? "increment" : "decrement"}` type="button" appearance="none" tabindex=-1
      aria-label=label aria-controls=`${state.id}-input` aria-disabled=(disabled or numberFieldBlocked(state, direction)) press=activate
      hatch="lenso-ui" data-lenso-kind=kind data-slot="number-button" data-lenso-direction=direction data-lenso-disabled=(disabled or numberFieldBlocked(state, direction)) data-lenso-own-disabled=disabled
      children

component NumberFieldIncrementButton
  props
    state: NumberFieldState
    label: string
    disabled: bool
    change: action
    commit: action
  slot
  view
    NumericButton(state=state, kind="number-field-increment", direction=1, label=label, disabled=disabled, change=change, commit=commit)
      children

component NumberFieldDecrementButton
  props
    state: NumberFieldState
    label: string
    disabled: bool
    change: action
    commit: action
  slot
  view
    NumericButton(state=state, kind="number-field-decrement", direction=-1, label=label, disabled=disabled, change=change, commit=commit)
      children

component Stepper
  props
    state: NumberFieldState
    change: action
    commit: action
  slot
