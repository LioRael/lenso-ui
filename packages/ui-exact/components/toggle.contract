use StyledToggleButton from "./generated/toggle-button.contract"
use StyledToggleButtonGroupItem from "./generated/toggle-group-item.contract"

component ToggleButton
  props
    id: string
    label: string
    pressed: bool
    change: action
    disabled: bool
    size: string
    variant: string
    iconOnly: bool
    fullWidth: bool
  slot
  view
    StyledToggleButton(id=id, label=label, pressed=pressed, disabled=disabled, change=change, size=size, variant=variant, iconOnly=iconOnly, fullWidth=fullWidth)
      children

component ToggleButtonIcon
  slot
  view
    box aria-hidden=true hatch="lenso-ui" data-lenso-kind="toggle-button-icon" data-slot="button-icon"
      children

shape ToggleButtonGroupState
  id: string
  label: string
  value: string[]
  multiple: bool
  disabled: bool
  size: string
  variant: string
  fullWidth: bool
  detached: bool
  orientation: string
  loopFocus: bool

component ToggleButtonGroup
  props
    state: ToggleButtonGroupState
  slot
  view
    box id=state.id testId=state.id role="group" aria-label=state.label aria-disabled=state.disabled
      hatch="lenso-ui" data-lenso-kind="toggle-button-group" data-slot="toggle-button-group"
      data-orientation=state.orientation data-lenso-loop-focus=state.loopFocus
      data-lenso-full-width=state.fullWidth data-lenso-detached=state.detached
      children

component ToggleButtonGroupItem
  props
    state: ToggleButtonGroupState
    id: string
    value: string
    label: string
    disabled: bool
    iconOnly: bool
    change: action
  derive pressed = state.value.includes(value)
  action toggle(next: bool)
    if not disabled and not state.disabled
      if not next
        change(state.value.filter(entry => entry != value))
      else
        change(state.multiple ? state.value.concat([value]) : [value])
  slot
  view
    StyledToggleButtonGroupItem(id=id, label=label, pressed=pressed, change=toggle, disabled=(state.disabled or disabled), size=state.size, variant=state.variant, fullWidth=state.fullWidth, iconOnly=iconOnly, orientation=state.orientation, detached=state.detached)
      children

component ToggleButtonGroupSeparator
  props
    state: ToggleButtonGroupState
  view
    box aria-hidden=true hatch="lenso-ui" data-lenso-kind="toggle-button-group-separator"
      data-slot="toggle-button-group-separator" data-orientation=state.orientation data-lenso-detached=state.detached
