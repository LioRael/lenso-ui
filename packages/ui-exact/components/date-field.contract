use StyledDateSegmentInput from "./generated/date-segment-input.contract"
use Label from "./forms.contract"

shape DateFieldState
  id: string
  label: string
  description: string
  error: string
  value: string
  placeholder: string
  locale: string
  calendar: string
  min: string
  max: string
  disabled: bool
  readOnly: bool
  required: bool
  invalid: bool
  direction: string
  variant: string
  fullWidth: bool
  name: string
  form: string

component DateField
  props
    state: DateFieldState
    change: action
  view
    DateFieldRoot(state=state)
      DateFieldLabel(state=state)
      DateInputGroup(state=state, change=change)
      DateFieldDescription(state=state)
      DateFieldError(state=state)

component DateFieldRoot
  props
    state: DateFieldState
  slot
  view
    box id=state.id testId=state.id hatch="lenso-ui" data-lenso-kind="date-field" data-slot="date-field" data-lenso-full-width=state.fullWidth data-lenso-disabled=state.disabled data-lenso-invalid=state.invalid
      children

component DateFieldLabel
  props
    state: DateFieldState
  view
    Label(id=`${state.id}-label`, controlId=`${state.id}-proxy`, label=state.label, required=state.required)

component DateFieldDescription
  props
    state: DateFieldState
  view
    text state.description id=`${state.id}-description` testId=`${state.id}-description` hatch="lenso-ui" data-lenso-kind="date-field-description" data-slot="description" data-lenso-invalid=state.invalid

component DateFieldError
  props
    state: DateFieldState
  view
    text state.error id=`${state.id}-error` testId=`${state.id}-error` role="alert" hatch="lenso-ui" data-lenso-kind="date-field-error" data-slot="field-error"

component DateInputGroup
  props
    state: DateFieldState
    change: action
  view
    DateInputGroupRoot(state=state)
      DateInputGroupInput(state=state, change=change)

component DateInputGroupRoot
  props
    state: DateFieldState
  slot
  view
    DateInputGroupRootModel(state=state, time=false, hourCycle="", granularity="minute")
      children

component DateInputGroupRootModel
  props
    state: DateFieldState
    time: bool
    hourCycle: string
    granularity: string
  slot
  view
    box id=`${state.id}-input` testId=`${state.id}-input` role="group" aria-label=state.label aria-disabled=state.disabled direction=state.direction
      hatch="lenso-ui" data-lenso-kind="date-input-group" data-slot="date-input-group" data-lenso-value=state.value data-lenso-placeholder=state.placeholder data-lenso-locale=state.locale data-lenso-calendar=state.calendar
      data-lenso-time=time data-lenso-hour-cycle=hourCycle data-lenso-granularity=granularity data-lenso-error=state.error data-lenso-min=state.min data-lenso-max=state.max data-lenso-disabled=state.disabled data-lenso-readonly=state.readOnly data-lenso-required=state.required data-lenso-invalid=state.invalid data-lenso-full-width=state.fullWidth data-lenso-variant=state.variant data-lenso-form=state.form data-lenso-direction=state.direction
      children


component DateInputGroupInput
  props
    state: DateFieldState
    change: action
  state layout = "month|literal-0|day|literal-1|year"
  action configure(next: string)
    layout = next
  action noChange(value: string)
    if false
      change(value)
  view
    box hatch="lenso-ui" data-lenso-kind="date-input-group-input" data-slot="date-input-group-input"
      for part in layout.split("|") key=part
        if part.slice(0, 8) == "literal-"
          box aria-hidden=true hatch="lenso-ui" data-lenso-kind="date-input-literal" data-slot="date-input-group-segment" data-lenso-date-part=part
        else
          StyledDateSegmentInput(id=`${state.id}-${part}`, part=part, label=part, description=`${state.id}-description ${state.id}-error ${state.id}-native-error`, value="", type="text", placeholder="", disabled=state.disabled, readOnly=true, invalid=state.invalid, input=noChange, change=noChange, name="", labelledBy="", autocomplete="off", required=state.required, variant=state.variant)
    input type="hidden" value="" input=configure hatch="lenso-ui" data-lenso-kind="date-field-request" data-slot="date-field-layout"
    input type="hidden" value="" input=change hatch="lenso-ui" data-lenso-kind="date-field-request" data-slot="date-field-change"
    box id=`${state.id}-native-error` role="status" aria-live="polite" aria-atomic=true hatch="lenso-ui" data-lenso-kind="date-field-validation" data-slot="date-field-validation"
    input id=`${state.id}-proxy` testId=`${state.id}-proxy` type="text" value=state.value readonly=state.readOnly disabled=state.disabled tabindex=-1 aria-hidden=true input=noChange
      hatch="lenso-ui" data-lenso-kind="date-field-proxy" data-slot="date-field-proxy" data-lenso-name=state.name data-lenso-required=state.required


component DateInputGroupPrefix
  slot
  view
    box aria-hidden=true hatch="lenso-ui" data-lenso-kind="date-input-prefix" data-slot="date-input-group-prefix"
      children

component DateInputGroupSuffix
  slot
  view
    box aria-hidden=true hatch="lenso-ui" data-lenso-kind="date-input-suffix" data-slot="date-input-group-suffix"
      children
