use StyledSlider from "./generated/color-slider-input.contract"

shape ColorAreaState
  id: string
  label: string
  value: string
  colorSpace: string
  xChannel: string
  yChannel: string
  locale: string
  direction: string
  xName: string
  yName: string
  disabled: bool
  readOnly: bool
  showDots: bool

component ColorArea
  props
    state: ColorAreaState
    change: action
    commit: action
  action changed(value: string)
    if not state.disabled and not state.readOnly
      change(value)
  action committed(value: string)
    if not state.disabled and not state.readOnly
      commit(value)
  action rolledBack(value: string)
    change(value)
  slot
  view
    box id=state.id testId=state.id role="group" aria-label=state.label direction=state.direction hatch="lenso-ui" data-lenso-kind="color-area" data-slot="color-area" data-lg-slider-control=""
      data-lenso-value=state.value data-lenso-color-space=state.colorSpace data-lenso-x-channel=state.xChannel data-lenso-y-channel=state.yChannel data-lenso-locale=state.locale data-lenso-direction=state.direction data-lenso-disabled=state.disabled data-lenso-readonly=state.readOnly data-lenso-dots=state.showDots
      children
      input type="hidden" value=state.value input=changed hatch="lenso-ui" data-lenso-kind="color-request" data-slot="color-area-change"
      input type="hidden" value=state.value input=committed hatch="lenso-ui" data-lenso-kind="color-request" data-slot="color-area-commit"
      input type="hidden" value=state.value input=rolledBack hatch="lenso-ui" data-lenso-kind="color-request" data-slot="color-area-rollback"
      input type="hidden" value=state.value disabled=state.disabled data-lenso-name=state.xName hatch="lenso-ui" data-lenso-kind="color-request" data-slot="color-area-form-x"
      input type="hidden" value=state.value disabled=state.disabled data-lenso-name=state.yName hatch="lenso-ui" data-lenso-kind="color-request" data-slot="color-area-form-y"

component ColorAreaThumb
  props
    state: ColorAreaState
    change: action
    commit: action
  action nativeInput(next: number)
    if not state.disabled and not state.readOnly
      change(state.value)
  action nativeChange(next: number)
    if not state.disabled and not state.readOnly
      commit(state.value)
  view
    box id=`${state.id}-thumb` testId=`${state.id}-thumb` hatch="lenso-ui" data-lenso-kind="color-area-thumb" data-slot="color-area-thumb" data-lg-slider-thumb="" data-orientation="horizontal" data-lenso-disabled=state.disabled
      box aria-hidden=true hatch="lenso-ui" data-lenso-kind="color-area-optical" data-slot="color-area-optical"
        box hatch="lenso-ui" data-lenso-kind="color-area-face" data-slot="color-area-face"
      StyledSlider(id=`${state.id}-x`, label=`${state.label} X`, description="", value=0, min=0, max=1, step=0.01, disabled=true, input=nativeInput, change=nativeChange)
    box hatch="lenso-ui" data-lenso-kind="color-area-secondary" data-slot="color-area-secondary"
      StyledSlider(id=`${state.id}-y`, label=`${state.label} Y`, description="", value=0, min=0, max=1, step=0.01, disabled=true, input=nativeInput, change=nativeChange)
