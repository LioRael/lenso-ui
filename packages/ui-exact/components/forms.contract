use StyledInput from "./generated/input.contract"
use StyledCheckbox from "./generated/checkbox.contract"
use StyledRadio from "./generated/radio.contract"
use StyledTextarea from "./generated/textarea.contract"
use StyledFieldDescription from "./generated/description.contract"

component Input
  props
    id: string
    name: string
    label: string
    labelledBy: string
    describedBy: string
    value: string
    input: action
    change: action
    submit: action
    placeholder: string
    type: string
    autocomplete: string
    disabled: bool
    readOnly: bool
    required: bool
    invalid: bool
    variant: string
  view
    StyledInput(id=id, label=label, description=describedBy, value=value, type=type, placeholder=placeholder, disabled=disabled, readOnly=readOnly, invalid=invalid, input=input, change=change, submit=submit, name=name, labelledBy=labelledBy, autocomplete=autocomplete, required=required, variant=variant)

component TextArea
  props
    id: string
    name: string
    label: string
    labelledBy: string
    describedBy: string
    value: string
    input: action
    change: action
    placeholder: string
    rows: number
    disabled: bool
    readOnly: bool
    required: bool
    invalid: bool
    variant: string
  view
    StyledTextarea(id=id, label=label, description=describedBy, value=value, placeholder=placeholder, disabled=disabled, readOnly=readOnly, invalid=invalid, input=input, change=change, name=name, labelledBy=labelledBy, rows=rows, required=required, variant=variant)

component TextField
  props
    id: string
    invalid: bool
    disabled: bool
  slot
  view
    column id=id testId=id hatch="lenso-ui" data-lenso-kind="text-field" data-slot="text-field"
      data-lenso-invalid=invalid data-lenso-disabled=disabled
      children

component InputGroup
  props
    id: string
    variant: string
  slot
  view
    row id=id testId=id hatch="lenso-ui" data-lenso-kind="input-group" data-slot="input-group" data-lenso-variant=variant
      children

component InputGroupPrefix
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="input-adornment" data-slot="input-group-prefix"
      children

component InputGroupSuffix
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="input-adornment" data-slot="input-group-suffix"
      children

component Label
  props
    id: string
    controlId: string
    label: string
    required: bool
  view
    text label id=id testId=id hatch="lenso-ui" data-lenso-kind="label" data-slot="label"
      data-lenso-for=controlId data-lenso-required=required

component Description
  props
    id: string
    label: string
  view
    StyledFieldDescription(id=id, message=label)

component FieldError
  props
    id: string
    message: string
  view
    if message != ""
      text message id=id testId=id role="alert" hatch="lenso-ui" data-lenso-kind="field-error"

component Fieldset
  props
    id: string
    label: string
  slot
  view
    column role="group" aria-labelledby=`${id}-legend` testId=id hatch="lenso-ui" data-lenso-kind="fieldset"
      text label id=`${id}-legend` hatch="lenso-ui" data-lenso-kind="legend"
      children

component Checkbox
  props
    id: string
    name: string
    label: string
    describedBy: string
    checked: bool
    indeterminate: bool
    change: action
    disabled: bool
    required: bool
    invalid: bool
  view
    column position="relative" hatch="lenso-ui" data-lenso-kind="checkbox" data-slot="checkbox"
      data-lenso-checked=checked data-lenso-indeterminate=indeterminate data-lenso-invalid=invalid data-lenso-disabled=disabled
      StyledCheckbox(id=id, label=label, description=describedBy, checked=checked, disabled=disabled, change=change, name=name, required=required, invalid=invalid, indeterminate=indeterminate)
      row aria-hidden=true hatch="lenso-ui" data-lenso-kind="checkbox-content"
        box hatch="lenso-ui" data-lenso-kind="checkbox-control"
          box hatch="lenso-ui" data-lenso-kind="checkbox-indicator"
            svg viewBox="0 0 17 18" fill="none" stroke="currentColor" stroke-dasharray="22"
              stroke-linecap="round" stroke-linejoin="round" hatch="lenso-ui" data-lenso-kind="checkbox-checkmark"
              polyline points="1 9 7 14 15 4"
            svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=3
              stroke-linecap="round" hatch="lenso-ui" data-lenso-kind="checkbox-mixed"
              line x1=4 y1=12 x2=20 y2=12
        text label

component CheckboxGroup
  props
    label: string
    describedBy: string
  slot
  view
    column role="group" aria-label=label aria-describedby=describedBy hatch="lenso-ui" data-lenso-kind="checkbox-group"
      children

component Radio
  props
    id: string
    name: string
    label: string
    describedBy: string
    value: string
    checked: bool
    change: action
    disabled: bool
    required: bool
    invalid: bool
  view
    column position="relative" hatch="lenso-ui" data-lenso-kind="radio" data-slot="radio"
      data-lenso-checked=checked data-lenso-invalid=invalid data-lenso-disabled=disabled
      StyledRadio(id=id, name=name, label=label, value=value, selected=(checked ? value : `${value} `), disabled=disabled, change=change, description=describedBy, required=required, invalid=invalid)
      row aria-hidden=true hatch="lenso-ui" data-lenso-kind="radio-content"
        box hatch="lenso-ui" data-lenso-kind="radio-control"
          box hatch="lenso-ui" data-lenso-kind="radio-indicator" data-lenso-checked=checked
        text label

component RadioGroup
  props
    label: string
    describedBy: string
    orientation: string
  slot
  view
    column role="radiogroup" aria-label=label aria-describedby=describedBy aria-orientation=orientation
      hatch="lenso-ui" data-lenso-kind="radio-group" data-orientation=orientation
      children
