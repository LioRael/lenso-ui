use StyledColorPickerTrigger from "./generated/color-picker-trigger.contract"
use PopoverState, PopoverPositioner from "./popover.contract"

shape ColorPickerState
  id: string
  label: string
  value: string
  disabled: bool
  readOnly: bool
  direction: string

component ColorPicker
  props
    state: ColorPickerState
  slot
  view
    box id=`${state.id}-root` testId=`${state.id}-root` direction=state.direction hatch="lenso-ui" data-lenso-kind="color-picker" data-slot="color-picker" data-lenso-value=state.value
      children

component ColorPickerTrigger
  props
    state: ColorPickerState
  slot
  view
    StyledColorPickerTrigger(id=`${state.id}-trigger`, label=state.label, target=state.id, disabled=state.disabled)
      children

component ColorPickerPopover
  props
    state: PopoverState
  slot
  view
    PopoverPositioner(state=state)
      column id=`${state.id}-popup` testId=`${state.id}-popup` role="dialog" tabindex=-1 aria-label=state.label aria-labelledby=state.labelledBy aria-describedby=state.describedBy
        hatch="lenso-ui" data-lenso-kind="color-picker-popover" data-slot="popover-popup" data-direction=state.direction
        box aria-hidden=true hatch="lenso-ui" data-lenso-kind="color-picker-lens" data-material-lens=""
        column hatch="lenso-ui" data-lenso-kind="color-picker-content" data-slot="color-picker-content"
          children

component ColorPickerDialog
  props
    id: string
    level: number
  slot
  view
    box id=id testId=id role="heading" aria-level=level hatch="lenso-ui" data-lenso-kind="color-picker-dialog" data-slot="color-picker-dialog"
      children
