shape AlertState
  id: string
  status: string
  role: string
  label: string
  labelledBy: string
  describedBy: string

component Alert
  props
    state: AlertState
  slot
  view
    row id=state.id testId=state.id role=state.role aria-label=state.label aria-labelledby=state.labelledBy aria-describedby=state.describedBy
      hatch="lenso-ui" data-lenso-kind="alert" data-slot="alert-root" data-lenso-color=state.status data-material="glass-medium"
      box aria-hidden=true hatch="lenso-ui" data-lenso-kind="alert-lens" data-material-lens=""
      children

component AlertTitle
  props
    state: AlertState
    id: string
  slot
  view
    box id=id hatch="lenso-ui" data-lenso-kind="alert-title" data-slot="alert-title" data-lenso-color=state.status
      children

component AlertIndicator
  props
    state: AlertState
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="alert-indicator" data-slot="alert-indicator" data-lenso-color=state.status
      children

component AlertContent
  slot
  view
    column hatch="lenso-ui" data-lenso-kind="alert-content" data-slot="alert-content"
      children

component AlertDescription
  props
    id: string
  slot
  view
    box id=id hatch="lenso-ui" data-lenso-kind="alert-description" data-slot="alert-description"
      children

component AlertDefaultIcon
  props
    status: string
  view
    svg viewBox="0 0 16 16" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" aria-hidden=true
      hatch="lenso-ui" data-lenso-kind="alert-icon" data-slot="alert-default-icon"
      if status == "success"
        path d="M13.5 8a5.5 5.5 0 1 1-11 0a5.5 5.5 0 0 1 11 0M15 8A7 7 0 1 1 1 8a7 7 0 0 1 14 0m-3.9-1.55a.75.75 0 1 0-1.2-.9L7.419 8.858L6.03 7.47a.75.75 0 0 0-1.06 1.06l2 2a.75.75 0 0 0 1.13-.08z"
      else if status == "warning"
        path d="M7.134 2.994L2.217 11.5a1 1 0 0 0 .866 1.5h9.834a1 1 0 0 0 .866-1.5L8.866 2.993a1 1 0 0 0-1.732 0m3.03-.75c-.962-1.665-3.366-1.665-4.329 0L.918 10.749c-.963 1.666.24 3.751 2.165 3.751h9.834c1.925 0 3.128-2.085 2.164-3.751zM8 5a.75.75 0 0 1 .75.75v2a.75.75 0 0 1-1.5 0v-2A.75.75 0 0 1 8 5m1 5.75a1 1 0 1 1-2 0a1 1 0 0 1 2 0"
      else if status == "danger"
        path d="M8 13.5a5.5 5.5 0 1 0 0-11a5.5 5.5 0 0 0 0 11M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14m1-4.5a1 1 0 1 1-2 0a1 1 0 0 1 2 0M8.75 5a.75.75 0 0 0-1.5 0v2.5a.75.75 0 0 0 1.5 0z"
      else
        path d="M8 13.5a5.5 5.5 0 1 0 0-11a5.5 5.5 0 0 0 0 11M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14m1-9.5a1 1 0 1 1-2 0a1 1 0 0 1 2 0m-.25 3a.75.75 0 0 0-1.5 0V11a.75.75 0 0 0 1.5 0z"

shape BadgeState
  id: string
  label: string
  size: string
  color: string
  variant: string
  placement: string

component Badge
  props
    state: BadgeState
  slot
  view
    box id=state.id testId=state.id role="img" aria-label=state.label hatch="lenso-ui" data-lenso-kind="badge" data-slot="badge"
      data-lenso-size=state.size data-lenso-color=state.color data-lenso-variant=state.variant data-placement=state.placement data-material="glass-small"
      box aria-hidden=true hatch="lenso-ui" data-lenso-kind="badge-lens" data-material-lens=""
      children

component BadgeAnchor
  props
    id: string
  slot
  view
    box id=id testId=id hatch="lenso-ui" data-lenso-kind="badge-anchor" data-slot="badge-anchor"
      children

component BadgeLabel
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="badge-label" data-slot="badge-label"
      children

component Chip
  props
    id: string
    size: string
    color: string
    variant: string
  slot
  view
    box id=id testId=id hatch="lenso-ui" data-lenso-kind="chip" data-slot="chip" data-lenso-size=size data-lenso-color=color data-lenso-variant=variant
      children

component ChipLabel
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="chip-label" data-slot="chip-label"
      children

component CloseButtonRoot
  props
    id: string
    label: string
    press: action
    disabled: bool
    loading: bool
    destructive: bool
  slot
  action activate
    if not disabled and not loading
      press()
  view
    button id=id testId=id appearance="none" tabindex=0 aria-label=label disabled=disabled aria-busy=loading aria-disabled=(disabled or loading) press=activate
      hatch="lenso-ui" data-lenso-kind="close-button" data-slot="close-button" data-lenso-loading=loading data-lenso-destructive=destructive
      children

component CloseButton
  props
    id: string
    label: string
    press: action
    disabled: bool
    loading: bool
    destructive: bool
  view
    CloseButtonRoot(id=id, label=label, press=press, disabled=disabled, loading=loading, destructive=destructive)
      CloseButtonGlyph()

component CloseButtonGlyph
  view
    svg viewBox="0 0 16 16" fill="none" aria-hidden=true hatch="lenso-ui" data-lenso-kind="close-button-icon" data-slot="close-button-icon"
      path d="m4 4 8 8M12 4l-8 8" stroke="currentColor" stroke-width=1.5 stroke-linecap="round"
