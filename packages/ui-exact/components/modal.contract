shape ModalState
  id: string
  label: string
  labelledBy: string
  describedBy: string
  dismiss: string
  size: string
  placement: string
  scroll: string
  backdrop: string

component Modal
  props
    state: ModalState
  slot
  view
    dialog id=state.id testId=state.id aria-label=state.label aria-labelledby=state.labelledBy aria-describedby=state.describedBy
      closedby=state.dismiss hatch="lenso-ui" data-lenso-kind="modal" data-slot="modal"
      data-lenso-dismiss=state.dismiss
      children

component ModalBackdrop
  props
    state: ModalState
  view
    box aria-hidden=true hatch="lenso-ui" data-lenso-kind="modal-backdrop" data-slot="modal-backdrop"
      data-lenso-variant=state.backdrop

component ModalViewport
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="modal-viewport" data-slot="modal-viewport"
      children

component ModalPopup
  props
    state: ModalState
  slot
  view
    column id=`${state.id}-popup` testId=`${state.id}-popup`
      hatch="lenso-ui" data-lenso-kind="modal-popup" data-slot="modal-popup"
      data-size=state.size data-placement=state.placement data-lenso-scroll=state.scroll
      children

component ModalHeader
  slot
  view
    column hatch="lenso-ui" data-lenso-kind="modal-header" data-slot="modal-header"
      children

component ModalTitle
  props
    id: string
    level: number
  slot
  view
    box id=id role="heading" aria-level=level hatch="lenso-ui" data-lenso-kind="modal-title" data-slot="modal-title"
      children

component ModalDescription
  props
    id: string
  slot
  view
    box id=id hatch="lenso-ui" data-lenso-kind="modal-description" data-slot="modal-description"
      children

component ModalBody
  props
    state: ModalState
  slot
  view
    column id=`${state.id}-body` testId=`${state.id}-body` hatch="lenso-ui" data-lenso-kind="modal-body"
      data-slot="modal-body" data-lenso-scroll=state.scroll
      children

component ModalIcon
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="modal-icon" data-slot="modal-icon"
      children

component ModalFooter
  slot
  view
    row hatch="lenso-ui" data-lenso-kind="modal-footer" data-slot="modal-footer"
      children

component ModalTrigger
  props
    id: string
    label: string
    target: string
    disabled: bool
    size: string
    variant: string
  slot
  view
    button id=id testId=id appearance="none" tabindex=0 aria-label=label disabled=disabled
      commandfor=target command="show-modal" hatch="lenso-ui" data-lenso-kind="modal-trigger"
      data-slot="modal-trigger" data-lenso-size=size data-lenso-variant=variant
      children

component ModalClose
  props
    id: string
    label: string
    target: string
    disabled: bool
    size: string
    variant: string
  slot
  view
    button id=id testId=id appearance="none" tabindex=0 aria-label=label disabled=disabled
      commandfor=target command="close" hatch="lenso-ui" data-lenso-kind="modal-close"
      data-slot="modal-close" data-lenso-size=size data-lenso-variant=variant
      children

component ModalAction
  props
    id: string
    label: string
    press: action
    disabled: bool
    size: string
    variant: string
  slot
  view
    button id=id testId=id appearance="none" tabindex=0 aria-label=label disabled=disabled press=press
      hatch="lenso-ui" data-lenso-kind="modal-action" data-slot="modal-action"
      data-lenso-size=size data-lenso-variant=variant
      children

component ModalCloseIcon
  props
    id: string
    label: string
    target: string
    disabled: bool
  view
    button id=id testId=id appearance="none" tabindex=0 aria-label=label disabled=disabled
      commandfor=target command="close" hatch="lenso-ui" data-lenso-kind="modal-close-icon" data-slot="modal-close"
      svg viewBox="0 0 16 16" fill="none" aria-hidden=true hatch="lenso-ui" data-lenso-kind="modal-close-glyph"
        path d="m4 4 8 8M12 4l-8 8" stroke="currentColor" stroke-width=1.5 stroke-linecap="round"
