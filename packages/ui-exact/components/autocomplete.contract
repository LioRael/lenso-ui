use StyledAutocompleteInput from "./generated/autocomplete-input.contract"
use StyledAutocompletePositioner, StyledAutocompleteTrigger, StyledAutocompleteItem from "./generated/autocomplete-parts.contract"
use Label from "./forms.contract"

shape AutocompleteState
  id: string
  label: string
  labelledBy: string
  describedBy: string
  value: string[]
  inputValue: string
  defaultValue: string[]
  defaultInputValue: string
  multiple: bool
  disabled: bool
  readOnly: bool
  required: bool
  invalid: bool
  name: string
  form: string
  placeholder: string
  searchLabel: string
  searchPlaceholder: string
  variant: string
  fullWidth: bool
  direction: string
  filter: string
  locale: string
  autoHighlight: bool
  loop: bool
  side: string
  align: string
  sideOffset: number
  collisionPadding: number

shape AutocompleteOption
  value: string
  label: string
  disabled: bool

fn autocompleteLabel(options: AutocompleteOption[], value: string): string = match first(options.filter(item => item.value == value)) { case some(item) => item.label, case none => value }

component AutocompleteRoot
  props
    state: AutocompleteState
    options: AutocompleteOption[]
    change: action
  derive closedText = ""
  action restore(text: string)
    if not state.disabled and not state.readOnly and state.inputValue != closedText
      change(state.value, closedText)
  action inputCleared(text: string)
    if not state.disabled and not state.readOnly and state.value.length > 0
      change([], "")
  action reset(text: string)
    change(state.defaultValue, state.defaultInputValue)
  slot
  view
    box id=state.id testId=state.id direction=state.direction hatch="lenso-ui" data-lenso-kind="autocomplete-root" data-slot="autocomplete-root"
      data-lenso-chips=(state.multiple and state.value.length > 0) data-lenso-value=state.inputValue data-lenso-multiple=state.multiple data-lenso-disabled=state.disabled data-lenso-readonly=state.readOnly data-lenso-full-width=state.fullWidth data-lenso-variant=state.variant data-lenso-direction=state.direction data-lenso-filter=state.filter data-lenso-locale=state.locale data-lenso-activate-on-focus=state.autoHighlight data-lenso-loop=state.loop
      children
      input type="hidden" value="" input=restore hatch="lenso-ui" data-lenso-kind="select-reset" data-slot="autocomplete-restore"
      input type="hidden" value="" input=inputCleared hatch="lenso-ui" data-lenso-kind="select-reset" data-slot="autocomplete-input-clear"
      input type="hidden" value="" input=reset hatch="lenso-ui" data-lenso-kind="select-reset" data-slot="autocomplete-reset"
      input type="text" value=(state.value.length > 0 ? "1" : "") disabled=state.disabled tabindex=-1 aria-hidden=true
        hatch="lenso-ui" data-lenso-kind="select-validity" data-slot="autocomplete-validity" data-lenso-required=state.required data-lenso-form=state.form
      for value in state.value key=value
        input type="hidden" value=value disabled=state.disabled hatch="lenso-ui" data-lenso-kind="select-form" data-slot="autocomplete-form" data-lenso-name=state.name data-lenso-form=state.form

component AutocompleteLabel
  props
    state: AutocompleteState
  view
    Label(id=`${state.id}-label`, controlId=`${state.id}-trigger`, label=state.label, required=state.required)

component AutocompleteInputGroup
  props
    state: AutocompleteState
  slot
  view
    box id=`${state.id}-field` testId=`${state.id}-field` hatch="lenso-ui" data-lenso-kind="autocomplete-input-group" data-slot="autocomplete-input-group" data-lenso-variant=state.variant data-lenso-full-width=state.fullWidth data-lenso-chips=(state.multiple and state.value.length > 0)
      children

component AutocompleteInput
  props
    state: AutocompleteState
    input: action
  action edited(value: string)
    if not state.disabled and not state.readOnly
      input(value)
  action noChange(value: string)
    if false
      input(value)
  view
    StyledAutocompleteInput(id=`${state.id}-input`, label=state.searchLabel, description=state.describedBy, value=state.inputValue, type="text", placeholder=state.searchPlaceholder, disabled=state.disabled, readOnly=state.readOnly, invalid=state.invalid, input=edited, change=noChange, listId=`${state.id}-list`, name="", labelledBy="", autocomplete="off", required=state.required, variant=state.variant)

component AutocompleteTrigger
  props
    state: AutocompleteState
    label: string
  slot
  view
    StyledAutocompleteTrigger(id=`${state.id}-trigger`, label=label, target=`${state.id}-popup`, disabled=(state.disabled or state.readOnly), variant=state.variant, fullWidth=state.fullWidth, labelledBy=state.labelledBy, describedBy=state.describedBy, invalid=state.invalid, chips=(state.multiple and state.value.length > 0))
      children

component AutocompleteIndicator
  view
    svg width=16 height=16 viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width=1.5 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true hatch="lenso-ui" data-lenso-kind="autocomplete-indicator" data-slot="autocomplete-indicator"
      path d="m4 6 4 4 4-4"

component AutocompleteClearButton
  props
    state: AutocompleteState
    label: string
    change: action
  action clear
    if not state.disabled and not state.readOnly and (state.value.length > 0 or state.inputValue != "")
      change([], "")
  view
    button id=`${state.id}-clear` testId=`${state.id}-clear` appearance="none" type="button" tabindex=-1 aria-label=label disabled=(state.disabled or state.readOnly or (state.value.length == 0 and state.inputValue == "")) press=clear
      hatch="lenso-ui" data-lenso-kind="autocomplete-clear" data-slot="autocomplete-clear"
      svg width=12 height=12 viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width=1.5 stroke-linecap="round" aria-hidden=true
        path d="m3 3 6 6m0-6-6 6"

component AutocompletePortal
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="autocomplete-portal" data-slot="autocomplete-portal"
      children

component AutocompletePositioner
  props
    state: AutocompleteState
  slot
  view
    StyledAutocompletePositioner(id=`${state.id}-popup`, direction=state.direction, side=state.side, align=state.align, sideOffset=state.sideOffset, collisionPadding=state.collisionPadding)
      children

component AutocompletePopover
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="autocomplete-popover" data-slot="autocomplete-popover"
      children

component AutocompleteList
  props
    state: AutocompleteState
  slot
  view
    box id=`${state.id}-list` testId=`${state.id}-list` role="listbox" aria-label=state.label aria-labelledby=state.labelledBy hatch="lenso-ui" data-lenso-kind="autocomplete-list" data-slot="autocomplete-list"
      children

component AutocompleteItem
  props
    state: AutocompleteState
    item: AutocompleteOption
    index: number
    change: action
  derive selected = state.value.includes(item.value)
  action choose
    if not state.disabled and not state.readOnly and not item.disabled
      if state.multiple
        change(selected ? state.value.filter(value => value != item.value) : state.value.concat([item.value]), "")
      else
        change([item.value], "")
  slot
  view
    StyledAutocompleteItem(id=`${state.id}-option-${index}`, label=item.label, disabled=(state.disabled or item.disabled), press=choose, value=item.value, selected=selected)
      children

component AutocompleteItemText
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="autocomplete-item-text" data-slot="autocomplete-item-text"
      children

component AutocompleteItemIndicator
  props
    selected: bool
  view
    box aria-hidden=true hatch="lenso-ui" data-lenso-kind="autocomplete-item-indicator" data-slot="autocomplete-item-indicator" data-lenso-checked=selected
      svg width=12 height=12 viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
        path d="m2 6 2.5 2.5L10 3"

component AutocompleteGroup
  props
    id: string
    labelledBy: string
  slot
  view
    box id=id role="group" aria-labelledby=labelledBy hatch="lenso-ui" data-lenso-kind="autocomplete-group" data-slot="autocomplete-group"
      children

component AutocompleteGroupLabel
  props
    id: string
  slot
  view
    box id=id hatch="lenso-ui" data-lenso-kind="autocomplete-group-label" data-slot="autocomplete-group-label"
      children

component AutocompleteSeparator
  view
    box role="separator" hatch="lenso-ui" data-lenso-kind="autocomplete-separator" data-slot="autocomplete-separator"

component AutocompleteEmpty
  props
    id: string
    label: string
  view
    text label id=id testId=id hatch="lenso-ui" data-lenso-kind="autocomplete-empty" data-slot="autocomplete-empty"

component AutocompleteStatus
  props
    id: string
    label: string
  view
    text "" id=id testId=id role="status" aria-live="polite" aria-atomic=true hatch="lenso-ui" data-lenso-kind="autocomplete-status" data-slot="autocomplete-status" data-lenso-label=label

component AutocompleteChips
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="autocomplete-chips" data-slot="autocomplete-chips"
      children

component AutocompleteChip
  props
    id: string
    value: string
    label: string
  slot
  view
    box id=id testId=id tabindex=-1 aria-label=label hatch="lenso-ui" data-lenso-kind="autocomplete-chip" data-slot="autocomplete-chip" data-lenso-value=value
      children

component AutocompleteChipRemove
  props
    state: AutocompleteState
    id: string
    value: string
    label: string
    change: action
  action remove
    if not state.disabled and not state.readOnly
      change(state.value.filter(key => key != value), state.inputValue)
  view
    button id=id testId=id appearance="none" type="button" tabindex=-1 aria-label=label disabled=(state.disabled or state.readOnly) press=remove hatch="lenso-ui" data-lenso-kind="autocomplete-chip-remove" data-slot="autocomplete-chip-remove"
      svg width=10 height=10 viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width=1.5 stroke-linecap="round" aria-hidden=true
        path d="m3 3 6 6m0-6-6 6"

component AutocompleteValue
  props
    state: AutocompleteState
    options: AutocompleteOption[]
  view
    if state.value.length > 0
      text state.value.map(value => autocompleteLabel(options, value)).join(", ")
        hatch="lenso-ui" data-lenso-kind="autocomplete-value" data-slot="autocomplete-value"
    else
      text state.placeholder hatch="lenso-ui" data-lenso-kind="autocomplete-value" data-slot="autocomplete-value" data-placeholder=""

component AutocompleteSearchClear
  props
    state: AutocompleteState
    label: string
    input: action
  action clear
    if not state.disabled and not state.readOnly
      input("")
  view
    button id=`${state.id}-search-clear` testId=`${state.id}-search-clear` appearance="none" type="button" tabindex=-1 aria-label=label disabled=(state.disabled or state.readOnly or state.inputValue == "") press=clear
      hatch="lenso-ui" data-lenso-kind="autocomplete-search-clear" data-slot="autocomplete-search-clear"
      text "×" aria-hidden=true

component Autocomplete
  props
    state: AutocompleteState
    options: AutocompleteOption[]
    input: action
    change: action
    triggerLabel: string
    clearLabel: string
    searchClearLabel: string
    emptyLabel: string
    statusLabel: string
  view
    AutocompleteRoot(state=state, options=options, change=change)
      AutocompleteLabel(state=state)
      AutocompleteInputGroup(state=state)
        if state.multiple and state.value.length > 0
          AutocompleteChips()
            for value, index in state.value key=value
              AutocompleteChip(id=`${state.id}-chip-${index}`, value=value, label=autocompleteLabel(options, value))
                text autocompleteLabel(options, value)
                AutocompleteChipRemove(state=state, id=`${state.id}-chip-remove-${index}`, value=value, label=`${clearLabel} ${autocompleteLabel(options, value)}`, change=change)
        AutocompleteTrigger(state=state, label=triggerLabel)
          if not state.multiple or state.value.length == 0
            AutocompleteValue(state=state, options=options)
          AutocompleteIndicator()
        AutocompleteClearButton(state=state, label=clearLabel, change=change)
      AutocompletePortal()
        AutocompletePositioner(state=state)
          AutocompletePopover()
            box hatch="lenso-ui" data-lenso-kind="autocomplete-search" data-slot="autocomplete-search"
              AutocompleteInput(state=state, input=input)
              AutocompleteSearchClear(state=state, label=searchClearLabel, input=input)
            AutocompleteList(state=state)
              for item, index in options key=item.value
                AutocompleteItem(state=state, item=item, index=index, change=change)
                  AutocompleteItemText()
                    text item.label
                  AutocompleteItemIndicator(selected=state.value.includes(item.value))
            AutocompleteEmpty(id=`${state.id}-empty`, label=emptyLabel)
      AutocompleteStatus(id=`${state.id}-status`, label=statusLabel)
