use StyledSectionIndexLink from "./generated/section-index-link.contract"

shape SectionIndexItem
  value: string
  label: string
  href: string
  disabled: bool

shape SectionIndexState
  id: string
  label: string
  value: string
  hasValue: bool
  disabled: bool
  direction: string
  scrollport: string
  scrollOffset: number

component SectionIndex
  props
    state: SectionIndexState
    items: SectionIndexItem[]
    change: action
  derive available = items.filter(item => not state.disabled and not item.disabled)
  derive preferred = state.hasValue ? first(available.filter(item => item.value == state.value)) : none
  derive tabValue = match preferred { case some(item) => item.value, case none => (match first(available) { case some(item) => item.value, case none => "" }) }
  action propose(value: string)
    if not state.disabled and items.filter(item => item.value == value and not item.disabled).length > 0
      change(value)
  view
    box id=state.id testId=state.id role="navigation" aria-label=state.label aria-disabled=state.disabled direction=state.direction
      hatch="lenso-ui" data-lenso-kind="section-index" data-slot="section-index" data-lenso-disabled=state.disabled data-lenso-value=state.value data-lenso-active=state.hasValue data-lenso-direction=state.direction data-lenso-scrollport=state.scrollport data-lenso-offset=state.scrollOffset
      for item, index in items key=item.value
        StyledSectionIndexLink(id=`${state.id}-item-${index}`, label=item.label, href=item.href, value=item.value, disabled=(state.disabled or item.disabled), current=(state.hasValue and state.value == item.value), tabStop=(not state.disabled and not item.disabled and item.value == tabValue))
          text item.label
      input type="hidden" value="" input=propose hatch="lenso-ui" data-lenso-kind="select-reset" data-slot="section-index-request"
