use StyledContextMenuBarItem, StyledContextMenuExpand from "./generated/context-menu-bar-item.contract"
use MenuState, MenuPopup, MenuPopupPresentation from "./menu.contract"
use StyledContextMenuPositioner from "./generated/context-menu-positioner.contract"

shape ContextMenuState
  menu: MenuState
  disabled: bool

component ContextMenu
  props
    state: ContextMenuState
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="context-menu" data-slot="context-menu" data-lenso-disabled=state.disabled
      children

component ContextMenuTrigger
  props
    state: ContextMenuState
    id: string
    label: string
  slot
  view
    box id=id testId=id tabindex=(state.disabled ? -1 : 0) aria-label=label aria-disabled=state.disabled aria-haspopup="menu" aria-controls=state.menu.id aria-expanded=false
      hatch="lenso-ui" data-lenso-kind="context-menu-trigger" data-slot="context-menu-trigger" data-lenso-for=state.menu.id data-lenso-disabled=state.disabled
      children

component ContextMenuPositioner
  props
    state: ContextMenuState
    modal: bool
  slot
  view
    StyledContextMenuPositioner(id=state.menu.id, label=state.menu.label, labelledBy=state.menu.labelledBy, modal=modal, side=state.menu.side, align=state.menu.align, direction=state.menu.direction, sideOffset=state.menu.sideOffset, alignOffset=state.menu.alignOffset, collisionPadding=state.menu.collisionPadding, collisionAvoidance=state.menu.collisionAvoidance, disableAnchorTracking=state.menu.disableAnchorTracking)
      box aria-hidden=true role="presentation" hatch="lenso-ui" data-lenso-kind="context-menu-backdrop" data-slot="menu-backdrop"
      children

component ContextMenuPopup
  props
    state: ContextMenuState
  slot
  view
    MenuPopup(state=state.menu)
      children

component ContextMenuBarPopup
  props
    state: ContextMenuState
    compact: bool
    reset: action
  action request(value: string)
    reset()
  slot
  view
    MenuPopupPresentation(state=state.menu, mode=(compact ? "compact" : "full"))
      input type="hidden" value="" input=request hatch="lenso-ui" data-lenso-kind="context-menu-bar-owner" data-slot="context-menu-bar-owner" data-lenso-mode=(compact ? "compact" : "full")
      children

component ContextMenuBar
  slot
  view
    box role="presentation" hatch="lenso-ui" data-lenso-kind="context-menu-bar" data-slot="context-menu-bar"
      children

component ContextMenuBarItem
  props
    id: string
    target: string
    label: string
    press: action
    disabled: bool
    variant: string
    closeOnClick: bool
  slot
  view
    StyledContextMenuBarItem(id=id, target=target, label=label, press=press, disabled=disabled, variant=variant, closeOnClick=closeOnClick)
      children

component ContextMenuExpand
  props
    state: ContextMenuState
    label: string
    expand: action
  view
    StyledContextMenuExpand(id=`${state.menu.id}-expand`, target=state.menu.id, label=label, press=expand, disabled=false, variant="default", closeOnClick=false)
      svg width=16 height=16 viewBox="0 0 16 16" aria-hidden=true
        path d="m6 3 5 5-5 5" fill="none" stroke="currentColor" stroke-width=1.5

component ContextMenuLayout
  props
    layout: string
    previewAlign: string
  slot
  view
    box role="presentation" hatch="lenso-ui" data-lenso-kind="context-menu-layout" data-slot="context-menu-layout" data-lenso-layout=layout data-lenso-alignment=previewAlign
      children

component ContextMenuPreview
  props
    id: string
  slot
  view
    box id=id testId=id aria-hidden=true inert=true hatch="lenso-ui" data-lenso-kind="context-menu-preview" data-slot="context-menu-preview" data-level="elevated"
      children
