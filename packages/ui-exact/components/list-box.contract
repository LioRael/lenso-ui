shape ListBoxKey
  key: string
  index: number

shape ListBoxState
  id: string
  label: string
  labelledBy: string
  describedBy: string
  keys: string[]
  value: string[]
  mode: string
  disabled: bool
  readOnly: bool
  direction: string
  loop: bool
  selectionFollowsFocus: bool

component ListBox
  props
    state: ListBoxState
    change: action
    activate: action
  slot
  view
    ListBoxPresentation(state=state, presentation="list-box", change=change, activate=activate)
      children

component ListBoxPresentation
  props
    state: ListBoxState
    presentation: string
    change: action
    activate: action
  slot
  view
    box id=state.id testId=state.id role="listbox" tabindex=0 aria-label=state.label aria-labelledby=state.labelledBy aria-describedby=state.describedBy aria-disabled=state.disabled direction=state.direction
      hatch="lenso-ui" data-lenso-kind=presentation data-slot="list-box" data-lenso-mode=state.mode data-lenso-disabled=state.disabled data-lenso-readonly=state.readOnly data-lenso-direction=state.direction data-lenso-loop=state.loop data-lenso-follow-focus=state.selectionFollowsFocus
      children
      CollectionRequests(keys=state.keys, value=state.value, mode=state.mode, disabled=state.disabled, readOnly=state.readOnly, change=change, activate=activate)

component ListBoxItem
  props
    state: ListBoxState
    itemKey: string
    id: string
    textValue: string
    disabled: bool
    variant: string
  slot
  view
    ListBoxItemPresentation(state=state, presentation="list-box-item", itemKey=itemKey, id=id, textValue=textValue, disabled=disabled, variant=variant)
      children

component ListBoxItemPresentation
  props
    state: ListBoxState
    presentation: string
    itemKey: string
    id: string
    textValue: string
    disabled: bool
    variant: string
  slot
  view
    box id=id testId=id role="option" tabindex=-1 aria-label=textValue aria-selected=(state.mode != "none" and state.value.includes(itemKey)) aria-disabled=(state.disabled or disabled)
      hatch="lenso-ui" data-lenso-kind=presentation data-slot="list-box-item" data-lenso-value=itemKey data-lenso-disabled=(state.disabled or disabled) data-lenso-variant=variant
      children

component ListBoxItemIndicator
  props
    selected: bool
    variant: string
  view
    box aria-hidden=true hatch="lenso-ui" data-lenso-kind="list-box-indicator" data-slot="list-box-indicator" data-collection-indicator="" data-lenso-checked=selected data-lenso-variant=variant
      svg width=10 height=10 viewBox="0 0 17 18" fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" stroke-dasharray=22 stroke-dashoffset=(selected ? 44 : 66)
        polyline points="1 9 7 14 15 4"

component ListBoxSection
  props
    id: string
    labelledBy: string
  slot
  view
    box id=id role="group" aria-labelledby=labelledBy hatch="lenso-ui" data-lenso-kind="list-box-section" data-slot="list-box-section"
      children

component ListBoxSectionLabel
  props
    id: string
  slot
  view
    box id=id testId=id hatch="lenso-ui" data-lenso-kind="list-box-section-label" data-slot="list-box-section-label"
      children

component CollectionRequests
  props
    keys: string[]
    value: string[]
    mode: string
    disabled: bool
    readOnly: bool
    change: action
    activate: action
  derive domain = keys.concat(value.filter(key => not keys.includes(key)))
  derive entries = domain.map((key, index) => ListBoxKey(key=key, index=index))
  action select(mask: string)
    if not disabled and not readOnly and mode != "none"
      change(entries.filter(entry => mask.slice(entry.index, entry.index + 1) == "1").map(entry => entry.key))
  action invoke(key: string)
    if not disabled
      activate(key)
  view
    input type="hidden" value="" input=select hatch="lenso-ui" data-lenso-kind="list-box-request" data-slot="list-box-change"
    input type="hidden" value="" input=invoke hatch="lenso-ui" data-lenso-kind="list-box-request" data-slot="list-box-action"
    for selectedKey in value key=selectedKey
      input type="hidden" value=selectedKey hatch="lenso-ui" data-lenso-kind="list-box-request" data-slot="list-box-selected"
    for key in domain key=key
      input type="hidden" value=key hatch="lenso-ui" data-lenso-kind="list-box-request" data-slot="list-box-key"
