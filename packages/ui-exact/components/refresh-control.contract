use StyledStatus from "./generated/refresh-control-status.contract"
use Spinner from "./feedback.contract"

shape RefreshControlState
  id: string
  label: string
  status: string
  generation: number
  disabled: bool
  threshold: number
  height: string
  refreshLabel: string
  pullLabel: string
  releaseLabel: string
  refreshingLabel: string
  completeLabel: string
  errorLabel: string

component RefreshControlRoot
  props
    state: RefreshControlState
    refresh: action
  action request(value: string)
    if not state.disabled and state.status != "refreshing"
      refresh()
  derive announcement = state.status == "refreshing" ? state.refreshingLabel : state.status == "complete" ? state.completeLabel : state.status == "error" ? state.errorLabel : ""
  slot
  view
    box id=state.id testId=state.id height=state.height role="group" aria-label=state.label aria-busy=(state.status == "refreshing")
      hatch="lenso-ui" data-lenso-kind="refresh-control" data-slot="refresh-control" data-lenso-mode=state.status data-lenso-value=state.generation data-lenso-disabled=state.disabled data-lenso-threshold=state.threshold data-lenso-pull-label=state.pullLabel data-lenso-release-label=state.releaseLabel data-lenso-refreshing-label=state.refreshingLabel data-lenso-complete-label=state.completeLabel data-lenso-error-label=state.errorLabel
      children
      box id=`${state.id}-error` testId=`${state.id}-error` data-lenso-active=(state.status == "error") hatch="lenso-ui" data-lenso-kind="refresh-control-error" data-slot="refresh-control-error"
        text state.errorLabel
      input type="hidden" value="" input=request hatch="lenso-ui" data-lenso-kind="select-reset" data-slot="refresh-control-request"
      StyledStatus(id=`${state.id}-status`, message=announcement)

component RefreshControlViewport
  props
    state: RefreshControlState
  derive message = state.status == "refreshing" ? state.refreshingLabel : state.status == "complete" ? state.completeLabel : state.status == "error" ? state.errorLabel : ""
  slot
  view
    box id=`${state.id}-viewport` testId=`${state.id}-viewport` tabindex=0 aria-label=state.label
      hatch="lenso-ui" data-lenso-kind="refresh-control-viewport" data-slot="refresh-control-viewport"
      box aria-hidden=true hatch="lenso-ui" data-lenso-kind="refresh-control-indicator" data-slot="refresh-control-indicator"
        box data-lenso-active=(state.status == "refreshing") hatch="lenso-ui" data-lenso-kind="refresh-control-spinner" data-slot="refresh-control-spinner"
          Spinner(id=`${state.id}-spinner`, label=state.refreshingLabel, size="sm", color="current")
        text "↓" data-lenso-active=(state.status != "refreshing") hatch="lenso-ui" data-lenso-kind="refresh-control-progress" data-slot="refresh-control-progress"
        text message hatch="lenso-ui" data-lenso-kind="refresh-control-message" data-slot="refresh-control-message"
      box id=`${state.id}-content` testId=`${state.id}-content` hatch="lenso-ui" data-lenso-kind="refresh-control-content" data-slot="refresh-control-content"
        children

component RefreshControlTrigger
  props
    state: RefreshControlState
    refresh: action
  action request
    if not state.disabled and state.status != "refreshing"
      refresh()
  slot
  view
    button id=`${state.id}-trigger` testId=`${state.id}-trigger` type="button" appearance="none" aria-label=state.refreshLabel disabled=(state.disabled or state.status == "refreshing") press=request
      hatch="lenso-ui" data-lenso-kind="refresh-control-trigger" data-slot="refresh-control-trigger"
      children

component RefreshControl
  props
    state: RefreshControlState
    refresh: action
  slot
  view
    RefreshControlRoot(state=state, refresh=refresh)
      RefreshControlTrigger(state=state, refresh=refresh)
        text state.refreshLabel
      RefreshControlViewport(state=state)
        children
