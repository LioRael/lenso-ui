use StyledPopupButtonMenuTrigger from "./generated/popup-button-menu-trigger.contract"
use SelectState, SelectTrigger from "./select.contract"

component PopupButtonIndicator
  view
    box aria-hidden=true hatch="lenso-ui" data-lenso-kind="popup-button-indicator" data-slot="popup-button-indicator"
      svg width=14 height=18 viewBox="0 0 16 16" fill="none" aria-hidden=true
        path d="m5 5 3-3 3 3 M5 11l3 3 3-3" stroke="currentColor" stroke-width=1.5 stroke-linecap="round" stroke-linejoin="round"

component PopupButton
  props
    id: string
    label: string
    disabled: bool
    type: enum<"button", "submit", "reset">
    press: action
  slot
  view
    button id=id testId=id aria-label=label disabled=disabled type=type press=press appearance="none"
      hatch="lenso-ui" data-lenso-kind="popup-button" data-slot="popup-button" data-popup-button=""
      children
      PopupButtonIndicator()

component PopupButtonMenuTrigger
  props
    id: string
    label: string
    target: string
    disabled: bool
  slot
  view
    StyledPopupButtonMenuTrigger(id=id, label=label, target=target, disabled=disabled)
      children
      PopupButtonIndicator()

component PopupButtonSelectTrigger
  props
    state: SelectState
  slot
  view
    SelectTrigger(state=state)
      children
      PopupButtonIndicator()
