shape PaginationState
  id: string
  label: string
  size: string
  direction: string
  disabled: bool

component Pagination
  props
    state: PaginationState
  slot
  view
    box id=state.id testId=state.id role="navigation" aria-label=state.label direction=state.direction
      hatch="lenso-ui" data-lenso-kind="pagination" data-slot="pagination" data-lenso-direction=state.direction
      children

component PaginationSummary
  props
    state: PaginationState
  slot
  view
    box id=`${state.id}-summary` testId=`${state.id}-summary` hatch="lenso-ui" data-lenso-kind="pagination-summary" data-slot="pagination-summary" data-lenso-size=state.size
      children

component PaginationContent
  slot
  view
    row role="list" hatch="lenso-ui" data-lenso-kind="pagination-content" data-slot="pagination-content"
      children

component PaginationItem
  slot
  view
    box role="listitem" hatch="lenso-ui" data-lenso-kind="pagination-item" data-slot="pagination-item"
      children

component PaginationLink
  props
    state: PaginationState
    id: string
    href: string
    target: string
    label: string
    current: bool
    disabled: bool
  slot
  view
    link id=id testId=id href=((state.disabled or disabled) ? "" : href) target=target role="link" aria-label=label
      aria-current=(current ? "page" : "false") aria-disabled=(state.disabled or disabled) tabindex=((state.disabled or disabled) ? -1 : 0)
      hatch="lenso-ui" data-lenso-kind="pagination-link" data-slot="pagination-link" data-lenso-active=current data-lenso-size=state.size
      children

component PaginationPrevious
  props
    state: PaginationState
    id: string
    href: string
    target: string
    label: string
    disabled: bool
  slot
  view
    link id=id testId=id href=((state.disabled or disabled) ? "" : href) target=target role="link" aria-label=label
      aria-disabled=(state.disabled or disabled) tabindex=((state.disabled or disabled) ? -1 : 0)
      hatch="lenso-ui" data-lenso-kind="pagination-previous" data-slot="pagination-link" data-lenso-active=false data-lenso-size=state.size
      children

component PaginationNext
  props
    state: PaginationState
    id: string
    href: string
    target: string
    label: string
    disabled: bool
  slot
  view
    link id=id testId=id href=((state.disabled or disabled) ? "" : href) target=target role="link" aria-label=label
      aria-disabled=(state.disabled or disabled) tabindex=((state.disabled or disabled) ? -1 : 0)
      hatch="lenso-ui" data-lenso-kind="pagination-next" data-slot="pagination-link" data-lenso-active=false data-lenso-size=state.size
      children

component PaginationEllipsis
  props
    state: PaginationState
  slot
  view
    box aria-hidden=true hatch="lenso-ui" data-lenso-kind="pagination-ellipsis" data-slot="pagination-ellipsis" data-lenso-size=state.size
      children

component PaginationPreviousIcon
  view
    box aria-hidden=true hatch="lenso-ui" data-lenso-kind="pagination-icon" data-slot="pagination-previous-icon"
      svg width="100%" height="100%" viewBox="0 0 16 16" fill="none"
        path d="m10 4-4 4 4 4" stroke="currentColor" stroke-width=1.5 stroke-linecap="round" stroke-linejoin="round"

component PaginationNextIcon
  view
    box aria-hidden=true hatch="lenso-ui" data-lenso-kind="pagination-icon" data-slot="pagination-next-icon"
      svg width="100%" height="100%" viewBox="0 0 16 16" fill="none"
        path d="m6 4 4 4-4 4" stroke="currentColor" stroke-width=1.5 stroke-linecap="round" stroke-linejoin="round"
