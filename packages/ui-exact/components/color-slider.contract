use StyledSlider from "./generated/color-slider-input.contract"

shape ColorSliderState
  id: string
  label: string
  value: string
  channel: string
  colorSpace: string
  locale: string
  name: string
  orientation: string
  direction: string
  disabled: bool
  readOnly: bool

component ColorSlider
  props
    state: ColorSliderState
    change: action
    commit: action
  action changed(value: string)
    if not state.disabled and not state.readOnly
      change(value)
  action committed(value: string)
    if not state.disabled and not state.readOnly
      commit(value)
  slot
  view
    box id=state.id testId=state.id role="group" aria-label=state.label direction=state.direction hatch="lenso-ui" data-lenso-kind="color-slider" data-slot="slider" data-orientation=state.orientation
      data-lenso-value=state.value data-lenso-channel=state.channel data-lenso-color-space=state.colorSpace data-lenso-locale=state.locale data-lenso-disabled=state.disabled data-lenso-readonly=state.readOnly data-lenso-direction=state.direction
      children
      input type="hidden" value=state.value input=changed hatch="lenso-ui" data-lenso-kind="color-request" data-slot="color-slider-change"
      input type="hidden" value=state.value input=committed hatch="lenso-ui" data-lenso-kind="color-request" data-slot="color-slider-commit"
      input type="hidden" value=state.value disabled=state.disabled data-lenso-name=state.name hatch="lenso-ui" data-lenso-kind="color-request" data-slot="color-slider-form"

component ColorSliderLabel
  props
    state: ColorSliderState
  view
    text state.label id=`${state.id}-label` testId=`${state.id}-label` hatch="lenso-ui" data-lenso-kind="color-slider-label" data-slot="label" data-lenso-for=`${state.id}-input`

component ColorSliderOutput
  props
    state: ColorSliderState
  view
    text state.value id=`${state.id}-output` testId=`${state.id}-output` hatch="lenso-ui" data-lenso-kind="color-slider-output" data-slot="color-slider-output"

component ColorSliderTrack
  props
    state: ColorSliderState
  slot
  view
    box id=`${state.id}-track` testId=`${state.id}-track` hatch="lenso-ui" data-lenso-kind="color-slider-track" data-slot="slider-control" data-orientation=state.orientation data-lg-slider-control=""
      children

component ColorSliderThumb
  props
    state: ColorSliderState
    change: action
    commit: action
  action nativeInput(next: number)
    if not state.disabled and not state.readOnly
      change(state.value)
  action nativeChange(next: number)
    if not state.disabled and not state.readOnly
      commit(state.value)
  view
    box id=`${state.id}-thumb` testId=`${state.id}-thumb` hatch="lenso-ui" data-lenso-kind="color-slider-thumb" data-slot="slider-thumb" data-orientation=state.orientation data-lg-slider-thumb=""
      box aria-hidden=true hatch="lenso-ui" data-lenso-kind="color-slider-optical" data-slot="color-slider-optical"
      StyledSlider(id=`${state.id}-input`, label=state.label, description="", value=0, min=0, max=1, step=0.01, disabled=true, input=nativeInput, change=nativeChange)
