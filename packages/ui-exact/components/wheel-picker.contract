use ListBoxState, ListBoxPresentation, ListBoxItemPresentation from "./list-box.contract"

shape WheelPickerOption
  value: string
  label: string
  disabled: bool

shape WheelPickerState
  id: string
  label: string
  labelledBy: string
  options: WheelPickerOption[]
  value: string
  disabled: bool
  direction: string
  name: string
  form: string
  emptyLabel: string

component WheelPicker
  props
    state: WheelPickerState
    change: action
  derive available = state.options.filter(option => not option.disabled)
  derive chosen = available.filter(option => option.value == state.value).concat(available).slice(0, 1).map(option => option.value)
  derive list = ListBoxState(id=`${state.id}-viewport`, label=state.label, labelledBy=state.labelledBy, describedBy="", keys=state.options.map(option => option.value), value=chosen, mode="single", disabled=state.disabled, readOnly=false, direction=state.direction, loop=false, selectionFollowsFocus=true)
  action select(values: string[])
    if not state.disabled and values.length > 0 and not chosen.includes(values.join(""))
      change(values.join(""))
  action activate(value: string)
    if false
      change(value)
  view
    box id=state.id testId=state.id hatch="lenso-ui" data-lenso-kind="wheel-picker" data-slot="wheel-picker" data-lenso-disabled=state.disabled
      box aria-hidden=true hatch="lenso-ui" data-lenso-kind="wheel-picker-band" data-slot="wheel-picker-band"
      ListBoxPresentation(state=list, presentation="wheel-picker-viewport", change=select, activate=activate)
        for option in state.options key=option.value
          ListBoxItemPresentation(state=list, presentation="wheel-picker-option", itemKey=option.value, id=`${state.id}-option-${option.value}`, textValue=option.label, disabled=option.disabled, variant="default")
            box aria-hidden=true hatch="lenso-ui" data-lenso-kind="wheel-picker-label" data-slot="wheel-picker-label" data-wheel-label=""
              text option.label
      if state.options.length == 0
        text state.emptyLabel hatch="lenso-ui" data-lenso-kind="wheel-picker-empty" data-slot="wheel-picker-empty"
      if state.name != ""
        input type="hidden" value=chosen.join("") disabled=state.disabled hatch="lenso-ui" data-lenso-kind="wheel-picker-form" data-slot="wheel-picker-form" data-lenso-name=state.name data-lenso-form=state.form
