shape SelectState
  id: string
  label: string
  labelledBy: string
  describedBy: string
  value: string[]
  defaultValue: string[]
  multiple: bool
  disabled: bool
  readOnly: bool
  required: bool
  invalid: bool
  name: string
  form: string
  variant: string
  fullWidth: bool
  direction: string
  side: string
  align: string
  sideOffset: number
  collisionPadding: number

shape SelectOption
  value: string
  label: string
  disabled: bool

component SelectRoot
  props
    state: SelectState
    change: action
  action reset(text: string)
    change(state.defaultValue)
  slot
  view
    box id=state.id testId=state.id direction=state.direction hatch="lenso-ui" data-lenso-kind="select-root" data-slot="select-root"
      data-lenso-disabled=state.disabled data-lenso-readonly=state.readOnly data-lenso-multiple=state.multiple
      data-lenso-variant=state.variant data-lenso-direction=state.direction data-lenso-full-width=state.fullWidth
      children
      input type="hidden" value="" input=reset hatch="lenso-ui" data-lenso-kind="select-reset" data-slot="select-reset"
      input type="text" value=(state.value.length > 0 ? "1" : "") disabled=state.disabled tabindex=-1 aria-hidden=true
        hatch="lenso-ui" data-lenso-kind="select-validity" data-slot="select-validity" data-lenso-required=state.required data-lenso-form=state.form
      for value, index in state.value key=value
        input type="hidden" value=value disabled=state.disabled hatch="lenso-ui" data-lenso-kind="select-form" data-slot="select-form"
          data-lenso-name=state.name data-lenso-form=state.form

component SelectTrigger
  props
    state: SelectState
  slot
  view
    button id=`${state.id}-trigger` testId=`${state.id}-trigger` appearance="none" type="button" role="combobox" tabindex=0
      aria-haspopup="listbox" aria-expanded=false aria-controls=`${state.id}-list` aria-label=state.label aria-labelledby=state.labelledBy aria-describedby=state.describedBy
      aria-required=state.required aria-invalid=state.invalid disabled=state.disabled
      popovertarget=`${state.id}-popup` popovertargetaction="toggle"
      hatch="lenso-ui" data-lenso-kind="select-trigger" data-slot="select-trigger" data-lenso-variant=state.variant data-lenso-full-width=state.fullWidth
      children

component SelectValue
  props
    text: string
    empty: bool
    placeholder: string
  view
    text (empty ? placeholder : text) hatch="lenso-ui" data-lenso-kind="select-value" data-slot="select-value" data-lenso-empty=empty

component SelectIndicator
  view
    svg width=14 height=18 viewBox="0 0 14 18" fill="none" stroke="currentColor" stroke-width=1.5 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
      hatch="lenso-ui" data-lenso-kind="select-indicator" data-slot="select-indicator"
      path d="m4 6 3-3 3 3m-6 6 3 3 3-3"

component SelectPortal
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="select-portal" data-slot="select-portal"
      children

component SelectPositioner
  props
    state: SelectState
  slot
  view
    box id=`${state.id}-popup` testId=`${state.id}-popup` popover="auto" role="presentation" tabindex=-1
      hatch="lenso-ui" data-lenso-kind="select-positioner" data-slot="select-positioner"
      data-lenso-side=state.side data-lenso-align=state.align data-lenso-side-offset=state.sideOffset data-lenso-collision-padding=state.collisionPadding
      children

component SelectPopover
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="select-popover" data-slot="select-popover" data-material="glass-medium"
      box aria-hidden=true hatch="lenso-ui" data-lenso-kind="select-surface" data-slot="select-surface"
        box aria-hidden=true hatch="lenso-ui" data-lenso-kind="select-lens" data-slot="select-lens" data-material-lens=""
      children

component SelectList
  props
    state: SelectState
  slot
  view
    box id=`${state.id}-list` role="listbox" tabindex=-1 aria-label=state.label aria-labelledby=state.labelledBy
      hatch="lenso-ui" data-lenso-kind="select-list" data-slot="select-list"
      children

component SelectItem
  props
    state: SelectState
    item: SelectOption
    index: number
    change: action
  derive selected = state.value.includes(item.value)
  action choose
    if not state.disabled and not state.readOnly and not item.disabled
      if state.multiple
        change(selected ? state.value.filter(value => value != item.value) : state.value.concat([item.value]))
      else
        if not selected
          change([item.value])
  slot
  view
    button id=`${state.id}-option-${index}` testId=`${state.id}-option-${index}` appearance="none" type="button" role="option" tabindex=-1
      aria-label=item.label aria-selected=selected aria-disabled=(state.disabled or item.disabled) disabled=(state.disabled or item.disabled) press=choose
      hatch="lenso-ui" data-lenso-kind="select-item" data-slot="select-item" data-lenso-value=item.value data-lenso-checked=selected
      data-lenso-variant=state.variant data-lenso-disabled=(state.disabled or item.disabled)
      children

component SelectItemText
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="select-item-text" data-slot="select-item-text"
      children

component SelectItemIndicator
  props
    selected: bool
  view
    box aria-hidden=true hatch="lenso-ui" data-lenso-kind="select-item-indicator" data-slot="select-item-indicator" data-lenso-checked=selected
      svg width=12 height=12 viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
        path d="m2 6 2.5 2.5L10 3"

component SelectLabel
  props
    state: SelectState
    label: string
  view
    text label id=`${state.id}-label` hatch="lenso-ui" data-lenso-kind="select-label" data-slot="select-label" data-lenso-for=`${state.id}-trigger`

component SelectGroup
  props
    id: string
    labelledBy: string
  slot
  view
    box id=id role="group" aria-labelledby=labelledBy hatch="lenso-ui" data-lenso-kind="select-group" data-slot="select-group"
      children

component SelectGroupLabel
  props
    id: string
    label: string
  view
    text label id=id hatch="lenso-ui" data-lenso-kind="select-group-label" data-slot="select-group-label"

component SelectSeparator
  view
    box role="separator" hatch="lenso-ui" data-lenso-kind="select-separator" data-slot="select-separator"

component Select
  props
    state: SelectState
    items: SelectOption[]
    placeholder: string
    change: action
  derive selectedText = items.filter(item => state.value.includes(item.value)).map(item => item.label).join(", ")
  view
    SelectRoot(state=state, change=change)
      SelectTrigger(state=state)
        SelectValue(text=selectedText, empty=(state.value.length == 0), placeholder=placeholder)
        SelectIndicator()
      SelectPortal()
        SelectPositioner(state=state)
          SelectPopover()
            SelectList(state=state)
              for item, index in items key=item.value
                SelectItem(state=state, item=item, index=index, change=change)
                  SelectItemIndicator(selected=state.value.includes(item.value))
                  SelectItemText()
                    text item.label
