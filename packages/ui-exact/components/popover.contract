use StyledPopoverPositioner, StyledPopoverTrigger, StyledPopoverClose from "./generated/popover-parts.contract"

shape PopoverState
  id: string
  label: string
  labelledBy: string
  describedBy: string
  side: string
  align: string
  direction: string
  sideOffset: number
  alignOffset: number
  collisionPadding: number
  collisionAvoidance: bool
  disableAnchorTracking: bool

component Popover
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="popover-root" data-slot="popover-root"
      children

component PopoverPortal
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="popover-portal" data-slot="popover-portal"
      children

component PopoverTrigger
  props
    id: string
    label: string
    target: string
    disabled: bool
    size: string
    variant: string
    openOnHover: bool
    delay: number
    closeDelay: number
  slot
  view
    StyledPopoverTrigger(id=id, label=label, target=target, disabled=disabled, size=size, variant=variant, openOnHover=openOnHover, delay=delay, closeDelay=closeDelay)
      children

component PopoverPositioner
  props
    state: PopoverState
  slot
  view
    StyledPopoverPositioner(id=state.id, side=state.side, align=state.align, direction=state.direction, sideOffset=state.sideOffset, alignOffset=state.alignOffset, collisionPadding=state.collisionPadding, collisionAvoidance=state.collisionAvoidance, disableAnchorTracking=state.disableAnchorTracking)
      children

component PopoverPopup
  props
    state: PopoverState
  slot
  view
    column id=`${state.id}-popup` testId=`${state.id}-popup` role="dialog" tabindex=-1
      aria-label=state.label aria-labelledby=state.labelledBy aria-describedby=state.describedBy
      hatch="lenso-ui" data-lenso-kind="popover-popup" data-slot="popover-popup"
      data-direction=state.direction data-material="thick"
      box aria-hidden=true hatch="lenso-ui" data-lenso-kind="popover-material" data-slot="popover-material"
        box aria-hidden=true hatch="lenso-ui" data-lenso-kind="popover-paint-blur"
        box aria-hidden=true hatch="lenso-ui" data-lenso-kind="popover-paint-upper"
        box aria-hidden=true hatch="lenso-ui" data-lenso-kind="popover-paint-lower"
      children

component PopoverArrow
  props
    state: PopoverState
  view
    box aria-hidden=true hatch="lenso-ui" data-lenso-kind="popover-arrow" data-slot="popover-arrow"
      data-side=state.side data-direction=state.direction
      box aria-hidden=true hatch="lenso-ui" data-lenso-kind="popover-arrow-material" data-slot="popover-arrow-material"

component PopoverTitle
  props
    id: string
    level: number
  slot
  view
    box id=id role="heading" aria-level=level hatch="lenso-ui" data-lenso-kind="popover-title" data-slot="popover-title"
      children

component PopoverDescription
  props
    id: string
  slot
  view
    box id=id role="paragraph" hatch="lenso-ui" data-lenso-kind="popover-description" data-slot="popover-description"
      children

component PopoverViewport
  slot
  view
    box hatch="lenso-ui" data-lenso-kind="popover-viewport" data-slot="popover-viewport"
      children

component PopoverClose
  props
    id: string
    label: string
    target: string
    disabled: bool
    size: string
    variant: string
  slot
  view
    StyledPopoverClose(id=id, label=label, target=target, disabled=disabled, size=size, variant=variant)
      children
