  ],
  "type": "module",
  "exports": {
    ".": "./index.contract",
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/browser.js"
    },
    "./stage": "./scripts/stage.ts",
    "./manifest": "./manifest.json",
    "./styles.css": "./dist/web.css",
    "./presentation": {
      "types": "./dist/presentation.d.ts",
      "import": "./dist/presentation.js"
    },
    "./atomic.css": "./dist/web.atomic.css"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "generate:primitives": "bun scripts/primitive-bridge.ts",
    "probe:primitives": "bun scripts/probe-primitives.ts",
    "typecheck": "bun check --no-script -p tsconfig.json",
    "test": "bun test test/*.test.ts",
    "test:browser": "bun run build && bun test/browser.mjs",
    "example:build": "bun run build && bun scripts/example.ts",
    "test:glass-capture": "bun test/visual-capabilities.mjs",
    "test:swipe": "bun test/swipe-browser.mjs",
    "test:color": "bun test/color-browser.mjs",
    "test:color-field": "bun test/color-field-browser.mjs",
    "test:color-slider": "bun test/color-slider-browser.mjs",
    "test:color-area": "bun test/color-area-browser.mjs",
    "test:color-picker": "bun test/color-picker-browser.mjs",
    "test:list-box": "bun test/list-box-browser.mjs",
    "test:tags": "bun test/tag-browser.mjs",
    "test:combo-box": "bun test/combo-box-browser.mjs",
    "test:autocomplete": "bun test/autocomplete-browser.mjs",
    "test:input-otp": "bun test/input-otp-browser.mjs",
    "test:popup-button": "bun test/popup-button-browser.mjs",
    "test:section-index": "bun test/section-index-browser.mjs",
    "test:tab-bar": "bun test/tab-bar-browser.mjs",
    "test:refresh-control": "bun test/refresh-control-browser.mjs",
    "test:refresh-control-initial": "bun test/refresh-control-initial.mjs",
    "test:context-menu": "bun test/context-menu-browser.mjs && bun test/context-menu-touch.mjs && bun test/context-menu-release.mjs",
    "test:glass-magnifier": "bun test/glass-magnifier-browser.mjs && bun test/glass-magnifier-elastic.mjs",
    "test:wheel-picker": "bun test/wheel-picker-browser.mjs",
    "test:navigation-bar": "bun test/navigation-bar-browser.mjs && bun test/navigation-bar-initial.mjs",
    "test:glass-toggle": "bun test/glass-toggle-browser.mjs && bun test/glass-toggle-initial.mjs",
    "test:context-menu-preview": "bun test/context-menu-preview-browser.mjs",
    "test:context-menu-bar": "bun test/context-menu-bar-browser.mjs && bun test/context-menu-bar-initial.mjs && bun test/context-menu-bar-touch.mjs",
    "test:date-field": "bun test/date-field-browser.mjs",
    "test:time-field": "bun test/time-field-browser.mjs",
    "test:calendar": "bun test/calendar-browser.mjs",
    "test:calendar-years": "bun test/calendar-year-picker-browser.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@internationalized/date": "3.12.4",
    "@lenso/glass": "workspace:*",
    "@lenso/tokens": "workspace:*",
    "@stylexjs/stylex": "catalog:",
    "postcss": "8.5.32",
    "postcss-selector-parser": "7.1.0",
    "react-stately": "3.51.0"
  },
  "devDependencies": {
    "@lenso/primitives-exact": "workspace:*",
    "@stylexjs/unplugin": "catalog:",
    "@types/bun": "^1.4.4",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
