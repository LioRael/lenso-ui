{
  "name": "@lenso/ui-exact",
  "version": "0.1.0",
  "private": true,
  "description": "Lenso Contract components and Web materials for Exact.",
  "license": "(Apache-2.0 AND MIT AND LGPL-2.0-or-later)",
  "files": [
    "index.contract",
    "components",
    "manifest.json",
    "COMPONENTS.md",
    "FEEDBACK.md",
    "FORMS.md",
    "TOGGLES.md",
    "DISCLOSURE.md",
    "NAVIGATION.md",
    "MODAL.md",
    "ALERT_DIALOG.md",
    "CONTENT.md",
    "VISUAL_CAPTURE.md",
    "STYLING.md",
    "INITIAL_STYLES.md",
    "dist",
    "scripts/stage.ts",
    "README.md",
    "scripts/initial-css.ts",
    "NOTICES.md",
    "LAYOUT.md",
    "SEMANTIC_GAPS.md",
    "AVATAR.md",
    "SWITCH.md",
    "SLIDER.md",
    "TABS.md",
    "SEGMENTED_CONTROL.md",
    "BUTTON_GROUP.md",
    "PAGE_CONTROL.md",
    "SCROLL_SHADOW.md"
  ],
  "type": "module",
  "exports": {
    ".": "./index.contract",
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/browser.js"
    },
    "./stage": "./scripts/stage.ts",
    "./manifest": "./manifest.json",
    "./styles.css": "./dist/web.css",
    "./presentation": {
      "types": "./dist/presentation.d.ts",
      "import": "./dist/presentation.js"
    },
    "./atomic.css": "./dist/web.atomic.css"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "bun check --no-script -p tsconfig.json",
    "test": "bun test test/*.test.ts",
    "test:browser": "bun run build && bun test/browser.mjs",
    "example:build": "bun run build && bun scripts/example.ts",
    "test:glass-capture": "bun test/visual-capabilities.mjs"
  },
  "dependencies": {
    "@lenso/glass": "workspace:*",
    "@lenso/tokens": "workspace:*",
    "@stylexjs/stylex": "catalog:",
    "postcss": "8.5.32",
    "postcss-selector-parser": "7.1.0"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "catalog:",
    "@types/bun": "^1.4.4",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
