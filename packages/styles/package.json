{
  "name": "@lenso/tokens",
  "version": "0.9.1",
  "description": "HeroUI default theme and StyleX constants for Lenso UI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LioRael/lenso-ui.git",
    "directory": "packages/styles"
  },
  "files": [
    "dist",
    "src/tokens.stylex.const.ts",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./stylex-rules.json": "./dist/stylex-rules.json",
    "./tokens.stylex.const": {
      "types": "./dist/tokens.stylex.const.d.ts",
      "source": "./src/tokens.stylex.const.ts",
      "import": "./src/tokens.stylex.const.ts"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node src/components/typography/generate-prose.mjs && tsdown --config tsdown.config.ts && tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --noEmit false --outDir dist && node scripts/copy-css.mjs",
    "build:dev": "node src/components/typography/generate-prose.mjs && tsdown --config tsdown.config.ts && node scripts/copy-css.mjs",
    "dev": "tsdown --config tsdown.config.ts --watch --no-clean",
    "test": "node src/components/typography/generate-prose.mjs --check && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stylexjs/stylex": "catalog:"
  },
  "devDependencies": {
    "@lenso/stylex-build": "workspace:*",
    "@types/node": "catalog:",
    "playwright": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
