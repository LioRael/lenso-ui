component TabsList
  props
    id: string
    label: string
    orientation: string
  slot
  view
    row id=id testId=id role="tablist" aria-label=label aria-orientation=orientation
      children

component Tab
  props
    id: string
    label: string
    panel: string
    value: string
    selected: string
    disabled: bool
    change: action
  slot
  view
    button id=id testId=id role="tab" aria-label=label aria-selected=(selected == value)
      aria-controls=panel disabled=disabled tabindex=(selected == value ? 0 : -1) press=change(value)
      children

component TabPanel
  props
    id: string
    tab: string
    value: string
    selected: string
  slot
  view
    column id=id testId=id role="tabpanel" aria-labelledby=tab tabindex=0
      display=(selected == value ? "flex" : "none") inert=(selected != value)
      children
