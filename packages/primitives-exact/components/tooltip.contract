shape TooltipState
  hovered: bool
  overContent: bool
  focused: bool
  dismissed: bool
  open: bool
  due: number

fn TooltipInitial(): TooltipState = TooltipState(hovered=false, overContent=false, focused=false, dismissed=false, open=false, due=-1)

// A deadline belongs to one continuous intent; moving into the popup cancels closing.
fn TooltipResolve(s: TooltipState, hovered: bool, overContent: bool, focused: bool, blocked: bool, now: number, delay: number, closeDelay: number): TooltipState =
  TooltipState(
    hovered=hovered,
    overContent=overContent,
    focused=focused,
    dismissed=blocked,
    open=(not blocked and (
      focused or
      ((hovered or overContent) and (s.open or delay <= 0)) or
      (s.open and not hovered and not overContent and closeDelay > 0)
    )),
    due=(
      blocked or focused ? -1 :
      hovered or overContent ? (
        s.open or delay <= 0 ? -1 :
        s.due >= 0 and (s.hovered or s.overContent) ? s.due : now + max(0, delay)
      ) :
      s.open and closeDelay > 0 ? (
        s.due >= 0 and not s.hovered and not s.overContent and not s.focused ? s.due : now + closeDelay
      ) : -1
    )
  )

fn TooltipIntent(s: TooltipState, hovered: bool, overContent: bool, focused: bool, now: number, delay: number, closeDelay: number): TooltipState =
  TooltipResolve(s, hovered, overContent, focused, s.dismissed and (hovered or overContent or focused), now, delay, closeDelay)

fn TooltipHover(s: TooltipState, on: bool, now: number, delay: number, closeDelay: number): TooltipState = TooltipIntent(s, on, s.overContent, s.focused, now, delay, closeDelay)
fn TooltipContentHover(s: TooltipState, on: bool, now: number, delay: number, closeDelay: number): TooltipState = TooltipIntent(s, s.hovered, on, s.focused, now, delay, closeDelay)
fn TooltipFocus(s: TooltipState, on: bool, now: number, delay: number, closeDelay: number): TooltipState = TooltipIntent(s, s.hovered, s.overContent, on, now, delay, closeDelay)
fn TooltipDismiss(s: TooltipState): TooltipState = TooltipState(hovered=s.hovered, overContent=false, focused=s.focused, dismissed=(s.hovered or s.focused), open=false, due=-1)
fn TooltipTick(s: TooltipState, now: number): TooltipState = s.due < 0 or now < s.due ? s : TooltipState(hovered=s.hovered, overContent=s.overContent, focused=s.focused, dismissed=s.dismissed, open=(not s.dismissed and (s.hovered or s.overContent or s.focused)), due=-1)

component TooltipTrigger
  props
    id: string
    label: string
    target: string
    description: string
    state: TooltipState
    delay: number
    closeDelay: number
    disabled: bool
    change: action
    press: action
  slot
  action hover(on: bool)
    if not disabled
      change(TooltipHover(state, on, performanceNow(), delay, closeDelay))
  action entered
    if not disabled
      change(TooltipFocus(state, true, performanceNow(), delay, closeDelay))
  action left
    change(TooltipFocus(state, false, performanceNow(), delay, closeDelay))
  action dismiss
    change(TooltipDismiss(state))
  action keyed(name: string)
    if name == "Escape" and (state.open or state.due >= 0)
      preventDefault()
      stopPropagation()
      dismiss()
  action activate
    dismiss()
    if not disabled
      press()
  view
    button id=id testId=id aria-label=label aria-describedby=(description == "" ? target : `${description} ${target}`)
      disabled=disabled hover=hover focus=entered blur=left key=keyed press=activate
      children

// Text-only content cannot accidentally create focusable controls inside a tooltip.
component Tooltip
  props
    id: string
    message: string
    state: TooltipState
    delay: number
    closeDelay: number
    change: action
  action hover(on: bool)
    change(TooltipContentHover(state, on, performanceNow(), delay, closeDelay))
  view
    column id=id testId=id role="tooltip" popover="manual" hover=hover
      position-area="top" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline"
      text message
