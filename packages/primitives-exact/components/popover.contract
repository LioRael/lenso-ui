component Popover
  props
    id: string
    label: string
  slot
  view
    column id=id testId=id popover="auto" role="dialog" aria-label=label
      children

component PopoverTrigger
  props
    id: string
    label: string
    target: string
    disabled: bool
  slot
  view
    button id=id testId=id aria-label=label popovertarget=target disabled=disabled
      children

component PopoverClose
  props
    id: string
    label: string
    target: string
  slot
  view
    button id=id testId=id aria-label=label commandfor=target command="hide-popover"
      children

component Menu
  props
    id: string
    label: string
  slot
  view
    column id=id testId=id popover="auto" role="menu" aria-label=label
      children

component MenuItem
  props
    id: string
    label: string
    target: string
    disabled: bool
    press: action
  slot
  view
    button id=id testId=id role="menuitem" aria-label=label disabled=disabled press=press
      commandfor=target command="hide-popover"
      children

component MenuSubmenuTrigger
  props
    id: string
    label: string
    target: string
    disabled: bool
  slot
  view
    button id=id testId=id role="menuitem" aria-label=label popovertarget=target disabled=disabled
      children
