component Checkbox
  props
    id: string
    label: string
    description: string
    checked: bool
    disabled: bool
    change: action
  view
    input type="checkbox" id=id testId=id aria-label=label aria-describedby=description
      checked=checked disabled=disabled change=change

component Switch
  props
    id: string
    label: string
    description: string
    checked: bool
    disabled: bool
    change: action
  view
    input type="checkbox" switch id=id testId=id aria-label=label aria-describedby=description
      checked=checked disabled=disabled change=change

component RadioGroup
  props
    id: string
    label: string
  slot
  view
    column id=id testId=id role="radiogroup" aria-label=label
      children

component Radio
  props
    id: string
    name: string
    label: string
    value: string
    selected: string
    disabled: bool
    change: action
  view
    input type="radio" id=id testId=id name=name aria-label=label value=value
      checked=(selected == value) disabled=disabled change=change

component Select
  props
    id: string
    label: string
    description: string
    value: string
    disabled: bool
    change: action
  slot
  view
    select id=id testId=id aria-label=label aria-describedby=description value=value disabled=disabled change=change
      children

component SelectOption
  props
    label: string
    value: string
    disabled: bool
  view
    option label value=value disabled=disabled

component Slider
  props
    id: string
    label: string
    description: string
    value: number
    min: number
    max: number
    step: number
    disabled: bool
    input: action
    change: action
  view
    input type="range" id=id testId=id aria-label=label aria-describedby=description
      value=value min=min max=max step=step disabled=disabled input=input change=change
