component Progress
  props
    id: string
    label: string
    value: number
    max: number
  view
    progress id=id testId=id aria-label=label value=value max=max

component Status
  props
    id: string
    message: string
  view
    text message id=id testId=id role="status" aria-live="polite" aria-atomic=true

component Separator
  props
    id: string
  view
    hr id=id testId=id
