shape DisclosureState
  id: string
  open: bool
  disabled: bool

shape AccordionState
  id: string
  value: string[]
  multiple: bool
  disabled: bool

shape AccordionItemState
  id: string
  value: string
  disabled: bool

component Disclosure
  props
    state: DisclosureState
  slot
  view
    column id=state.id testId=state.id
      children

component DisclosureTrigger
  props
    state: DisclosureState
    label: string
    change: action
  slot
  view
    button id=`${state.id}-trigger` testId=`${state.id}-trigger` aria-label=label
      aria-expanded=state.open aria-controls=`${state.id}-panel` disabled=state.disabled
      press=change(not state.open)
      children

component DisclosurePanel
  props
    state: DisclosureState
  slot
  view
    column id=`${state.id}-panel` testId=`${state.id}-panel` role="region"
      aria-labelledby=`${state.id}-trigger` display=(state.open ? "flex" : "none") inert=(not state.open)
      children

component Accordion
  props
    state: AccordionState
  slot
  view
    column id=state.id testId=state.id
      children

component AccordionItem
  props
    item: AccordionItemState
  slot
  view
    column id=item.id testId=item.id
      children

component AccordionTrigger
  props
    state: AccordionState
    item: AccordionItemState
    label: string
    change: action
  derive expanded = state.value.includes(item.value)
  action toggle
    if not state.disabled and not item.disabled
      if expanded
        change(state.value.filter(value => value != item.value))
      else
        change(state.multiple ? state.value.concat([item.value]) : [item.value])
  slot
  view
    button id=`${item.id}-trigger` testId=`${item.id}-trigger` aria-label=label
      aria-expanded=expanded aria-controls=`${item.id}-panel` disabled=(state.disabled or item.disabled) press=toggle
      children

component AccordionPanel
  props
    state: AccordionState
    item: AccordionItemState
  derive expanded = state.value.includes(item.value)
  slot
  view
    column id=`${item.id}-panel` testId=`${item.id}-panel` role="region"
      aria-labelledby=`${item.id}-trigger` display=(expanded ? "flex" : "none") inert=(not expanded)
      children
