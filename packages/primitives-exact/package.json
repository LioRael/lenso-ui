{
  "name": "@lenso/primitives-exact",
  "version": "0.1.0",
  "private": true,
  "description": "Composable Contract controls for unmodified Expo Exact.",
  "license": "MIT",
  "files": [
    "index.contract",
    "components",
    "COMPOSITION.md",
    "TOOLTIP.md",
    "VERIFICATION.md",
    "README.md",
    "LICENSE",
    "API.md",
    "COMPILER.md"
  ],
  "type": "module",
  "exports": {
    ".": "./index.contract",
    "./button": "./components/button.contract",
    "./field": "./components/field.contract",
    "./choice": "./components/choice.contract",
    "./disclosure": "./components/disclosure.contract",
    "./dialog": "./components/dialog.contract",
    "./popover": "./components/popover.contract",
    "./tabs": "./components/tabs.contract",
    "./feedback": "./components/feedback.contract",
    "./tooltip": "./components/tooltip.contract"
  },
  "scripts": {
    "example:build": "bun scripts/example.ts",
    "typecheck": "bun check --no-script -p tsconfig.json",
    "test:browser": "bun test/browser.mjs",
    "test:agent": "bun scripts/agent.ts web",
    "test:native": "bun scripts/native.ts",
    "test:contracts": "bun scripts/contracts.ts",
    "test:baseline": "bun scripts/baseline.ts",
    "research:host-patches": "bun scripts/host-patches.ts",
    "research:contracts": "bun scripts/contracts.ts --proposal",
    "test:agent:experimental": "EXACT_AGENT_SCOPE=all bun scripts/agent.ts web",
    "test:browser:experimental": "EXACT_BROWSER_SCOPE=lifecycle bun test/browser.mjs"
  }
}
