+export async function mapComments<Node, Comment>(
+  nodes: readonly Node[],
+  toComment: (node: Node) => Comment,
+): Promise<Comment[]> {
+  const comments: Comment[] = [];
+  for (let i = 0; i < nodes.length; i++) {
+    if (i % 2000 === 1999) await scheduler.yield();
+    comments.push(toComment(nodes[i]));
+  }
+  return comments;
 }
 ```
 
