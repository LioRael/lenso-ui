diff --git a/contract/analyze/src/relationships.rs b/contract/analyze/src/relationships.rs
new file mode 100644
--- /dev/null
+++ b/contract/analyze/src/relationships.rs
@@ -0,0 +1,376 @@
+//! Statically decidable command and accessibility edges in the expanded view.
+
+use super::{AnalyzeError, Related};
+use contract_syntax::{Attr, BinOp, Component, Expr, Node, Span, Stmt, TemplatePart};
+use std::collections::BTreeMap;
+
+struct Element<'a> {
+    tag: &'a str,
+    attrs: &'a [Attr],
+    positional: &'a [Expr],
+    children: &'a [Node],
+    span: Span,
+    arms: Vec<(u32, bool)>,
+}
+
+fn attr<'a>(attrs: &'a [Attr], name: &str) -> Option<&'a Attr> {
+    attrs.iter().find(|a| a.name == name)
+}
+
+fn literal(expr: &Expr) -> Option<String> {
+    match expr {
+        Expr::Str(value, _) => Some(value.clone()),
+        Expr::Typed(value, ..) => literal(value),
+        Expr::Template(parts, _) => parts
+            .iter()
+            .map(|part| match part {
+                TemplatePart::Text(value) => Some(value.clone()),
+                TemplatePart::Expr(value) => literal(value),
+            })
+            .collect(),
+        Expr::Binary(BinOp::Add, left, right, _) => Some(literal(left)? + &literal(right)?),
+        Expr::Ternary(_, left, right, _) => {
+            let left = literal(left)?;
+            (literal(right)? == left).then_some(left)
+        }
+        _ => None,
+    }
+}
+
+fn collect<'a>(nodes: &'a [Node], arms: &mut Vec<(u32, bool)>, out: &mut Vec<Element<'a>>) {
+    for node in nodes {
+        match node {
+            Node::Element {
+                tag,
+                attrs,
+                positional,
+                children,
+                span,
+                ..
+            } => {
+                out.push(Element {
+                    tag,
+                    attrs,
+                    positional,
+                    children,
+                    span: *span,
+                    arms: arms.clone(),
+                });
+                collect(children, arms, out);
+            }
+            Node::When {
+                tag,
+                then,
+                otherwise,
+                ..
+            } => {
+                arms.push((*tag, true));
+                collect(then, arms, out);
+                arms.pop();
+                arms.push((*tag, false));
+                collect(otherwise, arms, out);
+                arms.pop();
+            }
+            Node::Match {
+                tag, some, none, ..
+            } => {
+                arms.push((*tag, true));
+                collect(&some.1, arms, out);
+                arms.pop();
+                arms.push((*tag, false));
+                collect(none, arms, out);
+                arms.pop();
+            }
+            Node::Each { body, .. } => collect(body, arms, out),
+            Node::Use { .. } | Node::Children { .. } => {}
+        }
+    }
+}
+
+fn coexist(left: &Element<'_>, right: &Element<'_>) -> bool {
+    !left.arms.iter().any(|(tag, arm)| {
+        right
+            .arms
+            .iter()
+            .any(|(other, value)| tag == other && arm != value)
+    })
+}
+
+// Unknown text stays unknown: this is not a replacement for the Host's name computation.
+fn text(element: &Element<'_>) -> Option<String> {
+    if let Some(label) = attr(element.attrs, "aria-label") {
+        return literal(&label.value);
+    }
+    if attr(element.attrs, "aria-labelledby").is_some() {
+        return None;
+    }
+    if !matches!(
+        element.tag,
+        "text" | "span" | "row" | "column" | "button" | "link"
+    ) {
+        return None;
+    }
+    let mut result = String::new();
+    if element.tag == "text" {
+        for value in element.positional {
+            result.push_str(&literal(value)?);
+        }
+    }
+    for child in element.children {
+        match child {
+            Node::Element {
+                tag,
+                attrs,
+                positional,
+                children,
+                span,
+                ..
+            } => {
+                result.push_str(&text(&Element {
+                    tag,
+                    attrs,
+                    positional,
+                    children,
+                    span: *span,
+                    arms: Vec::new(),
+                })?);
+            }
+            _ => return None,
+        }
+    }
+    Some(result)
+}
+
+fn finding(
+    id: &'static str,
+    message: String,
+    span: Span,
+    target: Option<&Element<'_>>,
+) -> AnalyzeError {
+    AnalyzeError {
+        id,
+        message,
+        span,
+        related: target
+            .map(|target| Related {
+                span: attr(target.attrs, "id")
+                    .map(|a| a.value.span())
+                    .unwrap_or(target.span),
+                note: "target declared here".into(),
+            })
+            .into_iter()
+            .collect(),
+    }
+}
+
+fn wrong_kind(operation: &str, target: &Element<'_>) -> bool {
+    match operation {
+        "show-modal" | "close" => target.tag != "dialog",
+        "show-popover" | "hide-popover" | "toggle-popover" => {
+            attr(target.attrs, "popover").is_none()
+        }
+        _ => false,
+    }
+}
+
+fn commands<'a>(body: &'a [Stmt], out: &mut Vec<(&'a str, &'a [Expr], Span)>) {
+    for stmt in body {
+        match stmt {
+            Stmt::Command { name, args, span } => out.push((name, args, *span)),
+            Stmt::If {
+                then, otherwise, ..
+            } => {
+                commands(then, out);
+                commands(otherwise, out);
+            }
+            Stmt::Match { some, none, .. } => {
+                commands(&some.1, out);
+                commands(none, out);
+            }
+            // Callees are also declared in the expanded root's action table.
+            _ => {}
+        }
+    }
+}
+
+pub(super) fn check(root: &Component) -> Vec<AnalyzeError> {
+    let nodes = &root.view;
+    let mut elements = Vec::new();
+    collect(nodes, &mut Vec::new(), &mut elements);
+    let mut ids: BTreeMap<String, Vec<usize>> = BTreeMap::new();
+    let mut dynamic = Vec::new();
+    for (index, element) in elements.iter().enumerate() {
+        if let Some(id) = attr(element.attrs, "id") {
+            if let Some(value) = literal(&id.value) {
+                ids.entry(value).or_default().push(index);
+            } else {
+                dynamic.push(index);
+            }
+        }
+    }
+    let candidates = |source: &Element<'_>, id: &str| -> Vec<&Element<'_>> {
+        ids.get(id)
+            .into_iter()
+            .flatten()
+            .map(|&i| &elements[i])
+            .filter(|target| coexist(source, target))
+            .collect()
+    };
+    let unresolved = |source: &Element<'_>| dynamic.iter().any(|&i| coexist(source, &elements[i]));
+    let mut errors = Vec::new();
+    for source in &elements {
+        for reference in source.attrs.iter().filter(|a| {
+            matches!(
+                a.name.as_str(),
+                "commandfor"
+                    | "popovertarget"
+                    | "aria-labelledby"
+                    | "aria-describedby"
+                    | "aria-controls"
+            )
+        }) {
+            let Some(value) = literal(&reference.value) else {
+                continue;
+            };
+            let command = matches!(reference.name.as_str(), "commandfor" | "popovertarget");
+            // An empty native invoker target is deliberately unbound, not a missing edge.
+            if command && value.is_empty() {
+                continue;
+            }
+            if command && (value.trim().is_empty() || value.split_whitespace().count() != 1) {
+                errors.push(finding(
+                    "analyze-command-target",
+                    format!("`{}` needs one nonempty target ID", reference.name),
+                    reference.value.span(),
+                    None,
+                ));
+                continue;
+            }
+            let names = if command {
+                vec![value.as_str()]
+            } else {
+                value.split_whitespace().collect()
+            };
+            for name in names {
+                let targets = candidates(source, name);
+                if targets.is_empty() {
+                    if !unresolved(source) {
+                        errors.push(finding(
+                            if command {
+                                "analyze-command-target"
+                            } else {
+                                "analyze-aria-reference"
+                            },
+                            format!(
+                                "`{}` names `{name}`, but no compatible element declares that ID",
+                                reference.name
+                            ),
+                            reference.value.span(),
+                            ids.get(name)
+                                .and_then(|indices| indices.first())
+                                .map(|&i| &elements[i]),
+                        ));
+                    }
+                    continue;
+                }
+                let operation = if reference.name == "popovertarget" {
+                    Some("toggle-popover".into())
+                } else if command {
+                    attr(source.attrs, "command").and_then(|a| literal(&a.value))
+                } else {
+                    None
+                };
+                if !unresolved(source)
+                    && operation
+                        .as_deref()
+                        .is_some_and(|op| targets.iter().all(|target| wrong_kind(op, target)))
+                {
+                    errors.push(finding(
+                        "analyze-command-kind",
+                        format!(
+                            "`{}` target `{name}` does not support `{}`",
+                            reference.name,
+                            operation.unwrap_or_default()
+                        ),
+                        reference.value.span(),
+                        targets.first().copied(),
+                    ));
+                }
+            }
+        }
+        let role = attr(source.attrs, "role").and_then(|a| literal(&a.value));
+        if source.tag != "dialog" && !matches!(role.as_deref(), Some("dialog" | "alertdialog")) {
+            continue;
+        }
+        let label = attr(source.attrs, "aria-label");
+        let labelled = attr(source.attrs, "aria-labelledby");
+        let named = if let Some(reference) = labelled {
+            match literal(&reference.value) {
+                None => true,
+                Some(value) if !value.trim().is_empty() => {
+                    let targets: Vec<_> = value
+                        .split_whitespace()
+                        .flat_map(|id| candidates(source, id))
+                        .collect();
+                    // Missing edges have their own diagnostic; dynamic IDs/text require runtime observation.
+                    targets.is_empty()
+                        || unresolved(source)
+                        || targets
+                            .iter()
+                            .any(|target| text(target).is_none_or(|value| !value.trim().is_empty()))
+                }
+                _ => label.is_some_and(|a| {
+                    literal(&a.value).is_none_or(|value| !value.trim().is_empty())
+                }),
+            }
+        } else {
+            label.is_some_and(|a| literal(&a.value).is_none_or(|value| !value.trim().is_empty()))
+        };
+        if !named {
+            errors.push(finding("analyze-dialog-name", "Dialog needs a nonempty `aria-label` or `aria-labelledby` naming nonempty text; its body or description is not its name".into(), label.map(|a| a.value.span()).unwrap_or(source.span), None));
+        }
+    }
+    let mut calls = Vec::new();
+    for action in &root.actions {
+        commands(&action.body, &mut calls);
+    }
+    for (name, args, span) in calls {
+        let operation = match name {
+            "showModal" => "show-modal",
+            "close" => "close",
+            "showPopover" => "show-popover",
+            "hidePopover" => "hide-popover",
+            "togglePopover" => "toggle-popover",
+            _ => continue,
+        };
+        let Some(id) = args.first().and_then(literal) else {
+            continue;
+        };
+        // Action calls have no authored branch location; conditional targets remain a runtime obligation.
+        let targets: Vec<_> = ids
+            .get(&id)
+            .into_iter()
+            .flatten()
+            .map(|&i| &elements[i])
+            .collect();
+        if !dynamic.is_empty() {
+            continue;
+        }
+        if targets.is_empty() {
+            errors.push(finding(
+                "analyze-command-target",
+                format!("`{name}` names `{id}`, but no element declares that ID"),
+                span,
+                None,
+            ));
+        } else if targets.iter().all(|target| wrong_kind(operation, target)) {
+            errors.push(finding(
+                "analyze-command-kind",
+                format!("`{name}` target `{id}` does not support `{operation}`"),
+                span,
+                targets.first().copied(),
+            ));
+        }
+    }
+    errors
+}
