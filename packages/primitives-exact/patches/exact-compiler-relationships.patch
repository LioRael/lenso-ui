+++ b/contract/cli/tests/relationships.rs
@@ -0,0 +1,166 @@
+//! Expanded command/ARIA edges fail before any Host runs.
+
+#[path = "it/alert_parts.rs"]
+mod alert_parts;
+#[path = "it/blocks.rs"]
+mod blocks;
+#[path = "it/geometry.rs"]
+mod geometry;
+#[path = "it/menus.rs"]
+mod menus;
+#[path = "it/top_layer_inheritance.rs"]
+mod top_layer_inheritance;
+
+fn compile(source: &str) -> Result<(), Vec<contract::CompileError>> {
+    contract::compile_path_source_all(
+        std::path::Path::new("relationships.contract"),
+        source,
+        false,
+    )
+    .map(|_| ())
+}
+
+fn refuses(body: &str, id: &str) {
+    let source = format!("component App\n  view\n    column\n{body}");
+    let errors = compile(&source).expect_err(&source);
+    assert!(errors.iter().any(|e| e.id == id), "{errors:?}");
+}
+
+#[test]
+fn literal_command_edges_check_identity_and_kind() {
+    refuses(
+        "      button commandfor=\"gone\" command=\"show-modal\"\n",
+        "analyze-command-target",
+    );
+    refuses(
+        "      button commandfor=\"box\" command=\"show-modal\"\n      column id=\"box\"\n",
+        "analyze-command-kind",
+    );
+    refuses(
+        "      button popovertarget=\"box\"\n      column id=\"box\"\n",
+        "analyze-command-kind",
+    );
+    refuses(
+        "      button commandfor=\"two ids\" command=\"close\"\n",
+        "analyze-command-target",
+    );
+    let errors = compile("component App\n  action open\n    showModal(\"missing\")\n  view\n    button press=open\n      text \"Open\"\n").unwrap_err();
+    assert!(errors.iter().any(|e| e.id == "analyze-command-target"));
+}
+
+#[test]
+fn native_empty_targets_remain_unbound() {
+    compile(
+        r#"component App
+  view
+    column
+      button commandfor="" command="show-modal"
+        text "Unbound dialog"
+      button popovertarget=""
+        text "Unbound popover"
+"#,
+    )
+    .unwrap();
+}
+
+#[test]
+fn dialog_names_and_all_aria_tokens_are_checked() {
+    refuses(
+        "      dialog\n        text \"Body is not a title\"\n",
+        "analyze-dialog-name",
+    );
+    refuses(
+        "      column role=\"alertdialog\" aria-label=\"  \"\n",
+        "analyze-dialog-name",
+    );
+    refuses(
+        "      dialog aria-labelledby=\"title\"\n      text \"  \" id=\"title\"\n",
+        "analyze-dialog-name",
+    );
+    for property in ["aria-labelledby", "aria-describedby", "aria-controls"] {
+        refuses(
+            &format!(
+                "      button {property}=\"found missing\"\n      text \"Title\" id=\"found\"\n"
+            ),
+            "analyze-aria-reference",
+        );
+    }
+    let errors = compile("component App\n  view\n    column\n      button commandfor=\"absent\" command=\"show-modal\" aria-describedby=\"unknown\"\n      dialog\n").unwrap_err();
+    for id in [
+        "analyze-command-target",
+        "analyze-aria-reference",
+        "analyze-dialog-name",
+    ] {
+        assert!(errors.iter().any(|e| e.id == id), "{errors:?}");
+    }
+}
+
+#[test]
+fn expanded_props_slots_and_forward_references_compile() {
+    compile(
+        r#"component App
+  view
+    column
+      Trigger(target="settings")
+      Surface(id="settings", title="heading")
+        text "Settings" id="heading"
+      button popovertarget="help" aria-describedby="first second" aria-controls="settings"
+        text "Help"
+      column id="help" popover="auto"
+        text "Help text"
+      text "One" id="first"
+      text "Two" id="second"
+component Trigger
+  props
+    target: string
+  view
+    button commandfor=target command="show-modal"
+      text "Settings"
+component Surface
+  props
+    id: string
+    title: string
+  slot
+  view
+    dialog id=id aria-labelledby=title
+      children
+"#,
+    )
+    .unwrap();
+    refuses(
+        "      dialog aria-labelledby=\"missing\"\n",
+        "analyze-aria-reference",
+    );
+}
+
+#[test]
+fn mutually_exclusive_edges_fail_but_dynamic_lifetimes_are_not_guessed() {
+    let errors = compile(
+        r#"component App
+  state show = true
+  view
+    if show
+      button commandfor="other" command="show-modal"
+    else
+      dialog id="other" aria-label="Other"
+"#,
+    )
+    .unwrap_err();
+    assert!(errors.iter().any(|e| e.id == "analyze-command-target"));
+    compile(
+        r#"component App
+  state show = true
+  state target = "later"
+  state title = "Name"
+  view
+    column
+      button commandfor=target command="show-modal"
+        text "Open dynamic"
+      button commandfor="later" command="show-modal"
+        text "Open conditional"
+      if show
+        dialog id="later" aria-label=title
+"#,
+    )
+    .unwrap();
+}
