+// WebKit's command invokers leave controls in a covered dialog focusable.
+// A modal escapes an inert ancestor; block only the other open dialogs and
+// restore the author's value when they become the front scope or close.
+const coveredDialogs = new Set();
+export function syncDialogInert(closing) {
+  if (!globalThis.document) return;
+  const dialogs = [...document.querySelectorAll('dialog:modal')].filter(el => el !== closing);
+  const front = dialogs.reduce((top, el) => !top || (el.exactOpened ?? 0) >= (top.exactOpened ?? 0) ? el : top, null);
+  const covered = new Set(dialogs.filter(el => el !== front));
+  for (const el of new Set([...coveredDialogs, ...covered])) {
+    el.authoredInert ??= el.inert;
+    el.exactModalInert = covered.has(el);
+    const inert = !!el.authoredInert || el.exactModalInert;
+    if (el.inert !== inert) el.inert = inert;
+  }
+  coveredDialogs.clear();
+  for (const el of covered) coveredDialogs.add(el);
+}
+globalThis.addEventListener?.('toggle', e => {
+  if (e.target.localName === 'dialog') syncDialogInert();
+}, true);
+globalThis.addEventListener?.('beforetoggle', e => {
+  // Release the preceding scope before close() restores its focus.
+  if (e.target.localName === 'dialog' && e.newState === 'closed') syncDialogInert(e.target);
+}, true);
+// Structural reads retain the front modal and presentations opened after it.
+export function modalLayers() {
+  const top = [...document.querySelectorAll('dialog:modal,:popover-open')];
+  const modals = top.filter(el => el.matches('dialog:modal'));
+  const front = Math.max(0, ...modals.map(el => el.exactOpened ?? 0));
+  return modals.length ? top.filter(el => (el.exactOpened ?? 0) >= front) : null;
+}
