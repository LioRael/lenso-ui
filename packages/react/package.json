{
  "name": "@lenso/ui",
  "version": "0.9.0",
  "description": "HeroUI source reconstruction with StyleX and Base UI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LioRael/lenso-ui.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts && tsc -p tsconfig.build.json --emitDeclarationOnly --noEmit false --outDir dist && node scripts/copy-notices.mjs",
    "dev": "tsdown --config tsdown.config.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@internationalized/date": "3.12.4",
    "@lenso/tokens": "workspace:*",
    "@stylexjs/stylex": "catalog:",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-stately": "3.50.0"
  },
  "devDependencies": {
    "@lenso/stylex-build": "workspace:*",
    "@types/node": "catalog:",
    "@types/pngjs": "6.0.5",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "axe-core": "catalog:",
    "playwright": "catalog:",
    "pngjs": "7.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.2.0 <20.0.0",
    "react-dom": ">=19.2.0 <20.0.0"
  }
}
