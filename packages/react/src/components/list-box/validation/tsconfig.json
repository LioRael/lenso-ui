{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@lenso/tokens/*": ["./packages/styles/src/components/*/index.ts"]
    }
  },
  "include": ["packages"],
  "exclude": ["**/validation/**"]
}
