{
  "name": "@lenso/ui-devtools",
  "version": "0.1.0",
  "private": true,
  "description": "Private documentation contracts and repository source analysis.",
  "type": "module",
  "exports": {
    "./contract": "./src/contract/index.ts",
    "./contract/*": "./src/contract/*.ts",
    "./policy": "./src/policy/index.ts",
    "./parser": "./src/parser.ts",
    "./testing": "./src/testing.ts"
