  "scripts": {
    "typecheck": "bun check --no-script --noEmit",
    "test": "bun test test/*.test.ts"
  },
  "dependencies": {
    "@babel/parser": "7.29.9"
  },
  "devDependencies": {
    "@babel/types": "7.29.8",
    "@types/bun": "^1.4.4",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
