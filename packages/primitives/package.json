{
  "name": "@lenso/primitives",
  "version": "0.8.0",
  "description": "Headless product primitives for Lenso UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LioRael/lenso-ui.git",
    "directory": "packages/primitives"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./sidebar": {
      "types": "./dist/sidebar/index.d.ts",
      "import": "./dist/sidebar/index.js"
    },
    "./sidebar/core": {
      "types": "./dist/sidebar/sidebar.d.ts",
      "import": "./dist/sidebar/sidebar.js"
    },
    "./section-index": {
      "types": "./dist/section-index/index.d.ts",
      "import": "./dist/section-index/index.js"
    },
    "./section-index/core": {
      "types": "./dist/section-index/section-index.d.ts",
      "import": "./dist/section-index/section-index.js"
    },
    "./swipe-actions": {
      "types": "./dist/swipe-actions/index.d.ts",
      "import": "./dist/swipe-actions/index.js"
    },
    "./swipe-actions/core": {
      "types": "./dist/swipe-actions/swipe-actions.d.ts",
      "import": "./dist/swipe-actions/swipe-actions.js"
    },
    "./model-control": {
      "types": "./dist/model-control/model-control.d.ts",
      "import": "./dist/model-control/model-control.js"
    },
    "./list/core": {
      "types": "./dist/list/list.d.ts",
      "import": "./dist/list/list.js"
    },
    "./wheel-picker/core": {
      "types": "./dist/wheel-picker/wheel-picker.d.ts",
      "import": "./dist/wheel-picker/wheel-picker.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts && tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --noEmit false --outDir dist",
    "test": "bun test --preload ../../tests/setup/dom.ts src",
    "typecheck": "bun check --no-script --noEmit"
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.1",
    "@ui-sdk/react": "0.1.0-beta.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.2.0 <20.0.0"
  }
}
