    "./icons": {
      "types": "./dist/icons.d.ts",
      "solid": "./dist/icons.jsx"
    }
  },
  "scripts": {
    "build": "bun -e 'import { rmSync } from \"node:fs\"; rmSync(\"dist\", { recursive: true, force: true });' && tsc -p tsconfig.json --noEmit false --declaration --outDir dist && cp ../../THIRD_PARTY_NOTICES.md dist/",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@lenso/glass": "workspace:*",
    "@lenso/primitives": "workspace:*",
    "@lenso/tokens": "workspace:*",
    "@stylexjs/stylex": "catalog:",
    "@ui-sdk/core": "0.1.0-beta.8",
    "@ui-sdk/solid": "0.1.0-beta.8"
  },
  "devDependencies": {
    "@solidjs/babel-plugin": "2.0.2",
    "@solidjs/vite-plugin": "3.0.1",
    "@solidjs/web": "2.0.3",
    "@stylexjs/unplugin": "catalog:",
    "playwright": "1.65.0",
    "solid-js": "2.0.3",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.3",
    "solid-js": "^2.0.3"
  }
}
