    },
    "./glass-magnifier": {
      "types": "./dist/glass-magnifier.d.ts",
      "solid": "./dist/glass-magnifier.jsx"
    },
    "./glass-toggle-button": {
      "types": "./dist/glass-toggle-button.d.ts",
      "solid": "./dist/glass-toggle-button.jsx"
    },
    "./glass": {
      "types": "./dist/glass.d.ts",
      "solid": "./dist/glass.jsx"
    },
    "./list": {
      "types": "./dist/list.d.ts",
      "solid": "./dist/list.jsx"
    },
    "./page-control": {
      "types": "./dist/page-control.d.ts",
