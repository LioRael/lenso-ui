  "private": true,
  "description": "Experimental Lenso UI components for Solid 2.",
  "license": "(Apache-2.0 AND MIT)",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
