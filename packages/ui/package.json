{
  "name": "@lenso/ui",
  "version": "0.1.0",
  "description": "Styled React foundation components for Lenso UI.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/assets/stylex.css",
    "./dist/preflight.css"
  ],
  "exports": {
    "./avatar": {
      "types": "./dist/avatar/index.d.ts",
      "import": "./dist/avatar/index.js"
    },
    "./breadcrumb": {
      "types": "./dist/breadcrumb/index.d.ts",
      "import": "./dist/breadcrumb/index.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox/index.d.ts",
      "import": "./dist/checkbox/index.js"
    },
    "./combobox": {
      "types": "./dist/combobox/index.d.ts",
      "import": "./dist/combobox/index.js"
    },
    "./command-menu": {
      "types": "./dist/command-menu/index.d.ts",
      "import": "./dist/command-menu/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js"
    },
    "./csp-provider": {
      "types": "./dist/csp-provider/index.d.ts",
      "import": "./dist/csp-provider/index.js"
    },
    "./dialog": {
      "types": "./dist/dialog/index.d.ts",
      "import": "./dist/dialog/index.js"
    },
    "./disclosure": {
      "types": "./dist/disclosure/index.d.ts",
      "import": "./dist/disclosure/index.js"
    },
    "./icon-button": {
      "types": "./dist/icon-button/index.d.ts",
      "import": "./dist/icon-button/index.js"
    },
    "./label": {
      "types": "./dist/label/index.d.ts",
      "import": "./dist/label/index.js"
    },
    "./page-header": {
      "types": "./dist/page-header/index.d.ts",
      "import": "./dist/page-header/index.js"
    },
    "./quick-link": {
      "types": "./dist/quick-link/index.d.ts",
      "import": "./dist/quick-link/index.js"
    },
    "./radio": {
      "types": "./dist/radio/index.d.ts",
      "import": "./dist/radio/index.js"
    },
    "./select": {
      "types": "./dist/select/index.d.ts",
      "import": "./dist/select/index.js"
    },
    "./sidebar": {
      "types": "./dist/sidebar/index.d.ts",
      "import": "./dist/sidebar/index.js"
    },
    "./switch": {
      "types": "./dist/switch/index.d.ts",
      "import": "./dist/switch/index.js"
    },
    "./text-field": {
      "types": "./dist/text-field/index.d.ts",
      "import": "./dist/text-field/index.js"
    },
    "./theme-scope": {
      "types": "./dist/theme-scope/index.d.ts",
      "import": "./dist/theme-scope/index.js"
    },
    "./styles.css": "./dist/assets/stylex.css",
    "./preflight.css": "./dist/preflight.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts && tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --noEmit false --outDir dist && node scripts/copy-assets.mjs",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lenso/primitives": "workspace:*",
    "@lenso/tokens": "workspace:*",
    "@stylexjs/stylex": "catalog:",
    "lucide-react": "catalog:"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:",
    "@fontsource/ibm-plex-sans": "catalog:",
    "@fontsource/inter": "catalog:",
    "@stylexjs/unplugin": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "axe-core": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "peerDependencies": {
    "@base-ui/react": ">=1.7.0 <2.0.0",
    "react": ">=19.2.0 <20.0.0",
    "react-dom": ">=19.2.0 <20.0.0"
  }
}
