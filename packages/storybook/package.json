{
  "name": "@lenso/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:packages": "turbo run build --filter=@lenso/ui --filter=@lenso/tokens --output-logs=errors-only",
    "dev": "pnpm prepare:packages && storybook dev -p 6006",
    "build": "pnpm prepare:packages && storybook build",
    "typecheck": "pnpm prepare:packages && tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test:browser": "tsx scripts/browser-proofs.ts"
  },
  "dependencies": {
    "@lenso/tokens": "workspace:*",
    "@lenso/ui": "workspace:*",
    "@stylexjs/stylex": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:",
    "@internationalized/date": "3.12.4",
    "@lenso/stylex-build": "workspace:*",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "playwright": "catalog:",
    "react-aria-components": "1.21.1",
    "storybook": "10.6.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
