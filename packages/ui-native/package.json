{
  "name": "@lenso/ui-native",
  "version": "0.1.0",
  "private": true,
  "description": "Native Apple controls and Lenso glass for React Native and Expo.",
  "license": "(MIT AND LGPL-2.0-or-later)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "bun check --no-script -p tsconfig.json",
