{
  "name": "@lenso/glass",
  "version": "0.1.0",
  "description": "Shared glass rendering and motion for Lenso Web interfaces.",
  "license": "(MIT AND LGPL-2.0-or-later)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LioRael/lenso-ui.git",
    "directory": "packages/glass"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./motion": {
      "types": "./dist/motion/index.d.ts",
      "import": "./dist/motion/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json",
    "./fusion": {
      "types": "./dist/fusion-entry.d.ts",
      "import": "./dist/fusion/index.js"
    }
  },
  "scripts": {
    "build": "bun ./node_modules/tsdown/dist/run.mjs --config tsdown.config.ts && bun ./node_modules/typescript/bin/tsc -p tsconfig.build.json --emitDeclarationOnly --noEmit false --outDir dist && bun scripts/copy-notices.ts",
    "build:dev": "bun ./node_modules/tsdown/dist/run.mjs --config tsdown.config.ts && bun scripts/copy-notices.ts",
    "dev": "bun ./node_modules/tsdown/dist/run.mjs --config tsdown.config.ts --watch --no-clean",
    "typecheck": "bun check --no-script --noEmit",
    "test": "bun test test/*.test.ts && bun test --preload ../../tests/setup/dom.ts test/browser/*.dom.test.ts",
    "generate:shaders": "bun scripts/generate-shaders.ts"
  },
  "dependencies": {
    "@lenso/tokens": "workspace:*",
    "@stylexjs/stylex": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@webgpu/types": "0.1.74",
    "react": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.2.0 <20.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
