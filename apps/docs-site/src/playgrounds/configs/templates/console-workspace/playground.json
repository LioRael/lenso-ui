{
  "id": "console-workspace",
  "name": "Console Workspace",
  "themeControl": "theme",
  "layout": "template",
  "controls": [
    {
      "id": "theme",
      "label": "Theme",
      "type": "select",
      "options": ["dark", "light"],
      "default": "dark"
    },
    {
      "id": "workspace",
      "label": "Initial workspace",
      "type": "select",
      "options": [
        { "label": "Agent", "value": "agent" },
        { "label": "App management", "value": "app" },
        { "label": "Projects", "value": "projects" }
      ],
      "default": "agent"
    }
  ],
  "examples": [
    { "id": "agent", "label": "Agent · Chat", "values": { "workspace": "agent" } },
    { "id": "app", "label": "App · Plugin pages", "values": { "workspace": "app" } },
    { "id": "projects", "label": "Projects", "values": { "workspace": "projects" } }
  ]
}
