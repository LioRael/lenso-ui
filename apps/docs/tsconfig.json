{
  "extends": "../../packages/standard/tsconfig/next.json",
  "compilerOptions": {
    "incremental": false,
    "isolatedDeclarations": false,
    "jsx": "preserve",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [{ "name": "next" }],
    "skipLibCheck": true,
    "types": ["node", "react", "react-dom"]
  },
  "include": ["next-env.d.ts", ".next/types/**/*.ts", "src/**/*.ts", "src/**/*.tsx", "*.ts"],
  "exclude": ["node_modules"]
}
