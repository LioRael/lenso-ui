  "code": "import {Button, Popover} from \"@lenso/ui\";\n\nexport function PopoverPlacement() {\n  return (\n    <div className=\"grid grid-cols-3 gap-4\">\n      <div />\n      <Popover>\n        <Button className=\"w-full\" variant=\"tertiary\">\n          Top\n        </Button>\n        <Popover.Content placement=\"top\">\n          <Popover.Dialog>\n            <Popover.Arrow />\n            <p className=\"text-sm\">Top placement</p>\n          </Popover.Dialog>\n        </Popover.Content>\n      </Popover>\n      <div />\n\n      <Popover>\n        <Button className=\"w-full\" variant=\"tertiary\">\n          Left\n        </Button>\n        <Popover.Content placement=\"left\">\n          <Popover.Dialog>\n            <Popover.Arrow />\n            <p className=\"text-sm\">Left placement</p>\n          </Popover.Dialog>\n        </Popover.Content>\n      </Popover>\n\n      <div className=\"flex items-center justify-center\">\n        <span className=\"text-sm text-muted\">Click buttons</span>\n      </div>\n\n      <Popover>\n        <Button className=\"w-full\" variant=\"tertiary\">\n          Right\n        </Button>\n        <Popover.Content placement=\"right\">\n          <Popover.Dialog>\n            <Popover.Arrow />\n            <p className=\"text-sm\">Right placement</p>\n          </Popover.Dialog>\n        </Popover.Content>\n      </Popover>\n\n      <div />\n      <Popover>\n        <Button className=\"w-full\" variant=\"tertiary\">\n          Bottom\n        </Button>\n        <Popover.Content placement=\"bottom\">\n          <Popover.Dialog>\n            <Popover.Arrow />\n            <p className=\"text-sm\">Bottom placement</p>\n          </Popover.Dialog>\n        </Popover.Content>\n      </Popover>\n      <div />\n    </div>\n  );\n}\n"
