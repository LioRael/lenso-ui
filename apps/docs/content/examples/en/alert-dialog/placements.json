{
  "name": "alert-dialog-placements",
  "exported": "Placements",
  "source": "apps/docs/src/demos/en/alert-dialog/placements.tsx",
  "code": "\"use client\";\n\nimport {AlertDialog, Button} from \"@lenso/ui\";\n\nexport function Placements() {\n  const placements = [\"auto\", \"top\", \"center\", \"bottom\"] as const;\n\n  return (\n    <div className=\"flex flex-wrap gap-4\">\n      {placements.map((placement) => (\n        <AlertDialog key={placement}>\n          <Button variant=\"secondary\">\n            {placement.charAt(0).toUpperCase() + placement.slice(1)}\n          </Button>\n          <AlertDialog.Backdrop>\n            <AlertDialog.Container placement={placement}>\n              <AlertDialog.Dialog className=\"sm:max-w-[400px]\">\n                <AlertDialog.CloseTrigger />\n                <AlertDialog.Header>\n                  <AlertDialog.Icon status=\"accent\" />\n                  <AlertDialog.Heading>\n                    {placement === \"auto\"\n                      ? \"Auto Placement\"\n                      : `${placement.charAt(0).toUpperCase() + placement.slice(1)} Position`}\n                  </AlertDialog.Heading>\n                </AlertDialog.Header>\n                <AlertDialog.Body>\n                  <p>\n                    {placement === \"auto\"\n                      ? \"Automatically positions at the bottom on mobile and center on desktop for optimal user experience.\"\n                      : `This dialog is positioned at the ${placement} of the viewport. Critical confirmations are typically centered for maximum attention.`}\n                  </p>\n                </AlertDialog.Body>\n                <AlertDialog.Footer>\n                  <Button slot=\"close\" variant=\"tertiary\">\n                    Cancel\n                  </Button>\n                  <Button slot=\"close\">Confirm</Button>\n                </AlertDialog.Footer>\n              </AlertDialog.Dialog>\n            </AlertDialog.Container>\n          </AlertDialog.Backdrop>\n        </AlertDialog>\n      ))}\n    </div>\n  );\n}\n"
}
