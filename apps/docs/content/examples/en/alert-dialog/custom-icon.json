  "name": "alert-dialog-custom-icon",
  "exported": "CustomIcon",
  "source": "apps/docs/src/demos/en/alert-dialog/custom-icon.tsx",
  "code": "\"use client\";\n\nimport {LockOpen} from \"@gravity-ui/icons\";\nimport {AlertDialog, Button} from \"@lenso/ui\";\n\nexport function CustomIcon() {\n  return (\n    <AlertDialog>\n      <Button variant=\"secondary\">Reset Password</Button>\n      <AlertDialog.Backdrop>\n        <AlertDialog.Container>\n          <AlertDialog.Dialog className=\"sm:max-w-[400px]\">\n            <AlertDialog.CloseTrigger />\n            <AlertDialog.Header>\n              <AlertDialog.Icon status=\"warning\">\n                <LockOpen className=\"size-5\" />\n              </AlertDialog.Icon>\n              <AlertDialog.Heading>Reset your password?</AlertDialog.Heading>\n            </AlertDialog.Header>\n            <AlertDialog.Body>\n              <p>\n                We'll send a password reset link to your email address. You'll need to create a new\n                password to regain access to your account.\n              </p>\n            </AlertDialog.Body>\n            <AlertDialog.Footer>\n              <Button slot=\"close\" variant=\"tertiary\">\n                Cancel\n              </Button>\n              <Button slot=\"close\">Send Reset Link</Button>\n            </AlertDialog.Footer>\n          </AlertDialog.Dialog>\n        </AlertDialog.Container>\n      </AlertDialog.Backdrop>\n    </AlertDialog>\n  );\n}\n"
}
