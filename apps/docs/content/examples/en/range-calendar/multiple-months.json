{
  "name": "range-calendar-multiple-months",
  "exported": "MultipleMonths",
  "source": "apps/docs/src/demos/en/range-calendar/multiple-months.tsx",
  "code": "\"use client\";\n\nimport {RangeCalendar} from \"@lenso/ui\";\n\nexport function MultipleMonths() {\n  return (\n    <RangeCalendar\n      aria-label=\"Trip dates\"\n      className=\"@container-normal w-full max-w-none overflow-x-auto\"\n      visibleDuration={{months: 2}}\n    >\n      <div className=\"mx-auto flex w-max gap-8\">\n        <div className=\"w-64\">\n          <RangeCalendar.Header>\n            <RangeCalendar.NavButton slot=\"previous\" />\n            <RangeCalendar.Heading className=\"flex-none\" />\n            <div className=\"size-6\" />\n          </RangeCalendar.Header>\n          <RangeCalendar.Grid>\n            <RangeCalendar.GridHeader>\n              {(day) => <RangeCalendar.HeaderCell>{day}</RangeCalendar.HeaderCell>}\n            </RangeCalendar.GridHeader>\n            <RangeCalendar.GridBody>\n              {(date) => <RangeCalendar.Cell date={date} />}\n            </RangeCalendar.GridBody>\n          </RangeCalendar.Grid>\n        </div>\n        <div className=\"w-64\">\n          <RangeCalendar.Header>\n            <div className=\"size-6\" />\n            <RangeCalendar.Heading className=\"flex-none\" offset={{months: 1}} />\n            <RangeCalendar.NavButton slot=\"next\" />\n          </RangeCalendar.Header>\n          <RangeCalendar.Grid offset={{months: 1}}>\n            <RangeCalendar.GridHeader>\n              {(day) => <RangeCalendar.HeaderCell>{day}</RangeCalendar.HeaderCell>}\n            </RangeCalendar.GridHeader>\n            <RangeCalendar.GridBody>\n              {(date) => <RangeCalendar.Cell date={date} />}\n            </RangeCalendar.GridBody>\n          </RangeCalendar.Grid>\n        </div>\n      </div>\n    </RangeCalendar>\n  );\n}\n"
}
