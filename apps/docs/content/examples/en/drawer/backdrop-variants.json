{
  "name": "drawer-backdrop-variants",
  "exported": "BackdropVariants",
  "source": "apps/docs/src/demos/en/drawer/backdrop-variants.tsx",
  "code": "import {Button, Drawer} from \"@lenso/ui\";\n\nexport function BackdropVariants() {\n  const variants = [\"opaque\", \"blur\", \"transparent\"] as const;\n\n  return (\n    <div className=\"flex flex-wrap gap-4\">\n      {variants.map((variant) => (\n        <Drawer key={variant}>\n          <Button variant=\"secondary\">{variant.charAt(0).toUpperCase() + variant.slice(1)}</Button>\n          <Drawer.Backdrop variant={variant}>\n            <Drawer.Content>\n              <Drawer.Dialog>\n                <Drawer.Handle />\n                <Drawer.CloseTrigger />\n                <Drawer.Header>\n                  <Drawer.Heading>\n                    Backdrop: {variant.charAt(0).toUpperCase() + variant.slice(1)}\n                  </Drawer.Heading>\n                </Drawer.Header>\n                <Drawer.Body>\n                  <p>\n                    This drawer uses the <code>{variant}</code> backdrop variant.\n                  </p>\n                </Drawer.Body>\n                <Drawer.Footer>\n                  <Button className=\"w-full\" slot=\"close\">\n                    Close\n                  </Button>\n                </Drawer.Footer>\n              </Drawer.Dialog>\n            </Drawer.Content>\n          </Drawer.Backdrop>\n        </Drawer>\n      ))}\n    </div>\n  );\n}\n"
}
