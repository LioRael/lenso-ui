  "source": "apps/docs/src/demos/en/toggle-button-group/full-width.tsx",
  "code": "import {\n  Bold,\n  Italic,\n  Strikethrough,\n  TextAlignCenter,\n  TextAlignLeft,\n  TextAlignRight,\n  Underline,\n} from \"@gravity-ui/icons\";\nimport {ToggleButton, ToggleButtonGroup} from \"@lenso/ui\";\n\nexport function FullWidth() {\n  return (\n    <div className=\"w-full max-w-md space-y-3\">\n      <ToggleButtonGroup fullWidth selectionMode=\"multiple\">\n        <ToggleButton isIconOnly aria-label=\"Bold\" id=\"bold\">\n          <Bold />\n        </ToggleButton>\n        <ToggleButton isIconOnly aria-label=\"Italic\" id=\"italic\">\n          <ToggleButtonGroup.Separator />\n          <Italic />\n        </ToggleButton>\n        <ToggleButton isIconOnly aria-label=\"Underline\" id=\"underline\">\n          <ToggleButtonGroup.Separator />\n          <Underline />\n        </ToggleButton>\n        <ToggleButton isIconOnly aria-label=\"Strikethrough\" id=\"strikethrough\">\n          <ToggleButtonGroup.Separator />\n          <Strikethrough />\n        </ToggleButton>\n      </ToggleButtonGroup>\n      <ToggleButtonGroup fullWidth selectionMode=\"single\">\n        <ToggleButton id=\"left\">\n          <TextAlignLeft />\n          Left\n        </ToggleButton>\n        <ToggleButton id=\"center\">\n          <ToggleButtonGroup.Separator />\n          <TextAlignCenter />\n          Center\n        </ToggleButton>\n        <ToggleButton id=\"right\">\n          <ToggleButtonGroup.Separator />\n          <TextAlignRight />\n          Right\n        </ToggleButton>\n      </ToggleButtonGroup>\n    </div>\n  );\n}\n"
}
