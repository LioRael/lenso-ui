{
  "name": "toggle-button-group-attached",
  "exported": "Attached",
  "source": "apps/docs/src/demos/en/toggle-button-group/attached.tsx",
  "code": "import {Bold, Italic, Strikethrough, Underline} from \"@gravity-ui/icons\";\nimport {ToggleButton, ToggleButtonGroup} from \"@lenso/ui\";\n\nexport function Attached() {\n  return (\n    <div className=\"flex flex-col gap-6\">\n      <div className=\"flex flex-col gap-2\">\n        <span className=\"text-sm text-muted\">Attached (default)</span>\n        <ToggleButtonGroup selectionMode=\"multiple\">\n          <ToggleButton isIconOnly aria-label=\"Bold\" id=\"bold\">\n            <Bold />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"Italic\" id=\"italic\">\n            <ToggleButtonGroup.Separator />\n            <Italic />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"Underline\" id=\"underline\">\n            <ToggleButtonGroup.Separator />\n            <Underline />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"Strikethrough\" id=\"strikethrough\">\n            <ToggleButtonGroup.Separator />\n            <Strikethrough />\n          </ToggleButton>\n        </ToggleButtonGroup>\n      </div>\n      <div className=\"flex flex-col gap-2\">\n        <span className=\"text-sm text-muted\">Detached</span>\n        <ToggleButtonGroup isDetached selectionMode=\"multiple\">\n          <ToggleButton isIconOnly aria-label=\"Bold\" id=\"bold\">\n            <Bold />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"Italic\" id=\"italic\">\n            <Italic />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"Underline\" id=\"underline\">\n            <Underline />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"Strikethrough\" id=\"strikethrough\">\n            <Strikethrough />\n          </ToggleButton>\n        </ToggleButtonGroup>\n      </div>\n    </div>\n  );\n}\n"
}
