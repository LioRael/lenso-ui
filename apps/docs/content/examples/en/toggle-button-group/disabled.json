  "name": "toggle-button-group-disabled",
  "exported": "Disabled",
  "source": "apps/docs/src/demos/en/toggle-button-group/disabled.tsx",
  "code": "import {Bold, Italic, Underline} from \"@gravity-ui/icons\";\nimport {ToggleButton, ToggleButtonGroup} from \"@lenso/ui\";\n\nexport function Disabled() {\n  return (\n    <div className=\"flex flex-col gap-6\">\n      <div className=\"flex flex-col gap-2\">\n        <span className=\"text-sm text-muted\">All buttons disabled</span>\n        <ToggleButtonGroup isDisabled selectionMode=\"multiple\">\n          <ToggleButton isIconOnly aria-label=\"Bold\" id=\"bold\">\n            <Bold />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"Italic\" id=\"italic\">\n            <ToggleButtonGroup.Separator />\n            <Italic />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"Underline\" id=\"underline\">\n            <ToggleButtonGroup.Separator />\n            <Underline />\n          </ToggleButton>\n        </ToggleButtonGroup>\n      </div>\n      <div className=\"flex flex-col gap-2\">\n        <span className=\"text-sm text-muted\">Individual button disabled</span>\n        <ToggleButtonGroup selectionMode=\"multiple\">\n          <ToggleButton isIconOnly aria-label=\"Bold\" id=\"bold\">\n            <Bold />\n          </ToggleButton>\n          <ToggleButton isDisabled isIconOnly aria-label=\"Italic\" id=\"italic\">\n            <ToggleButtonGroup.Separator />\n            <Italic />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"Underline\" id=\"underline\">\n            <ToggleButtonGroup.Separator />\n            <Underline />\n          </ToggleButton>\n        </ToggleButtonGroup>\n      </div>\n    </div>\n  );\n}\n"
}
