{
  "name": "toggle-button-group-orientation",
  "exported": "Orientation",
  "source": "apps/docs/src/demos/en/toggle-button-group/orientation.tsx",
  "code": "import {Bold, Italic, Underline} from \"@gravity-ui/icons\";\nimport {ToggleButton, ToggleButtonGroup} from \"@lenso/ui\";\n\nexport function Orientation() {\n  return (\n    <div className=\"flex items-start gap-8\">\n      <div className=\"flex flex-col gap-2\">\n        <span className=\"text-sm text-muted\">Horizontal</span>\n        <ToggleButtonGroup orientation=\"horizontal\" selectionMode=\"multiple\">\n          <ToggleButton isIconOnly aria-label=\"Bold\" id=\"bold\">\n            <Bold />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"Italic\" id=\"italic\">\n            <ToggleButtonGroup.Separator />\n            <Italic />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"Underline\" id=\"underline\">\n            <ToggleButtonGroup.Separator />\n            <Underline />\n          </ToggleButton>\n        </ToggleButtonGroup>\n      </div>\n      <div className=\"flex flex-col gap-2\">\n        <span className=\"text-sm text-muted\">Vertical</span>\n        <ToggleButtonGroup orientation=\"vertical\" selectionMode=\"multiple\">\n          <ToggleButton isIconOnly aria-label=\"Bold\" id=\"bold\">\n            <Bold />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"Italic\" id=\"italic\">\n            <ToggleButtonGroup.Separator />\n            <Italic />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"Underline\" id=\"underline\">\n            <ToggleButtonGroup.Separator />\n            <Underline />\n          </ToggleButton>\n        </ToggleButtonGroup>\n      </div>\n    </div>\n  );\n}\n"
}
