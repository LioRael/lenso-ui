  "source": "apps/docs/src/demos/en/progress-bar/colors.tsx",
  "code": "import {Label, ProgressBar} from \"@lenso/ui\";\n\nexport function Colors() {\n  return (\n    <div className=\"flex w-64 flex-col gap-6\">\n      <ProgressBar aria-label=\"Default\" color=\"default\" value={50}>\n        <Label>Default</Label>\n        <ProgressBar.Output />\n        <ProgressBar.Track>\n          <ProgressBar.Fill />\n        </ProgressBar.Track>\n      </ProgressBar>\n      <ProgressBar aria-label=\"Accent\" color=\"accent\" value={50}>\n        <Label>Accent</Label>\n        <ProgressBar.Output />\n        <ProgressBar.Track>\n          <ProgressBar.Fill />\n        </ProgressBar.Track>\n      </ProgressBar>\n      <ProgressBar aria-label=\"Success\" color=\"success\" value={50}>\n        <Label>Success</Label>\n        <ProgressBar.Output />\n        <ProgressBar.Track>\n          <ProgressBar.Fill />\n        </ProgressBar.Track>\n      </ProgressBar>\n      <ProgressBar aria-label=\"Warning\" color=\"warning\" value={50}>\n        <Label>Warning</Label>\n        <ProgressBar.Output />\n        <ProgressBar.Track>\n          <ProgressBar.Fill />\n        </ProgressBar.Track>\n      </ProgressBar>\n      <ProgressBar aria-label=\"Danger\" color=\"danger\" value={50}>\n        <Label>Danger</Label>\n        <ProgressBar.Output />\n        <ProgressBar.Track>\n          <ProgressBar.Fill />\n        </ProgressBar.Track>\n      </ProgressBar>\n    </div>\n  );\n}\n"
}
