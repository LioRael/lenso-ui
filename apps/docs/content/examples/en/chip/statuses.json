  "source": "apps/docs/src/demos/en/chip/statuses.tsx",
  "code": "import {Ban, Check, CircleFill, CircleInfo, TriangleExclamation} from \"@gravity-ui/icons\";\nimport {Chip} from \"@lenso/ui\";\n\nexport function ChipStatuses() {\n  return (\n    <div className=\"flex flex-col gap-4\">\n      <div className=\"flex flex-wrap items-center gap-3\">\n        <Chip variant=\"primary\">\n          <CircleFill width={6} />\n          <Chip.Label>Default</Chip.Label>\n        </Chip>\n        <Chip color=\"success\" variant=\"primary\">\n          <CircleFill width={6} />\n          <Chip.Label>Active</Chip.Label>\n        </Chip>\n        <Chip color=\"warning\" variant=\"primary\">\n          <CircleFill width={6} />\n          <Chip.Label>Pending</Chip.Label>\n        </Chip>\n        <Chip color=\"danger\" variant=\"primary\">\n          <CircleFill width={6} />\n          <Chip.Label>Inactive</Chip.Label>\n        </Chip>\n      </div>\n\n      <div className=\"flex flex-wrap items-center gap-3\">\n        <Chip>\n          <CircleInfo width={12} />\n          <Chip.Label>New Feature</Chip.Label>\n        </Chip>\n        <Chip color=\"success\">\n          <Check width={12} />\n          <Chip.Label>Available</Chip.Label>\n        </Chip>\n        <Chip color=\"warning\">\n          <TriangleExclamation width={12} />\n          <Chip.Label>Beta</Chip.Label>\n        </Chip>\n        <Chip color=\"danger\">\n          <Ban width={12} />\n          <Chip.Label>Deprecated</Chip.Label>\n        </Chip>\n      </div>\n    </div>\n  );\n}\n"
}
