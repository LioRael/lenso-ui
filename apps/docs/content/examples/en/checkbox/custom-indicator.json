{
  "name": "checkbox-custom-indicator",
  "exported": "CustomIndicator",
  "source": "apps/docs/src/demos/en/checkbox/custom-indicator.tsx",
  "code": "\"use client\";\n\nimport {Checkbox} from \"@lenso/ui\";\n\nexport function CustomIndicator() {\n  return (\n    <div className=\"flex gap-4\">\n      <Checkbox defaultSelected name=\"heart\">\n        <Checkbox.Content>\n          <Checkbox.Control>\n            <Checkbox.Indicator>\n              {({isSelected}) =>\n                isSelected ? (\n                  <svg fill=\"currentColor\" viewBox=\"0 0 24 24\">\n                    <path\n                      d=\"M12.62 20.81c-.34.12-.9.12-1.24 0C8.48 19.82 2 15.69 2 8.69 2 5.6 4.49 3.1 7.56 3.1c1.82 0 3.43.88 4.44 2.24a5.53 5.53 0 0 1 4.44-2.24C19.51 3.1 22 5.6 22 8.69c0 7-6.48 11.13-9.38 12.12Z\"\n                      fill=\"currentColor\"\n                    />\n                  </svg>\n                ) : null\n              }\n            </Checkbox.Indicator>\n          </Checkbox.Control>\n          Heart\n        </Checkbox.Content>\n      </Checkbox>\n      <Checkbox defaultSelected name=\"plus\">\n        <Checkbox.Content>\n          <Checkbox.Control>\n            <Checkbox.Indicator>\n              {({isSelected}) =>\n                isSelected ? (\n                  <svg fill=\"none\" viewBox=\"0 0 24 24\">\n                    <path\n                      d=\"M6 12H18\"\n                      stroke=\"currentColor\"\n                      strokeLinecap=\"round\"\n                      strokeLinejoin=\"round\"\n                      strokeWidth=\"3\"\n                    />\n                    <path\n                      d=\"M12 18V6\"\n                      stroke=\"currentColor\"\n                      strokeLinecap=\"round\"\n                      strokeLinejoin=\"round\"\n                      strokeWidth=\"3\"\n                    />\n                  </svg>\n                ) : null\n              }\n            </Checkbox.Indicator>\n          </Checkbox.Control>\n          Plus\n        </Checkbox.Content>\n      </Checkbox>\n      <Checkbox isIndeterminate name=\"indeterminate\">\n        <Checkbox.Content>\n          <Checkbox.Control>\n            <Checkbox.Indicator>\n              {({isIndeterminate}) =>\n                isIndeterminate ? (\n                  <svg stroke=\"currentColor\" strokeWidth={3} viewBox=\"0 0 24 24\">\n                    <line x1=\"21\" x2=\"3\" y1=\"12\" y2=\"12\" />\n                  </svg>\n                ) : null\n              }\n            </Checkbox.Indicator>\n          </Checkbox.Control>\n          Indeterminate\n        </Checkbox.Content>\n      </Checkbox>\n    </div>\n  );\n}\n"
}
