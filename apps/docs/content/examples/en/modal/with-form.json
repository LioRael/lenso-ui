{
  "name": "modal-with-form",
  "exported": "WithForm",
  "source": "apps/docs/src/demos/en/modal/with-form.tsx",
  "code": "\"use client\";\n\nimport {Envelope} from \"@gravity-ui/icons\";\nimport {Button, Input, Label, Modal, Surface, TextField} from \"@lenso/ui\";\n\nexport function WithForm() {\n  return (\n    <Modal>\n      <Button variant=\"secondary\">Open Contact Form</Button>\n      <Modal.Backdrop>\n        <Modal.Container placement=\"auto\">\n          <Modal.Dialog className=\"sm:max-w-md\">\n            <Modal.CloseTrigger />\n            <Modal.Header>\n              <Modal.Icon className=\"bg-accent-soft text-accent-soft-foreground\">\n                <Envelope className=\"size-5\" />\n              </Modal.Icon>\n              <Modal.Heading>Contact Us</Modal.Heading>\n              <p className=\"mt-1.5 text-sm leading-5 text-muted\">\n                Fill out the form below and we'll get back to you. The modal adapts automatically\n                when the keyboard appears on mobile.\n              </p>\n            </Modal.Header>\n            <Modal.Body className=\"p-6\">\n              <Surface variant=\"default\">\n                <form className=\"flex flex-col gap-4\">\n                  <TextField className=\"w-full\" name=\"name\" type=\"text\" variant=\"secondary\">\n                    <Label>Name</Label>\n                    <Input placeholder=\"Enter your name\" />\n                  </TextField>\n                  <TextField className=\"w-full\" name=\"email\" type=\"email\" variant=\"secondary\">\n                    <Label>Email</Label>\n                    <Input placeholder=\"Enter your email\" />\n                  </TextField>\n                  <TextField className=\"w-full\" name=\"phone\" type=\"tel\" variant=\"secondary\">\n                    <Label>Phone</Label>\n                    <Input placeholder=\"Enter your phone number\" />\n                  </TextField>\n                  <TextField className=\"w-full\" name=\"company\" variant=\"secondary\">\n                    <Label>Company</Label>\n                    <Input placeholder=\"Enter your company name\" />\n                  </TextField>\n                  <TextField className=\"w-full\" name=\"message\" variant=\"secondary\">\n                    <Label>Message</Label>\n                    <Input placeholder=\"Enter your message\" />\n                  </TextField>\n                </form>\n              </Surface>\n            </Modal.Body>\n            <Modal.Footer>\n              <Button slot=\"close\" variant=\"secondary\">\n                Cancel\n              </Button>\n              <Button slot=\"close\">Send Message</Button>\n            </Modal.Footer>\n          </Modal.Dialog>\n        </Modal.Container>\n      </Modal.Backdrop>\n    </Modal>\n  );\n}\n"
}
