{
  "name": "button-group-with-icons",
  "exported": "WithIcons",
  "source": "apps/docs/src/demos/en/button-group/with-icons.tsx",
  "code": "import {Globe, Plus, TrashBin} from \"@gravity-ui/icons\";\nimport {Button, ButtonGroup} from \"@lenso/ui\";\n\nexport function WithIcons() {\n  return (\n    <div className=\"flex flex-col gap-6\">\n      <div className=\"flex flex-col items-start gap-2\">\n        <p className=\"text-sm text-muted\">With icons</p>\n        <ButtonGroup variant=\"secondary\">\n          <Button>\n            <Globe />\n            Search\n          </Button>\n          <Button>\n            <ButtonGroup.Separator />\n            <Plus />\n            Add\n          </Button>\n          <Button>\n            <ButtonGroup.Separator />\n            <TrashBin />\n            Delete\n          </Button>\n        </ButtonGroup>\n      </div>\n      <div className=\"flex flex-col items-start gap-2\">\n        <p className=\"text-sm text-muted\">Icon only buttons</p>\n        <ButtonGroup variant=\"tertiary\">\n          <Button isIconOnly aria-label=\"Search\">\n            <Globe />\n          </Button>\n          <Button isIconOnly aria-label=\"Add\">\n            <ButtonGroup.Separator />\n            <Plus />\n          </Button>\n          <Button isIconOnly aria-label=\"Delete\">\n            <ButtonGroup.Separator />\n            <TrashBin />\n          </Button>\n        </ButtonGroup>\n      </div>\n    </div>\n  );\n}\n"
}
