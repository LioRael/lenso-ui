on>\n          <Button>\n            <ButtonGroup.Separator />\n            Second\n          </Button>\n          <Button>\n            <ButtonGroup.Separator />\n            Third\n          </Button>\n        </ButtonGroup>\n      </div>\n      <div className=\"flex flex-col gap-2\">\n        <p className=\"text-sm text-muted\">Danger</p>\n        <ButtonGroup variant=\"danger\">\n          <Button>First</Button>\n          <Button>\n            <ButtonGroup.Separator />\n            Second\n          </Button>\n          <Button>\n            <ButtonGroup.Separator />\n            Third\n          </Button>\n        </ButtonGroup>\n      </div>\n    </div>\n  );\n}\n"
