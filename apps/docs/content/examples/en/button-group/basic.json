{
  "name": "button-group-basic",
  "exported": "Basic",
  "source": "apps/docs/src/demos/en/button-group/basic.tsx",
  "code": "import {\n  ChevronDown,\n  ChevronLeft,\n  ChevronRight,\n  CodeFork,\n  Ellipsis,\n  Picture,\n  Pin,\n  QrCode,\n  Star,\n  TextAlignCenter,\n  TextAlignJustify,\n  TextAlignLeft,\n  TextAlignRight,\n  ThumbsDown,\n  ThumbsUp,\n  Video,\n} from \"@gravity-ui/icons\";\nimport {Button, ButtonGroup, Chip, Description, Dropdown, Label} from \"@lenso/ui\";\n\nexport function Basic() {\n  return (\n    <div className=\"flex flex-col items-start gap-6\">\n      {/* Single button with dropdown */}\n      <div className=\"flex flex-col gap-2\">\n        <ButtonGroup>\n          <Button>Merge pull request</Button>\n          <Dropdown>\n            <Button isIconOnly aria-label=\"More options\">\n              <ButtonGroup.Separator />\n              <ChevronDown />\n            </Button>\n            <Dropdown.Popover className=\"max-w-[290px]\" placement=\"bottom end\">\n              <Dropdown.Menu>\n                <Dropdown.Item\n                  className=\"flex flex-col items-start gap-1\"\n                  id=\"merge\"\n                  textValue=\"Create a merge commit\"\n                >\n                  <Label>Create a merge commit</Label>\n                  <Description>\n                    All commits from this branch will be added to the base branch\n                  </Description>\n                </Dropdown.Item>\n                <Dropdown.Item\n                  className=\"flex flex-col items-start gap-1\"\n                  id=\"squash-and-merge\"\n                  textValue=\"Squash and merge\"\n                >\n                  <Label>Squash and merge</Label>\n                  <Description>\n                    The 14 commits from this branch will be combined into one commit in the base\n                    branch\n                  </Description>\n                </Dropdown.Item>\n                <Dropdown.Item\n                  className=\"flex flex-col items-start gap-1\"\n                  id=\"rebase-and-merge\"\n                  textValue=\"Rebase and merge\"\n                >\n                  <Label>Rebase and merge</Label>\n                  <Description>\n                    The 14 commits from this branch will be rebased and added to the base branch\n                  </Description>\n                </Dropdown.Item>\n              </Dropdown.Menu>\n            </Dropdown.Popover>\n          </Dropdown>\n        </ButtonGroup>\n      </div>\n\n      {/* Individual buttons */}\n      <div className=\"flex flex-col gap-2\">\n        <div className=\"flex flex-wrap gap-x-2 gap-y-4\">\n          <ButtonGroup variant=\"tertiary\">\n            <Button>\n              <CodeFork className=\"size-3.5\" />\n              Fork\n              <Chip color=\"accent\" size=\"sm\" variant=\"soft\">\n                24\n              </Chip>\n            </Button>\n            <Button isIconOnly aria-label=\"More fork options\">\n              <ButtonGroup.Separator />\n              <ChevronDown />\n            </Button>\n          </ButtonGroup>\n          <ButtonGroup variant=\"tertiary\">\n            <Button isIconOnly aria-label=\"Show QR code\">\n              <QrCode />\n            </Button>\n            <Button>\n              <ButtonGroup.Separator />\n              Scan to pay\n            </Button>\n          </ButtonGroup>\n          <ButtonGroup variant=\"tertiary\">\n            <Button>\n              <ThumbsUp />\n              <span className=\"text-xs font-semibold\">2.4K</span>\n            </Button>\n            <Button isIconOnly aria-label=\"Dislike\">\n              <ButtonGroup.Separator />\n              <ThumbsDown />\n            </Button>\n          </ButtonGroup>\n          <ButtonGroup variant=\"tertiary\">\n            <Button>\n              <Star className=\"size-3.5\" />\n              Star\n            </Button>\n            <Button className=\"px-2\">\n              <ButtonGroup.Separator />\n              <Chip color=\"accent\" size=\"sm\" variant=\"soft\">\n                104\n              </Chip>\n            </Button>\n          </ButtonGroup>\n          <ButtonGroup variant=\"tertiary\">\n            <Button>\n              <Pin />\n              Pinned\n            </Button>\n            <Button isIconOnly aria-label=\"More pin options\">\n              <ButtonGroup.Separator />\n              <ChevronDown />\n            </Button>\n          </ButtonGroup>\n        </div>\n      </div>\n\n      {/* Previous/Next Button Group */}\n      <div className=\"flex flex-col gap-2\">\n        <ButtonGroup variant=\"tertiary\">\n          <Button>\n            <ChevronLeft />\n            Previous\n          </Button>\n          <Button>\n            <ButtonGroup.Separator />\n            Next\n            <ChevronRight />\n          </Button>\n        </ButtonGroup>\n      </div>\n\n      {/* Content Selection Button Group */}\n      <div className=\"flex flex-col gap-2\">\n        <ButtonGroup variant=\"tertiary\">\n          <Button>\n            <Picture />\n            Photos\n          </Button>\n          <Button>\n            <ButtonGroup.Separator />\n            <Video />\n            Videos\n          </Button>\n          <Button isIconOnly aria-label=\"More options\">\n            <ButtonGroup.Separator />\n            <Ellipsis />\n          </Button>\n        </ButtonGroup>\n      </div>\n\n      {/* Text Alignment Button Group */}\n      <div className=\"flex flex-col gap-2\">\n        <ButtonGroup variant=\"tertiary\">\n          <Button>Left</Button>\n          <Button>\n            <ButtonGroup.Separator />\n            Center\n          </Button>\n          <Button>\n            <ButtonGroup.Separator />\n            Right\n          </Button>\n        </ButtonGroup>\n      </div>\n\n      {/* Icon-Only Alignment Button Group */}\n      <div className=\"flex flex-col gap-2\">\n        <ButtonGroup variant=\"tertiary\">\n          <Button isIconOnly aria-label=\"Align left\">\n            <TextAlignLeft />\n          </Button>\n          <Button isIconOnly aria-label=\"Align center\">\n            <ButtonGroup.Separator />\n            <TextAlignCenter />\n          </Button>\n          <Button isIconOnly aria-label=\"Align right\">\n            <ButtonGroup.Separator />\n            <TextAlignRight />\n          </Button>\n          <Button isIconOnly aria-label=\"Justify\">\n            <ButtonGroup.Separator />\n            <TextAlignJustify />\n          </Button>\n        </ButtonGroup>\n      </div>\n    </div>\n  );\n}\n"
}
