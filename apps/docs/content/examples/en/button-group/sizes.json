  "code": "import {Button, ButtonGroup} from \"@lenso/ui\";\n\nexport function Sizes() {\n  return (\n    <div className=\"flex flex-col gap-4\">\n      <div className=\"flex flex-col items-start gap-2\">\n        <p className=\"text-sm text-muted\">Small</p>\n        <ButtonGroup size=\"sm\" variant=\"secondary\">\n          <Button>First</Button>\n          <Button>\n            <ButtonGroup.Separator />\n            Second\n          </Button>\n          <Button>\n            <ButtonGroup.Separator />\n            Third\n          </Button>\n        </ButtonGroup>\n      </div>\n      <div className=\"flex flex-col items-start gap-2\">\n        <p className=\"text-sm text-muted\">Medium (default)</p>\n        <ButtonGroup size=\"md\" variant=\"secondary\">\n          <Button>First</Button>\n          <Button>\n            <ButtonGroup.Separator />\n            Second\n          </Button>\n          <Button>\n            <ButtonGroup.Separator />\n            Third\n          </Button>\n        </ButtonGroup>\n      </div>\n      <div className=\"flex flex-col items-start gap-2\">\n        <p className=\"text-sm text-muted\">Large</p>\n        <ButtonGroup size=\"lg\" variant=\"secondary\">\n          <Button>First</Button>\n          <Button>\n            <ButtonGroup.Separator />\n            Second\n          </Button>\n          <Button>\n            <ButtonGroup.Separator />\n            Third\n          </Button>\n        </ButtonGroup>\n      </div>\n    </div>\n  );\n}\n"
