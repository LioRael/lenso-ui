{
  "name": "button-group-orientation",
  "exported": "Orientation",
  "source": "apps/docs/src/demos/en/button-group/orientation.tsx",
  "code": "import {TextAlignCenter, TextAlignJustify, TextAlignLeft, TextAlignRight} from \"@gravity-ui/icons\";\nimport {Button, ButtonGroup} from \"@lenso/ui\";\n\nexport function Orientation() {\n  return (\n    <div className=\"flex items-start gap-8\">\n      <div className=\"flex flex-col gap-2\">\n        <span className=\"text-sm text-muted\">Horizontal</span>\n        <ButtonGroup orientation=\"horizontal\" variant=\"tertiary\">\n          <Button isIconOnly aria-label=\"Align left\">\n            <TextAlignLeft />\n          </Button>\n          <Button isIconOnly aria-label=\"Align center\">\n            <ButtonGroup.Separator />\n            <TextAlignCenter />\n          </Button>\n          <Button isIconOnly aria-label=\"Align right\">\n            <ButtonGroup.Separator />\n            <TextAlignRight />\n          </Button>\n          <Button isIconOnly aria-label=\"Justify\">\n            <ButtonGroup.Separator />\n            <TextAlignJustify />\n          </Button>\n        </ButtonGroup>\n      </div>\n      <div className=\"flex flex-col gap-2\">\n        <span className=\"text-sm text-muted\">Vertical</span>\n        <ButtonGroup orientation=\"vertical\" variant=\"tertiary\">\n          <Button isIconOnly aria-label=\"Align left\">\n            <TextAlignLeft />\n          </Button>\n          <Button isIconOnly aria-label=\"Align center\">\n            <ButtonGroup.Separator />\n            <TextAlignCenter />\n          </Button>\n          <Button isIconOnly aria-label=\"Align right\">\n            <ButtonGroup.Separator />\n            <TextAlignRight />\n          </Button>\n          <Button isIconOnly aria-label=\"Justify\">\n            <ButtonGroup.Separator />\n            <TextAlignJustify />\n          </Button>\n        </ButtonGroup>\n      </div>\n    </div>\n  );\n}\n"
}
