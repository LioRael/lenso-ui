{
  "name": "calendar-multiple-months",
  "exported": "MultipleMonths",
  "source": "apps/docs/src/demos/en/calendar/multiple-months.tsx",
  "code": "\"use client\";\n\nimport {Calendar} from \"@lenso/ui\";\n\nexport function MultipleMonths() {\n  return (\n    <Calendar\n      aria-label=\"Trip dates\"\n      className=\"@container-normal w-full max-w-none overflow-x-auto\"\n      visibleDuration={{months: 2}}\n    >\n      <div className=\"mx-auto flex w-max gap-8\">\n        <div className=\"w-64\">\n          <Calendar.Header>\n            <Calendar.NavButton slot=\"previous\" />\n            <Calendar.Heading className=\"flex-none\" />\n            <div className=\"size-6\" />\n          </Calendar.Header>\n          <Calendar.Grid>\n            <Calendar.GridHeader>\n              {(day) => <Calendar.HeaderCell>{day}</Calendar.HeaderCell>}\n            </Calendar.GridHeader>\n            <Calendar.GridBody>{(date) => <Calendar.Cell date={date} />}</Calendar.GridBody>\n          </Calendar.Grid>\n        </div>\n        <div className=\"w-64\">\n          <Calendar.Header>\n            <div className=\"size-6\" />\n            <Calendar.Heading className=\"flex-none\" offset={{months: 1}} />\n            <Calendar.NavButton slot=\"next\" />\n          </Calendar.Header>\n          <Calendar.Grid offset={{months: 1}}>\n            <Calendar.GridHeader>\n              {(day) => <Calendar.HeaderCell>{day}</Calendar.HeaderCell>}\n            </Calendar.GridHeader>\n            <Calendar.GridBody>{(date) => <Calendar.Cell date={date} />}</Calendar.GridBody>\n          </Calendar.Grid>\n        </div>\n      </div>\n    </Calendar>\n  );\n}\n"
}
