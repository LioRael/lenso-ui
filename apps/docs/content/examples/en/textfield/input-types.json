  "source": "apps/docs/src/demos/en/textfield/input-types.tsx",
  "code": "import {Input, Label, TextField} from \"@lenso/ui\";\n\nexport function InputTypes() {\n  return (\n    <div className=\"flex w-full max-w-64 flex-col gap-4\">\n      <TextField name=\"password\" type=\"password\">\n        <Label>Password</Label>\n        <Input placeholder=\"••••••••\" />\n      </TextField>\n\n      <TextField name=\"age\" type=\"number\">\n        <Label>Age</Label>\n        <Input max=\"150\" min=\"0\" placeholder=\"21\" />\n      </TextField>\n\n      <TextField name=\"email\" type=\"email\">\n        <Label>Email</Label>\n        <Input placeholder=\"user@example.com\" />\n      </TextField>\n\n      <TextField name=\"website\" type=\"url\">\n        <Label>Website</Label>\n        <Input placeholder=\"https://example.com\" />\n      </TextField>\n\n      <TextField name=\"phone\" type=\"tel\">\n        <Label>Phone</Label>\n        <Input placeholder=\"+1 (555) 000-0000\" />\n      </TextField>\n    </div>\n  );\n}\n"
}
