{
  "name": "dropdown-controlled-open-state",
  "exported": "ControlledOpenState",
  "source": "apps/docs/src/demos/en/dropdown/controlled-open-state.tsx",
  "code": "\"use client\";\n\nimport {Button, Dropdown, Label} from \"@lenso/ui\";\nimport {useState} from \"react\";\n\nexport function ControlledOpenState() {\n  const [open, setOpen] = useState(false);\n\n  return (\n    <div className=\"flex min-w-sm flex-col items-center justify-center gap-4\">\n      <p className=\"text-sm text-muted\">\n        Dropdown is: <strong>{open ? \"open\" : \"closed\"}</strong>\n      </p>\n      <Dropdown isOpen={open} onOpenChange={setOpen}>\n        <Button aria-label=\"Menu\" variant=\"secondary\">\n          Actions\n        </Button>\n        <Dropdown.Popover>\n          <Dropdown.Menu>\n            <Dropdown.Item id=\"new-file\" textValue=\"New file\">\n              <Label>New file</Label>\n            </Dropdown.Item>\n            <Dropdown.Item id=\"open-file\" textValue=\"Open file\">\n              <Label>Open file</Label>\n            </Dropdown.Item>\n            <Dropdown.Item id=\"save-file\" textValue=\"Save file\">\n              <Label>Save file</Label>\n            </Dropdown.Item>\n            <Dropdown.Item id=\"delete-file\" textValue=\"Delete file\" variant=\"danger\">\n              <Label>Delete file</Label>\n            </Dropdown.Item>\n          </Dropdown.Menu>\n        </Dropdown.Popover>\n      </Dropdown>\n    </div>\n  );\n}\n"
}
