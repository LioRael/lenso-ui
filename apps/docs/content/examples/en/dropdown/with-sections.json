{
  "name": "dropdown-with-sections",
  "exported": "WithSections",
  "source": "apps/docs/src/demos/en/dropdown/with-sections.tsx",
  "code": "\"use client\";\n\nimport {EllipsisVertical, Pencil, SquarePlus, TrashBin} from \"@gravity-ui/icons\";\nimport {Button, Description, Dropdown, Header, Kbd, Label, Separator} from \"@lenso/ui\";\n\nexport function WithSections() {\n  return (\n    <Dropdown>\n      <Button isIconOnly aria-label=\"Menu\" variant=\"secondary\">\n        <EllipsisVertical className=\"outline-none\" />\n      </Button>\n      <Dropdown.Popover>\n        <Dropdown.Menu onAction={(key) => console.log(`Selected: ${key}`)}>\n          <Dropdown.Section>\n            <Header>Actions</Header>\n            <Dropdown.Item id=\"new-file\" textValue=\"New file\">\n              <div className=\"flex h-8 items-start justify-center pt-px\">\n                <SquarePlus className=\"size-4 shrink-0 text-muted\" />\n              </div>\n              <div className=\"flex flex-col\">\n                <Label>New file</Label>\n                <Description>Create a new file</Description>\n              </div>\n              <Kbd className=\"ms-auto\" slot=\"keyboard\" variant=\"light\">\n                <Kbd.Abbr keyValue=\"command\" />\n                <Kbd.Content>N</Kbd.Content>\n              </Kbd>\n            </Dropdown.Item>\n            <Dropdown.Item id=\"edit-file\" textValue=\"Edit file\">\n              <div className=\"flex h-8 items-start justify-center pt-px\">\n                <Pencil className=\"size-4 shrink-0 text-muted\" />\n              </div>\n              <div className=\"flex flex-col\">\n                <Label>Edit file</Label>\n                <Description>Make changes</Description>\n              </div>\n              <Kbd className=\"ms-auto\" slot=\"keyboard\" variant=\"light\">\n                <Kbd.Abbr keyValue=\"command\" />\n                <Kbd.Content>E</Kbd.Content>\n              </Kbd>\n            </Dropdown.Item>\n          </Dropdown.Section>\n          <Separator />\n          <Dropdown.Section>\n            <Header>Danger zone</Header>\n            <Dropdown.Item id=\"delete-file\" textValue=\"Delete file\" variant=\"danger\">\n              <div className=\"flex h-8 items-start justify-center pt-px\">\n                <TrashBin className=\"size-4 shrink-0 text-danger\" />\n              </div>\n              <div className=\"flex flex-col\">\n                <Label>Delete file</Label>\n                <Description>Move to trash</Description>\n              </div>\n              <Kbd className=\"ms-auto\" slot=\"keyboard\" variant=\"light\">\n                <Kbd.Abbr keyValue=\"command\" />\n                <Kbd.Abbr keyValue=\"shift\" />\n                <Kbd.Content>D</Kbd.Content>\n              </Kbd>\n            </Dropdown.Item>\n          </Dropdown.Section>\n        </Dropdown.Menu>\n      </Dropdown.Popover>\n    </Dropdown>\n  );\n}\n"
}
