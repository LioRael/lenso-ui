  "source": "apps/docs/src/demos/en/tabs/render-function.tsx",
  "code": "\"use client\";\n\nimport {Tabs} from \"@lenso/ui\";\nimport Link from \"next/link\";\n\nexport function RenderFunction() {\n  return (\n    <Tabs className=\"w-full max-w-md\" render={(props) => <div {...props} data-custom=\"foo\" />}>\n      <Tabs.ListContainer>\n        <Tabs.List aria-label=\"Options\">\n          <Tabs.Tab\n            href=\"/docs/react/getting-started\"\n            id=\"getting-started\"\n            render={(domProps: any) => <Link {...domProps} />}\n          >\n            Getting Started\n            <Tabs.Indicator />\n          </Tabs.Tab>\n          <Tabs.Tab\n            href=\"/docs/react/components\"\n            id=\"components\"\n            render={(domProps: any) => <Link {...domProps} />}\n          >\n            Components\n            <Tabs.Indicator />\n          </Tabs.Tab>\n          <Tabs.Tab\n            href=\"/docs/react/releases\"\n            id=\"releases\"\n            render={(domProps: any) => <Link {...domProps} />}\n          >\n            Releases\n            <Tabs.Indicator />\n          </Tabs.Tab>\n        </Tabs.List>\n      </Tabs.ListContainer>\n      <Tabs.Panel className=\"pt-4\" id=\"overview\">\n        <p>View your project overview and recent activity.</p>\n      </Tabs.Panel>\n      <Tabs.Panel className=\"pt-4\" id=\"analytics\">\n        <p>Track your metrics and analyze performance data.</p>\n      </Tabs.Panel>\n      <Tabs.Panel className=\"pt-4\" id=\"reports\">\n        <p>Generate and download detailed reports.</p>\n      </Tabs.Panel>\n    </Tabs>\n  );\n}\n"
}
