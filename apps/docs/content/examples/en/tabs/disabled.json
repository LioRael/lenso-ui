{
  "name": "tabs-disabled",
  "exported": "Disabled",
  "source": "apps/docs/src/demos/en/tabs/disabled.tsx",
  "code": "import {Tabs} from \"@lenso/ui\";\n\nexport function Disabled() {\n  return (\n    <Tabs className=\"w-full max-w-md\">\n      <Tabs.ListContainer>\n        <Tabs.List aria-label=\"Tabs with disabled\">\n          <Tabs.Tab id=\"active\">\n            Active\n            <Tabs.Indicator />\n          </Tabs.Tab>\n          <Tabs.Tab isDisabled id=\"disabled\">\n            Disabled\n            <Tabs.Indicator />\n          </Tabs.Tab>\n          <Tabs.Tab id=\"available\">\n            Available\n            <Tabs.Indicator />\n          </Tabs.Tab>\n        </Tabs.List>\n      </Tabs.ListContainer>\n      <Tabs.Panel className=\"pt-4\" id=\"active\">\n        <p>This tab is active and can be selected.</p>\n      </Tabs.Panel>\n      <Tabs.Panel className=\"pt-4\" id=\"disabled\">\n        <p>This content cannot be accessed.</p>\n      </Tabs.Panel>\n      <Tabs.Panel className=\"pt-4\" id=\"available\">\n        <p>This tab is also available for selection.</p>\n      </Tabs.Panel>\n    </Tabs>\n  );\n}\n"
}
