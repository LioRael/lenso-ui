  "source": "apps/docs/src/demos/en/radio-group/custom-indicator.tsx",
  "code": "\"use client\";\n\nimport {Description, Label, Radio, RadioGroup} from \"@lenso/ui\";\n\nexport function CustomIndicator() {\n  return (\n    <RadioGroup defaultValue=\"premium\" name=\"plan-custom-indicator\">\n      <Label>Plan selection</Label>\n      <Description>Choose the plan that suits you best</Description>\n      <Radio value=\"basic\">\n        <Radio.Content>\n          <Radio.Control>\n            <Radio.Indicator>\n              {({isSelected}) =>\n                isSelected ? <span className=\"text-xs leading-none text-background\">✓</span> : null\n              }\n            </Radio.Indicator>\n          </Radio.Control>\n          Basic Plan\n        </Radio.Content>\n        <Description>Includes 100 messages per month</Description>\n      </Radio>\n      <Radio value=\"premium\">\n        <Radio.Content>\n          <Radio.Control>\n            <Radio.Indicator>\n              {({isSelected}) =>\n                isSelected ? <span className=\"text-xs leading-none text-background\">✓</span> : null\n              }\n            </Radio.Indicator>\n          </Radio.Control>\n          Premium Plan\n        </Radio.Content>\n        <Description>Includes 200 messages per month</Description>\n      </Radio>\n      <Radio value=\"business\">\n        <Radio.Content>\n          <Radio.Control>\n            <Radio.Indicator>\n              {({isSelected}) =>\n                isSelected ? <span className=\"text-xs leading-none text-background\">✓</span> : null\n              }\n            </Radio.Indicator>\n          </Radio.Control>\n          Business Plan\n        </Radio.Content>\n        <Description>Unlimited messages</Description>\n      </Radio>\n    </RadioGroup>\n  );\n}\n"
}
