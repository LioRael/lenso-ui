  "source": "apps/docs/src/demos/en/radio-group/variants.tsx",
  "code": "import {Description, Radio, RadioGroup} from \"@lenso/ui\";\n\nexport function Variants() {\n  return (\n    <div className=\"flex flex-col gap-8\">\n      <div className=\"flex flex-col gap-2\">\n        <p className=\"text-sm font-medium text-muted\">Primary variant</p>\n        <RadioGroup defaultValue=\"option1\" name=\"primary-plan\" variant=\"primary\">\n          <Radio value=\"option1\">\n            <Radio.Content>\n              <Radio.Control>\n                <Radio.Indicator />\n              </Radio.Control>\n              Option 1\n            </Radio.Content>\n            <Description>Standard styling with default background</Description>\n          </Radio>\n          <Radio value=\"option2\">\n            <Radio.Content>\n              <Radio.Control>\n                <Radio.Indicator />\n              </Radio.Control>\n              Option 2\n            </Radio.Content>\n            <Description>Another option with primary styling</Description>\n          </Radio>\n        </RadioGroup>\n      </div>\n      <div className=\"flex flex-col gap-2\">\n        <p className=\"text-sm font-medium text-muted\">Secondary variant</p>\n        <RadioGroup defaultValue=\"option1\" name=\"secondary-plan\" variant=\"secondary\">\n          <Radio value=\"option1\">\n            <Radio.Content>\n              <Radio.Control>\n                <Radio.Indicator />\n              </Radio.Control>\n              Option 1\n            </Radio.Content>\n            <Description>Lower emphasis variant for use in surfaces</Description>\n          </Radio>\n          <Radio value=\"option2\">\n            <Radio.Content>\n              <Radio.Control>\n                <Radio.Indicator />\n              </Radio.Control>\n              Option 2\n            </Radio.Content>\n            <Description>Another option with secondary styling</Description>\n          </Radio>\n        </RadioGroup>\n      </div>\n    </div>\n  );\n}\n"
}
