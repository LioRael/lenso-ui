  "name": "radio-group-controlled",
  "exported": "Controlled",
  "source": "apps/docs/src/demos/en/radio-group/controlled.tsx",
  "code": "\"use client\";\n\nimport {Description, Label, Radio, RadioGroup} from \"@lenso/ui\";\nimport React from \"react\";\n\nexport function Controlled() {\n  const [value, setValue] = React.useState(\"pro\");\n\n  return (\n    <div className=\"flex flex-col gap-4\">\n      <RadioGroup name=\"plan-controlled\" value={value} onChange={setValue}>\n        <Label>Subscription plan</Label>\n        <Radio value=\"starter\">\n          <Radio.Content>\n            <Radio.Control>\n              <Radio.Indicator />\n            </Radio.Control>\n            Starter\n          </Radio.Content>\n          <Description>For side projects and small teams</Description>\n        </Radio>\n        <Radio value=\"pro\">\n          <Radio.Content>\n            <Radio.Control>\n              <Radio.Indicator />\n            </Radio.Control>\n            Pro\n          </Radio.Content>\n          <Description>Advanced reporting and analytics</Description>\n        </Radio>\n        <Radio value=\"teams\">\n          <Radio.Content>\n            <Radio.Control>\n              <Radio.Indicator />\n            </Radio.Control>\n            Teams\n          </Radio.Content>\n          <Description>Share access with up to 10 teammates</Description>\n        </Radio>\n      </RadioGroup>\n      <p className=\"text-sm text-muted\">\n        Selected plan: <span className=\"font-medium\">{value}</span>\n      </p>\n    </div>\n  );\n}\n"
}
