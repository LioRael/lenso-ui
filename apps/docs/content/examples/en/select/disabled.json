  "code": "import {Label, ListBox, Select} from \"@lenso/ui\";\n\nexport function Disabled() {\n  return (\n    <div className=\"flex flex-col gap-4\">\n      <Select isDisabled className=\"w-[256px]\" defaultValue=\"california\" placeholder=\"Select one\">\n        <Label>State</Label>\n        <Select.Trigger>\n          <Select.Value />\n          <Select.Indicator />\n        </Select.Trigger>\n        <Select.Popover>\n          <ListBox>\n            <ListBox.Item id=\"florida\" textValue=\"Florida\">\n              Florida\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n            <ListBox.Item id=\"delaware\" textValue=\"Delaware\">\n              Delaware\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n            <ListBox.Item id=\"california\" textValue=\"California\">\n              California\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n            <ListBox.Item id=\"texas\" textValue=\"Texas\">\n              Texas\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n            <ListBox.Item id=\"new-york\" textValue=\"New York\">\n              New York\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n            <ListBox.Item id=\"washington\" textValue=\"Washington\">\n              Washington\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n          </ListBox>\n        </Select.Popover>\n      </Select>\n      <Select\n        isDisabled\n        className=\"w-[256px]\"\n        defaultValue={[\"argentina\", \"japan\", \"france\"]}\n        placeholder=\"Select countries\"\n        selectionMode=\"multiple\"\n      >\n        <Label>Countries to Visit</Label>\n        <Select.Trigger>\n          <Select.Value />\n          <Select.Indicator />\n        </Select.Trigger>\n        <Select.Popover>\n          <ListBox>\n            <ListBox.Item id=\"argentina\" textValue=\"Argentina\">\n              Argentina\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n            <ListBox.Item id=\"venezuela\" textValue=\"Venezuela\">\n              Venezuela\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n            <ListBox.Item id=\"japan\" textValue=\"Japan\">\n              Japan\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n            <ListBox.Item id=\"france\" textValue=\"France\">\n              France\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n            <ListBox.Item id=\"italy\" textValue=\"Italy\">\n              Italy\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n            <ListBox.Item id=\"spain\" textValue=\"Spain\">\n              Spain\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n          </ListBox>\n        </Select.Popover>\n      </Select>\n    </div>\n  );\n}\n"
