{
  "name": "autocomplete-disabled",
  "exported": "Disabled",
  "source": "apps/docs/src/demos/en/autocomplete/disabled.tsx",
  "code": "\"use client\";\n\nimport {Autocomplete, EmptyState, Label, ListBox, SearchField, useFilter} from \"@lenso/ui\";\n\nexport function Disabled() {\n  const {contains} = useFilter({sensitivity: \"base\"});\n\n  const items = [\n    {id: \"florida\", name: \"Florida\"},\n    {id: \"delaware\", name: \"Delaware\"},\n    {id: \"california\", name: \"California\"},\n    {id: \"texas\", name: \"Texas\"},\n    {id: \"new-york\", name: \"New York\"},\n    {id: \"washington\", name: \"Washington\"},\n  ];\n\n  const countries = [\n    {id: \"argentina\", name: \"Argentina\"},\n    {id: \"venezuela\", name: \"Venezuela\"},\n    {id: \"japan\", name: \"Japan\"},\n    {id: \"france\", name: \"France\"},\n    {id: \"italy\", name: \"Italy\"},\n    {id: \"spain\", name: \"Spain\"},\n  ];\n\n  return (\n    <div className=\"flex flex-col gap-4\">\n      <Autocomplete\n        isDisabled\n        className=\"w-[256px]\"\n        defaultValue=\"california\"\n        placeholder=\"Select one\"\n        selectionMode=\"single\"\n      >\n        <Label>State</Label>\n        <Autocomplete.Trigger>\n          <Autocomplete.Value />\n          <Autocomplete.ClearButton />\n          <Autocomplete.Indicator />\n        </Autocomplete.Trigger>\n        <Autocomplete.Popover>\n          <Autocomplete.Filter filter={contains}>\n            <SearchField autoFocus aria-label=\"Search states\" name=\"search\" variant=\"secondary\">\n              <SearchField.Group>\n                <SearchField.SearchIcon />\n                <SearchField.Input placeholder=\"Search states...\" />\n                <SearchField.ClearButton />\n              </SearchField.Group>\n            </SearchField>\n            <ListBox renderEmptyState={() => <EmptyState>No results found</EmptyState>}>\n              {items.map((item) => (\n                <ListBox.Item key={item.id} id={item.id} textValue={item.name}>\n                  {item.name}\n                  <ListBox.ItemIndicator />\n                </ListBox.Item>\n              ))}\n            </ListBox>\n          </Autocomplete.Filter>\n        </Autocomplete.Popover>\n      </Autocomplete>\n      <Autocomplete\n        isDisabled\n        className=\"w-[256px]\"\n        defaultValue={[\"argentina\", \"japan\", \"france\"]}\n        placeholder=\"Select countries\"\n        selectionMode=\"multiple\"\n      >\n        <Label>Countries to Visit</Label>\n        <Autocomplete.Trigger>\n          <Autocomplete.Value />\n          <Autocomplete.ClearButton />\n          <Autocomplete.Indicator />\n        </Autocomplete.Trigger>\n        <Autocomplete.Popover>\n          <Autocomplete.Filter filter={contains}>\n            <SearchField autoFocus aria-label=\"Search countries\" name=\"search\" variant=\"secondary\">\n              <SearchField.Group>\n                <SearchField.SearchIcon />\n                <SearchField.Input placeholder=\"Search countries...\" />\n                <SearchField.ClearButton />\n              </SearchField.Group>\n            </SearchField>\n            <ListBox renderEmptyState={() => <EmptyState>No results found</EmptyState>}>\n              {countries.map((country) => (\n                <ListBox.Item key={country.id} id={country.id} textValue={country.name}>\n                  {country.name}\n                  <ListBox.ItemIndicator />\n                </ListBox.Item>\n              ))}\n            </ListBox>\n          </Autocomplete.Filter>\n        </Autocomplete.Popover>\n      </Autocomplete>\n    </div>\n  );\n}\n"
}
