{
  "name": "color-slider-channels",
  "exported": "Channels",
  "source": "apps/docs/src/demos/en/color-slider/channels.tsx",
  "code": "\"use client\";\n\nimport {ColorSlider, ColorSwatch, Label} from \"@lenso/ui\";\nimport {useState} from \"react\";\nimport {parseColor} from \"react-aria-components\";\n\nexport function Channels() {\n  const [color, setColor] = useState(parseColor(\"hsl(0, 100%, 50%)\"));\n\n  return (\n    <div className=\"flex w-full max-w-xs flex-col gap-4\">\n      <ColorSlider channel=\"hue\" value={color} onChange={setColor}>\n        <Label>Hue</Label>\n        <ColorSlider.Output />\n        <ColorSlider.Track>\n          <ColorSlider.Thumb />\n        </ColorSlider.Track>\n      </ColorSlider>\n      <ColorSlider channel=\"saturation\" value={color} onChange={setColor}>\n        <Label>Saturation</Label>\n        <ColorSlider.Output />\n        <ColorSlider.Track>\n          <ColorSlider.Thumb />\n        </ColorSlider.Track>\n      </ColorSlider>\n      <ColorSlider channel=\"lightness\" value={color} onChange={setColor}>\n        <Label>Lightness</Label>\n        <ColorSlider.Output />\n        <ColorSlider.Track>\n          <ColorSlider.Thumb />\n        </ColorSlider.Track>\n      </ColorSlider>\n      <div className=\"flex items-center gap-2\">\n        <ColorSwatch color={color} size=\"sm\" />\n        <p className=\"text-sm text-muted\">\n          Current color: <code className=\"font-mono\">{color.toString(\"hsl\")}</code>\n        </p>\n      </div>\n    </div>\n  );\n}\n"
}
