{
  "name": "color-field-channel-editing",
  "exported": "ChannelEditing",
  "source": "apps/docs/src/demos/en/color-field/channel-editing.tsx",
  "code": "\"use client\";\n\nimport type {Color} from \"@lenso/ui\";\n\nimport {ColorField, ColorSwatch, Label, parseColor} from \"@lenso/ui\";\nimport {useState} from \"react\";\n\nexport function ChannelEditing() {\n  const [color, setColor] = useState<Color | null>(parseColor(\"#7F007F\"));\n\n  return (\n    <div className=\"flex flex-col gap-4\">\n      <p className=\"text-sm text-muted\">Edit individual HSL channels:</p>\n      <div className=\"flex gap-4\">\n        <ColorField\n          channel=\"hue\"\n          className=\"w-[100px]\"\n          colorSpace=\"hsl\"\n          name=\"hue\"\n          value={color}\n          onChange={setColor}\n        >\n          <Label>Hue</Label>\n          <ColorField.Group>\n            <ColorField.Input />\n          </ColorField.Group>\n        </ColorField>\n        <ColorField\n          channel=\"saturation\"\n          className=\"w-[100px]\"\n          colorSpace=\"hsl\"\n          name=\"saturation\"\n          value={color}\n          onChange={setColor}\n        >\n          <Label>Saturation</Label>\n          <ColorField.Group>\n            <ColorField.Input />\n            <ColorField.Suffix>\n              <span className=\"text-sm text-muted\">%</span>\n            </ColorField.Suffix>\n          </ColorField.Group>\n        </ColorField>\n        <ColorField\n          channel=\"lightness\"\n          className=\"w-[100px]\"\n          colorSpace=\"hsl\"\n          name=\"lightness\"\n          value={color}\n          onChange={setColor}\n        >\n          <Label>Lightness</Label>\n          <ColorField.Group>\n            <ColorField.Input />\n            <ColorField.Suffix>\n              <span className=\"text-sm text-muted\">%</span>\n            </ColorField.Suffix>\n          </ColorField.Group>\n        </ColorField>\n      </div>\n      <div className=\"flex items-center gap-2\">\n        <ColorSwatch color={color ?? undefined} size=\"md\" />\n        <span className=\"text-sm\">Current: {color ? color.toString(\"hex\") : \"(empty)\"}</span>\n      </div>\n    </div>\n  );\n}\n"
}
