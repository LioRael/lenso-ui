  "source": "apps/docs/src/demos/cn/chip/statuses.tsx",
  "code": "import {Ban, Check, CircleFill, CircleInfo, TriangleExclamation} from \"@gravity-ui/icons\";\nimport {Chip} from \"@lenso/ui\";\n\nexport function ChipStatuses() {\n  return (\n    <div className=\"flex flex-col gap-4\">\n      <div className=\"flex flex-wrap items-center gap-3\">\n        <Chip variant=\"primary\">\n          <CircleFill width={6} />\n          <Chip.Label>默认</Chip.Label>\n        </Chip>\n        <Chip color=\"success\" variant=\"primary\">\n          <CircleFill width={6} />\n          <Chip.Label>活跃</Chip.Label>\n        </Chip>\n        <Chip color=\"warning\" variant=\"primary\">\n          <CircleFill width={6} />\n          <Chip.Label>待处理</Chip.Label>\n        </Chip>\n        <Chip color=\"danger\" variant=\"primary\">\n          <CircleFill width={6} />\n          <Chip.Label>未激活</Chip.Label>\n        </Chip>\n      </div>\n\n      <div className=\"flex flex-wrap items-center gap-3\">\n        <Chip>\n          <CircleInfo width={12} />\n          <Chip.Label>新功能</Chip.Label>\n        </Chip>\n        <Chip color=\"success\">\n          <Check width={12} />\n          <Chip.Label>可用</Chip.Label>\n        </Chip>\n        <Chip color=\"warning\">\n          <TriangleExclamation width={12} />\n          <Chip.Label>测试版</Chip.Label>\n        </Chip>\n        <Chip color=\"danger\">\n          <Ban width={12} />\n          <Chip.Label>已弃用</Chip.Label>\n        </Chip>\n      </div>\n    </div>\n  );\n}\n"
}
