{
  "name": "tooltip-placement",
  "exported": "TooltipPlacement",
  "source": "apps/docs/src/demos/cn/tooltip/placement.tsx",
  "code": "import {Button, Tooltip} from \"@lenso/ui\";\n\nexport function TooltipPlacement() {\n  return (\n    <div className=\"grid grid-cols-3 gap-4\">\n      <div />\n      <Tooltip delay={0}>\n        <Button className=\"w-full\" variant=\"tertiary\">\n          Top\n        </Button>\n        <Tooltip.Content showArrow placement=\"top\">\n          <Tooltip.Arrow />\n          <p>顶部位置</p>\n        </Tooltip.Content>\n      </Tooltip>\n      <div />\n\n      <Tooltip delay={0}>\n        <Button className=\"w-full\" variant=\"tertiary\">\n          Left\n        </Button>\n        <Tooltip.Content showArrow placement=\"left\">\n          <Tooltip.Arrow />\n          <p>左侧位置</p>\n        </Tooltip.Content>\n      </Tooltip>\n\n      <div className=\"flex items-center justify-center\">\n        <span className=\"text-sm text-muted\">悬停按钮</span>\n      </div>\n\n      <Tooltip delay={0}>\n        <Button className=\"w-full\" variant=\"tertiary\">\n          Right\n        </Button>\n        <Tooltip.Content showArrow placement=\"right\">\n          <Tooltip.Arrow />\n          <p>右侧位置</p>\n        </Tooltip.Content>\n      </Tooltip>\n\n      <div />\n      <Tooltip delay={0}>\n        <Button className=\"w-full\" variant=\"tertiary\">\n          Bottom\n        </Button>\n        <Tooltip.Content showArrow placement=\"bottom\">\n          <Tooltip.Arrow />\n          <p>底部位置</p>\n        </Tooltip.Content>\n      </Tooltip>\n      <div />\n    </div>\n  );\n}\n"
}
