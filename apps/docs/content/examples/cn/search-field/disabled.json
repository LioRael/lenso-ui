  "code": "import {Description, Label, SearchField} from \"@lenso/ui\";\n\nexport function Disabled() {\n  return (\n    <div className=\"flex flex-col gap-4\">\n      <SearchField isDisabled name=\"search\" value=\"已禁用的搜索\">\n        <Label>搜索</Label>\n        <SearchField.Group>\n          <SearchField.SearchIcon />\n          <SearchField.Input className=\"w-[280px]\" placeholder=\"搜索…\" />\n          <SearchField.ClearButton />\n        </SearchField.Group>\n        <Description>此搜索框已禁用</Description>\n      </SearchField>\n      <SearchField isDisabled name=\"search-empty\">\n        <Label>搜索</Label>\n        <SearchField.Group>\n          <SearchField.SearchIcon />\n          <SearchField.Input className=\"w-[280px]\" placeholder=\"搜索…\" />\n          <SearchField.ClearButton />\n        </SearchField.Group>\n        <Description>此搜索框已禁用</Description>\n      </SearchField>\n    </div>\n  );\n}\n"
