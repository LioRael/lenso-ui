{
  "name": "dropdown-custom-trigger",
  "exported": "CustomTrigger",
  "source": "apps/docs/src/demos/cn/dropdown/custom-trigger.tsx",
  "code": "import {ArrowRightFromSquare, Gear, Persons} from \"@gravity-ui/icons\";\nimport {Avatar, Dropdown, Label} from \"@lenso/ui\";\n\nexport function CustomTrigger() {\n  return (\n    <Dropdown>\n      <Dropdown.Trigger className=\"rounded-full\">\n        <Avatar>\n          <Avatar.Image\n            alt=\"Junior Garcia\"\n            src=\"https://heroui-assets.nyc3.cdn.digitaloceanspaces.com/avatars/orange.jpg\"\n          />\n          <Avatar.Fallback delayMs={600}>JD</Avatar.Fallback>\n        </Avatar>\n      </Dropdown.Trigger>\n      <Dropdown.Popover>\n        <div className=\"px-3 pt-3 pb-1\">\n          <div className=\"flex items-center gap-2\">\n            <Avatar size=\"sm\">\n              <Avatar.Image\n                alt=\"Jane\"\n                src=\"https://heroui-assets.nyc3.cdn.digitaloceanspaces.com/avatars/orange.jpg\"\n              />\n              <Avatar.Fallback delayMs={600}>JD</Avatar.Fallback>\n            </Avatar>\n            <div className=\"flex flex-col gap-0\">\n              <p className=\"text-sm leading-5 font-medium\">Jane Doe</p>\n              <p className=\"text-xs leading-none text-muted\">jane@example.com</p>\n            </div>\n          </div>\n        </div>\n        <Dropdown.Menu>\n          <Dropdown.Item id=\"dashboard\" textValue=\"仪表盘\">\n            <Label>仪表盘</Label>\n          </Dropdown.Item>\n          <Dropdown.Item id=\"profile\" textValue=\"个人资料\">\n            <Label>个人资料</Label>\n          </Dropdown.Item>\n          <Dropdown.Item id=\"settings\" textValue=\"设置\">\n            <div className=\"flex w-full items-center justify-between gap-2\">\n              <Label>设置</Label>\n              <Gear className=\"size-3.5 text-muted\" />\n            </div>\n          </Dropdown.Item>\n          <Dropdown.Item id=\"new-project\" textValue=\"新建项目\">\n            <div className=\"flex w-full items-center justify-between gap-2\">\n              <Label>创建团队</Label>\n              <Persons className=\"size-3.5 text-muted\" />\n            </div>\n          </Dropdown.Item>\n          <Dropdown.Item id=\"logout\" textValue=\"退出登录\" variant=\"danger\">\n            <div className=\"flex w-full items-center justify-between gap-2\">\n              <Label>退出登录</Label>\n              <ArrowRightFromSquare className=\"size-3.5 text-danger\" />\n            </div>\n          </Dropdown.Item>\n        </Dropdown.Menu>\n      </Dropdown.Popover>\n    </Dropdown>\n  );\n}\n"
}
