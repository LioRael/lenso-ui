{
  "name": "dropdown-with-disabled-items",
  "exported": "WithDisabledItems",
  "source": "apps/docs/src/demos/cn/dropdown/with-disabled-items.tsx",
  "code": "\"use client\";\n\nimport {Bars, Pencil, SquarePlus, TrashBin} from \"@gravity-ui/icons\";\nimport {Button, Description, Dropdown, Header, Kbd, Label, Separator} from \"@lenso/ui\";\n\nexport function WithDisabledItems() {\n  return (\n    <Dropdown>\n      <Button isIconOnly aria-label=\"菜单\" variant=\"secondary\">\n        <Bars className=\"outline-none\" />\n      </Button>\n      <Dropdown.Popover className=\"min-w-[220px]\">\n        <Dropdown.Menu\n          disabledKeys={[\"delete-file\"]}\n          onAction={(key) => console.log(`Selected: ${key}`)}\n        >\n          <Dropdown.Section>\n            <Header>操作</Header>\n            <Dropdown.Item id=\"new-file\" textValue=\"新建文件\">\n              <div className=\"flex h-8 items-start justify-center pt-px\">\n                <SquarePlus className=\"size-4 shrink-0 text-muted\" />\n              </div>\n              <div className=\"flex flex-col\">\n                <Label>新建文件</Label>\n                <Description>创建新文件</Description>\n              </div>\n              <Kbd className=\"ms-auto\" slot=\"keyboard\" variant=\"light\">\n                <Kbd.Abbr keyValue=\"command\" />\n                <Kbd.Content>N</Kbd.Content>\n              </Kbd>\n            </Dropdown.Item>\n            <Dropdown.Item id=\"edit-file\" textValue=\"编辑文件\">\n              <div className=\"flex h-8 items-start justify-center pt-px\">\n                <Pencil className=\"size-4 shrink-0 text-muted\" />\n              </div>\n              <div className=\"flex flex-col\">\n                <Label>编辑文件</Label>\n                <Description>进行修改</Description>\n              </div>\n              <Kbd className=\"ms-auto\" slot=\"keyboard\" variant=\"light\">\n                <Kbd.Abbr keyValue=\"command\" />\n                <Kbd.Content>E</Kbd.Content>\n              </Kbd>\n            </Dropdown.Item>\n          </Dropdown.Section>\n          <Separator />\n          <Dropdown.Section>\n            <Header>危险区域</Header>\n            <Dropdown.Item id=\"delete-file\" textValue=\"删除文件\" variant=\"danger\">\n              <div className=\"flex h-8 items-start justify-center pt-px\">\n                <TrashBin className=\"size-4 shrink-0 text-danger\" />\n              </div>\n              <div className=\"flex flex-col\">\n                <Label>删除文件</Label>\n                <Description>移至废纸篓</Description>\n              </div>\n              <Kbd className=\"ms-auto\" slot=\"keyboard\" variant=\"light\">\n                <Kbd.Abbr keyValue=\"command\" />\n                <Kbd.Abbr keyValue=\"shift\" />\n                <Kbd.Content>D</Kbd.Content>\n              </Kbd>\n            </Dropdown.Item>\n          </Dropdown.Section>\n        </Dropdown.Menu>\n      </Dropdown.Popover>\n    </Dropdown>\n  );\n}\n"
}
