  "source": "apps/docs/src/demos/cn/progress-bar/sizes.tsx",
  "code": "import {Label, ProgressBar} from \"@lenso/ui\";\n\nconst SIZE_LABELS = {\n  lg: \"大\",\n  md: \"中\",\n  sm: \"小\",\n} as const;\n\nexport function Sizes() {\n  return (\n    <div className=\"flex w-64 flex-col gap-6\">\n      <ProgressBar aria-label={SIZE_LABELS.sm} size=\"sm\" value={40}>\n        <Label>{SIZE_LABELS.sm}</Label>\n        <ProgressBar.Output />\n        <ProgressBar.Track>\n          <ProgressBar.Fill />\n        </ProgressBar.Track>\n      </ProgressBar>\n      <ProgressBar aria-label={SIZE_LABELS.md} size=\"md\" value={60}>\n        <Label>{SIZE_LABELS.md}</Label>\n        <ProgressBar.Output />\n        <ProgressBar.Track>\n          <ProgressBar.Fill />\n        </ProgressBar.Track>\n      </ProgressBar>\n      <ProgressBar aria-label={SIZE_LABELS.lg} size=\"lg\" value={80}>\n        <Label>{SIZE_LABELS.lg}</Label>\n        <ProgressBar.Output />\n        <ProgressBar.Track>\n          <ProgressBar.Fill />\n        </ProgressBar.Track>\n      </ProgressBar>\n    </div>\n  );\n}\n"
}
