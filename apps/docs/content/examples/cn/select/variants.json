  "code": "import {Label, ListBox, Select} from \"@lenso/ui\";\n\nexport function Variants() {\n  return (\n    <div className=\"flex flex-col gap-4\">\n      <Select className=\"w-[256px]\" placeholder=\"请选择\" variant=\"primary\">\n        <Label>主要变体</Label>\n        <Select.Trigger>\n          <Select.Value />\n          <Select.Indicator />\n        </Select.Trigger>\n        <Select.Popover>\n          <ListBox>\n            <ListBox.Item id=\"option1\" textValue=\"选项 1\">\n              Option 1\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n            <ListBox.Item id=\"option2\" textValue=\"选项 2\">\n              Option 2\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n          </ListBox>\n        </Select.Popover>\n      </Select>\n      <Select className=\"w-[256px]\" placeholder=\"请选择\" variant=\"secondary\">\n        <Label>次要变体</Label>\n        <Select.Trigger>\n          <Select.Value />\n          <Select.Indicator />\n        </Select.Trigger>\n        <Select.Popover>\n          <ListBox>\n            <ListBox.Item id=\"option1\" textValue=\"选项 1\">\n              Option 1\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n            <ListBox.Item id=\"option2\" textValue=\"选项 2\">\n              Option 2\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n          </ListBox>\n        </Select.Popover>\n      </Select>\n    </div>\n  );\n}\n"
}
