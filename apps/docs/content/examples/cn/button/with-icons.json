  "source": "apps/docs/src/demos/cn/button/with-icons.tsx",
  "code": "import {Envelope, Globe, Plus, TrashBin} from \"@gravity-ui/icons\";\nimport {Button} from \"@lenso/ui\";\n\nexport function WithIcons() {\n  return (\n    <div className=\"flex flex-wrap gap-3\">\n      <Button>\n        <Globe />\n        搜索\n      </Button>\n      <Button variant=\"secondary\">\n        <Plus />\n        添加成员\n      </Button>\n      <Button variant=\"tertiary\">\n        <Envelope />\n        邮件\n      </Button>\n      <Button variant=\"danger\">\n        <TrashBin />\n        删除\n      </Button>\n    </div>\n  );\n}\n"
}
