  "code": "\"use client\";\n\nimport {ComboBox, Description, Input, Label, ListBox} from \"@lenso/ui\";\n\nexport function MenuTrigger() {\n  return (\n    <div className=\"flex flex-col gap-8\">\n      <div className=\"flex flex-col gap-2\">\n        <p className=\"text-sm font-medium text-muted\">聚焦（默认）</p>\n        <ComboBox className=\"w-[256px]\" menuTrigger=\"focus\">\n          <Label>最喜欢的动物</Label>\n          <ComboBox.InputGroup>\n            <Input placeholder=\"搜索动物…\" />\n            <ComboBox.Trigger />\n          </ComboBox.InputGroup>\n          <ComboBox.Popover>\n            <ListBox>\n              <ListBox.Item id=\"aardvark\" textValue=\"土豚\">\n                土豚\n                <ListBox.ItemIndicator />\n              </ListBox.Item>\n              <ListBox.Item id=\"cat\" textValue=\"猫\">\n                猫\n                <ListBox.ItemIndicator />\n              </ListBox.Item>\n              <ListBox.Item id=\"dog\" textValue=\"狗\">\n                狗\n                <ListBox.ItemIndicator />\n              </ListBox.Item>\n              <ListBox.Item id=\"kangaroo\" textValue=\"袋鼠\">\n                袋鼠\n                <ListBox.ItemIndicator />\n              </ListBox.Item>\n              <ListBox.Item id=\"panda\" textValue=\"熊猫\">\n                熊猫\n                <ListBox.ItemIndicator />\n              </ListBox.Item>\n              <ListBox.Item id=\"snake\" textValue=\"蛇\">\n                蛇\n                <ListBox.ItemIndicator />\n              </ListBox.Item>\n            </ListBox>\n          </ComboBox.Popover>\n          <Description>输入框获得焦点时打开弹出层</Description>\n        </ComboBox>\n      </div>\n\n      <div className=\"flex flex-col gap-2\">\n        <p className=\"text-sm font-medium text-muted\">输入</p>\n        <ComboBox className=\"w-[256px]\" menuTrigger=\"input\">\n          <Label>最喜欢的动物</Label>\n          <ComboBox.InputGroup>\n            <Input placeholder=\"搜索动物…\" />\n            <ComboBox.Trigger />\n          </ComboBox.InputGroup>\n          <ComboBox.Popover>\n            <ListBox>\n              <ListBox.Item id=\"aardvark\" textValue=\"土豚\">\n                土豚\n                <ListBox.ItemIndicator />\n              </ListBox.Item>\n              <ListBox.Item id=\"cat\" textValue=\"猫\">\n                猫\n                <ListBox.ItemIndicator />\n              </ListBox.Item>\n              <ListBox.Item id=\"dog\" textValue=\"狗\">\n                狗\n                <ListBox.ItemIndicator />\n              </ListBox.Item>\n              <ListBox.Item id=\"kangaroo\" textValue=\"袋鼠\">\n                袋鼠\n                <ListBox.ItemIndicator />\n              </ListBox.Item>\n              <ListBox.Item id=\"panda\" textValue=\"熊猫\">\n                熊猫\n                <ListBox.ItemIndicator />\n              </ListBox.Item>\n              <ListBox.Item id=\"snake\" textValue=\"蛇\">\n                蛇\n                <ListBox.ItemIndicator />\n              </ListBox.Item>\n            </ListBox>\n          </ComboBox.Popover>\n          <Description>用户编辑输入文本时打开弹出层</Description>\n        </ComboBox>\n      </div>\n\n      <div className=\"flex flex-col gap-2\">\n        <p className=\"text-sm font-medium text-muted\">手动</p>\n        <ComboBox className=\"w-[256px]\" menuTrigger=\"manual\">\n          <Label>最喜欢的动物</Label>\n          <ComboBox.InputGroup>\n            <Input placeholder=\"搜索动物…\" />\n            <ComboBox.Trigger />\n          </ComboBox.InputGroup>\n          <ComboBox.Popover>\n            <ListBox>\n              <ListBox.Item id=\"aardvark\" textValue=\"土豚\">\n                土豚\n                <ListBox.ItemIndicator />\n              </ListBox.Item>\n              <ListBox.Item id=\"cat\" textValue=\"猫\">\n                猫\n                <ListBox.ItemIndicator />\n              </ListBox.Item>\n              <ListBox.Item id=\"dog\" textValue=\"狗\">\n                狗\n                <ListBox.ItemIndicator />\n              </ListBox.Item>\n              <ListBox.Item id=\"kangaroo\" textValue=\"袋鼠\">\n                袋鼠\n                <ListBox.ItemIndicator />\n              </ListBox.Item>\n              <ListBox.Item id=\"panda\" textValue=\"熊猫\">\n                熊猫\n                <ListBox.ItemIndicator />\n              </ListBox.Item>\n              <ListBox.Item id=\"snake\" textValue=\"蛇\">\n                蛇\n                <ListBox.ItemIndicator />\n              </ListBox.Item>\n            </ListBox>\n          </ComboBox.Popover>\n          <Description>仅在按下触发按钮或使用方向键时打开弹出层</Description>\n        </ComboBox>\n      </div>\n    </div>\n  );\n}\n"
}
