{
  "name": "combo-box-controlled-input-value",
  "exported": "ControlledInputValue",
  "source": "apps/docs/src/demos/cn/combo-box/controlled-input-value.tsx",
  "code": "\"use client\";\n\nimport {ComboBox, Input, Label, ListBox} from \"@lenso/ui\";\nimport {useState} from \"react\";\n\nexport function ControlledInputValue() {\n  const [inputValue, setInputValue] = useState(\"\");\n\n  return (\n    <div className=\"space-y-2\">\n      <ComboBox className=\"w-[256px]\" inputValue={inputValue} onInputChange={setInputValue}>\n        <Label>搜索（受控输入）</Label>\n        <ComboBox.InputGroup>\n          <Input placeholder=\"输入以搜索…\" />\n          <ComboBox.Trigger />\n        </ComboBox.InputGroup>\n        <ComboBox.Popover>\n          <ListBox>\n            <ListBox.Item id=\"aardvark\" textValue=\"土豚\">\n              土豚\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n            <ListBox.Item id=\"cat\" textValue=\"猫\">\n              猫\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n            <ListBox.Item id=\"dog\" textValue=\"狗\">\n              狗\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n            <ListBox.Item id=\"kangaroo\" textValue=\"袋鼠\">\n              袋鼠\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n            <ListBox.Item id=\"panda\" textValue=\"熊猫\">\n              熊猫\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n            <ListBox.Item id=\"snake\" textValue=\"蛇\">\n              蛇\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n          </ListBox>\n        </ComboBox.Popover>\n      </ComboBox>\n      <p className=\"text-sm text-muted\">输入值：{inputValue || \"（空）\"}</p>\n    </div>\n  );\n}\n"
}
