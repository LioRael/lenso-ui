  "source": "apps/docs/src/demos/cn/combo-box/full-width.tsx",
  "code": "import {ComboBox, Input, Label, ListBox} from \"@lenso/ui\";\n\nexport function FullWidth() {\n  return (\n    <div className=\"w-[400px] space-y-4\">\n      <ComboBox fullWidth>\n        <Label>最喜欢的动物</Label>\n        <ComboBox.InputGroup>\n          <Input placeholder=\"搜索动物…\" />\n          <ComboBox.Trigger />\n        </ComboBox.InputGroup>\n        <ComboBox.Popover>\n          <ListBox>\n            <ListBox.Item id=\"aardvark\" textValue=\"土豚\">\n              土豚\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n            <ListBox.Item id=\"cat\" textValue=\"猫\">\n              猫\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n            <ListBox.Item id=\"dog\" textValue=\"狗\">\n              狗\n              <ListBox.ItemIndicator />\n            </ListBox.Item>\n          </ListBox>\n        </ComboBox.Popover>\n      </ComboBox>\n    </div>\n  );\n}\n"
}
