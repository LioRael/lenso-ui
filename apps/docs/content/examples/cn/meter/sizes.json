  "name": "meter-sizes",
  "exported": "Sizes",
  "source": "apps/docs/src/demos/cn/meter/sizes.tsx",
  "code": "import {Label, Meter} from \"@lenso/ui\";\n\nconst SIZE_LABELS = {\n  lg: \"大\",\n  md: \"中\",\n  sm: \"小\",\n} as const;\n\nexport function Sizes() {\n  return (\n    <div className=\"flex w-64 flex-col gap-6\">\n      <Meter color=\"success\" size=\"sm\" value={40}>\n        <Label>{SIZE_LABELS.sm}</Label>\n        <Meter.Output />\n        <Meter.Track>\n          <Meter.Fill />\n        </Meter.Track>\n      </Meter>\n      <Meter color=\"accent\" size=\"md\" value={60}>\n        <Label>{SIZE_LABELS.md}</Label>\n        <Meter.Output />\n        <Meter.Track>\n          <Meter.Fill />\n        </Meter.Track>\n      </Meter>\n      <Meter color=\"warning\" size=\"lg\" value={80}>\n        <Label>{SIZE_LABELS.lg}</Label>\n        <Meter.Output />\n        <Meter.Track>\n          <Meter.Fill />\n        </Meter.Track>\n      </Meter>\n    </div>\n  );\n}\n"
}
