{
  "name": "list-box-controlled",
  "exported": "Controlled",
  "source": "apps/docs/src/demos/cn/list-box/controlled.tsx",
  "code": "\"use client\";\n\nimport type {Selection} from \"@lenso/ui\";\n\nimport {Check} from \"@gravity-ui/icons\";\nimport {Avatar, Description, Label, ListBox, Surface} from \"@lenso/ui\";\nimport {useState} from \"react\";\n\nexport function Controlled() {\n  const [selected, setSelected] = useState<Selection>(new Set([\"1\"]));\n\n  const selectedItems = Array.from(selected);\n\n  return (\n    <div className=\"space-y-4\">\n      <Surface className=\"w-[256px] rounded-3xl shadow-surface\">\n        <ListBox\n          aria-label=\"用户\"\n          selectedKeys={selected}\n          selectionMode=\"multiple\"\n          onSelectionChange={setSelected}\n        >\n          <ListBox.Item id=\"1\" textValue=\"Bob\">\n            <Avatar size=\"sm\">\n              <Avatar.Image\n                alt=\"Bob\"\n                src=\"https://heroui-assets.nyc3.cdn.digitaloceanspaces.com/avatars/blue.jpg\"\n              />\n              <Avatar.Fallback>B</Avatar.Fallback>\n            </Avatar>\n            <div className=\"flex flex-col\">\n              <Label>Bob</Label>\n              <Description>bob@heroui.com</Description>\n            </div>\n            <ListBox.ItemIndicator>\n              {({isSelected}) => (isSelected ? <Check className=\"size-4 text-accent\" /> : null)}\n            </ListBox.ItemIndicator>\n          </ListBox.Item>\n          <ListBox.Item id=\"2\" textValue=\"Fred\">\n            <Avatar size=\"sm\">\n              <Avatar.Image\n                alt=\"Fred\"\n                src=\"https://heroui-assets.nyc3.cdn.digitaloceanspaces.com/avatars/green.jpg\"\n              />\n              <Avatar.Fallback>F</Avatar.Fallback>\n            </Avatar>\n            <div className=\"flex flex-col\">\n              <Label>Fred</Label>\n              <Description>fred@heroui.com</Description>\n            </div>\n            <ListBox.ItemIndicator>\n              {({isSelected}) => (isSelected ? <Check className=\"size-4 text-accent\" /> : null)}\n            </ListBox.ItemIndicator>\n          </ListBox.Item>\n          <ListBox.Item id=\"3\" textValue=\"Martha\">\n            <Avatar size=\"sm\">\n              <Avatar.Image\n                alt=\"Martha\"\n                src=\"https://heroui-assets.nyc3.cdn.digitaloceanspaces.com/avatars/purple.jpg\"\n              />\n              <Avatar.Fallback>M</Avatar.Fallback>\n            </Avatar>\n            <div className=\"flex flex-col\">\n              <Label>Martha</Label>\n              <Description>martha@heroui.com</Description>\n            </div>\n            <ListBox.ItemIndicator>\n              {({isSelected}) => (isSelected ? <Check className=\"size-4 text-accent\" /> : null)}\n            </ListBox.ItemIndicator>\n          </ListBox.Item>\n        </ListBox>\n      </Surface>\n      <p className=\"text-sm text-muted\">\n        已选：{selectedItems.length > 0 ? selectedItems.join(\"、\") : \"无\"}\n      </p>\n    </div>\n  );\n}\n"
}
