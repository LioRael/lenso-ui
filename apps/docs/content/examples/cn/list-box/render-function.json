  "name": "list-box-render-function",
  "exported": "RenderFunction",
  "source": "apps/docs/src/demos/cn/list-box/render-function.tsx",
  "code": "\"use client\";\n\nimport {Avatar, Description, Label, ListBox} from \"@lenso/ui\";\n\nexport function RenderFunction() {\n  return (\n    <ListBox\n      aria-label=\"用户\"\n      className=\"w-[220px]\"\n      render={(props) => <div {...props} data-custom=\"true\" />}\n      selectionMode=\"single\"\n    >\n      <ListBox.Item\n        id=\"1\"\n        render={(props) => <span {...props} data-custom=\"foo\" />}\n        textValue=\"Bob\"\n      >\n        <Avatar size=\"sm\">\n          <Avatar.Image\n            alt=\"Bob\"\n            src=\"https://heroui-assets.nyc3.cdn.digitaloceanspaces.com/avatars/blue.jpg\"\n          />\n          <Avatar.Fallback>B</Avatar.Fallback>\n        </Avatar>\n        <div className=\"flex flex-col\">\n          <Label>Bob</Label>\n          <Description>bob@heroui.com</Description>\n        </div>\n        <ListBox.ItemIndicator />\n      </ListBox.Item>\n      <ListBox.Item\n        id=\"2\"\n        render={(props) => <span {...props} data-custom=\"bar\" />}\n        textValue=\"Fred\"\n      >\n        <Avatar size=\"sm\">\n          <Avatar.Image\n            alt=\"Fred\"\n            src=\"https://heroui-assets.nyc3.cdn.digitaloceanspaces.com/avatars/green.jpg\"\n          />\n          <Avatar.Fallback>F</Avatar.Fallback>\n        </Avatar>\n        <div className=\"flex flex-col\">\n          <Label>Fred</Label>\n          <Description>fred@heroui.com</Description>\n        </div>\n        <ListBox.ItemIndicator />\n      </ListBox.Item>\n      <ListBox.Item\n        id=\"3\"\n        render={(props) => <span {...props} data-custom=\"baz\" />}\n        textValue=\"Martha\"\n      >\n        <Avatar size=\"sm\">\n          <Avatar.Image\n            alt=\"Martha\"\n            src=\"https://heroui-assets.nyc3.cdn.digitaloceanspaces.com/avatars/purple.jpg\"\n          />\n          <Avatar.Fallback>M</Avatar.Fallback>\n        </Avatar>\n        <div className=\"flex flex-col\">\n          <Label>Martha</Label>\n          <Description>martha@heroui.com</Description>\n        </div>\n        <ListBox.ItemIndicator />\n      </ListBox.Item>\n    </ListBox>\n  );\n}\n"
}
