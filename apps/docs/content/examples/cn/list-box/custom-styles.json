  "name": "list-box-custom-styles",
  "exported": "CustomStyles",
  "source": "apps/docs/src/demos/cn/list-box/custom-styles.tsx",
  "code": "import {Avatar, Description, Label, ListBox} from \"@lenso/ui\";\n\nexport function CustomStyles() {\n  return (\n    <ListBox\n      aria-label=\"负责人\"\n      className=\"w-56 rounded-xl border border-border/80 bg-surface p-1 shadow-sm\"\n      selectionMode=\"single\"\n    >\n      <ListBox.Item\n        className=\"rounded-lg data-[focused=true]:bg-accent/10 data-[selected=true]:bg-accent/5\"\n        id=\"1\"\n        textValue=\"Bob\"\n      >\n        <Avatar size=\"sm\">\n          <Avatar.Image\n            alt=\"Bob\"\n            src=\"https://heroui-assets.nyc3.cdn.digitaloceanspaces.com/avatars/blue.jpg\"\n          />\n          <Avatar.Fallback>B</Avatar.Fallback>\n        </Avatar>\n        <div className=\"flex flex-col\">\n          <Label>Bob</Label>\n          <Description>bob@heroui.com</Description>\n        </div>\n        <ListBox.ItemIndicator />\n      </ListBox.Item>\n      <ListBox.Item\n        className=\"rounded-lg data-[focused=true]:bg-accent/10 data-[selected=true]:bg-accent/5\"\n        id=\"2\"\n        textValue=\"Fred\"\n      >\n        <Avatar size=\"sm\">\n          <Avatar.Image\n            alt=\"Fred\"\n            src=\"https://heroui-assets.nyc3.cdn.digitaloceanspaces.com/avatars/green.jpg\"\n          />\n          <Avatar.Fallback>F</Avatar.Fallback>\n        </Avatar>\n        <div className=\"flex flex-col\">\n          <Label>Fred</Label>\n          <Description>fred@heroui.com</Description>\n        </div>\n        <ListBox.ItemIndicator />\n      </ListBox.Item>\n    </ListBox>\n  );\n}\n"
}
