  "code": "\"use client\";\n\nimport {Check} from \"@gravity-ui/icons\";\nimport {Avatar, Description, Label, ListBox, Surface} from \"@lenso/ui\";\n\nexport function CustomCheckIcon() {\n  return (\n    <Surface className=\"w-[256px] rounded-3xl shadow-surface\">\n      <ListBox aria-label=\"用户\" selectionMode=\"multiple\">\n        <ListBox.Item id=\"1\" textValue=\"Bob\">\n          <Avatar size=\"sm\">\n            <Avatar.Image\n              alt=\"Bob\"\n              src=\"https://heroui-assets.nyc3.cdn.digitaloceanspaces.com/avatars/blue.jpg\"\n            />\n            <Avatar.Fallback>B</Avatar.Fallback>\n          </Avatar>\n          <div className=\"flex flex-col\">\n            <Label>Bob</Label>\n            <Description>bob@heroui.com</Description>\n          </div>\n          <ListBox.ItemIndicator>\n            {({isSelected}) => (isSelected ? <Check className=\"size-4 text-accent\" /> : null)}\n          </ListBox.ItemIndicator>\n        </ListBox.Item>\n        <ListBox.Item id=\"2\" textValue=\"Fred\">\n          <Avatar size=\"sm\">\n            <Avatar.Image\n              alt=\"Fred\"\n              src=\"https://heroui-assets.nyc3.cdn.digitaloceanspaces.com/avatars/green.jpg\"\n            />\n            <Avatar.Fallback>F</Avatar.Fallback>\n          </Avatar>\n          <div className=\"flex flex-col\">\n            <Label>Fred</Label>\n            <Description>fred@heroui.com</Description>\n          </div>\n          <ListBox.ItemIndicator>\n            {({isSelected}) => (isSelected ? <Check className=\"size-4 text-accent\" /> : null)}\n          </ListBox.ItemIndicator>\n        </ListBox.Item>\n        <ListBox.Item id=\"3\" textValue=\"Martha\">\n          <Avatar size=\"sm\">\n            <Avatar.Image\n              alt=\"Martha\"\n              src=\"https://heroui-assets.nyc3.cdn.digitaloceanspaces.com/avatars/purple.jpg\"\n            />\n            <Avatar.Fallback>M</Avatar.Fallback>\n          </Avatar>\n          <div className=\"flex flex-col\">\n            <Label>Martha</Label>\n            <Description>martha@heroui.com</Description>\n          </div>\n          <ListBox.ItemIndicator>\n            {({isSelected}) => (isSelected ? <Check className=\"size-4 text-accent\" /> : null)}\n          </ListBox.ItemIndicator>\n        </ListBox.Item>\n      </ListBox>\n    </Surface>\n  );\n}\n"
}
