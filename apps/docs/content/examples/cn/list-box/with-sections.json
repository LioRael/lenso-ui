{
  "name": "list-box-with-sections",
  "exported": "WithSections",
  "source": "apps/docs/src/demos/cn/list-box/with-sections.tsx",
  "code": "\"use client\";\n\nimport {Pencil, SquarePlus, TrashBin} from \"@gravity-ui/icons\";\nimport {Description, Header, Kbd, Label, ListBox, Separator, Surface} from \"@lenso/ui\";\n\nexport function WithSections() {\n  return (\n    <Surface className=\"w-[256px] rounded-3xl shadow-surface\">\n      <ListBox\n        aria-label=\"文件操作\"\n        className=\"w-full p-2\"\n        selectionMode=\"none\"\n        onAction={(key) => alert(`已选项目：${key}`)}\n      >\n        <ListBox.Section>\n          <Header>操作</Header>\n          <ListBox.Item id=\"new-file\" textValue=\"新建文件\">\n            <div className=\"flex h-8 items-start justify-center pt-px\">\n              <SquarePlus className=\"size-4 shrink-0 text-muted\" />\n            </div>\n            <div className=\"flex flex-col\">\n              <Label>新建文件</Label>\n              <Description>创建新文件</Description>\n            </div>\n            <Kbd className=\"ms-auto\" variant=\"light\">\n              <Kbd.Abbr keyValue=\"command\" />\n              <Kbd.Content>N</Kbd.Content>\n            </Kbd>\n          </ListBox.Item>\n          <ListBox.Item id=\"edit-file\" textValue=\"编辑文件\">\n            <div className=\"flex h-8 items-start justify-center pt-px\">\n              <Pencil className=\"size-4 shrink-0 text-muted\" />\n            </div>\n            <div className=\"flex flex-col\">\n              <Label>编辑文件</Label>\n              <Description>进行修改</Description>\n            </div>\n            <Kbd className=\"ms-auto\" variant=\"light\">\n              <Kbd.Abbr keyValue=\"command\" />\n              <Kbd.Content>E</Kbd.Content>\n            </Kbd>\n          </ListBox.Item>\n        </ListBox.Section>\n        <Separator />\n        <ListBox.Section>\n          <Header>危险区域</Header>\n          <ListBox.Item id=\"delete-file\" textValue=\"删除文件\" variant=\"danger\">\n            <div className=\"flex h-8 items-start justify-center pt-px\">\n              <TrashBin className=\"size-4 shrink-0 text-danger\" />\n            </div>\n            <div className=\"flex flex-col\">\n              <Label>删除文件</Label>\n              <Description>移至废纸篓</Description>\n            </div>\n            <Kbd className=\"ms-auto\" variant=\"light\">\n              <Kbd.Abbr keyValue=\"command\" />\n              <Kbd.Abbr keyValue=\"shift\" />\n              <Kbd.Content>D</Kbd.Content>\n            </Kbd>\n          </ListBox.Item>\n        </ListBox.Section>\n      </ListBox>\n    </Surface>\n  );\n}\n"
}
