  "code": "import {Avatar, Badge} from \"@lenso/ui\";\n\nconst GREEN_AVATAR_URL = \"https://heroui-assets.nyc3.cdn.digitaloceanspaces.com/avatars/green.jpg\";\nconst ORANGE_AVATAR_URL =\n  \"https://heroui-assets.nyc3.cdn.digitaloceanspaces.com/avatars/orange.jpg\";\nconst BLUE_AVATAR_URL = \"https://heroui-assets.nyc3.cdn.digitaloceanspaces.com/avatars/blue.jpg\";\n\nexport function BadgeBasic() {\n  return (\n    <div className=\"flex items-center gap-6\">\n      <Badge.Anchor>\n        <Avatar>\n          <Avatar.Image alt=\"头像\" src={GREEN_AVATAR_URL} />\n          <Avatar.Fallback>JD</Avatar.Fallback>\n        </Avatar>\n        <Badge color=\"danger\" size=\"sm\">\n          5\n        </Badge>\n      </Badge.Anchor>\n\n      <Badge.Anchor>\n        <Avatar>\n          <Avatar.Image alt=\"头像\" src={ORANGE_AVATAR_URL} />\n          <Avatar.Fallback>AB</Avatar.Fallback>\n        </Avatar>\n        <Badge color=\"accent\" size=\"sm\">\n          新\n        </Badge>\n      </Badge.Anchor>\n\n      <Badge.Anchor>\n        <Avatar>\n          <Avatar.Image alt=\"头像\" src={BLUE_AVATAR_URL} />\n          <Avatar.Fallback>CD</Avatar.Fallback>\n        </Avatar>\n        <Badge color=\"success\" placement=\"bottom-right\" size=\"sm\" />\n      </Badge.Anchor>\n    </div>\n  );\n}\n"
}
