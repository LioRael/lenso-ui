  "source": "apps/docs/src/demos/cn/kbd/variants.tsx",
  "code": "import {Kbd} from \"@lenso/ui\";\n\nexport function Variants() {\n  return (\n    <div className=\"flex flex-col gap-4\">\n      <div className=\"flex items-center gap-2\">\n        <span>复制：</span>\n        <Kbd>\n          <Kbd.Abbr keyValue=\"command\" />\n          <Kbd.Content>C</Kbd.Content>\n        </Kbd>\n        <Kbd variant=\"light\">\n          <Kbd.Abbr keyValue=\"command\" />\n          <Kbd.Content>C</Kbd.Content>\n        </Kbd>\n      </div>\n      <div className=\"flex items-center gap-2\">\n        <span>粘贴：</span>\n        <Kbd>\n          <Kbd.Abbr keyValue=\"command\" />\n          <Kbd.Content>V</Kbd.Content>\n        </Kbd>\n        <Kbd variant=\"light\">\n          <Kbd.Abbr keyValue=\"command\" />\n          <Kbd.Content>V</Kbd.Content>\n        </Kbd>\n      </div>\n      <div className=\"flex items-center gap-2\">\n        <span>剪切：</span>\n        <Kbd>\n          <Kbd.Abbr keyValue=\"command\" />\n          <Kbd.Content>X</Kbd.Content>\n        </Kbd>\n        <Kbd variant=\"light\">\n          <Kbd.Abbr keyValue=\"command\" />\n          <Kbd.Content>X</Kbd.Content>\n        </Kbd>\n      </div>\n      <div className=\"flex items-center gap-2\">\n        <span>撤销：</span>\n        <Kbd>\n          <Kbd.Abbr keyValue=\"command\" />\n          <Kbd.Content>Z</Kbd.Content>\n        </Kbd>\n        <Kbd variant=\"light\">\n          <Kbd.Abbr keyValue=\"command\" />\n          <Kbd.Content>Z</Kbd.Content>\n        </Kbd>\n      </div>\n      <div className=\"flex items-center gap-2\">\n        <span>重做：</span>\n        <Kbd>\n          <Kbd.Abbr keyValue=\"command\" />\n          <Kbd.Abbr keyValue=\"shift\" />\n          <Kbd.Content>Z</Kbd.Content>\n        </Kbd>\n        <Kbd variant=\"light\">\n          <Kbd.Abbr keyValue=\"command\" />\n          <Kbd.Abbr keyValue=\"shift\" />\n          <Kbd.Content>Z</Kbd.Content>\n        </Kbd>\n      </div>\n    </div>\n  );\n}\n"
}
