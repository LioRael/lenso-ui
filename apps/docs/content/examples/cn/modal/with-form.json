{
  "name": "modal-with-form",
  "exported": "WithForm",
  "source": "apps/docs/src/demos/cn/modal/with-form.tsx",
  "code": "\"use client\";\n\nimport {Envelope} from \"@gravity-ui/icons\";\nimport {Button, Input, Label, Modal, Surface, TextField} from \"@lenso/ui\";\n\nexport function WithForm() {\n  return (\n    <Modal>\n      <Button variant=\"secondary\">打开联系表单</Button>\n      <Modal.Backdrop>\n        <Modal.Container placement=\"auto\">\n          <Modal.Dialog className=\"sm:max-w-md\">\n            <Modal.CloseTrigger />\n            <Modal.Header>\n              <Modal.Icon className=\"bg-accent-soft text-accent-soft-foreground\">\n                <Envelope className=\"size-5\" />\n              </Modal.Icon>\n              <Modal.Heading>联系我们</Modal.Heading>\n              <p className=\"mt-1.5 text-sm leading-5 text-muted\">\n                填写下方表单，我们会尽快回复。在移动端弹出键盘时，模态框会自动适配。\n              </p>\n            </Modal.Header>\n            <Modal.Body className=\"p-6\">\n              <Surface variant=\"default\">\n                <form className=\"flex flex-col gap-4\">\n                  <TextField className=\"w-full\" name=\"name\" type=\"text\">\n                    <Label>姓名</Label>\n                    <Input placeholder=\"输入你的姓名\" />\n                  </TextField>\n                  <TextField className=\"w-full\" name=\"email\" type=\"email\">\n                    <Label>邮箱</Label>\n                    <Input placeholder=\"输入你的邮箱\" />\n                  </TextField>\n                  <TextField className=\"w-full\" name=\"phone\" type=\"tel\">\n                    <Label>电话</Label>\n                    <Input placeholder=\"输入你的电话号码\" />\n                  </TextField>\n                  <TextField className=\"w-full\" name=\"company\">\n                    <Label>公司</Label>\n                    <Input placeholder=\"输入公司名称\" />\n                  </TextField>\n                  <TextField className=\"w-full\" name=\"message\">\n                    <Label>留言</Label>\n                    <Input placeholder=\"输入留言内容\" />\n                  </TextField>\n                </form>\n              </Surface>\n            </Modal.Body>\n            <Modal.Footer>\n              <Button slot=\"close\" variant=\"secondary\">\n                取消\n              </Button>\n              <Button slot=\"close\">发送消息</Button>\n            </Modal.Footer>\n          </Modal.Dialog>\n        </Modal.Container>\n      </Modal.Backdrop>\n    </Modal>\n  );\n}\n"
}
