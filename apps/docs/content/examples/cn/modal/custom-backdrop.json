{
  "name": "modal-custom-backdrop",
  "exported": "CustomBackdrop",
  "source": "apps/docs/src/demos/cn/modal/custom-backdrop.tsx",
  "code": "\"use client\";\n\nimport {Sparkles} from \"@gravity-ui/icons\";\nimport {Button, Modal} from \"@lenso/ui\";\n\nexport function CustomBackdrop() {\n  return (\n    <Modal>\n      <Button variant=\"secondary\">自定义背景</Button>\n      <Modal.Backdrop\n        className=\"bg-linear-to-t from-black/80 via-black/40 to-transparent dark:from-zinc-800/80 dark:via-zinc-800/40\"\n        variant=\"blur\"\n      >\n        <Modal.Container>\n          <Modal.Dialog className=\"sm:max-w-[360px]\">\n            <Modal.Header className=\"items-center text-center\">\n              <Modal.Icon className=\"bg-accent-soft text-accent-soft-foreground\">\n                <Sparkles className=\"size-5\" />\n              </Modal.Icon>\n              <Modal.Heading>高级背景</Modal.Heading>\n            </Modal.Header>\n            <Modal.Body>\n              <p>\n                此背景采用从底部深色过渡到顶部完全透明的精致渐变，并配合柔和的模糊效果。渐变会在浅色与深色模式下自动调整强度，以获得最佳对比度。\n              </p>\n            </Modal.Body>\n            <Modal.Footer className=\"flex-col-reverse\">\n              <Button className=\"w-full\" slot=\"close\">\n                Amazing!\n              </Button>\n              <Button className=\"w-full\" slot=\"close\" variant=\"secondary\">\n                关闭\n              </Button>\n            </Modal.Footer>\n            <Modal.CloseTrigger />\n          </Modal.Dialog>\n        </Modal.Container>\n      </Modal.Backdrop>\n    </Modal>\n  );\n}\n"
}
