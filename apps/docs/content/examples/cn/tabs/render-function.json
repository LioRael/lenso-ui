  "source": "apps/docs/src/demos/cn/tabs/render-function.tsx",
  "code": "\"use client\";\n\nimport {Tabs} from \"@lenso/ui\";\nimport Link from \"next/link\";\n\nexport function RenderFunction() {\n  return (\n    <Tabs className=\"w-full max-w-md\" render={(props) => <div {...props} data-custom=\"foo\" />}>\n      <Tabs.ListContainer>\n        <Tabs.List aria-label=\"选项\">\n          <Tabs.Tab\n            href=\"/docs/react/getting-started\"\n            id=\"getting-started\"\n            render={(domProps: any) => <Link {...domProps} />}\n          >\n            快速入门\n            <Tabs.Indicator />\n          </Tabs.Tab>\n          <Tabs.Tab\n            href=\"/docs/react/components\"\n            id=\"components\"\n            render={(domProps: any) => <Link {...domProps} />}\n          >\n            组件\n            <Tabs.Indicator />\n          </Tabs.Tab>\n          <Tabs.Tab\n            href=\"/docs/react/releases\"\n            id=\"releases\"\n            render={(domProps: any) => <Link {...domProps} />}\n          >\n            发布说明\n            <Tabs.Indicator />\n          </Tabs.Tab>\n        </Tabs.List>\n      </Tabs.ListContainer>\n      <Tabs.Panel className=\"pt-4\" id=\"overview\">\n        <p>查看项目概览与近期活动。</p>\n      </Tabs.Panel>\n      <Tabs.Panel className=\"pt-4\" id=\"analytics\">\n        <p>跟踪指标并分析性能数据。</p>\n      </Tabs.Panel>\n      <Tabs.Panel className=\"pt-4\" id=\"reports\">\n        <p>生成并下载详细报告。</p>\n      </Tabs.Panel>\n    </Tabs>\n  );\n}\n"
}
