{
  "name": "toggle-button-group-orientation",
  "exported": "Orientation",
  "source": "apps/docs/src/demos/cn/toggle-button-group/orientation.tsx",
  "code": "import {Bold, Italic, Underline} from \"@gravity-ui/icons\";\nimport {ToggleButton, ToggleButtonGroup} from \"@lenso/ui\";\n\nexport function Orientation() {\n  return (\n    <div className=\"flex items-start gap-8\">\n      <div className=\"flex flex-col gap-2\">\n        <span className=\"text-sm text-muted\">水平</span>\n        <ToggleButtonGroup orientation=\"horizontal\" selectionMode=\"multiple\">\n          <ToggleButton isIconOnly aria-label=\"粗体\" id=\"bold\">\n            <Bold />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"斜体\" id=\"italic\">\n            <ToggleButtonGroup.Separator />\n            <Italic />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"下划线\" id=\"underline\">\n            <ToggleButtonGroup.Separator />\n            <Underline />\n          </ToggleButton>\n        </ToggleButtonGroup>\n      </div>\n      <div className=\"flex flex-col gap-2\">\n        <span className=\"text-sm text-muted\">垂直</span>\n        <ToggleButtonGroup orientation=\"vertical\" selectionMode=\"multiple\">\n          <ToggleButton isIconOnly aria-label=\"粗体\" id=\"bold\">\n            <Bold />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"斜体\" id=\"italic\">\n            <ToggleButtonGroup.Separator />\n            <Italic />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"下划线\" id=\"underline\">\n            <ToggleButtonGroup.Separator />\n            <Underline />\n          </ToggleButton>\n        </ToggleButtonGroup>\n      </div>\n    </div>\n  );\n}\n"
}
