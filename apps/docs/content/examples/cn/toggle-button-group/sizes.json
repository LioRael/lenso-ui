  "source": "apps/docs/src/demos/cn/toggle-button-group/sizes.tsx",
  "code": "import {Bold, Italic, Strikethrough, Underline} from \"@gravity-ui/icons\";\nimport {ToggleButton, ToggleButtonGroup} from \"@lenso/ui\";\n\nexport function Sizes() {\n  return (\n    <div className=\"flex flex-col gap-6\">\n      <div className=\"flex flex-col gap-2\">\n        <span className=\"text-sm text-muted\">小</span>\n        <ToggleButtonGroup selectionMode=\"multiple\" size=\"sm\">\n          <ToggleButton isIconOnly aria-label=\"粗体\" id=\"bold\">\n            <Bold />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"斜体\" id=\"italic\">\n            <ToggleButtonGroup.Separator />\n            <Italic />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"下划线\" id=\"underline\">\n            <ToggleButtonGroup.Separator />\n            <Underline />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"删除线\" id=\"strikethrough\">\n            <ToggleButtonGroup.Separator />\n            <Strikethrough />\n          </ToggleButton>\n        </ToggleButtonGroup>\n      </div>\n      <div className=\"flex flex-col gap-2\">\n        <span className=\"text-sm text-muted\">中（默认）</span>\n        <ToggleButtonGroup selectionMode=\"multiple\" size=\"md\">\n          <ToggleButton isIconOnly aria-label=\"粗体\" id=\"bold\">\n            <Bold />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"斜体\" id=\"italic\">\n            <ToggleButtonGroup.Separator />\n            <Italic />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"下划线\" id=\"underline\">\n            <ToggleButtonGroup.Separator />\n            <Underline />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"删除线\" id=\"strikethrough\">\n            <ToggleButtonGroup.Separator />\n            <Strikethrough />\n          </ToggleButton>\n        </ToggleButtonGroup>\n      </div>\n      <div className=\"flex flex-col gap-2\">\n        <span className=\"text-sm text-muted\">大</span>\n        <ToggleButtonGroup selectionMode=\"multiple\" size=\"lg\">\n          <ToggleButton isIconOnly aria-label=\"粗体\" id=\"bold\">\n            <Bold />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"斜体\" id=\"italic\">\n            <ToggleButtonGroup.Separator />\n            <Italic />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"下划线\" id=\"underline\">\n            <ToggleButtonGroup.Separator />\n            <Underline />\n          </ToggleButton>\n          <ToggleButton isIconOnly aria-label=\"删除线\" id=\"strikethrough\">\n            <ToggleButtonGroup.Separator />\n            <Strikethrough />\n          </ToggleButton>\n        </ToggleButtonGroup>\n      </div>\n    </div>\n  );\n}\n"
