{
  "name": "input-group-required",
  "exported": "Required",
  "source": "apps/docs/src/demos/cn/input-group/required.tsx",
  "code": "\"use client\";\n\nimport {Envelope} from \"@gravity-ui/icons\";\nimport {Description, InputGroup, Label, TextField} from \"@lenso/ui\";\n\nexport function Required() {\n  return (\n    <div className=\"flex flex-col gap-4\">\n      <TextField isRequired className=\"w-full max-w-[280px]\" name=\"email\">\n        <Label>邮箱地址</Label>\n        <InputGroup>\n          <InputGroup.Prefix>\n            <Envelope className=\"size-4 text-muted\" />\n          </InputGroup.Prefix>\n          <InputGroup.Input className=\"w-full max-w-[280px]\" placeholder=\"name@email.com\" />\n        </InputGroup>\n      </TextField>\n      <TextField isRequired className=\"w-full max-w-[280px]\" name=\"price\">\n        <Label>设置价格</Label>\n        <InputGroup>\n          <InputGroup.Prefix>$</InputGroup.Prefix>\n          <InputGroup.Input className=\"w-full max-w-[200px]\" placeholder=\"0\" type=\"number\" />\n          <InputGroup.Suffix>USD</InputGroup.Suffix>\n        </InputGroup>\n        <Description>客户将支付的价格</Description>\n      </TextField>\n    </div>\n  );\n}\n"
}
