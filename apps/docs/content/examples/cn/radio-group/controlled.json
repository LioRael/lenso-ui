  "name": "radio-group-controlled",
  "exported": "Controlled",
  "source": "apps/docs/src/demos/cn/radio-group/controlled.tsx",
  "code": "\"use client\";\n\nimport {Description, Label, Radio, RadioGroup} from \"@lenso/ui\";\nimport React from \"react\";\n\nexport function Controlled() {\n  const [value, setValue] = React.useState(\"pro\");\n\n  return (\n    <div className=\"flex flex-col gap-4\">\n      <RadioGroup name=\"plan-controlled\" value={value} onChange={setValue}>\n        <Label>订阅套餐</Label>\n        <Radio value=\"starter\">\n          <Radio.Content>\n            <Radio.Control>\n              <Radio.Indicator />\n            </Radio.Control>\n            入门版\n          </Radio.Content>\n          <Description>适合副项目和小型团队</Description>\n        </Radio>\n        <Radio value=\"pro\">\n          <Radio.Content>\n            <Radio.Control>\n              <Radio.Indicator />\n            </Radio.Control>\n            专业版\n          </Radio.Content>\n          <Description>高级报表与分析</Description>\n        </Radio>\n        <Radio value=\"teams\">\n          <Radio.Content>\n            <Radio.Control>\n              <Radio.Indicator />\n            </Radio.Control>\n            团队版\n          </Radio.Content>\n          <Description>最多可与 10 名队友共享访问权限</Description>\n        </Radio>\n      </RadioGroup>\n      <p className=\"text-sm text-muted\">\n        已选套餐： <span className=\"font-medium\">{value}</span>\n      </p>\n    </div>\n  );\n}\n"
}
