  "source": "apps/docs/src/demos/cn/radio-group/variants.tsx",
  "code": "import {Description, Radio, RadioGroup} from \"@lenso/ui\";\n\nexport function Variants() {\n  return (\n    <div className=\"flex flex-col gap-8\">\n      <div className=\"flex flex-col gap-2\">\n        <p className=\"text-sm font-medium text-muted\">主要变体</p>\n        <RadioGroup defaultValue=\"option1\" name=\"primary-plan\" variant=\"primary\">\n          <Radio value=\"option1\">\n            <Radio.Content>\n              <Radio.Control>\n                <Radio.Indicator />\n              </Radio.Control>\n              选项 1\n            </Radio.Content>\n            <Description>默认背景的标准样式</Description>\n          </Radio>\n          <Radio value=\"option2\">\n            <Radio.Content>\n              <Radio.Control>\n                <Radio.Indicator />\n              </Radio.Control>\n              选项 2\n            </Radio.Content>\n            <Description>另一种主要样式选项</Description>\n          </Radio>\n        </RadioGroup>\n      </div>\n      <div className=\"flex flex-col gap-2\">\n        <p className=\"text-sm font-medium text-muted\">次要变体</p>\n        <RadioGroup defaultValue=\"option1\" name=\"secondary-plan\" variant=\"secondary\">\n          <Radio value=\"option1\">\n            <Radio.Content>\n              <Radio.Control>\n                <Radio.Indicator />\n              </Radio.Control>\n              选项 1\n            </Radio.Content>\n            <Description>用于表面上的低强调变体</Description>\n          </Radio>\n          <Radio value=\"option2\">\n            <Radio.Content>\n              <Radio.Control>\n                <Radio.Indicator />\n              </Radio.Control>\n              选项 2\n            </Radio.Content>\n            <Description>另一种次要样式选项</Description>\n          </Radio>\n        </RadioGroup>\n      </div>\n    </div>\n  );\n}\n"
