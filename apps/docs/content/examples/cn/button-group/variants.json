tor />\n            第二项\n          </Button>\n          <Button>\n            <ButtonGroup.Separator />\n            第三项\n          </Button>\n        </ButtonGroup>\n      </div>\n      <div className=\"flex flex-col gap-2\">\n        <p className=\"text-sm text-muted\">危险</p>\n        <ButtonGroup variant=\"danger\">\n          <Button>第一项</Button>\n          <Button>\n            <ButtonGroup.Separator />\n            第二项\n          </Button>\n          <Button>\n            <ButtonGroup.Separator />\n            第三项\n          </Button>\n        </ButtonGroup>\n      </div>\n    </div>\n  );\n}\n"
