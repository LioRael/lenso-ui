{
  "name": "button-group-with-icons",
  "exported": "WithIcons",
  "source": "apps/docs/src/demos/cn/button-group/with-icons.tsx",
  "code": "import {Globe, Plus, TrashBin} from \"@gravity-ui/icons\";\nimport {Button, ButtonGroup} from \"@lenso/ui\";\n\nexport function WithIcons() {\n  return (\n    <div className=\"flex flex-col gap-6\">\n      <div className=\"flex flex-col items-start gap-2\">\n        <p className=\"text-sm text-muted\">带图标</p>\n        <ButtonGroup variant=\"secondary\">\n          <Button>\n            <Globe />\n            搜索\n          </Button>\n          <Button>\n            <ButtonGroup.Separator />\n            <Plus />\n            添加\n          </Button>\n          <Button>\n            <ButtonGroup.Separator />\n            <TrashBin />\n            删除\n          </Button>\n        </ButtonGroup>\n      </div>\n      <div className=\"flex flex-col items-start gap-2\">\n        <p className=\"text-sm text-muted\">仅图标按钮</p>\n        <ButtonGroup variant=\"tertiary\">\n          <Button isIconOnly aria-label=\"搜索\">\n            <Globe />\n          </Button>\n          <Button isIconOnly aria-label=\"添加\">\n            <ButtonGroup.Separator />\n            <Plus />\n          </Button>\n          <Button isIconOnly aria-label=\"删除\">\n            <ButtonGroup.Separator />\n            <TrashBin />\n          </Button>\n        </ButtonGroup>\n      </div>\n    </div>\n  );\n}\n"
}
