  "source": "apps/docs/src/demos/cn/button-group/sizes.tsx",
  "code": "import {Button, ButtonGroup} from \"@lenso/ui\";\n\nexport function Sizes() {\n  return (\n    <div className=\"flex flex-col gap-4\">\n      <div className=\"flex flex-col items-start gap-2\">\n        <p className=\"text-sm text-muted\">小</p>\n        <ButtonGroup size=\"sm\" variant=\"secondary\">\n          <Button>第一项</Button>\n          <Button>\n            <ButtonGroup.Separator />\n            第二项\n          </Button>\n          <Button>\n            <ButtonGroup.Separator />\n            第三项\n          </Button>\n        </ButtonGroup>\n      </div>\n      <div className=\"flex flex-col items-start gap-2\">\n        <p className=\"text-sm text-muted\">中（默认）</p>\n        <ButtonGroup size=\"md\" variant=\"secondary\">\n          <Button>第一项</Button>\n          <Button>\n            <ButtonGroup.Separator />\n            第二项\n          </Button>\n          <Button>\n            <ButtonGroup.Separator />\n            第三项\n          </Button>\n        </ButtonGroup>\n      </div>\n      <div className=\"flex flex-col items-start gap-2\">\n        <p className=\"text-sm text-muted\">大</p>\n        <ButtonGroup size=\"lg\" variant=\"secondary\">\n          <Button>第一项</Button>\n          <Button>\n            <ButtonGroup.Separator />\n            第二项\n          </Button>\n          <Button>\n            <ButtonGroup.Separator />\n            第三项\n          </Button>\n        </ButtonGroup>\n      </div>\n    </div>\n  );\n}\n"
}
