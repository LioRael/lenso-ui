  "source": "apps/docs/src/demos/cn/number-field/required.tsx",
  "code": "import {Description, Label, NumberField} from \"@lenso/ui\";\n\nexport function Required() {\n  return (\n    <div className=\"flex w-full max-w-64 flex-col gap-4\">\n      <NumberField isRequired minValue={0} name=\"quantity\">\n        <Label>数量</Label>\n        <NumberField.Group>\n          <NumberField.DecrementButton />\n          <NumberField.Input className=\"w-[120px]\" />\n          <NumberField.IncrementButton />\n        </NumberField.Group>\n      </NumberField>\n      <NumberField isRequired defaultValue={1} maxValue={10} minValue={1} name=\"rating\">\n        <Label>评分</Label>\n        <NumberField.Group>\n          <NumberField.DecrementButton />\n          <NumberField.Input className=\"w-[120px]\" />\n          <NumberField.IncrementButton />\n        </NumberField.Group>\n        <Description>评分范围 1 到 10</Description>\n      </NumberField>\n    </div>\n  );\n}\n"
}
