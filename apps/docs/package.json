{
  "name": "@lenso/ui-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "bun scripts/generate-docs.ts",
    "generate:api": "bun scripts/generate-docs.ts api",
    "generate:content": "bun scripts/generate-docs.ts content",
    "generate:contract": "bun scripts/generate-docs.ts contract",
    "build": "bun scripts/generate-docs.ts site --skip-build && node node_modules/vite/bin/vite.js build && bun scripts/check-export-size.ts",
    "dev": "bun scripts/generate-docs.ts dev --skip-build && node node_modules/vite/bin/vite.js",
    "start": "node node_modules/vite/bin/vite.js preview",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "typecheck": "bun check --no-script --noEmit && bun run typecheck:scripts",
    "typecheck:scripts": "bun check --no-script -p tsconfig.scripts.json",
    "test": "bun test --preload ../../tests/setup/stylex.ts --timeout 30000 scripts/*.test.ts src/lib/*.test.ts",
    "test:stylex-artifacts": "bun test test/stylex-artifacts.test.ts test/static-export.test.ts",
    "test:dev": "node test/start-dev.mjs",
    "test:dev-isolation": "node test/start-dev-isolation.mjs",
    "test:backdrop-prefetch": "node test/backdrop-prefetch.mjs",
    "test:backdrop-paint-animation": "node test/backdrop-paint-animation.mjs",
    "test:backdrop-edits": "node test/backdrop-edits.mjs",
    "test:backdrop-cache": "node test/backdrop-cache.mjs",
    "test:canvas-navigation": "node test/glass-canvas-navigation.mjs",
    "test:moving-glass-preferences": "node test/moving-glass-preferences.mjs",
    "test:home-showcase": "node test/home-showcase-initial.mjs",
    "test:home-scroll-material": "node test/home-scroll-material.mjs",
    "test:material-tone-alpha": "node test/material-tone-alpha.mjs",
    "test:mobile-navigation": "node test/mobile-navigation.mjs",
    "test:tab-bar-performance": "node test/tab-bar-performance.mjs",
    "test:upstream-glass": "node test/upstream-glass.mjs",
    "test:document-loading": "node test/document-loading.mjs",
    "test:loading-budget": "node test/loading-budget.mjs",
    "test:production-loading": "node test/production-loading.mjs",
    "test:loading-timing": "node test/loading-timing.mjs",
    "test:deferred-content": "node test/deferred-content.mjs",
    "test:first-paint": "node test/first-paint.mjs",
    "test:tabs-overflow": "node test/tabs-overflow.mjs",
    "test:navigation-controls": "node test/navigation-controls.mjs",
    "test:list-hover": "node test/list-hover.mjs",
    "test:list-refresh": "node test/list-refresh.mjs",
    "test:swipe-wheel": "node test/swipe-wheel.mjs",
    "test:segmented-section": "node test/segmented-section.mjs",
    "test:section-index": "node test/section-index.mjs",
    "test:ios-controls-preview": "node test/start-ios-controls.mjs",
    "lint": "bun --bun oxlint --deny-warnings --react-plugin --jsx-a11y-plugin src scripts test",
    "format": "bun --bun oxfmt src scripts test *.ts *.json",
    "test:photos": "bun test --preload ./test/photos-dom.preload.ts test/photos-search.dom.test.tsx test/photos-drag.dom.test.tsx test/photos-editing.test.ts test/photos-editor.dom.test.tsx test/photos-viewer-menu.dom.test.tsx",
    "test:browser": "node test/start-browser.mjs",
    "test:presentation-panels": "node test/presentation-panels.mjs",
    "test:anchored-material": "node test/popover-material.mjs",
    "test:popover-material": "node test/popover-material.mjs",
    "test:search-material": "node test/search-material.mjs",
    "test:search-stability": "node test/search-stability.mjs",
    "test:hmr": "node test/start-stylex-hmr.mjs",
    "test:command": "node test/command.mjs"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@fumadocs/story": "1.5.3",
    "@fumari/stf": "1.1.2",
    "@gravity-ui/icons": "2.23.1",
    "@iconify/react": "6.0.4",
    "@internationalized/date": "3.12.4",
    "@lenso/docs": "workspace:*",
    "@lenso/glass": "workspace:*",
    "@lenso/tokens": "workspace:*",
    "@lenso/ui": "workspace:*",
    "@pierre/highlights": "0.5.0",
    "@stylexjs/stylex": "catalog:",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "@tanstack/react-table": "catalog:",
    "culori": "4.0.2",
    "fumadocs-core": "16.18.4",
    "fumadocs-mdx": "15.5.3",
    "fumadocs-ui": "16.18.4",
    "gray-matter": "4.0.3",
    "m3-ripple": "1.1.3",
    "next-themes": "0.4.6",
    "nuqs": "2.10.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "shiki": "4.6.0",
    "vfile": "6.0.3"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@babel/types": "7.29.8",
    "@lenso/ui-devtools": "workspace:*",
    "@stylexjs/babel-plugin": "0.19.1",
    "@stylexjs/unplugin": "catalog:",
    "@types/culori": "4.0.1",
    "@types/mdast": "4.0.4",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "6.3.0",
    "playwright": "1.65.0",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions"
  ]
}
