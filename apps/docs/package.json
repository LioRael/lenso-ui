{
  "name": "@lenso/ui-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "import:upstream": "node scripts/import-upstream.mjs",
    "build": "node scripts/prepare-docs.mjs && next build --webpack && node scripts/check-export-size.mjs",
    "dev": "node scripts/prepare-docs.mjs && next dev --webpack",
    "start": "node scripts/serve-docs.mjs",
    "typecheck": "node scripts/prepare-docs.mjs && next typegen && tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "test:stylex-build": "node test/stylex-build.mjs",
    "test:api-browser": "node test/native-api.browser.mjs",
    "test:locale-browser": "node scripts/locale-example-proof.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:examples": "node scripts/examples-browser-check.mjs",
    "lint": "oxlint --deny-warnings --react-plugin --jsx-a11y-plugin src scripts test",
    "format": "oxfmt src scripts test *.ts *.json"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@gravity-ui/icons": "2.22.0",
    "@iconify/react": "6.0.2",
    "@internationalized/date": "3.12.4",
    "@lenso/tokens": "workspace:*",
    "@lenso/ui": "workspace:*",
    "@orama/orama": "3.1.18",
    "@orama/tokenizers": "3.1.18",
    "@stylexjs/stylex": "catalog:",
    "@tanstack/react-table": "catalog:",
    "fumadocs-core": "16.9.0",
    "fumadocs-ui": "16.9.0",
    "gray-matter": "4.0.3",
    "m3-ripple": "1.1.3",
    "next": "catalog:",
    "next-mdx-remote": "6.0.0",
    "next-themes": "0.4.6",
    "react": "catalog:",
    "react-aria-components": "1.21.1",
    "react-dom": "catalog:",
    "remark-gfm": "4.0.1",
    "shiki": "3.23.0"
  },
  "devDependencies": {
    "@babel/generator": "7.29.8",
    "@babel/parser": "7.29.9",
    "@stylexjs/babel-plugin": "0.19.1",
    "@stylexjs/postcss-plugin": "0.19.1",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "axe-core": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "typescript-api": "npm:typescript@5.9.3"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions"
  ]
}
