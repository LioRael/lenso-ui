{
  "id": "combobox",
  "name": "Combobox",
  "description": "Try single and multiple selection states on the real component.",
  "themeControl": "theme",
  "controls": [
    {
      "id": "state",
      "label": "State",
      "type": "select",
      "options": ["closed", "open", "empty", "loading"],
      "default": "closed"
    },
    {
      "id": "selection",
      "label": "Selection",
      "type": "select",
      "options": ["single", "multiple"],
      "default": "multiple"
    },
    {
      "id": "theme",
      "label": "Theme",
      "type": "select",
      "options": ["system", "light", "dark"],
      "default": "system"
    }
  ],
  "examples": [{ "id": "default", "label": "Example · Default" }]
}
