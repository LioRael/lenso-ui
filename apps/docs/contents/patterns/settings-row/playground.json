    { "id": "disabled", "label": "Disabled", "type": "boolean", "default": false },
    {
      "id": "theme",
      "label": "Theme",
      "type": "select",
      "options": ["system", "light", "dark"],
      "default": "system"
    }
  ],
  "examples": [{ "id": "default", "label": "Example · Preference" }]
