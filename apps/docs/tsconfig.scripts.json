{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun", "node"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": ["scripts/*.ts", "test/stylex-artifacts.test.ts"]
}
